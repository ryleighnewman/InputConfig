    },
    "The Globe key can be bound as an input, tapped on its own or held as fn" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن ربط مفتاح Globe كإدخال، بنقرة منفردة أو بإبقائه مضغوطًا كمفتاح fn"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klávesu Globe lze přiřadit jako vstup, klepnutím samostatně nebo podržením jako fn"
