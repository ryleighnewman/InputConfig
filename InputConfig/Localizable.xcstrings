          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una riga per ogni input che il dispositivo segnala in questo momento, raggruppata per parte, ognuna in attesa che tu scelga la sua uscita"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
