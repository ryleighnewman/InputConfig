    "Outside every band, at %@ of the travel" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خارج كل النطاقات، عند %@ من المشوار"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimo všechna pásma, při %@ zdvihu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden for alle bånd, ved %@ af udslaget"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerhalb aller Bereiche, bei %@ des Wegs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera de toda banda, a %@ del recorrido"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikkien alueiden ulkopuolella, liikeradan kohdassa %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors de toute bande, à %@ de la course"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחוץ לכל הפסים, ב-%@ מהמהלך"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden sávon kívül, az út %@ pontján"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di luar semua pita, pada %@ dari jarak gerak"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuori da ogni fascia, a %@ della corsa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての帯の外側、可動範囲の%@の位置"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 구간 밖, 이동 범위의 %@ 지점"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utenfor alle bånd, ved %@ av utslaget"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buiten alle gebieden, op %@ van de beweging"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poza wszystkimi pasmami, przy %@ skoku"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora de toda faixa, a %@ do curso"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вне всех полос, на %@ хода"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimo všetkých pásiem, pri %@ zdvihu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utanför alla band, vid %@ av utslaget"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นอกทุกช่วง ที่ %@ ของระยะเคลื่อนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm bantların dışında, yolun %@ noktasında"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поза всіма смугами, на %@ ходу"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoài mọi dải, ở mức %@ của hành trình"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有区段之外，位于行程的 %@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在所有區段之外，位於行程的 %@"
          }
        }
      }
    },
    "Over Bluetooth the controller keeps its profiles to itself: it shows which one is active, and its Profile button switches. Connect by USB-C to view and edit them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبر Bluetooth تحتفظ الوحدة بملفات تعريفها لنفسها: تعرض أيها نشط، ويبدّل زر ملف التعريف بينها. اتصل عبر USB-C لعرضها وتحريرها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přes Bluetooth si ovladač nechává profily pro sebe: ukazuje, který je aktivní, a jeho tlačítko Profil přepíná. Pro zobrazení a úpravy připojte přes USB-C."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via Bluetooth holder controlleren sine profiler for sig selv: den viser, hvilken der er aktiv, og dens Profil-knap skifter. Forbind via USB-C for at se og redigere dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über Bluetooth behält der Controller seine Profile für sich: Er zeigt, welches aktiv ist, und seine Profiltaste schaltet um. Verbinde ihn über USB-C, um sie anzusehen und zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por Bluetooth el mando se guarda sus perfiles: muestra cuál está activo, y su botón Perfil cambia. Conéctalo por USB-C para verlos y editarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetoothilla ohjain pitää profiilinsa itsellään: se näyttää, mikä on aktiivinen, ja sen Profiili-painike vaihtaa. Yhdistä USB-C:llä nähdäksesi ja muokataksesi niitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Bluetooth, la manette garde ses profils pour elle : elle indique lequel est actif, et son bouton Profil bascule. Connectez-la en USB-C pour les voir et les modifier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דרך Bluetooth הבקר שומר את הפרופילים לעצמו: הוא מציג איזה פעיל, וכפתור הפרופיל שלו מחליף. התחברו דרך USB-C כדי לצפות ולערוך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetoothon a kontroller megtartja magának a profiljait: mutatja, melyik aktív, és a Profil gombja vált. A megtekintéshez és szerkesztéshez csatlakoztasd USB-C-n."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lewat Bluetooth kontroler menyimpan profilnya sendiri: ia menunjukkan mana yang aktif, dan tombol Profilnya berpindah. Hubungkan lewat USB-C untuk melihat dan mengeditnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via Bluetooth il controller tiene per sé i profili: mostra quale è attivo, e il suo pulsante Profilo li cambia. Collegalo via USB-C per vederli e modificarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth経由では、コントローラーはプロファイルを自分で保持します。どれが有効かを表示し、プロファイルボタンで切り替わります。表示と編集にはUSB-Cで接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth에서는 컨트롤러가 프로파일을 스스로 보관합니다. 어떤 것이 활성인지 표시하고 프로파일 버튼으로 전환합니다. 보고 편집하려면 USB-C로 연결하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via Bluetooth holder kontrolleren profilene for seg selv: den viser hvilken som er aktiv, og Profil-knappen bytter. Koble til via USB-C for å se og redigere dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via Bluetooth houdt de controller zijn profielen voor zich: hij toont welk profiel actief is, en zijn Profiel-knop schakelt. Verbind via USB-C om ze te bekijken en te bewerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przez Bluetooth kontroler zachowuje profile dla siebie: pokazuje, który jest aktywny, a jego przycisk Profil przełącza. Podłącz przez USB-C, aby je zobaczyć i edytować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por Bluetooth o controle guarda os perfis para si: mostra qual está ativo, e seu botão Perfil alterna. Conecte por USB-C para vê-los e editá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По Bluetooth контроллер держит профили при себе: он показывает, какой активен, а его кнопка Профиль переключает. Подключите по USB-C, чтобы просмотреть и изменить их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cez Bluetooth si ovládač necháva profily pre seba: ukazuje, ktorý je aktívny, a jeho tlačidlo Profil prepína. Na zobrazenie a úpravy pripojte cez USB-C."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Via Bluetooth behåller kontrollen sina profiler för sig själv: den visar vilken som är aktiv, och dess Profil-knapp växlar. Anslut via USB-C för att se och redigera dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผ่าน Bluetooth คอนโทรลเลอร์เก็บโปรไฟล์ไว้กับตัวเอง: แสดงว่าโปรไฟล์ใดใช้งานอยู่ และปุ่มโปรไฟล์ใช้สลับ เชื่อมต่อผ่าน USB-C เพื่อดูและแก้ไข"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth üzerinden denetleyici profillerini kendine saklar: hangisinin etkin olduğunu gösterir ve Profil düğmesi geçiş yapar. Görmek ve düzenlemek için USB-C ile bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По Bluetooth контролер тримає профілі при собі: він показує, який активний, а його кнопка Профіль перемикає. Під'єднайте по USB-C, щоб переглянути та змінити їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qua Bluetooth, tay cầm tự giữ hồ sơ: nó cho biết hồ sơ nào đang hoạt động, và nút Hồ sơ của nó chuyển đổi. Kết nối qua USB-C để xem và sửa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝牙下控制器自行保管配置文件：它显示哪个处于活动状态，配置文件按键负责切换。请通过 USB-C 连接以查看和编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "藍牙下控制器自行保管設定檔：它顯示哪個正在使用，設定檔按鈕負責切換。請透過 USB-C 連接以檢視和編輯。"
          }
        }
      }
    },
