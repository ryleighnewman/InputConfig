    "Every button is drawn where it is on your controller, and lights up when you press it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل زر مرسوم في مكانه على ذراع التحكم، ويضيء عند الضغط عليه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé tlačítko je nakreslené tam, kde je na ovladači, a rozsvítí se, když ho stisknete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver knap er tegnet, hvor den sidder på din controller, og lyser, når du trykker på den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Taste ist dort gezeichnet, wo sie an deinem Controller sitzt, und leuchtet, wenn du sie drückst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada botón está dibujado donde está en tu mando, y se ilumina al pulsarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen painike on piirretty sinne, missä se on ohjaimessasi, ja syttyy, kun painat sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque bouton est dessiné là où il se trouve sur votre manette, et s'allume quand vous l'appuyez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כל כפתור מצויר במקום שלו בשלט, ונדלק כשלוחצים עליו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden gomb ott van megrajzolva, ahol a vezérlődön van, és világít, amikor megnyomod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap tombol digambar di tempatnya pada pengontrol Anda, dan menyala saat ditekan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni tasto è disegnato dove si trova sul controller, e si illumina quando lo premi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ボタンはコントローラ上の位置に描かれ、押すと光ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 버튼은 컨트롤러에 있는 자리에 그려지고, 누르면 빛납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver knapp er tegnet der den sitter på kontrolleren, og lyser når du trykker på den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke knop is getekend waar hij op je controller zit, en licht op als je hem indrukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy przycisk jest narysowany tam, gdzie jest na kontrolerze, i świeci, gdy go naciśniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada botão é desenhado onde fica no seu controle, e acende quando você o aperta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая кнопка нарисована там, где она на вашем контроллере, и подсвечивается при нажатии."
          }
        },
        "sk" : {
          "stringUnit" : {
