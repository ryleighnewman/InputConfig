          "stringUnit" : {
            "state" : "translated",
            "value" : "扳机手感：在 DualSense 或 DualSense Edge 的实时可视化器中点击 L2 或 R2，可选择轻、中或硬的阻力"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扳機手感：在 DualSense 或 DualSense Edge 的即時視覺化器中點按 L2 或 R2，可選擇輕、中或硬的阻力"
          }
        }
      }
    },
