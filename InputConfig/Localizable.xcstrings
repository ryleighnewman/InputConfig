    "This copy was not installed from the Mac App Store, so it cannot take tips. Thank you for using it all the same." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُثبَّت هذه النسخة من Mac App Store، لذا لا يمكنها تلقي إكراميات. شكرًا لك على استخدامها مع ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato kopie nebyla nainstalována z Mac App Store, takže nemůže přijímat spropitné. Přesto děkujeme, že ji používáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kopi blev ikke installeret fra Mac App Store, så den kan ikke tage imod drikkepenge. Tak, fordi du bruger den alligevel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kopie wurde nicht aus dem Mac App Store installiert und kann daher keine Trinkgelder annehmen. Danke, dass du sie trotzdem nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia no se instaló desde el Mac App Store, así que no puede aceptar propinas. Gracias de todos modos por usarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä kopiota ei asennettu Mac App Storesta, joten se ei voi ottaa vastaan tippejä. Kiitos silti sen käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette copie n’a pas été installée depuis le Mac App Store, donc elle ne peut pas recevoir de pourboires. Merci quand même de l’utiliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העותק הזה לא הותקן מ-Mac App Store, ולכן הוא לא יכול לקבל טיפים. תודה על השימוש בו בכל זאת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt a példányt nem a Mac App Store-ból telepítették, ezért nem fogadhat borravalót. Köszönjük, hogy ennek ellenére használja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan ini tidak dipasang dari Mac App Store, sehingga tidak dapat menerima tip. Terima kasih telah menggunakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa copia non è stata installata dal Mac App Store, quindi non può ricevere mance. Grazie comunque per usarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコピーはMac App Storeからインストールされていないため、チップを受け付けられません。それでもご利用いただき、ありがとうございます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사본은 Mac App Store에서 설치한 것이 아니므로 팁을 받을 수 없습니다. 그래도 사용해 주셔서 감사합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne kopien ble ikke installert fra Mac App Store, så den kan ikke ta imot tips. Takk for at du bruker den likevel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kopie is niet geïnstalleerd vanuit de Mac App Store, dus er kunnen geen fooien mee worden gegeven. Bedankt voor het gebruik hoe dan ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia nie została zainstalowana z Mac App Store, więc nie może przyjmować napiwków. Dziękujemy mimo to za korzystanie z niej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia não foi instalada pela Mac App Store, então não pode receber gorjetas. Obrigado por usá-la mesmo assim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта копия установлена не из Mac App Store, поэтому не может принимать чаевые. Всё равно спасибо, что пользуетесь ею."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto kópia nebola nainštalovaná z Mac App Store, takže nemôže prijímať sponzorské dary. Aj tak ďakujem, že ju používate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här kopian installerades inte från Mac App Store, så den kan inte ta emot drickspengar. Tack för att du använder den ändå."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำเนานี้ไม่ได้ติดตั้งจาก Mac App Store จึงรับทิปไม่ได้ ขอบคุณที่ใช้งานอยู่ดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kopya Mac App Store’dan kurulmadığından bahşiş alamaz. Yine de kullandığınız için teşekkürler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю копію встановлено не з Mac App Store, тому вона не може приймати чайові. Усе одно дякуємо, що користуєтеся нею."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản này không được cài từ Mac App Store, nên không thể nhận tiền boa. Dù vậy vẫn cảm ơn bạn đã dùng nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此副本并非从 Mac App Store 安装，因此无法打赏。仍然感谢你使用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此複本不是從 Mac App Store 安裝的，因此無法接受贊助。仍然謝謝你使用它。"
          }
        }
      }
    },
