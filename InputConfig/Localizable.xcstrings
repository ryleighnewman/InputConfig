        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesto výstup zapne a nechá zapnutý. Další provedení gesta ho vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevægelsen slår outputtet til og lader det være slået til. Når den laves igen, slås det fra."
