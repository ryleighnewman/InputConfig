        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové akce aplikace zapínají a vypínají pohyb jedním stisknutím, nebo ho nechají hýbat ukazatelem jen při podržení tlačítka, z libovolného vstupu, včetně klávesy nebo nožního pedálu"
