            "state" : "translated",
            "value" : "Ölü bölgesinin kenarında duran bir çubuk artık her karede açılıp kapanmıyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джойстик у спокої на межі своєї мертвої зони більше не дрижить, вмикаючись і вимикаючись щокадру"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần nằm ở mép vùng chết không còn nhấp nháy bật tắt ở mỗi khung hình"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摇杆静止在死区边缘时，不再每帧反复开关"
          }
        },
        "zh-Hant" : {
