    "A Steam Controller connected over Bluetooth is listed with how to connect it, instead of being taken for a keyboard" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏يظهر Steam Controller المتصل عبر Bluetooth في القائمة مع طريقة توصيله، بدل أن يُعامل كلوحة مفاتيح"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller připojený přes Bluetooth se zobrazí s návodem, jak ho připojit, místo aby byl považován za klávesnici"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Steam Controller tilsluttet via Bluetooth vises med, hvordan den tilsluttes, i stedet for at blive taget for et tastatur"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein über Bluetooth verbundener Steam Controller wird mit einem Hinweis zum Verbinden aufgeführt, statt für eine Tastatur gehalten zu werden"
