    "This band overlaps row %@. While the control is inside it, only this row fires; that row waits until the control leaves the band." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتداخل هذا النطاق مع الصف %@. وما دام عنصر التحكم داخله، يعمل هذا الصف وحده؛ وينتظر ذلك الصف حتى يغادر عنصر التحكم النطاق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto pásmo zasahuje do řádku %@. Dokud je ovladač uvnitř něj, spouští se jen tento řádek; ten druhý čeká, dokud ovladač pásmo neopustí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette bånd overlapper række %@. Mens kontrollen er inden i det, udløses kun denne række; den række venter, til kontrollen forlader båndet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich überschneidet sich mit der Zeile %@. Solange sich das Bedienelement darin befindet, löst nur diese Zeile aus; jene Zeile wartet, bis das Bedienelement den Bereich verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta banda se solapa con la fila %@. Mientras el control está dentro, solo se activa esta fila; esa fila espera hasta que el control sale de la banda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä alue menee päällekkäin rivin %@ kanssa. Kun ohjain on sen sisällä, vain tämä rivi laukeaa; tuo rivi odottaa, kunnes ohjain poistuu alueelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette bande chevauche la ligne %@. Tant que la commande est dedans, seule cette ligne se déclenche ; l’autre ligne attend que la commande quitte la bande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפס הזה חופף לשורה %@. כל עוד הבקר בתוכו, רק השורה הזו פועלת; השורה ההיא ממתינה עד שהבקר יוצא מהפס."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a sáv a(z) %@. sort fedi át. Amíg a vezérlő benne van, csak ez a sor aktiválódik; az a sor vár, amíg a vezérlő el nem hagyja a sávot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pita ini tumpang tindih dengan baris %@. Selama kontrol berada di dalamnya, hanya baris ini yang aktif; baris itu menunggu sampai kontrol keluar dari pita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa fascia si sovrappone alla riga %@. Finché il controllo è al suo interno, si attiva solo questa riga; quella riga aspetta che il controllo esca dalla fascia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この帯は行 %@ と重なっています。コントロールが帯の中にある間は、この行だけが動作し、その行はコントロールが帯を出るまで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 구간은 %@ 행과 겹칩니다. 컨트롤이 구간 안에 있는 동안에는 이 행만 동작하고, 해당 행은 컨트롤이 구간을 벗어날 때까지 기다립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette båndet overlapper rad %@. Mens kontrollen er inne i det, utløses bare denne raden; den raden venter til kontrollen forlater båndet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit gebied overlapt met rij %@. Zolang de bediening erin zit, wordt alleen deze rij geactiveerd; die rij wacht tot de bediening het gebied verlaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To pasmo nakłada się na wiersz %@. Gdy element sterujący jest wewnątrz niego, uruchamia się tylko ten wiersz; tamten wiersz czeka, aż element opuści pasmo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta faixa se sobrepõe à linha %@. Enquanto o controle está dentro dela, só esta linha dispara; aquela linha espera até o controle sair da faixa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта полоса пересекается со строкой %@. Пока элемент управления в ней, срабатывает только эта строка; та строка ждёт, пока он не покинет полосу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto pásmo zasahuje do riadka %@. Kým je ovládač vnútri neho, spúšťa sa len tento riadok; ten druhý čaká, kým ovládač pásmo neopustí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här bandet överlappar rad %@. Medan kontrollen är inne i det utlöses bara den här raden; den raden väntar tills kontrollen lämnar bandet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ช่วงนี้ซ้อนกับแถว %@ ขณะที่ตัวควบคุมอยู่ในช่วง จะมีเพียงแถวนี้ที่ทำงาน แถวนั้นจะรอจนกว่าตัวควบคุมออกจากช่วง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bant %@ satırıyla çakışıyor. Kontrol bandın içindeyken yalnızca bu satır çalışır; o satır kontrol banttan çıkana kadar bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця смуга перетинається з рядком %@. Поки елемент керування в ній, спрацьовує лише цей рядок; той рядок чекає, доки він не покине смугу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dải này chồng lên hàng %@. Khi điều khiển nằm trong dải, chỉ hàng này kích hoạt; hàng kia chờ đến khi điều khiển rời khỏi dải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此区段与第 %@ 行重叠。控件处于其中时，只有这一行触发；那一行会等到控件离开区段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此區段與第 %@ 列重疊。控制項位於其中時，只有這一列觸發；那一列會等到控制項離開區段。"
          }
        }
      }
    },
