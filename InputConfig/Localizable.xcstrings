        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пресет може активуватися автоматично, коли його програма виходить на передній план, а потім відступати, коли ви її залишаєте."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cài đặt sẵn có thể tự kích hoạt khi ứng dụng của nó ra phía trước, rồi nhường chỗ khi bạn rời đi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
