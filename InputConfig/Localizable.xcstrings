    "Press ⌃⌥⌘P anywhere to toggle your most recent preset, even while a game is in front (enable it in Settings)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط ⌃⌥⌘P في أي مكان لتبديل أحدث إعداد مسبق لديك، حتى أثناء وجود لعبة في المقدمة (فعّله في الإعدادات)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskem ⌃⌥⌘P kdekoli přepnete nejnovější předvolbu, i když je v popředí hra (zapněte v Nastavení)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk ⌃⌥⌘P hvor som helst for at slå din seneste forudindstilling til eller fra, selv mens et spil er forrest (slå det til i Indstillinger)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke überall ⌃⌥⌘P, um dein zuletzt verwendetes Preset umzuschalten, auch wenn ein Spiel im Vordergrund ist (in den Einstellungen aktivieren)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⌃⌥⌘P en cualquier lugar para alternar tu preajuste más reciente, incluso con un juego en primer plano (actívalo en Ajustes)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina ⌃⌥⌘P missä tahansa kytkeäksesi viimeisimmän esiasetuksen, vaikka peli olisi etualalla (ota käyttöön Asetuksissa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⌃⌥⌘P n’importe où pour basculer votre préréglage le plus récent, même quand un jeu est au premier plan (à activer dans les réglages)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ ⌃⌥⌘P בכל מקום כדי להחליף את הפריסט האחרון שלך, גם כשמשחק בחזית (הפעל זאת בהגדרות)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomja meg a ⌃⌥⌘P billentyűket bárhol a legutóbbi előbeállítás váltásához, akkor is, ha egy játék van előtérben (a Beállításokban engedélyezhető)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan ⌃⌥⌘P di mana saja untuk menyalakan atau mematikan preset terbaru Anda, bahkan saat game berada di depan (aktifkan di Pengaturan)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi ⌃⌥⌘P ovunque per attivare o disattivare il preset più recente, anche con un gioco in primo piano (attivalo nelle Impostazioni)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どこでも⌃⌥⌘Pを押すと、直近のプリセットのオン / オフを切り替えられます（ゲームが最前面にあっても可、設定で有効にします）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어디서든 ⌃⌥⌘P를 누르면 게임이 맨 앞에 있어도 가장 최근 프리셋을 켜고 끌 수 있습니다(설정에서 활성화)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk ⌃⌥⌘P hvor som helst for å slå den nyeste forhåndsinnstillingen av og på, selv mens et spill er foran (slå det på i Innstillinger)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk overal op ⌃⌥⌘P om je meest recente preset in of uit te schakelen, zelfs terwijl een game voorop staat (schakel dit in via Instellingen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij ⌃⌥⌘P w dowolnym miejscu, aby przełączyć ostatni preset, nawet gdy na pierwszym planie jest gra (włącz to w Ustawieniach)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⌃⌥⌘P em qualquer lugar para alternar o seu preset mais recente, mesmo com um jogo na frente (ative nos Ajustes)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⌃⌥⌘P в любом месте, чтобы переключить последний пресет, даже если на переднем плане игра (включается в настройках)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlačením ⌃⌥⌘P kdekoľvek prepnete svoju najnovšiu predvoľbu, aj keď je vpredu hra (zapnite to v Nastaveniach)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ⌃⌥⌘P var som helst för att slå på din senaste förinställning, även medan ett spel är främst (aktivera det i Inställningar)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด ⌃⌥⌘P ที่ใดก็ได้เพื่อสลับพรีเซ็ตล่าสุดของคุณ แม้ขณะที่เกมอยู่ด้านหน้า (เปิดในการตั้งค่า)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En son ön ayarınızı, bir oyun öndeyken bile, açıp kapatmak için herhangi bir yerde ⌃⌥⌘P tuşlarına basın (Ayarlar’da etkinleştirin)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть ⌃⌥⌘P будь-де, щоб перемкнути ваш останній пресет, навіть коли на передньому плані гра (увімкніть це в Параметрах)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn ⌃⌥⌘P ở bất kỳ đâu để bật tắt cài đặt sẵn gần nhất của bạn, kể cả khi trò chơi ở phía trước (bật trong Cài đặt)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何位置按 ⌃⌥⌘P 可开关你最近的预设，即使游戏位于最前（需在“设置”中启用）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何地方按下 ⌃⌥⌘P 即可切換最近的預設，即使遊戲位於最前方也行（需在「設定」中啟用）。"
          }
        }
      }
    },
