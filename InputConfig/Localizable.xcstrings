    "Your tip is waiting for approval. It will go through on its own once approved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إكراميتك بانتظار الموافقة. ستتم تلقائيًا بعد الموافقة عليها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše spropitné čeká na schválení. Po schválení se provede automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine drikkepenge afventer godkendelse. De gennemføres automatisk, når de er godkendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
