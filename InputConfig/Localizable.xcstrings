    "Joystick depth scales output speed. Pick linear, smooth, or aggressive curves per binding." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر عمق عصا التحكم سرعة المخرج. اختر منحنيات خطية أو سلسة أو حادة لكل ربط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hloubka joysticku škáluje rychlost výstupu. Vyberte lineární, plynulou nebo agresivní křivku pro každé přiřazení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joystickets dybde skalerer outputhastigheden. Vælg lineære, bløde eller aggressive kurver pr. tildeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tiefe des Joysticks skaliert die Ausgabegeschwindigkeit. Wähle pro Belegung lineare, weiche oder aggressive Kurven."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profundidad del joystick escala la velocidad de salida. Elige curvas lineales, suaves o agresivas por asignación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjaussauvan syvyys skaalaa ulostulon nopeutta. Valitse lineaarinen, pehmeä tai aggressiivinen käyrä määrityskohtaisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondeur du joystick règle la vitesse de sortie. Choisissez des courbes linéaires, douces ou agressives par affectation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עומק הג׳ויסטיק מכוונן את מהירות הפלט. בחר עקומות ליניאריות, חלקות או אגרסיביות לכל קישור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A joystick kitérése skálázza a kimenet sebességét. Válasszon lineáris, sima vagy agresszív görbét hozzárendelésenként."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedalaman joystick menskalakan kecepatan output. Pilih kurva linear, halus, atau agresif per pemetaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La profondità del joystick scala la velocità di uscita. Scegli curve lineari, morbide o aggressive per ogni assegnazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョイスティックの傾きの深さで出力速度が変わります。バインディングごとに、リニア、スムーズ、アグレッシブのカーブから選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조이스틱을 누른 깊이에 따라 출력 속도가 조절됩니다. 바인딩마다 선형, 부드러움, 공격적 곡선 중에서 고르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joystickens utslag skalerer utdatahastigheten. Velg lineære, myke eller aggressive kurver per tilordning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De diepte van de joystick schaalt de uitvoersnelheid. Kies per toewijzing een lineaire, vloeiende of agressieve curve."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głębokość joysticka skaluje prędkość wyjścia. Wybierz krzywe liniowe, gładkie lub agresywne dla każdego przypisania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profundidade do joystick escala a velocidade de saída. Escolha curvas lineares, suaves ou agressivas por mapeamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубина джойстика масштабирует скорость вывода. Выберите линейную, плавную или агрессивную кривую для каждой привязки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hĺbka joysticku mení rýchlosť výstupu. Vyberte lineárne, plynulé alebo agresívne krivky pre každé priradenie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joystickdjup skalar utdatahastigheten. Välj linjära, mjuka eller aggressiva kurvor per tilldelning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความลึกของจอยสติ๊กปรับความเร็วเอาต์พุต เลือกเส้นโค้งเชิงเส้น นุ่มนวล หรือรุนแรงต่อการผูก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joystick derinliği çıkış hızını ölçekler. Atama başına doğrusal, yumuşak veya agresif eğrilerden birini seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глибина відхилення джойстика масштабує швидкість виходу. Виберіть лінійну, плавну або агресивну криву для кожної прив’язки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ sâu cần điều khiển điều chỉnh tốc độ đầu ra. Chọn đường cong tuyến tính, mượt hoặc mạnh cho từng mục gán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摇杆深度会缩放输出速度。可为每个绑定选取线性、平滑或激进曲线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搖桿推動深度會縮放輸出速度。可為每個綁定選擇線性、平滑或激進曲線。"
          }
        }
      }
    },
