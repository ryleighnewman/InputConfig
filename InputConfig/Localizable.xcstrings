    "On now. It starts when you switch to another app; stop it any time with %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفعّل الآن. يبدأ عند الانتقال إلى تطبيق آخر؛ أوقفه في أي وقت بـ %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnuto. Spustí se, až přepnete do jiné aplikace; kdykoli ho zastavíte pomocí %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slået til nu. Den starter, når du skifter til en anden app; stop den når som helst med %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt an. Es beginnt, wenn du zu einer anderen App wechselst; halte es jederzeit mit %@ an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado ahora. Empieza al cambiar a otra app; detenlo cuando quieras con %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päällä nyt. Se alkaa, kun vaihdat toiseen apiin; pysäytä se milloin tahansa näppäimillä %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé. Il démarre quand vous passez à une autre app ; arrêtez-le à tout moment avec %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מופעל עכשיו. מתחיל כשעוברים לאפליקציה אחרת; אפשר לעצור בכל עת עם %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most be van kapcsolva. Akkor indul, amikor másik appra váltasz; bármikor leállíthatod ezzel: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktif sekarang. Mulai saat kamu beralih ke app lain; hentikan kapan saja dengan %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivo ora. Parte quando passi a un’altra app; fermalo quando vuoi con %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンです。別のアプリに切り替えると始まります。%@ でいつでも止められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 켜져 있습니다. 다른 앱으로 전환하면 시작되며, %@로 언제든 멈출 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På nå. Den starter når du bytter til en annen app; stopp den når som helst med %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu aan. Het begint zodra je naar een andere app gaat; stop het altijd met %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączone. Zacznie działać po przejściu do innej aplikacji; zatrzymasz je w każdej chwili skrótem %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativado agora. Começa quando você muda para outro app; pare quando quiser com %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включено. Начнёт работать, когда вы переключитесь на другое приложение; остановить можно в любой момент сочетанием %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnuté. Spustí sa, keď prepnete do inej aplikácie; kedykoľvek ho zastavíte pomocou %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På nu. Den startar när du byter till en annan app; stoppa den när som helst med %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดอยู่ จะเริ่มเมื่อคุณสลับไปแอปอื่น หยุดได้ทุกเมื่อด้วย %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi açık. Başka bir uygulamaya geçtiğinizde başlar; istediğiniz zaman %@ ile durdurun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнено. Почне працювати, коли ви перейдете до іншої програми; зупинити можна будь-коли сполученням %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang bật. Bắt đầu khi bạn chuyển sang ứng dụng khác; dừng bất kỳ lúc nào bằng %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已打开。切换到其他应用时开始生效；随时可用 %@ 停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已開啟。切換到其他 App 時開始生效；隨時可用 %@ 停止。"
          }
        }
      }
    },
