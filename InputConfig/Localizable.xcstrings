    "Click Activate when you're ready, and your controller does what the preset says. Click it again to stop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر «تفعيل» عندما تكون مستعدًا، فيفعل ذراع التحكم ما يقوله الإعداد المسبق. انقر مرة أخرى للإيقاف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až budete připraveni, klikněte na Aktivovat a ovladač bude dělat to, co říká předvolba. Dalším kliknutím přestanete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
