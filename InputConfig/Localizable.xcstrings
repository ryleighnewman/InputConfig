    "Cumulative time any controller has been plugged in or paired since you first launched the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقت التراكمي الذي كان فيه أي ذراع تحكم موصولًا أو مقترنًا منذ أول تشغيل للتطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celkový čas, po který byl kterýkoli ovladač zapojen nebo spárován od prvního spuštění aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samlet tid, en controller har været tilsluttet eller parret, siden du første gang startede appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtzeit, in der ein Controller seit dem ersten Start der App angeschlossen oder gekoppelt war."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo acumulado que cualquier mando ha estado conectado o emparejado desde que abriste la app por primera vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokonaisaika, jonka mikä tahansa ohjain on ollut kytkettynä tai pariliitettynä apin ensimmäisestä käynnistyksestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée cumulée pendant laquelle une manette a été branchée ou appairée depuis le premier lancement de l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזמן המצטבר ששלט כלשהו היה מחובר או מצומד מאז ההפעלה הראשונה של האפליקציה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az az összesített idő, amíg bármely vezérlő csatlakoztatva vagy párosítva volt az app első indítása óta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu kumulatif pengontrol mana pun tercolok atau dipasangkan sejak Anda pertama kali membuka app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo cumulativo in cui un controller è stato collegato o abbinato dal primo avvio dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを初めて起動してから、コントローラが接続またはペアリングされていた累計時間。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 처음 실행한 이후 컨트롤러가 연결되거나 페어링되어 있던 누적 시간."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samlet tid en kontroller har vært koblet til eller paret siden du først startet appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totale tijd dat een controller is aangesloten of gekoppeld sinds je de app voor het eerst startte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łączny czas, przez który jakikolwiek kontroler był podłączony lub sparowany od pierwszego uruchomienia aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo acumulado em que qualquer controle ficou conectado ou pareado desde que você abriu o app pela primeira vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суммарное время, в течение которого любой контроллер был подключён или спарен с момента первого запуска приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumulatívny čas, počas ktorého bol akýkoľvek ovládač zapojený alebo spárovaný od prvého spustenia aplikácie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammanlagd tid som någon spelkontroll har varit ansluten eller parkopplad sedan du först startade appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาสะสมที่มีคอนโทรลเลอร์เสียบหรือจับคู่อยู่ตั้งแต่คุณเปิดแอปครั้งแรก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı ilk başlattığınızdan beri herhangi bir kumandanın takılı veya eşleşmiş olduğu toplam süre."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сукупний час, протягом якого будь-який контролер був підключений або спарений відтоді, як ви вперше запустили програму."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tổng thời gian mọi bộ điều khiển được cắm hoặc ghép nối kể từ lần đầu bạn mở ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自首次启动 App 以来，任何控制器接入或配对的累计时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自你第一次啟動 App 以來，任何控制器已插入或配對的累計時間。"
          }
        }
      }
    },
