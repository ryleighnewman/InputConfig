        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet appitoiminnot kytkevät liikkeen päälle ja pois yhdellä painalluksella tai antavat sen liikuttaa osoitinta vain painikkeen ollessa pohjassa, miltä tahansa syötteeltä, myös näppäimeltä tai jalkapolkimelta"
