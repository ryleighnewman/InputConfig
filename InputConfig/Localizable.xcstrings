        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hareket sensörünü açmayı reddetti; bu yüzden dokunmalar yalnızca başka bir uygulama onu çalışır tuttuğunda duyuluyor."
          }
        },
        "uk" : {
