    "The help guides have a search field, plus new guides for chords, ratcheting, and tapping the Mac" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأدلة المساعدة حقل بحث، إضافة إلى أدلة جديدة للتركيبات وإعادة التموضع والنقر على Mac"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průvodci nápovědy mají vyhledávací pole a nové průvodce pro kombinace, rohatkování a klepání na Mac"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælpeguiderne har et søgefelt samt nye guider til tastekombinationer, ratcheting og tap på Mac"
