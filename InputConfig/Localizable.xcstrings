    "Move the stick and watch the bars; or hold it in one direction and tap the matching button." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّك العصا وراقب الأشرطة؛ أو أبقها في اتجاه واحد وانقر الزر المطابق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohněte páčkou a sledujte pruhy; nebo ji podržte v jednom směru a klepněte na odpovídající tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt sticken, og se på bjælkerne. Eller hold den i én retning, og tryk på den tilsvarende knap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewege den Stick und beobachte die Leisten; oder halte ihn in eine Richtung und tippe die passende Taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve el stick y observa las barras; o mantenlo en una dirección y pulsa el botón correspondiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikuta sauvaa ja seuraa palkkeja; tai pidä sitä yhteen suuntaan ja napauta vastaavaa painiketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez le stick et observez les barres ; ou maintenez-le dans une direction et touchez le bouton correspondant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזז את הג׳ויסטיק וצפה בסרגלים; או החזק אותו בכיוון אחד והקש על הלחצן התואם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozgassa a joystickot, és figyelje a sávokat; vagy tartsa egy irányban, és koppintson a megfelelő gombra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerakkan stik dan perhatikan bar; atau tahan ke satu arah dan ketuk tombol yang sesuai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muovi lo stick e osserva le barre; oppure tienilo in una direzione e tocca il pulsante corrispondente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スティックを動かしてバーを見るか、1方向に倒したまま対応するボタンをタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스틱을 움직이면서 막대를 보세요. 또는 한 방향으로 누른 채 해당 버튼을 탭하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt joysticken og se på linjene, eller hold den i én retning og trykk på den tilsvarende knappen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beweeg de stick en kijk naar de balken; of houd hem in één richting en tik op de bijbehorende knop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruszaj drążkiem i obserwuj paski albo przytrzymaj go w jednym kierunku i dotknij pasującego przycisku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova o stick e observe as barras; ou segure-o em uma direção e toque no botão correspondente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двигайте стик и следите за полосами; или удерживайте его в одном направлении и нажмите соответствующую кнопку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pohnite páčkou a sledujte pruhy; alebo ju podržte v jednom smere a ťuknite na zodpovedajúce tlačidlo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta spaken och titta på fälten, eller håll den i en riktning och tryck på motsvarande knapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขยับจอยสติ๊กแล้วดูแถบ หรือกดค้างไว้ทางเดียวแล้วแตะปุ่มที่ตรงกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubuğu hareket ettirin ve çubuklara bakın; ya da onu bir yönde tutup eşleşen düğmeye dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рухайте джойстик і стежте за смугами; або утримуйте його в одному напрямку й торкніться відповідної кнопки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di chuyển cần và xem các thanh; hoặc giữ nó về một hướng và chạm nút tương ứng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动摇杆并观察条；或朝一个方向按住，再点按对应的按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動搖桿並觀察長條；或朝某個方向按住，再輕點對應的按鈕。"
          }
        }
      }
    },
