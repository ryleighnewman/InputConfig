          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе працює й залишається на вашому Mac. Жодної телеметрії, жодного облікового запису, нічого не завантажується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ chạy và ở lại trên Mac của bạn. Không đo từ xa, không tài khoản, không tải lên gì cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都在你的 Mac 上运行并留在其中。没有遥测，没有账户，没有任何内容被上传。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
