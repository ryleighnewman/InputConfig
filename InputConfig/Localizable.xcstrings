          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha, da esquerda para a direita"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Строка слева направо"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riadok zľava doprava"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rad, från vänster till höger"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนึ่งแถว จากซ้ายไปขวา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soldan sağa bir satır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядок зліва направо"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hàng, từ trái sang phải"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一行，从左到右"
          }
        },
        "zh-Hant" : {
