    "Mouse-button outputs the engine has fired: left, right, middle, and other buttons. A press and its release count once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرجات أزرار الماوس التي أطلقها المحرك: الأيسر والأيمن والأوسط وغيرها. تُحتسب الضغطة وتحريرها مرة واحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výstupy tlačítek myši, které jádro spustilo: levé, pravé, prostřední a další tlačítka. Stisk a jeho uvolnění se počítají jednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museknapoutput, som motoren har udløst: venstre, højre, midterste og andre knapper. Et tryk og dets slip tælles én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maustasten-Ausgaben, die die Engine ausgelöst hat: linke, rechte, mittlere und andere Tasten. Ein Drücken und sein Loslassen zählen einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salidas de botón del ratón que el motor ha activado: izquierdo, derecho, central y otros botones. Una pulsación y su soltado cuentan una vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moottorin laukaisemat hiiren painikkeiden ulostulot: vasen, oikea, keskipainike ja muut painikkeet. Painallus ja sen vapautus lasketaan kerran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorties de boutons de souris déclenchées par le moteur : gauche, droit, central et autres boutons. Un appui et son relâchement comptent une fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פלטי לחצני עכבר שהמנוע הפעיל: שמאלי, ימני, אמצעי ולחצנים אחרים. לחיצה ושחרורה נספרות פעם אחת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A motor által kiváltott egérgomb-kimenetek: bal, jobb, középső és más gombok. Egy lenyomás és a felengedése egynek számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Output tombol tetikus yang telah dipicu mesin: kiri, kanan, tengah, dan tombol lainnya. Penekanan dan pelepasannya dihitung sekali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uscite dei pulsanti del mouse attivate dal motore: sinistro, destro, centrale e altri pulsanti. Una pressione e il suo rilascio contano una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジンが実行したマウスボタンの出力: 左、右、中、その他のボタン。押下とその解除は1回として数えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진이 실행한 마우스 버튼 출력: 왼쪽, 오른쪽, 가운데 및 기타 버튼. 누름과 놓음은 한 번으로 집계됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Museknappsutdata motoren har utløst: venstre, høyre, midtre og andre knapper. Et trykk og slippet av det telles én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitvoeren van muisknoppen die de engine heeft geactiveerd: links, rechts, midden en andere knoppen. Een druk en het loslaten tellen als één."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyjścia przycisków myszy uruchomione przez silnik: lewy, prawy, środkowy i inne. Naciśnięcie i jego puszczenie liczą się jako jedno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saídas de botão do mouse que o motor disparou: esquerdo, direito, do meio e outros botões. Um pressionamento e sua liberação contam uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выводы кнопок мыши, выполненные движком: левая, правая, средняя и другие кнопки. Нажатие и его отпускание считаются один раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výstupy tlačidiel myši, ktoré nástroj spustil: ľavé, pravé, stredné a ďalšie tlačidlá. Stlačenie a jeho uvoľnenie sa počítajú raz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musknappsutdata som motorn har utlöst: vänster, höger, mitten och andra knappar. Ett tryck och dess släpp räknas en gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอาต์พุตปุ่มเมาส์ที่เอนจินสั่งแล้ว: ซ้าย ขวา กลาง และปุ่มอื่นๆ การกดและการปล่อยนับเป็นหนึ่งครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motorun tetiklediği fare düğmesi çıkışları: sol, sağ, orta ve diğer düğmeler. Bir basış ve bırakılışı bir kez sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виходи кнопок миші, які запустив рушій: ліва, права, середня й інші кнопки. Натискання та його відпускання рахуються один раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu ra nút chuột mà công cụ đã kích hoạt: nút trái, phải, giữa và các nút khác. Một lần nhấn và lần nhả của nó tính một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎触发的鼠标按钮输出：左键、右键、中键和其他按钮。一次按下及其释放算一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎已觸發的滑鼠按鈕輸出：左鍵、右鍵、中鍵和其他按鈕。一次按下及其放開只算一次。"
          }
        }
      }
    },
