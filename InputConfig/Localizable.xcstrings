    "Only while this preset runs, and paused whenever InputConfig or the Finder is in front." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط أثناء تشغيل هذا الإعداد، ويتوقف مؤقتًا كلما كان InputConfig أو Finder في المقدمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jen když tato předvolba běží, a pozastaveno, kdykoli je v popředí InputConfig nebo Finder."
