          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Javítva, hogy ugyanazon a gombon egy sima és egy kombinációs sor is világított a szerkesztőben: a sor csak akkor világít, ha aktiválódna, a nyomva tartott vezérlőivel együtt"
