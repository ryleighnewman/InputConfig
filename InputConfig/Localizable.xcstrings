          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketjuta näppäinpainalluksia mukautetulla ajoituksella tai laukaise mitä tahansa painiketta nopeasti säädettävällä taajuudella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enchaînez des frappes avec un minutage personnalisé, ou répétez rapidement n’importe quel bouton à une cadence configurable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שרשר הקשות מקשים עם תזמון מותאם, או הפעל כל לחצן בקצב גבוה שאפשר להגדיר."
          }
        },
        "hu" : {
          "stringUnit" : {
