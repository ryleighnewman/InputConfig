    "Brightens hints and status lines. On by itself when Increase Contrast is on in System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضيء التلميحات وأسطر الحالة. يعمل من تلقاء نفسه عند تشغيل «زيادة التباين» في إعدادات النظام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýrazní nápovědy a stavové řádky. Zapne se samo, když je v Nastavení systému zapnuto Zvýšit kontrast."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør hints og statuslinjer lysere. Slås til af sig selv, når Øg kontrast er slået til i Systemindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hellt Hinweise und Statuszeilen auf. Schaltet sich von selbst ein, wenn „Kontrast erhöhen“ in den Systemeinstellungen eingeschaltet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumenta el brillo de las sugerencias y las líneas de estado. Se activa solo cuando Aumentar contraste está activado en Ajustes del Sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirkastaa vihjeet ja tilarivit. Päällä itsestään, kun Lisää kontrastia on päällä Järjestelmäasetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éclaircit les astuces et les lignes d’état. S’active de lui-même lorsque Augmenter le contraste est activé dans Réglages Système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מבהיר רמזים ושורות מצב. מופעל מעצמו כשהאפשרות ״הגברת ניגודיות״ פועלת ב״הגדרות המערכת״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Világosabbá teszi a tippeket és az állapotsorokat. Magától bekapcsol, ha a Rendszerbeállításokban be van kapcsolva a Kontraszt növelése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencerahkan petunjuk dan baris status. Menyala sendiri saat Tambah Kontras aktif di Pengaturan Sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende più luminosi suggerimenti e righe di stato. Si attiva da solo quando Aumenta contrasto è attivo in Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒントとステータス行を明るくします。「システム設定」で「コントラストを上げる」がオンのときは、自動でオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "힌트와 상태 줄을 더 밝게 합니다. 시스템 설정에서 대비 증가가 켜져 있으면 자동으로 켜집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør hint og statuslinjer lysere. Slås på av seg selv når Øk kontrast er på i Systeminnstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt hints en statusregels helderder. Staat vanzelf aan wanneer Verhoog contrast aan staat in Systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozjaśnia podpowiedzi i wiersze stanu. Włącza się samoczynnie, gdy w Ustawieniach systemowych włączono Zwiększ kontrast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realça dicas e linhas de status. Ativado por si só quando Aumentar contraste está ativado nos Ajustes do Sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делает подсказки и строки состояния ярче. Включается само, когда в «Системных настройках» включено «Увеличить контрастность»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zjasní nápovedy a stavové riadky. Samo sa zapne, keď je v aplikácii Systémové nastavenia zapnuté Zvýšiť kontrast."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör tips och statusrader ljusare. Slås på av sig själv när Öka kontrast är på i Systeminställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้คำแนะนำและบรรทัดสถานะสว่างขึ้น เปิดเองเมื่อเปิดเพิ่มความคมชัดในการตั้งค่าระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpuçlarını ve durum satırlarını parlatır. Sistem Ayarları’nda Karşıtlığı Artır açıkken kendiliğinden açılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підсвічує підказки та рядки стану. Вмикається сама, коли в розділі «Системні параметри» увімкнено «Збільшити контрастність»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm sáng gợi ý và dòng trạng thái. Tự bật khi Tăng độ tương phản đang bật trong Cài đặt hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提亮提示和状态行。在“系统设置”中开启“提高对比度”时自动开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓提示和狀態列更明亮。在「系統設定」中開啟「提高對比」時會自動開啟。"
          }
        }
      }
    },
