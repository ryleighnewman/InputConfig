          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khôi phục bản sao lưu trên Mac mới không còn nhân đôi các cài đặt sẵn tích hợp, và cho biết nó đã khôi phục gì"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
