          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa Aktivoi käynnistääksesi esiasetuksen, niin se avaa Minecraftin puolestasi. Lopeta klikkaamalla uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Activer pour lancer le préréglage, qui ouvre Minecraft pour vous. Cliquez à nouveau pour arrêter."
          }
