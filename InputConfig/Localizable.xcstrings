    "A gesture is not held, so it has no held action." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيماءة لا تُمسَك، لذا ليس لها إجراء إمساك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesto se nedrží, takže nemá akci podržení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bevægelse holdes ikke, så den har ingen holdt handling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Geste wird nicht gehalten, daher hat sie keine Aktion für Halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gesto no se mantiene, así que no tiene acción al mantener pulsado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elettä ei pidetä pohjassa, joten sillä ei ole pitotoimintoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un geste n’est pas maintenu, il n’a donc pas d’action maintenue."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחווה אינה מוחזקת, ולכן אין לה פעולת החזקה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mozdulatot nem lehet nyomva tartani, ezért nincs tartott művelete."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestur tidak ditahan, jadi tidak punya aksi tahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gesto non si tiene premuto, quindi non ha un’azione da tenuto premuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジェスチャは押し続けるものではないため、押している間の動作はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제스처는 누르고 있는 동작이 아니므로 누르는 동안의 동작이 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bevegelse holdes ikke, så den har ingen holdt handling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gebaar wordt niet ingehouden, dus het heeft geen actie voor ingedrukt houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gest nie jest przytrzymywany, więc nie ma działania przytrzymania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um gesto não é segurado, então não tem ação ao segurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жест не удерживается, поэтому у него нет действия при удержании."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesto sa nedrží, takže nemá akciu podržania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gest hålls inte, så den har ingen hållen åtgärd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ท่าทางไม่ใช่การกดค้าง จึงไม่มีการทำงานขณะกดค้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir jest basılı tutulmaz, bu yüzden tutulan bir eylemi yoktur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жест не утримується, тому в нього немає дії при утриманні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cử chỉ không được giữ, nên không có hành động khi giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手势不能按住，因此没有按住时的动作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手勢無法按住，因此沒有按住時的動作。"
          }
        }
      }
    },
    "A gesture is not held, so this does nothing here. Pick another way for it to fire." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيماءة لا تُمسَك، لذا لا يفعل هذا شيئًا هنا. اختر طريقة أخرى لتشغيله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesto se nedrží, takže to tady nic nedělá. Vyberte jiný způsob jeho spuštění."
          }
        },
