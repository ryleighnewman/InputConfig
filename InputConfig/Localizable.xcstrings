    "Check Older Presets Again in Settings offers the update for presets made before 1.6 once more" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح «فحص الإعدادات المسبقة الأقدم مجددًا» في الإعدادات التحديث مرة أخرى للإعدادات المسبقة المنشأة قبل 1.6"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu zkontrolovat starší předvolby v Nastavení znovu nabídne aktualizaci předvoleb vytvořených před verzí 1.6"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek ældre forudindstillinger igen i Indstillinger tilbyder opdateringen til forudindstillinger lavet før 1.6 en gang til"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ältere Presets erneut prüfen“ in den Einstellungen bietet das Update für vor 1.6 erstellte Presets noch einmal an"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a buscar preajustes antiguos en Ajustes ofrece de nuevo la actualización para los preajustes creados antes de la 1.6"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista vanhemmat esiasetukset uudelleen -toiminto Asetuksissa tarjoaa päivityksen ennen versiota 1.6 tehdyille esiasetuksille vielä kerran"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revérifier les anciens préréglages, dans les réglages, propose à nouveau la mise à jour des préréglages créés avant la version 1.6"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״בדוק שוב פריסטים ישנים״ בהגדרות מציע שוב את העדכון לפריסטים שנוצרו לפני 1.6"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Beállításokban a Régebbi előbeállítások újbóli ellenőrzése ismét felajánlja a frissítést az 1.6 előtt készült előbeállításokhoz"
