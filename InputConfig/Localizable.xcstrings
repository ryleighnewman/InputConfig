    "Two-port adapters that send each port on its own read the second port's stick too" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏المحوّلات ذات المنفذين التي ترسل كل منفذ وحده تقرأ عصا المنفذ الثاني أيضًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvouportové adaptéry, které posílají každý port zvlášť, čtou i páčku druhého portu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptere med to porte, der sender hver port for sig, læser også den anden ports stik"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapter mit zwei Anschlüssen, die jeden Anschluss einzeln senden, lesen auch den Stick des zweiten Anschlusses"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los adaptadores de dos puertos que envían cada puerto por separado también leen el stick del segundo puerto"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahden portin sovittimet, jotka lähettävät kunkin portin erikseen, lukevat myös toisen portin tikun"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adaptateurs à deux ports qui envoient chaque port séparément lisent aussi le stick du second port"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏מתאמים עם שתי יציאות ששולחים כל יציאה בנפרד קוראים גם את הסטיק של היציאה השנייה"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A két portos adapterek, amelyek minden portot külön küldenek, a második port karját is olvassák"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptor dua port yang mengirim tiap port sendiri-sendiri kini juga membaca stik port kedua"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli adattatori a due porte che inviano ogni porta separatamente leggono anche lo stick della seconda porta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポートごとに別々に送信する 2 ポートのアダプタでは、2 つ目のポートのスティックも読み取られます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포트마다 따로 보내는 2포트 어댑터에서 두 번째 포트의 스틱도 읽습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptere med to porter som sender hver port for seg, leser også den andre portens stikke"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapters met twee poorten die elke poort apart versturen, lezen ook de stick van de tweede poort"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptery z dwoma portami, które wysyłają każdy port osobno, odczytują też drążek drugiego portu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptadores de duas portas que enviam cada porta separadamente também leem o analógico da segunda porta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двухпортовые адаптеры, которые передают каждый порт отдельно, теперь читают и стик второго порта"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojportové adaptéry, ktoré posielajú každý port zvlášť, čítajú aj páčku druhého portu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaptrar med två portar som skickar varje port för sig läser även den andra portens spak"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อะแดปเตอร์สองพอร์ตที่ส่งข้อมูลแต่ละพอร์ตแยกกันจะอ่านจอยสติ๊กของพอร์ตที่สองด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her bağlantı noktasını ayrı gönderen iki bağlantı noktalı adaptörler, ikinci bağlantı noktasının çubuğunu da okur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двопортові адаптери, що передають кожен порт окремо, тепер читають і стік другого порту"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ chuyển đổi hai cổng gửi từng cổng riêng giờ cũng đọc cần analog của cổng thứ hai"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
