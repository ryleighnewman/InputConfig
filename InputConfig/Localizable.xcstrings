    "A stick resting at the edge of its deadzone no longer chatters on and off every frame" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العصا الساكنة عند حافة منطقتها الميتة لم تعد تتذبذب بين التشغيل والإيقاف في كل إطار"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páčka v klidu na hraně mrtvé zóny už nepřeskakuje každým snímkem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En stick, der hviler ved kanten af sin dødzone, flimrer ikke længere til og fra hver frame"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stick, der am Rand seiner Totzone ruht, flackert nicht mehr in jedem Frame an und aus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un stick en reposo en el borde de su zona muerta ya no parpadea entre activado y desactivado en cada fotograma"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuolleen alueen reunalla lepäävä sauva ei enää välky päälle ja pois joka ruudulla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un stick au repos au bord de sa zone morte ne scintille plus à chaque image"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ג׳ויסטיק שנח בקצה האזור המת שלו כבר לא מהבהב בין מופעל לכבוי בכל פריים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A holttér szélén nyugvó joystick már nem villog be-ki minden képkockánál"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stik yang diam di tepi zona matinya tidak lagi berkedip menyala dan mati di setiap frame"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stick a riposo sul bordo della sua zona morta non scatta più a intermittenza a ogni fotogramma"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デッドゾーンの端で静止したスティックが、フレームごとにオンとオフを繰り返さなくなりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데드존 가장자리에 놓인 스틱이 더 이상 매 프레임 켜졌다 꺼졌다 하지 않음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En joystick som hviler ved kanten av dødsonen, slår ikke lenger av og på for hver ramme"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stick die op de rand van zijn dode zone rust, flikkert niet meer aan en uit bij elk beeld"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drążek spoczywający na krawędzi martwej strefy nie włącza się i wyłącza już w każdej klatce"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um stick parado na borda da zona morta não oscila mais entre ligado e desligado a cada quadro"
