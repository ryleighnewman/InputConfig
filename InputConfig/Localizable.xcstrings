          }
        }
      }
    },
    "Turn on the controller hold in Settings so there is still a way to stop a preset." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل ضغط ذراع التحكم في الإعدادات ليبقى هناك سبيل لإيقاف إعداد مسبق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte podržení na ovladači v Nastavení, aby vždy existoval způsob, jak předvolbu zastavit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå controllerens hold til i Indstillinger, så der stadig er en måde at stoppe en forudindstilling på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte das Halten am Controller in den Einstellungen ein, damit es weiterhin einen Weg gibt, ein Preset zu stoppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la pulsación larga del mando en Ajustes para que siga habiendo una forma de detener un preajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota ohjaimen pito käyttöön Asetuksissa, jotta esiasetuksen pysäyttämiseen on aina keino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le maintien de la manette dans les réglages pour qu’il reste un moyen d’arrêter un préréglage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל את החזקת השלט בהגדרות כדי שעדיין תהיה דרך לעצור פריסט."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be a vezérlőn tartást a Beállításokban, hogy még mindig legyen mód egy előbeállítás leállítására."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan tahan pengontrol di Pengaturan agar tetap ada cara untuk menghentikan preset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la pressione prolungata del controller nelle Impostazioni così c’è ancora un modo per fermare un preset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でコントローラの長押しをオンにすると、プリセットを停止する方法が常に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋을 중지할 방법이 계속 있도록 설정에서 컨트롤러 길게 누르기를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på kontrollerholdet i Innstillinger så det fortsatt finnes en måte å stoppe en forhåndsinnstilling på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het ingedrukt houden op de controller aan in Instellingen, zodat er nog steeds een manier is om een preset te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz przytrzymanie na kontrolerze w Ustawieniach, aby nadal był sposób na zatrzymanie presetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o segurar do controle nos Ajustes para que ainda haja um jeito de parar um preset."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите удержание на контроллере в настройках, чтобы по-прежнему был способ остановить пресет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite podržanie ovládačom v Nastaveniach, aby stále existoval spôsob, ako predvoľbu zastaviť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på hållet på spelkontrollen i Inställningar så att det fortfarande finns ett sätt att stoppa en förinställning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดการกดค้างบนคอนโทรลเลอร์ในการตั้งค่า เพื่อให้ยังมีวิธีหยุดพรีเซ็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ön ayarı durdurmanın bir yolu kalması için Ayarlar’da kumanda basılı tutmayı açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть утримання контролера в Параметрах, щоб завжди був спосіб зупинити пресет."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật thao tác giữ trên bộ điều khiển trong Cài đặt để vẫn có cách dừng một cài đặt sẵn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中开启控制器按住，这样仍有办法停止预设。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中開啟控制器長按，這樣仍有辦法停止預設。"
          }
        }
      }
    },
