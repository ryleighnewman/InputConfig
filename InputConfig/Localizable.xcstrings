    "Chords can hold up to three controls, chosen from the menu or scanned" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تضم التركيبات حتى ثلاثة عناصر تحكم، تُختار من القائمة أو تُفحص"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombinace mohou obsahovat až tři ovládací prvky, vybrané z nabídky nebo naskenované"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastekombinationer kan indeholde op til tre kontroller, valgt fra menuen eller scannet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastenkombinationen können bis zu drei Bedienelemente enthalten, aus dem Menü gewählt oder gescannt"
