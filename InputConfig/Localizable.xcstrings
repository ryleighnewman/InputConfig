    "Not brought in: %@. Set them again in the preset if you want them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُستورد: %@. اضبطها مجددًا في الإعداد المسبق إن أردتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepřevzato: %@. Chcete-li je, nastavte je v předvolbě znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke medtaget: %@. Indstil dem igen i forudindstillingen, hvis du vil have dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht übernommen: %@. Lege sie im Preset erneut fest, wenn du sie willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han traído: %@. Defínelos de nuevo en el preajuste si los quieres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei tuotu: %@. Aseta ne uudelleen esiasetuksessa, jos haluat ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non importés : %@. Définissez-les à nouveau dans le préréglage si vous les voulez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא יובאו: %@. הגדר אותם שוב בפריסט אם תרצה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem lett átvéve: %@. Állítsa be őket újra az előbeállításban, ha szeretné."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dibawa masuk: %@. Atur lagi di preset jika Anda menginginkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non importati: %@. Impostali di nuovo nel preset se li vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込まれませんでした: %@。必要な場合は、プリセットで設定し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져오지 않음: %@. 필요하면 프리셋에서 다시 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke hentet inn: %@. Angi dem på nytt i forhåndsinnstillingen hvis du vil ha dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet overgenomen: %@. Stel ze opnieuw in de preset in als je ze wilt hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie przeniesiono: %@. Ustaw je ponownie w presecie, jeśli chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não trazido: %@. Defina-os de novo no preset se quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не перенесено: %@. Задайте их в пресете заново, если они нужны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neprenesené: %@. Ak ich chcete, nastavte ich v predvoľbe znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inte hämtade: %@. Ställ in dem igen i förinställningen om du vill ha dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้นำเข้า: %@ ตั้งค่าใหม่ในพรีเซ็ตหากต้องการ"
          }
        },
        "tr" : {
