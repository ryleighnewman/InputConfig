          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ravaszérzet: kattints az L2-re vagy R2-re egy DualSense vagy DualSense Edge Élő vizualizálójában könnyű, közepes vagy kemény ellenállásért"
          }
        },
        "id" : {
          "stringUnit" : {
