    "Import presets with the tray icon in the bottom bar; export any preset from its right-click menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد الإعدادات المسبقة بأيقونة الصينية في الشريط السفلي؛ وصدّر أي إعداد مسبق من قائمته عند النقر بزر الماوس الأيمن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importujte předvolby ikonou zásobníku ve spodním panelu; exportujte libovolnou předvolbu z její nabídky na pravé tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importér forudindstillinger med bakkesymbolet i bundlinjen. Eksportér en forudindstilling fra dens højreklikmenu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere Presets über das Ablagesymbol in der unteren Leiste; exportiere jedes Preset über sein Kontextmenü."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa preajustes con el icono de bandeja de la barra inferior; exporta cualquier preajuste desde su menú contextual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuo esiasetuksia alapalkin lokerokuvakkeella; vie mikä tahansa esiasetus sen kakkospainikevalikosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez des préréglages avec l’icône de plateau dans la barre du bas ; exportez n’importe quel préréglage depuis son menu du clic droit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייבא פריסטים בעזרת סמל המגש בשורה התחתונה; ייצא כל פריסט מתפריט הלחיצה הימנית שלו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importáljon előbeállításokat az alsó sávban lévő tálcaikonnal; exportáljon bármely előbeállítást a jobb kattintású menüjéből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impor preset dengan ikon baki di bar bawah; ekspor preset mana pun dari menu klik kanannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa i preset con l’icona del vassoio nella barra in basso; esporta qualsiasi preset dal suo menu contestuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下部バーのトレイアイコンでプリセットを読み込めます。書き出しは、プリセットの右クリックメニューから行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하단 막대의 트레이 아이콘으로 프리셋을 가져오고, 프리셋의 오른쪽 클릭 메뉴에서 내보내세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importer forhåndsinnstillinger med skuffikonet i bunnlinjen. Eksporter hvilken som helst forhåndsinnstilling fra høyreklikkmenyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeer presets met het lade-icoon in de onderste balk; exporteer elke preset via het contextmenu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importuj presety ikoną tacki na dolnym pasku. Eksportuj dowolny preset z jego menu kontekstowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe presets com o ícone da bandeja na barra inferior; exporte qualquer preset pelo menu de clique com o botão direito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте пресеты значком лотка в нижней панели; экспортируйте любой пресет из его контекстного меню."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importujte predvoľby ikonou zásobníka v dolnom paneli; exportujte ľubovoľnú predvoľbu z jej kontextovej ponuky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importera förinställningar med fackikonen i den nedre raden. Exportera vilken förinställning som helst från dess högerklicksmeny."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำเข้าพรีเซ็ตด้วยไอคอนถาดที่แถบด้านล่าง ส่งออกพรีเซ็ตใดก็ได้จากเมนูคลิกขวา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ön ayarları alt çubuktaki tepsi simgesiyle içe aktarın; herhangi bir ön ayarı sağ tıklama menüsünden dışa aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Імпортуйте пресети за допомогою піктограми лотка в нижній панелі; експортуйте будь-який пресет з його контекстного меню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập cài đặt sẵn bằng biểu tượng khay ở thanh dưới; xuất bất kỳ cài đặt sẵn nào từ menu nhấp chuột phải của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用底部栏中的托盘图标导入预设；从预设的右键菜单中导出任何预设。"
