        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupina už nehlásí chybějící ovladač, když žádný nepotřebuje"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gruppe advarer ikke længere om en manglende controller, når intet i den har brug for en"
