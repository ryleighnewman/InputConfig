    "You can still stop everything by %@, or by %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال بإمكانك إيقاف كل شيء عبر %1$@، أو عبر %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše můžete stále zastavit %1$@ nebo %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan stadig stoppe alt ved %1$@ eller ved %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst weiterhin alles stoppen: %1$@ oder %2$@."
