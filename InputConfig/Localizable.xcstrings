        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безкоштовний інструмент доступності, що зіставляє будь-який пристрій введення з будь-чим на вашому Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công cụ trợ năng miễn phí, ánh xạ mọi thiết bị đầu vào tới bất cứ thứ gì trên Mac của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款免费的无障碍工具，可将任何输入设备映射到 Mac 上的任何操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款免費的輔助使用工具，可將任何輸入裝置對應到你 Mac 上的任何功能。"
          }
        }
      }
    },
