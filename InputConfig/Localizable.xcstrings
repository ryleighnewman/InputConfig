          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja regiones de pantalla que actúan como entradas: el cursor al entrar en una puede pulsar teclas, ejecutar macros o activar cualquier otra cosa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirrä näyttöalueita, jotka toimivat syötteinä: osoittimen siirtyminen yhteen voi painaa näppäimiä, suorittaa makroja tai laukaista mitä tahansa muuta."
          }
