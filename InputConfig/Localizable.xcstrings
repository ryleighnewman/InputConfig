    "The low end of the travel is at the bottom. Contains the bands and a line at the axis's live reading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطرف الأدنى من المشوار في الأسفل. يحتوي على النطاقات وخطًا عند القراءة المباشرة للمحور."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolní konec zdvihu je dole. Obsahuje pásma a čáru na aktuální hodnotě osy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udslagets lave ende er nederst. Indeholder båndene og en linje ved aksens aktuelle værdi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das untere Ende des Wegs liegt unten. Enthält die Bereiche und eine Linie beim aktuellen Wert der Achse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El extremo bajo del recorrido está abajo. Contiene las bandas y una línea en la lectura en vivo del eje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liikeradan alapää on alhaalla. Sisältää alueet ja viivan akselin reaaliaikaisen lukeman kohdalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’extrémité basse de la course est en bas. Contient les bandes et une ligne à la valeur en direct de l’axe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקצה התחתון של המהלך נמצא למטה. מכיל את הפסים וקו בקריאה החיה של הציר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az út alsó vége alul van. Tartalmazza a sávokat és egy vonalat a tengely élő értékénél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ujung bawah jarak gerak ada di bagian bawah. Berisi pita dan satu garis pada pembacaan langsung sumbu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
