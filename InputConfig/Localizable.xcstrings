        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייבאת את הפריסט הזה ועוד לא הפעלת אותו. "
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
