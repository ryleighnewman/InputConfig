    "To send the keyboard and mouse actions in this preset, turn on InputConfig under System Settings → Privacy & Security → Accessibility. Your mappings will start working as soon as you do." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإرسال إجراءات لوحة المفاتيح والماوس في هذا الإعداد المسبق، شغّل InputConfig في إعدادات النظام، الخصوصية والأمن، تسهيلات الاستخدام. ستبدأ تعييناتك بالعمل بمجرد ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby bylo možné odesílat akce klávesnice a myši z této předvolby, zapněte InputConfig v Nastavení systému → Soukromí a zabezpečení → Zpřístupnění. Vaše mapování začne fungovat, jakmile to uděláte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at sende de tastatur- og museshandlinger i denne forudindstilling skal du slå InputConfig til under Systemindstillinger → Anonymitet & sikkerhed → Tilgængelighed. Dine tildelinger begynder at virke, så snart du gør det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Tastatur- und Mausaktionen in diesem Preset zu senden, schalte InputConfig in den Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen ein. Deine Zuordnungen funktionieren, sobald du das tust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para enviar las acciones de teclado y ratón de este preajuste, activa InputConfig en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad. Tus asignaciones empezarán a funcionar en cuanto lo hagas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähettääksesi tämän esiasetuksen näppäimistö- ja hiiritoiminnot, ota InputConfig käyttöön kohdassa Järjestelmäasetukset → Tietosuoja ja suojaus → Käyttöapu. Määrityksesi alkavat toimia heti sen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour envoyer les actions de clavier et de souris de ce préréglage, activez InputConfig dans Réglages Système → Confidentialité et sécurité → Accessibilité. Vos mappages commenceront à fonctionner dès que vous l’aurez fait."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לשלוח את פעולות המקלדת והעכבר בפריסט הזה, הפעל את InputConfig ב״הגדרות המערכת״ ← ״פרטיות ואבטחה״ ← ״נגישות״. המיפויים שלך יתחילו לעבוד ברגע שתעשה זאת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A preset billentyűzet- és egérműveleteinek elküldéséhez kapcsolja be az InputConfiget itt: Rendszerbeállítások → Adatvédelem és biztonság → Kisegítő lehetőségek. A leképezések abban a pillanatban működni kezdenek, amikor ezt megteszi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengirim tindakan papan ketik dan tetikus di preset ini, nyalakan InputConfig di Pengaturan Sistem → Privasi & Keamanan → Aksesibilitas. Pemetaan Anda akan mulai berfungsi begitu Anda melakukannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per inviare le azioni di tastiera e mouse di questo preset, attiva InputConfig in Impostazioni di Sistema → Privacy e sicurezza → Accessibilità. Le tue mappature inizieranno a funzionare non appena lo fai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプリセットのキーボードとマウスの操作を送信するには、「システム設定」>「プライバシーとセキュリティ」>「アクセシビリティ」でInputConfigをオンにしてください。オンにしたらすぐ、マッピングが動作し始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프리셋의 키보드와 마우스 동작을 보내려면 시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 InputConfig를 켜세요. 켜는 즉시 매핑이 작동하기 시작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å sende tastatur- og musehandlingene i denne forhåndsinnstillingen slår du på InputConfig under Systeminnstillinger → Personvern og sikkerhet → Tilgjengelighet. Tilordningene dine begynner å fungere så snart du gjør det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de toetsenbord- en muisacties in deze preset te sturen, schakel je InputConfig in via Systeeminstellingen → Privacy en beveiliging → Toegankelijkheid. Je toewijzingen gaan werken zodra je dat doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wysyłać działania klawiatury i myszy z tego presetu, włącz InputConfig w: Ustawienia systemowe → Prywatność i ochrona → Dostępność. Twoje mapowania zaczną działać, gdy tylko to zrobisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para enviar as ações de teclado e mouse deste preset, ative o InputConfig em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade. Seus mapeamentos começarão a funcionar assim que você o fizer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы отправлять действия клавиатуры и мыши из этого пресета, включите InputConfig в разделе «Системные настройки» > «Конфиденциальность и безопасность» > «Универсальный доступ». Ваши назначения заработают, как только вы это сделаете."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete odosielať akcie klávesnice a myši v tejto predvoľbe, zapnite InputConfig v aplikácii Systémové nastavenia (Súkromie a bezpečnosť → Prístupnosť). Vaše mapovania začnú fungovať hneď, ako to urobíte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att skicka tangentbords- och musåtgärderna i den här förinställningen slår du på InputConfig under Systeminställningar → Integritet och säkerhet → Hjälpmedel. Dina mappningar börjar fungera så fort du gör det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการส่งการทำงานของแป้นพิมพ์และเมาส์ในพรีเซ็ตนี้ ให้เปิด InputConfig ใต้การตั้งค่าระบบ → ความเป็นส่วนตัวและความปลอดภัย → การช่วยการเข้าถึง การแมปของคุณจะเริ่มทำงานทันทีที่คุณเปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ön ayardaki klavye ve fare eylemlerini göndermek için Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik altında InputConfig’i açın. Eşlemeleriniz siz açar açmaz çalışmaya başlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб надсилати дії клавіатури й миші з цього пресета, увімкніть InputConfig у «Системні параметри» → «Приватність і безпека» → «Доступність». Ваші зіставлення почнуть працювати, щойно ви це зробите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để gửi các hành động bàn phím và chuột trong cài đặt sẵn này, hãy bật InputConfig trong Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Trợ năng. Các ánh xạ của bạn sẽ bắt đầu hoạt động ngay khi bạn bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要发送此预设中的键盘和鼠标动作，请在“系统设置”>“隐私与安全性”>“辅助功能”下开启 InputConfig。开启后你的映射会立即开始生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要傳送此預設中的鍵盤與滑鼠動作，請在「系統設定」>「隱私權與安全性」>「輔助使用」中開啟 InputConfig。你一開啟，對應就會開始運作。"
          }
        }
      }
    },
    "To set a control, click Scan, then press the button or move the stick. The row fills itself in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لضبط عنصر تحكم، انقر «فحص» ثم اضغط الزر أو حرّك العصا. يمتلئ الصف من تلقاء نفسه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládací prvek nastavíte kliknutím na Skenovat a pak stiskem tlačítka nebo pohybem páčky. Řádek se vyplní sám."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at indstille en betjening klikker du på Scan og trykker så på knappen eller flytter sticken. Rækken udfylder sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um eine Steuerung festzulegen, klick auf Scannen und drück dann die Taste oder beweg den Stick. Die Zeile füllt sich selbst aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para fijar un control, haz clic en Escanear y luego pulsa el botón o mueve el stick. La fila se rellena sola."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta ohjain klikkaamalla Skannaa ja paina sitten painiketta tai liikuta sauvaa. Rivi täyttyy itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour régler une commande, cliquez sur Scanner, puis appuyez sur le bouton ou bougez le stick. La ligne se remplit toute seule."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לקבוע פקד, לחצו ״סריקה״ ואז לחצו על הכפתור או הזיזו את הג׳ויסטיק. השורה מתמלאת לבד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kezelőszerv beállításához kattints a Beolvasás gombra, majd nyomd meg a gombot vagy mozdítsd a joystickot. A sor magától kitöltődik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengatur kontrol, klik Pindai, lalu tekan tombol atau gerakkan stik. Baris terisi sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per impostare un comando, fai clic su Scansiona, poi premi il tasto o muovi lo stick. La riga si compila da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作部を設定するには、「スキャン」をクリックしてから、ボタンを押すかスティックを倒します。行が自動で埋まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤을 정하려면 스캔을 클릭한 뒤 버튼을 누르거나 스틱을 움직이세요. 행이 저절로 채워집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å stille inn en kontroll klikker du på Skann og trykker så på knappen eller beveger joysticken. Raden fyller seg ut selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om een bediening in te stellen, klik je op Scan en druk je de knop in of beweeg je de stick. De rij vult zichzelf in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby ustawić element sterujący, kliknij Skanuj, a potem naciśnij przycisk lub rusz drążkiem. Wiersz wypełni się sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para definir um controle, clique em Escanear e depois aperte o botão ou mova o stick. A linha se preenche sozinha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы задать элемент управления, нажмите «Сканировать», затем нажмите кнопку или сдвиньте стик. Строка заполнится сама."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládací prvok nastavíte kliknutím na Skenovať a potom stlačením tlačidla alebo pohybom páčky. Riadok sa vyplní sám."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att ställa in en kontroll klickar du på Skanna och trycker sedan på knappen eller rör spaken. Raden fyller i sig själv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการตั้งตัวควบคุม คลิกสแกน แล้วกดปุ่มหรือขยับจอยสติ๊ก แถวจะกรอกเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kontrolü ayarlamak için Tara'ya tıklayın, sonra düğmeye basın veya çubuğu oynatın. Satır kendiliğinden dolar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб задати елемент керування, натисніть «Сканувати», а потім натисніть кнопку або зсуньте джойстик. Рядок заповниться сам."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để đặt một nút điều khiển, nhấp Quét, rồi bấm nút hoặc di chuyển cần. Hàng tự điền vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要设定一个控件，点按“扫描”，然后按下按钮或推动摇杆。这一行会自动填好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要設定一個控制項，點按「掃描」，然後按下按鈕或推動搖桿。這一列會自動填好。"
          }
        }
      }
    },
