    "Middle and side mouse buttons do only this preset's rows" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زرّا الماوس الأوسط والجانبيان يفعلان ما في صفوف هذا الإعداد فقط"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostřední a boční tlačítka myši dělají jen to, co řádky této předvolby"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musens midter- og sideknapper gør kun det, denne forudindstillings rækker siger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittlere und seitliche Maustasten tun nur, was die Zeilen dieses Presets sagen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones central y laterales del ratón solo hacen lo que dicen las filas de este preset"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiiren keski- ja sivupainikkeet tekevät vain tämän esiasetuksen rivien työt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les boutons central et latéraux de la souris ne font que ce que disent les lignes de ce préréglage"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחצני העכבר האמצעי והצדדיים עושים רק את מה שבשורות ההגדרה הזו"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egér középső és oldalsó gombjai csak ennek a beállításnak a sorait követik"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol tengah dan samping mouse hanya menjalankan baris preset ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tasti centrale e laterali del mouse fanno solo ciò che dicono le righe di questo preset"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスの中央ボタンとサイドボタンは、このプリセットの行の動作だけを行います"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 가운데 버튼과 측면 버튼은 이 프리셋 행의 동작만 합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Midt- og sideknappene på musen gjør bare det denne forhåndsinnstillingens rader sier"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Middelste en zijknoppen van de muis doen alleen wat de rijen van deze voorinstelling zeggen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Środkowy i boczne przyciski myszy robią tylko to, co wiersze tego ustawienia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os botões do meio e laterais do mouse só fazem o que as linhas deste preset dizem"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средняя и боковые кнопки мыши делают только то, что задано в строках этого пресета"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stredné a bočné tlačidlá myši robia len to, čo riadky tejto predvoľby"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musens mitt- och sidoknappar gör bara det förinställningens rader säger"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มกลางและปุ่มข้างของเมาส์ทำงานตามแถวของพรีเซ็ตนี้เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farenin orta ve yan düğmeleri yalnızca bu ön ayarın satırlarını yapar"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Середня й бічні кнопки миші виконують лише те, що в рядках цього пресету"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nút giữa và nút bên của chuột chỉ làm theo các hàng của cài đặt sẵn này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
