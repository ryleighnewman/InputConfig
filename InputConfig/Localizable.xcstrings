    "Touchpad calibration and regions, gyroscope aim, deadzone tuning, one-stick driving" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معايرة لوحة اللمس ومناطقها، والتصويب بالجيروسكوب، وضبط المنطقة الميتة، والقيادة بعصا واحدة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrace touchpadu a oblasti, zamíření gyroskopem, ladění mrtvé zóny, řízení jednou páčkou"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpad-kalibrering og områder, gyro-sigte, justering af dødzone, kørsel med én stick"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpad-Kalibrierung und -Bereiche, Gyroskop-Zielen, Totzonen-Abstimmung, Fahren mit einem Stick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibración y regiones del panel táctil, apuntado por giroscopio, ajuste de la zona muerta, conducción con un solo stick"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketuslevyn kalibrointi ja alueet, gyrokohdistus, kuolleen alueen säätö, yhden sauvan ajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrage et zones du pavé tactile, visée au gyroscope, réglage de la zone morte, conduite à un stick"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כיול משטח מגע ואזורים, כיוון ג׳יירו, כוונון אזור מת, נהיגה בג׳ויסטיק אחד"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érintőpad-kalibrálás és -területek, giroszkópos célzás, holttér-hangolás, egyjoystickos vezetés"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrasi dan wilayah touchpad, bidikan giroskop, penyetelan zona mati, mengemudi satu stik"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibrazione e regioni del touchpad, mira con giroscopio, regolazione della zona morta, guida con un solo stick"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチパッドのキャリブレーションと領域、ジャイロエイム、デッドゾーンの調整、One-Stick Driving"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터치패드 보정과 영역, 자이로스코프 조준, 데드존 조정, 스틱 하나로 주행"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrering og områder for berøringsflate, gyrosikting, justering av dødsone, kjøring med én joystick"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpadkalibratie en gebieden, richten met de gyroscoop, afstemmen van de dode zone, besturing met één stick"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibracja i obszary gładzika, celowanie żyroskopem, strojenie martwej strefy, jazda jednym drążkiem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calibração e regiões do touchpad, mira por giroscópio, ajuste da zona morta, direção com um stick"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калибровка тачпада и области, прицеливание гироскопом, настройка мёртвой зоны, вождение одним стиком"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrácia a oblasti touchpadu, mierenie gyroskopom, ladenie mŕtvej zóny, jazda jednou páčkou"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibrering och regioner för pekplatta, gyrosiktning, finjustering av dödzon, körning med en spak"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปรับเทียบและพื้นที่ทัชแพด การเล็งด้วยไจโรสโคป การปรับเดดโซน การขับด้วยจอยสติ๊กเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunmatik yüzey kalibrasyonu ve bölgeleri, jiroskop nişanı, ölü bölge ayarı, tek çubukla sürüş"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калібрування сенсорної панелі та області, прицілювання гіроскопом, налаштування мертвої зони, їзда одним джойстиком"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiệu chỉnh và vùng bàn di cảm ứng, ngắm bằng con quay, tinh chỉnh vùng chết, lái bằng một cần"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "触摸板校准和区域、陀螺仪瞄准、死区调节、单摇杆驾驶"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
