    "None of this file's rows could be read. It may come from a newer version of InputConfig, or it is missing fields such as row ids." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت قراءة أي من صفوف هذا الملف. قد يكون من نسخة أحدث من InputConfig، أو تنقصه حقول مثل معرّفات الصفوف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádný řádek z tohoto souboru nešlo přečíst. Může pocházet z novější verze InputConfig nebo mu chybí pole, například id řádků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af denne fils rækker kunne læses. Den kan komme fra en nyere version af InputConfig, eller der mangler felter som række-id'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Zeile dieser Datei konnte gelesen werden. Sie stammt möglicherweise von einer neueren Version von InputConfig, oder es fehlen Felder wie Zeilen-IDs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer ninguna fila de este archivo. Puede proceder de una versión más reciente de InputConfig, o le faltan campos como los identificadores de fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään tämän tiedoston riveistä ei voitu lukea. Se voi olla peräisin InputConfigin uudemmasta versiosta, tai siitä puuttuu kenttiä, kuten rivitunnisteet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune des lignes de ce fichier n’a pu être lue. Il provient peut-être d’une version plus récente d’InputConfig, ou il manque des champs comme les identifiants de ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לקרוא אף שורה בקובץ הזה. ייתכן שהוא מגרסה חדשה יותר של InputConfig, או שחסרים בו שדות כמו מזהי שורות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fájl egyetlen sora sem olvasható. Az InputConfig újabb verziójából származhat, vagy hiányoznak belőle mezők, például a sorazonosítók."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada baris dalam file ini yang dapat dibaca. Mungkin berasal dari versi InputConfig yang lebih baru, atau tidak memiliki kolom seperti id baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere nessuna riga di questo file. Potrebbe provenire da una versione più recente di InputConfig, oppure mancano campi come gli id delle righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルの行はどれも読み込めませんでした。新しいバージョンのInputConfigで作成されたか、行IDなどのフィールドが欠けている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일의 행을 하나도 읽을 수 없습니다. 더 새로운 버전의 InputConfig에서 만들었거나, 행 ID 같은 필드가 없을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen av radene i denne filen kunne leses. Den kan komme fra en nyere versjon av InputConfig, eller mangle felt som rad-ID-er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen van de rijen in dit bestand kon worden gelezen. Het komt mogelijk van een nieuwere versie van InputConfig, of er ontbreken velden zoals rij-id's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać żadnego wiersza z tego pliku. Może pochodzić z nowszej wersji InputConfig albo brakuje w nim pól, takich jak identyfikatory wierszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma linha deste arquivo pôde ser lida. Ele pode vir de uma versão mais recente do InputConfig, ou faltam campos como os ids das linhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать ни одну строку этого файла. Возможно, он создан более новой версией InputConfig или в нём нет полей, например идентификаторов строк."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepodarilo sa prečítať žiadny riadok tohto súboru. Môže pochádzať z novšej verzie InputConfig alebo mu chýbajú polia, ako sú ID riadkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga av den här filens rader kunde läsas. Den kan komma från en nyare version av InputConfig, eller sakna fält som rad-id."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถอ่านแถวใดของไฟล์นี้ได้ อาจมาจาก InputConfig เวอร์ชันที่ใหม่กว่า หรือขาดฟิลด์เช่นรหัสแถว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dosyanın hiçbir satırı okunamadı. InputConfig’in daha yeni bir sürümünden olabilir ya da satır kimlikleri gibi alanlar eksik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоден рядок цього файлу не вдалося прочитати. Він може бути з новішої версії InputConfig або в ньому бракує полів, як-от ідентифікаторів рядків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đọc được hàng nào của tệp này. Có thể nó đến từ phiên bản InputConfig mới hơn, hoặc thiếu các trường như mã hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件中的行都无法读取。它可能来自更新版本的 InputConfig，或缺少行标识符等字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案中的列都無法讀取。它可能來自較新版本的 InputConfig，或缺少列 ID 等欄位。"
          }
        }
      }
