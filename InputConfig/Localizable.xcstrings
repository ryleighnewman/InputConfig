    "Force Touch is read only while InputConfig is the front window; everything else works from any app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقرأ Force Touch فقط بينما تكون نافذة InputConfig في المقدمة؛ وكل شيء آخر يعمل من أي تطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch se čte jen tehdy, když je InputConfig v popředí; vše ostatní funguje z libovolné aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch læses kun, mens InputConfig er det forreste vindue. Alt andet virker fra enhver app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch wird nur gelesen, solange InputConfig das vorderste Fenster ist; alles andere funktioniert aus jeder App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch solo se lee mientras InputConfig es la ventana frontal; todo lo demás funciona desde cualquier app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch luetaan vain, kun InputConfig on etummaisena ikkunana; kaikki muu toimii mistä tahansa apista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch n’est lu que lorsque InputConfig est la fenêtre au premier plan ; tout le reste fonctionne depuis n’importe quelle app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Force Touch נקרא רק כש-InputConfig הוא החלון הקדמי; כל השאר עובד מכל אפליקציה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Force Touch csak akkor olvasható, ha az InputConfig az előtérben lévő ablak; minden más bármely appból működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch hanya dibaca saat InputConfig menjadi jendela depan; yang lainnya berfungsi dari app mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch viene letto solo mentre InputConfig è la finestra in primo piano; tutto il resto funziona da qualsiasi app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touchは、InputConfigが最前面のウインドウのときにのみ読み取られます。そのほかはすべて、どのAppからでも動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch는 InputConfig가 맨 앞 윈도우일 때만 읽히며, 나머지 기능은 모든 앱에서 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch leses bare mens InputConfig er det fremste vinduet. Alt annet fungerer fra hvilken som helst app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch wordt alleen gelezen terwijl InputConfig het voorste venster is; al het andere werkt vanuit elke app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch jest odczytywany tylko wtedy, gdy InputConfig jest oknem na pierwszym planie. Wszystko inne działa z dowolnej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Force Touch só é lido enquanto o InputConfig é a janela da frente; todo o resto funciona a partir de qualquer app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch считывается, только пока InputConfig в переднем окне; всё остальное работает из любого приложения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch sa číta iba vtedy, keď je InputConfig predné okno; všetko ostatné funguje z ktorejkoľvek aplikácie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch läses bara medan InputConfig är det främsta fönstret. Allt annat fungerar från vilken app som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch อ่านค่าเฉพาะเมื่อ InputConfig เป็นหน้าต่างหน้าสุด อย่างอื่นทำงานได้จากทุกแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch yalnızca InputConfig ön penceredeyken okunur; diğer her şey herhangi bir uygulamadan çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch зчитується, лише поки InputConfig є переднім вікном; усе інше працює з будь-якої програми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force Touch chỉ được đọc khi InputConfig là cửa sổ phía trước; mọi thứ khác hoạt động từ bất kỳ ứng dụng nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当 InputConfig 是最前窗口时才会读取 Force Touch；其他一切在任何 App 中都有效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在 InputConfig 是最前方視窗時才會讀取 Force Touch；其他一切都能從任何 App 運作。"
          }
        }
      }
    },
    "Forget this controller's stored zero" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسيان صفر ذراع التحكم هذا المخزّن"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomenout uloženou nulu tohoto ovladače"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem denne controllers gemte nulpunkt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherten Nullpunkt dieses Controllers vergessen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidar el cero guardado de este mando"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unohda tämän ohjaimen tallennettu nollapiste"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oublier le zéro mémorisé de cette manette"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שכח את האפס השמור של השלט הזה"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vezérlő tárolt nullapontjának elfelejtése"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupakan nol tersimpan pengontrol ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimentica lo zero memorizzato di questo controller"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコントローラの保存済みゼロ点を消去"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 컨트롤러의 저장된 영점 지우기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem nullpunktet som er lagret for denne kontrolleren"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergeet het opgeslagen nulpunt van deze controller"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapomnij zapamiętane zero tego kontrolera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquecer o zero armazenado deste controle"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забыть сохранённый ноль этого контроллера"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zabudnúť uloženú nulu tohto ovládača"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glöm den här spelkontrollens sparade nollvärde"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลืมค่าศูนย์ที่เก็บไว้ของคอนโทรลเลอร์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kumandanın saklı sıfırını unut"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забути збережений нуль цього контролера"
          }
        },
        "vi" : {
