        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: elige una zona en el menú de dirección de una fila de stick o gatillo, junto a más y menos. Las Opciones de la fila y la hoja de zona muerta también muestran las zonas."
          }
        },
        "fi" : {
          "stringUnit" : {
