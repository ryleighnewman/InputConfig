            "value" : "Com Start (Menu / Options / Plus) também segurado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также с удержанием Start (Menu / Options / Plus)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So súčasne podržaným Start (Menu / Options / Plus)"
          }
        },
        "sv" : {
          "stringUnit" : {
