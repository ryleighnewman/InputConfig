          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolba se může automaticky aktivovat, když se její aplikace dostane do popředí, a po vašem odchodu ustoupit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En forudindstilling kan aktiveres automatisk, når dens app kommer forrest, og træde til side, når du forlader den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Preset kann sich automatisch aktivieren, wenn seine App in den Vordergrund kommt, und wieder zurücktreten, wenn du sie verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un preajuste puede activarse automáticamente cuando su app pasa a primer plano y apartarse cuando te vas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiasetus voi aktivoitua automaattisesti, kun sen appi tulee etualalle, ja väistyä, kun appi jätetään."
          }
