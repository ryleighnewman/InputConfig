    "“%@” uses %@, so this shortcut does nothing. Choose another chord, or change that preset's." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏“%1$@” يستخدم %2$@، لذا لا يفعل هذا الاختصار شيئًا. اختر تركيبة أخرى، أو غيّر تركيبة ذلك الإعداد المسبق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ používá %2$@, takže tato zkratka nic nedělá. Zvolte jinou kombinaci, nebo změňte kombinaci té předvolby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” bruger %2$@, så denne genvej gør ingenting. Vælg en anden tastekombination, eller ændr den forudindstillings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ verwendet %2$@, daher bewirkt dieser Kurzbefehl nichts. Wähle eine andere Tastenkombination oder ändere die dieses Presets."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” uses %2$@, so this shortcut does nothing. Choose another chord, or change that preset's."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” usa %2$@, así que este atajo no hace nada. Elige otra combinación, o cambia la de ese preajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” käyttää yhdistelmää %2$@, joten tämä oikotie ei tee mitään. Valitse toinen yhdistelmä tai vaihda kyseisen esiasetuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » utilise %2$@, donc ce raccourci ne fait rien. Choisissez une autre combinaison, ou modifiez celle de ce préréglage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏“%1$@” משתמש ב-%2$@, ולכן הקיצור הזה לא עושה דבר. בחר צירוף מקשים אחר, או שנה את זה של הפריסט ההוא."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%1$@” ezt használja: %2$@, ezért ez a billentyűparancs nem csinál semmit. Válasszon másik billentyűkombinációt, vagy módosítsa az adott előbeállításét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” menggunakan %2$@, sehingga pintasan ini tidak berfungsi. Pilih kombinasi tombol lain, atau ubah milik preset itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” usa %2$@, quindi questa scorciatoia non fa nulla. Scegli un’altra combinazione, oppure cambia quella di quel preset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」が%2$@を使用しているため、このショートカットは何も実行しません。別のキーの組み合わせを選ぶか、そのプリセットのものを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” 프리셋이 %2$@을(를) 사용 중이므로 이 단축키는 작동하지 않습니다. 다른 키 조합을 선택하거나 해당 프리셋의 조합을 변경하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» bruker %2$@, så denne snarveien gjør ingenting. Velg en annen tastekombinasjon, eller endre den forhåndsinnstillingens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” gebruikt %2$@, dus deze sneltoets doet niets. Kies een andere toetscombinatie, of wijzig die van die preset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” używa %2$@, więc ten skrót nic nie robi. Wybierz inną kombinację albo zmień kombinację tego presetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” usa %2$@, então este atalho não faz nada. Escolha outra combinação, ou altere a desse preset."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» использует %2$@, поэтому это сочетание ничего не делает. Выберите другое сочетание или измените сочетание этого пресета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ používa %2$@, takže táto skratka nič nerobí. Vyberte inú kombináciu alebo zmeňte skratku tej predvoľby."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” använder %2$@, så den här genvägen gör ingenting. Välj en annan tangentkombination, eller ändra den förinställningens."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” ใช้ %2$@ แป้นพิมพ์ลัดนี้จึงไม่ทำงาน เลือกชุดแป้นอื่น หรือเปลี่ยนของพรีเซ็ตนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”, %2$@ kullanıyor, bu yüzden bu kısayol bir şey yapmıyor. Başka bir tuş birleşimi seçin ya da o ön ayarınkini değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» використовує %2$@, тож це скорочення нічого не робить. Виберіть іншу комбінацію або змініть комбінацію того пресета."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” dùng %2$@, nên phím tắt này không có tác dụng. Hãy chọn tổ hợp phím khác, hoặc đổi tổ hợp của cài đặt sẵn đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”使用 %2$@，因此此快捷键不起作用。请选择其他组合键，或更改该预设的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」使用 %2$@，因此這個快速鍵沒有作用。請選擇其他組合鍵，或更改該預設的。"
          }
        }
      }
    },
    "\"%@\" will be moved to the Trash at the bottom of the sidebar. Restore it from there; the Trash keeps the last 60 presets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم نقل “%@” إلى سلة المحذوفات أسفل الشريط الجانبي. استعده من هناك؛ تحتفظ سلة المحذوفات بآخر 60 إعدادًا مسبقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolba „%@“ bude přesunuta do Koše dole v postranním panelu. Obnovíte ji odtud; Koš uchovává posledních 60 předvoleb."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” flyttes til papirkurven nederst i indholdsoversigten. Gendan den derfra. Papirkurven gemmer de seneste 60 forudindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird in den Papierkorb unten in der Seitenleiste verschoben. Dort kannst du es wiederherstellen; der Papierkorb behält die letzten 60 Presets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se moverá a la Papelera, al final de la barra lateral. Restáuralo desde allí; la Papelera conserva los últimos 60 preajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” siirretään sivupalkin alareunan Roskakoriin. Palauta se sieltä. Roskakoriin mahtuu 60 viimeisintä esiasetusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera déplacé dans la corbeille, en bas de la barre latérale. Vous pouvez l’y restaurer. La corbeille conserve les 60 derniers préréglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏“%@” יועבר לאשפה בתחתית סרגל הצד. אפשר לשחזר אותו משם; האשפה שומרת את 60 הפריסטים האחרונים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%@” a Kukába kerül az oldalsáv alján. Onnan állíthatja vissza; a Kuka az utolsó 60 előbeállítást őrzi meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" akan dipindahkan ke Sampah di bagian bawah bar samping. Pulihkan dari sana; Sampah menyimpan 60 preset terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà spostato nel cestino in fondo alla barra laterale. Ripristinalo da lì; il cestino conserva gli ultimi 60 preset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は、サイドバー下部のゴミ箱に移動されます。そこから復元できます。ゴミ箱には直近60個のプリセットが保管されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 항목이 사이드바 하단의 휴지통으로 이동됩니다. 거기에서 복원할 수 있으며, 휴지통에는 최근 프리셋 60개가 보관됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» flyttes til Papirkurv nederst i sidepanelet. Gjenopprett den derfra. Papirkurven beholder de siste 60 forhåndsinnstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” wordt verplaatst naar de Prullenmand onderaan de navigatiekolom. Zet het daar terug; de Prullenmand bewaart de laatste 60 presets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preset „%@” zostanie przeniesiony do Kosza na dole paska bocznego. Możesz go stamtąd przywrócić. Kosz przechowuje 60 ostatnich presetów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será movido para a Lixeira, na parte inferior da barra lateral. Restaure-o de lá; a Lixeira guarda os últimos 60 presets."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» будет перемещён в корзину внизу боковой панели. Восстановите его оттуда; в корзине хранятся последние 60 пресетов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ sa presunie do Koša v dolnej časti bočného panela. Obnovte ju odtiaľ; Kôš uchováva posledných 60 predvolieb."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” flyttas till papperskorgen längst ned i sidofältet. Återställ den därifrån. Papperskorgen behåller de senaste 60 förinställningarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” จะถูกย้ายไปที่ถังขยะที่ด้านล่างของแถบด้านข้าง กู้คืนได้จากที่นั่น ถังขยะเก็บพรีเซ็ตล่าสุด 60 รายการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”, kenar çubuğunun altındaki Çöp Sepeti’ne taşınacak. Oradan geri yükleyebilirsiniz; Çöp Sepeti son 60 ön ayarı tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» буде переміщено до Смітника внизу бічної панелі. Відновіть його звідти; у Смітнику зберігаються останні 60 пресетів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sẽ được chuyển vào Thùng rác ở cuối thanh bên. Hãy khôi phục từ đó; Thùng rác giữ 60 cài đặt sẵn gần nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将被移到边栏底部的废纸篓。可从那里恢复；废纸篓会保留最近 60 个预设。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」將移至側邊欄底部的垃圾桶。可從該處復原；垃圾桶會保留最近 60 個預設。"
          }
        }
      }
    },
