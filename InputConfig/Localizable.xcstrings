    "Stick, trigger and screen region editors show only the stick, trigger or display they were opened from, sized to what they show" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض محررات المناطق ومناطق الشاشة العصا أو الزناد أو الشاشة التي فُتحت منها فقط، بحجم ما تعرضه"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editory oblastí a oblastí obrazovky ukazují jen páčku, spoušť nebo displej, ze kterého byly otevřeny, a mají velikost podle toho, co ukazují"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editorerne for stick-, aftrækker- og skærmområder viser kun den stick, aftrækker eller skærm, de blev åbnet fra, i den størrelse, det de viser kræver"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Editoren für Stick-, Trigger- und Bildschirmbereiche zeigen nur den Stick, Trigger oder Bildschirm, von dem aus sie geöffnet wurden, so groß wie das, was sie zeigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los editores de regiones y de regiones de pantalla muestran solo el stick, gatillo o pantalla desde el que se abrieron, del tamaño de lo que muestran"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauva-, liipaisin- ja näyttöalue-editorit näyttävät vain sen sauvan, liipaisimen tai näytön, josta ne avattiin, ja ovat sen kokoisia kuin sisältönsä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éditeurs de zones et de régions d’écran ne montrent que le stick, la gâchette ou l’écran depuis lequel ils ont été ouverts, à la taille de ce qu’ils montrent"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עורכי האזורים ואזורי המסך מציגים רק את הג׳ויסטיק, ההדק או המסך שמהם נפתחו, בגודל של מה שהם מציגים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kar-, ravasz- és képernyőterület-szerkesztők csak azt a kart, ravaszt vagy kijelzőt mutatják, amelyről megnyitották őket, akkorák, amekkora a tartalmuk"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor wilayah dan wilayah layar hanya menampilkan stik, pelatuk, atau layar tempat editor itu dibuka, seukuran yang ditampilkan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli editor di regioni e regioni dello schermo mostrano solo la levetta, il grilletto o lo schermo da cui sono stati aperti, grandi quanto ciò che mostrano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "領域と画面領域のエディタは、開いた元のスティック、トリガー、ディスプレイだけを表示し、表示内容に合った大きさになります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역과 화면 영역 편집기는 연 곳의 스틱, 트리거, 디스플레이만 보여 주며, 보여 주는 내용에 맞는 크기입니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeringsverktøyene for spak-, avtrekker- og skjermområder viser bare spaken, avtrekkeren eller skjermen de ble åpnet fra, i størrelsen det de viser trenger"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De editors voor stick-, trigger- en schermgebieden tonen alleen de stick, trigger of het scherm waarvandaan ze zijn geopend, zo groot als wat ze tonen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytory obszarów drążka, spustu i ekranu pokazują tylko drążek, spust lub ekran, z którego je otwarto, w rozmiarze tego, co pokazują"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os editores de regiões e de regiões da tela mostram só o analógico, gatilho ou tela de onde foram abertos, do tamanho do que mostram"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редакторы областей и областей экрана показывают только тот стик, курок или дисплей, из которого их открыли, и по размеру соответствуют содержимому"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editory oblastí a oblastí obrazovky ukazujú len páčku, spúšť alebo displej, z ktorého boli otvorené, a majú veľkosť podľa toho, čo ukazujú"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigerarna för regioner och skärmområden visar bara den spak, avtryckare eller skärm de öppnades från, i den storlek det de visar kräver"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวแก้ไขพื้นที่และพื้นที่หน้าจอจะแสดงเฉพาะสติ๊ก ทริกเกอร์ หรือจอภาพที่เปิดมา และมีขนาดพอดีกับสิ่งที่แสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölge ve ekran alanı düzenleyicileri yalnızca açıldıkları çubuğu, tetiği veya ekranı, gösterdikleri kadar büyük gösterir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактори областей і областей екрана показують лише той джойстик, курок чи дисплей, з якого їх відкрили, і мають розмір за вмістом"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình chỉnh sửa vùng và vùng màn hình chỉ hiện cần, cò hoặc màn hình mà nó được mở từ đó, với kích thước vừa với nội dung"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区域和屏幕区域编辑器只显示打开它的那根摇杆、那个扳机或那块显示器，大小与内容相符"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "區域和螢幕區域編輯器只顯示打開它的那根搖桿、那個扳機或那個顯示器，大小與內容相符"
          }
        }
      }
    },
