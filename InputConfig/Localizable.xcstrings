    "%@, from any app. If another app owns it, this switches off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@، من أي تطبيق. إذا كان تطبيق آخر يملكه، فسيتوقف هذا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ z libovolné aplikace. Pokud ho používá jiná aplikace, tato možnost se vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, fra enhver app. Hvis en anden app bruger den, slås dette fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, aus jeder App. Gehört es einer anderen App, wird dies ausgeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, desde cualquier app. Si otra app lo tiene asignado, esto se desactiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, miltä tahansa apilta. Jos jokin toinen appi käyttää sitä, tämä kytkeytyy pois päältä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, depuis n’importe quelle app. Si une autre app l’utilise, ce réglage se désactive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@, מכל אפליקציה. אם אפליקציה אחרת משתמשת בו, ההגדרה הזו תיכבה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, bármely appból. Ha egy másik app használja, ez kikapcsol."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, dari app mana pun. Jika app lain menggunakannya, ini akan dimatikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, da qualsiasi app. Se è già usato da un’altra app, questa opzione si disattiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。どのAppからでも有効です。別のAppが使用している場合は、オフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, 모든 앱에서. 다른 앱이 이미 사용 중이면 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, fra alle apper. Hvis en annen app bruker den, slås dette av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, vanuit elke app. Als een andere app het al gebruikt, wordt dit uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, z dowolnej aplikacji. Jeśli używa go inna aplikacja, ta opcja się wyłączy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, de qualquer app. Se outro app já o usa, isto é desativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ из любого приложения. Если его использует другое приложение, этот параметр выключится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, z ktorejkoľvek aplikácie. Ak ho vlastní iná aplikácia, vypne sa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, från vilken app som helst. Om en annan app äger den slås detta av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ จากแอปใดก็ได้ หากแอปอื่นใช้งานอยู่ จะปิดการใช้งานนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, herhangi bir uygulamadan. Başka bir uygulama bunu kullanıyorsa bu kapanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, з будь-якої програми. Якщо ним володіє інша програма, це вимкнеться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, từ bất kỳ ứng dụng nào. Nếu ứng dụng khác đang dùng, tùy chọn này sẽ tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，适用于任何 App。如果其他 App 已占用它，此项将关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，來自任何 App。若其他 App 已擁有它，此功能會關閉。"
          }
        }
      }
    },
