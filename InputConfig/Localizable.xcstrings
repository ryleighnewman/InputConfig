    "Emergency stop. Everything stopped. Holding the controller stop starts the preset again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف الطوارئ. توقف كل شيء. الضغط مطولًا على إيقاف ذراع التحكم يبدأ الإعداد المسبق مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouzové zastavení. Vše se zastavilo. Podržením zastavení na ovladači se předvolba spustí znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nødstop. Alt er stoppet. Hvis du holder controllerens stop nede, starter forudindstillingen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notstopp. Alles wurde gestoppt. Wenn du den Controller-Stopp hältst, startet das Preset erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parada de emergencia. Todo detenido. Mantener pulsada la parada del mando vuelve a iniciar el preajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hätäpysäytys. Kaikki pysäytettiin. Kun pidät ohjaimen pysäytystä painettuna, esiasetus käynnistyy uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt d’urgence. Tout est arrêté. Maintenir l’arrêt de la manette relance le préréglage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצירת חירום. הכול נעצר. החזקת עצירת השלט מפעילה שוב את הפריסט."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vészleállítás. Minden leállt. A vezérlős leállítás nyomva tartása újraindítja az előbeállítást."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
