    "Crash recovery now fully restores your active preset, including restarting the mapping engine" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستعيد التعافي من العطل الآن إعدادك المسبق النشط بالكامل، بما في ذلك إعادة تشغيل محرك التعيين"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnova po pádu nyní plně obnoví aktivní předvolbu, včetně restartu mapovacího jádra"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannelse efter nedbrud gendanner nu fuldt ud din aktive forudindstilling, også genstart af tildelingsmotoren"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Absturzwiederherstellung stellt jetzt dein aktives Preset vollständig wieder her, einschließlich eines Neustarts der Mapping-Engine"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación tras un cierre inesperado ahora restaura por completo tu preajuste activo, incluido el reinicio del motor de asignación"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaatumisesta toipuminen palauttaa nyt aktiivisen esiasetuksen kokonaan, myös määritysmoottorin uudelleenkäynnistyksen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reprise après plantage restaure désormais entièrement votre préréglage actif, y compris le redémarrage du moteur de mappage"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שחזור מקריסה משחזר עכשיו במלואו את הפריסט הפעיל, כולל הפעלה מחדש של מנוע המיפוי"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az összeomlás utáni helyreállítás most teljesen visszaállítja az aktív előbeállítást, a leképezőmotor újraindításával együtt"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemulihan setelah mogok kini sepenuhnya memulihkan preset aktif Anda, termasuk memulai ulang mesin pemetaan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ripristino dopo un arresto anomalo ora ripristina completamente il preset attivo, compreso il riavvio del motore di mappatura"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラッシュからの復旧で、マッピングエンジンの再起動を含め、アクティブなプリセットが完全に復元されるようになりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 충돌 복구가 매핑 엔진 재시작을 포함해 활성 프리셋을 완전히 복원함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krasjgjenoppretting gjenoppretter nå den aktive forhåndsinnstillingen fullt ut, inkludert omstart av tilordningsmotoren"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstel na een crash zet je actieve preset nu volledig terug, inclusief het opnieuw starten van de toewijzingsengine"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odzyskiwanie po awarii w pełni przywraca teraz aktywny preset, w tym ponowne uruchomienie silnika mapowania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recuperação de falhas agora restaura totalmente seu preset ativo, inclusive reiniciando o motor de mapeamento"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановление после сбоя теперь полностью возвращает активный пресет, включая перезапуск движка назначения"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnova po páde teraz plne obnoví vašu aktívnu predvoľbu, vrátane reštartu mapovacieho nástroja"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kraschåterställning återställer nu helt din aktiva förinställning, inklusive omstart av mappningsmotorn"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกู้คืนหลังข้อขัดข้องกู้คืนพรีเซ็ตที่ใช้งานอยู่ได้เต็มรูปแบบแล้ว รวมถึงการเริ่มเอนจินการแมปใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çökme kurtarma artık etkin ön ayarınızı, eşleme motorunu yeniden başlatmak dahil, tamamen geri yüklüyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відновлення після збою тепер повністю відновлює ваш активний пресет, зокрема перезапуск рушія зіставлення"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khôi phục sau sự cố giờ đây khôi phục đầy đủ cài đặt sẵn đang hoạt động, kể cả khởi động lại công cụ ánh xạ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩溃恢复现在会完整恢复你已启用的预设，包括重新启动映射引擎"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當機復原現在可完整還原你使用中的預設，包括重新啟動對應引擎"
          }
        }
      }
    },
