          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva InputConfig in Privacy e sicurezza → Accessibilità per inviare input di tastiera e mouse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードとマウスの入力を送信するには、「プライバシーとセキュリティ」>「アクセシビリティ」でInputConfigをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드와 마우스 입력을 보내려면 개인정보 보호 및 보안 → 손쉬운 사용에서 InputConfig를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
