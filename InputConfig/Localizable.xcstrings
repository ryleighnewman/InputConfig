    "Back home. Every card here opens an example you can copy and make your own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدنا إلى الصفحة الرئيسية. كل بطاقة هنا تفتح مثالًا يمكنك نسخه وجعله خاصًا بك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpátky na úvodu. Každá karta tady otevře příklad, který si můžete zkopírovat a upravit po svém."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilbage på forsiden. Hvert kort her åbner et eksempel, du kan kopiere og gøre til dit eget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück auf der Startseite. Jede Karte hier öffnet ein Beispiel, das du kopieren und zu deinem eigenen machen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vuelta en el inicio. Cada tarjeta abre un ejemplo que puedes copiar y hacer tuyo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takaisin kotisivulla. Jokainen kortti avaa esimerkin, jonka voit kopioida ja tehdä omaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retour à l'accueil. Chaque carte ici ouvre un exemple que vous pouvez copier et faire vôtre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חזרה לדף הבית. כל כרטיס כאן פותח דוגמה שאפשר להעתיק ולהפוך לשלכם."
