    "In Arabic and Hebrew the app reads right to left, while the drawings of keyboards, controllers, touchpads, and screens keep their real left and right" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في العربية والعبرية يُقرأ التطبيق من اليمين إلى اليسار، بينما تحتفظ رسوم لوحات المفاتيح وأذرع التحكم ولوحات اللمس والشاشات بيمينها ويسارها الحقيقيين"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V arabštině a hebrejštině se aplikace čte zprava doleva, zatímco kresby klávesnic, ovladačů, touchpadů a displejů zachovávají své skutečné pravé a levé strany"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På arabisk og hebraisk læses appen fra højre mod venstre, mens tegningerne af tastaturer, controllere, touchpads og skærme bevarer deres rigtige venstre og højre side"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Arabisch und Hebräisch wird die App von rechts nach links gelesen, während die Zeichnungen von Tastaturen, Controllern, Touchpads und Displays ihr echtes Links und Rechts behalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En árabe y hebreo la app se lee de derecha a izquierda, mientras que los dibujos de teclados, mandos, paneles táctiles y pantallas conservan su izquierda y derecha reales"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arabiaksi ja hepreaksi appi luetaan oikealta vasemmalle, mutta näppäimistöjen, ohjainten, kosketuslevyjen ja näyttöjen piirrokset säilyttävät todellisen vasemman ja oikean puolensa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En arabe et en hébreu, l’app se lit de droite à gauche, tandis que les dessins des claviers, des manettes, des pavés tactiles et des écrans gardent leur vraie gauche et leur vraie droite"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בערבית ובעברית האפליקציה נקראת מימין לשמאל, בעוד שהציורים של מקלדות, שלטים, משטחי מגע ותצוגות שומרים על הימין והשמאל האמיתיים שלהם"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arabul és héberül az app jobbról balra olvasható, miközben a billentyűzetek, vezérlők, érintőpadok és kijelzők rajzai megtartják valódi bal és jobb oldalukat"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam bahasa Arab dan Ibrani, app dibaca dari kanan ke kiri, sedangkan gambar papan ketik, pengontrol, touchpad, dan layar tetap mempertahankan kiri dan kanan yang sebenarnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In arabo e in ebraico l’app si legge da destra a sinistra, mentre i disegni di tastiere, controller, touchpad e display mantengono la loro vera sinistra e destra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アラビア語とヘブライ語ではアプリが右から左へ読む向きになり、キーボード、コントローラ、タッチパッド、ディスプレイの図は実際の左右のまま表示されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아랍어와 히브리어에서는 앱이 오른쪽에서 왼쪽으로 읽히고, 키보드, 컨트롤러, 터치패드, 디스플레이 그림은 실제 왼쪽과 오른쪽을 유지함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På arabisk og hebraisk leses appen fra høyre til venstre, mens tegningene av tastaturer, kontrollere, berøringsflater og skjermer beholder sin virkelige venstre og høyre side"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In het Arabisch en Hebreeuws wordt de app van rechts naar links gelezen, terwijl de tekeningen van toetsenborden, controllers, touchpads en beeldschermen hun echte links en rechts behouden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W języku arabskim i hebrajskim aplikacja jest czytana od prawej do lewej, a rysunki klawiatur, kontrolerów, gładzików i wyświetlaczy zachowują swoją prawdziwą lewą i prawą stronę"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em árabe e hebraico o app é lido da direita para a esquerda, enquanto os desenhos de teclados, controles, touchpads e telas mantêm sua esquerda e direita reais"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На арабском и иврите приложение читается справа налево, а рисунки клавиатур, контроллеров, тачпадов и дисплеев сохраняют свои настоящие левую и правую стороны"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V arabčine a hebrejčine sa aplikácia číta sprava doľava, zatiaľ čo kresby klávesníc, ovládačov, touchpadov a displejov si zachovávajú skutočnú ľavú a pravú stranu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På arabiska och hebreiska läses appen från höger till vänster, medan teckningarna av tangentbord, spelkontroller, pekplattor och skärmar behåller sin verkliga vänster och höger"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในภาษาอาหรับและฮีบรู แอปจะอ่านจากขวาไปซ้าย ขณะที่ภาพวาดของแป้นพิมพ์ คอนโทรลเลอร์ ทัชแพด และจอแสดงผลยังคงซ้ายและขวาตามจริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arapça ve İbranicede uygulama sağdan sola okunur, ancak klavyelerin, kumandaların, dokunmatik yüzeylerin ve ekranların çizimleri gerçek sol ve sağ yönlerini korur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Арабською та івритом програма читається справа наліво, а малюнки клавіатур, контролерів, сенсорних панелей і дисплеїв зберігають свої справжні лівий і правий боки"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong tiếng Ả Rập và tiếng Do Thái, ứng dụng được đọc từ phải sang trái, trong khi hình vẽ của bàn phím, bộ điều khiển, bàn di cảm ứng và màn hình vẫn giữ trái và phải thực sự của chúng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在阿拉伯语和希伯来语中，App 从右向左阅读，而键盘、控制器、触摸板和显示器的图示保持真实的左右方向"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在阿拉伯文和希伯來文中，App 會從右向左閱讀，而鍵盤、控制器、觸控板和顯示器的圖示則保持真實的左右方向"
          }
        }
      }
    },
