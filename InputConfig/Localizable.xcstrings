    "Sensitivity and deadzone stay as set on the PS5." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الحساسية والمنطقة الميتة كما ضُبطت على PS5."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citlivost a mrtvá zóna zůstávají podle nastavení na PS5."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følsomhed og dødzone forbliver som indstillet på PS5."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfindlichkeit und Totzone bleiben wie an der PS5 eingestellt."
          }
        },
        "es" : {
