    "Turn it off, then hold B and Start to turn it on in the mode for a Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقفه، ثم اضغط B وStart معًا لتشغيله في وضع Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypněte ho a poté podržte B a Start, abyste ho zapnuli v režimu pro Mac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå den fra, og hold derefter B og Start for at slå den til i tilstanden til en Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte es aus und halte dann B und Start, um es im Modus für einen Mac einzuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apágalo y luego mantén pulsados B y Start para encenderlo en el modo para Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kytke se pois ja pidä sitten B ja Start painettuna kytkeäksesi sen päälle Macille tarkoitettuun tilaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éteignez-la, puis maintenez B et Start pour l’allumer dans le mode pour Mac."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבה אותו, ואז החזק B ו-Start כדי להפעיל אותו במצב ל-Mac."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja ki, majd tartsa nyomva a B-t és a Startot, hogy a Machez való módban kapcsolja be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan, lalu tahan B dan Start untuk menyalakannya dalam mode untuk Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegnilo, poi tieni premuti B e Start per accenderlo nella modalità per Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにしてから、BとStartを押し続けると、Mac用のモードでオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "껐다가 B와 Start를 누르고 있으면 Mac용 모드로 켜집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå den av, og hold deretter B og Start for å slå den på i modusen for en Mac."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet hem uit en houd dan B en Start ingedrukt om hem aan te zetten in de modus voor een Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz go, a potem przytrzymaj B i Start, aby włączyć go w trybie dla Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desligue-o e depois segure B e Start para ligá-lo no modo para Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите его, затем удерживайте B и Start, чтобы включить режим для Mac."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypnite ho a potom podržte B a Start, aby sa zapol v režime pre Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå av den och håll sedan B och Start för att slå på den i läget för en Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดมัน แล้วกด B และ Start ค้างเพื่อเปิดในโหมดสำหรับ Mac"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapatın, ardından Mac için olan modda açmak için B ve Start tuşlarını basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимкніть його, потім утримуйте B і Start, щоб увімкнути його в режимі для Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt nó, rồi giữ B và Start để bật ở chế độ dành cho Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将其关闭，然后按住 B 和 Start，以 Mac 适用的模式将其开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先將它關閉，然後按住 B 和 Start，以適用於 Mac 的模式開啟。"
          }
        }
      }
    },
    "Turn mode fires a nudge for every few steps of rotation, clockwise or counterclockwise, built for volume, brightness, and stepped scrolling" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلق وضع الدوران دفعة لكل بضع خطوات من الدوران، باتجاه عقارب الساعة أو عكسه، وهو مصمم للصوت والسطوع والتمرير المتدرج"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim Otáčení spustí impuls za každých pár kroků otáčení, po směru i proti směru hodinových ručiček, vytvořený pro hlasitost, jas a krokové posouvání"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drej-tilstand udløser et skub for hvert par trin af rotation, med eller mod uret, bygget til lydstyrke, lysstyrke og rulning i trin"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Drehmodus löst bei jeweils einigen Schritten Drehung im oder gegen den Uhrzeigersinn einen Impuls aus, gedacht für Lautstärke, Helligkeit und schrittweises Scrollen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Giro activa un ajuste cada pocos pasos de rotación, en sentido horario o antihorario, pensado para volumen, brillo y desplazamiento por pasos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kierto-tila laukaisee töytäisyn joka muutaman kiertoaskeleen välein, myötä- tai vastapäivään, tehty äänenvoimakkuudelle, kirkkaudelle ja portaittaiselle vieritykselle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Rotation déclenche une impulsion tous les quelques crans de rotation, dans le sens horaire ou antihoraire, conçu pour le volume, la luminosité et le défilement par paliers"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצב סיבוב מפעיל הזזה לכל כמה צעדי סיבוב, עם כיוון השעון או נגדו, שנבנה לעוצמת קול, בהירות וגלילה בצעדים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Forgatás mód a forgás néhány lépésenként egy lökést aktivál, óramutató járásával megegyező vagy ellentétes irányban, hangerőhöz, fényerőhöz és lépcsőzetes görgetéshez"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode Putar memicu dorongan untuk setiap beberapa langkah putaran, searah atau berlawanan arah jarum jam, dibuat untuk volume, kecerahan, dan pengguliran bertahap"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Rotazione attiva uno scatto ogni pochi passi di rotazione, in senso orario o antiorario, pensata per volume, luminosità e scorrimento a passi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回転モードは、時計回りでも反時計回りでも、数ステップ回転するごとに微調整を実行します。音量、明るさ、段階的なスクロール向けに作られています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회전 모드는 시계 방향이든 반시계 방향이든 몇 단계 회전할 때마다 한 번씩 미세 조정을 실행하며, 볼륨, 밝기, 단계별 스크롤용으로 만들어졌습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vri-modus utløser et dytt for hvert par trinn med rotasjon, med eller mot klokken, bygd for volum, lysstyrke og trinnvis rulling"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De modus Draaien geeft een duwtje voor elke paar stappen rotatie, met de klok mee of tegen de klok in, gemaakt voor volume, helderheid en scrollen in stappen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb Obrót wysyła impuls co kilka kroków obrotu, w prawo lub w lewo, stworzony dla głośności, jasności i krokowego przewijania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Girar dispara um ajuste a cada poucos passos de rotação, no sentido horário ou anti-horário, feito para volume, brilho e rolagem em passos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим «Вращение» вызывает толчок за каждые несколько шагов поворота по часовой стрелке или против, создан для громкости, яркости и ступенчатой прокрутки"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim Otáčanie spustí posun pri každých niekoľkých krokoch otáčania, v smere alebo proti smeru hodinových ručičiek, vytvorený pre hlasitosť, jas a krokové posúvanie"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vridläge utlöser en knuff för var några steg av rotation, medurs eller moturs, byggt för volym, ljusstyrka och stegvis rullning"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหมดหมุนสั่งการขยับทุกๆ สองสามขั้นของการหมุน ตามเข็มนาฬิกาหรือทวนเข็มนาฬิกา สร้างมาสำหรับระดับเสียง ความสว่าง และการเลื่อนเป็นขั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çevirme modu, saat yönünde veya tersine her birkaç dönüş adımı için bir dürtme tetikler; ses düzeyi, parlaklık ve adım adım kaydırma için yapılmıştır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим обертання запускає поштовх на кожні кілька кроків обертання за годинниковою стрілкою чи проти неї, створений для гучності, яскравості та покрокового прокручування"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ Xoay kích hoạt một cú nhích cho mỗi vài bước xoay, theo chiều kim đồng hồ hoặc ngược lại, dành cho âm lượng, độ sáng và cuộn theo bước"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“旋转”模式每转动几步就触发一次微调，顺时针或逆时针均可，专为音量、亮度和分步滚动而设计"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「旋轉」模式每轉幾格就觸發一次微調，順時針或逆時針皆可，專為音量、亮度和步進式捲動而設計"
          }
        }
      }
    },
