    "System Settings, Privacy & Security, Accessibility, then switch on InputConfig." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعدادات النظام، الخصوصية والأمن، تسهيلات الاستخدام، ثم شغّل InputConfig."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení systému, Soukromí a zabezpečení, Zpřístupnění, pak zapněte InputConfig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemindstillinger, Anonymitet & sikkerhed, Tilgængelighed, og slå derefter InputConfig til."
