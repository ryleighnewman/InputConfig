    "Preset system with groups, notes, per-preset light bar colors, and app auto-activation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظام إعدادات مسبقة بمجموعات وملاحظات وألوان شريط إضاءة لكل إعداد مسبق وتفعيل تلقائي بحسب التطبيق"
