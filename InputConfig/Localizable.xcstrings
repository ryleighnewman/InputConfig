        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giống hệ thống sẽ theo Cài đặt hệ thống, Chung, Ngôn ngữ & Vùng, nơi bạn cũng có thể đặt ngôn ngữ riêng cho InputConfig."
          }
