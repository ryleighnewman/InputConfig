        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme som systemet følger Systeminnstillinger, Generelt, Språk og region, der du også kan angi et språk for bare InputConfig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetzelfde als het systeem volgt Systeeminstellingen, Algemeen, Taal en regio, waar je ook een taal voor alleen InputConfig kunt instellen."
