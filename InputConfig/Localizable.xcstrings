      }
    },
    "Added infrastructure for the Stream Deck, the Neo's touch points and the Stream Deck modules included, connected from the Devices menu or the menu bar" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
