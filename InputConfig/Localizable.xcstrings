        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érvénytelen JSON. Nyissa meg a fájlt szövegszerkesztőben, és ellenőrizze, nincsenek-e hiányzó zárójelek, idézőjelek vagy vesszők."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
