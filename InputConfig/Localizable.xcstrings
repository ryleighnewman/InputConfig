          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad lysbjælken gennemløbe alle farver, mens denne forudindstilling kører"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Lightbar durchläuft alle Farben, solange dieses Preset läuft"
