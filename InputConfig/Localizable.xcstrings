    "Presets made before 1.6 are offered again the next time a controller that 1.6 numbers differently connects." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعرض الإعدادات المسبقة المنشأة قبل 1.6 مجددًا في المرة التالية التي يتصل فيها ذراع تحكم يرقّمه 1.6 بشكل مختلف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolby vytvořené před verzí 1.6 se nabídnou znovu při příštím připojení ovladače, který verze 1.6 číslují jinak."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forudindstillinger lavet før 1.6 tilbydes igen, næste gang en controller, som 1.6 nummererer anderledes, forbindes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor 1.6 erstellte Presets werden erneut angeboten, wenn sich das nächste Mal ein Controller verbindet, den 1.6 anders nummeriert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los preajustes creados antes de la 1.6 se ofrecen de nuevo la próxima vez que se conecte un mando que la 1.6 numera de forma distinta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennen versiota 1.6 tehdyt esiasetukset tarjotaan uudelleen, kun seuraavan kerran yhdistetään ohjain, jonka 1.6 numeroi eri tavalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les préréglages créés avant la version 1.6 sont proposés à nouveau la prochaine fois que se connecte une manette que la version 1.6 numérote différemment."
          }
        },
