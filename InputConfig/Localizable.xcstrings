            "state" : "translated",
            "value" : "La sensibilidad y la zona muerta se quedan como en la PS5."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkkyys ja kuollut alue pysyvät PS5:llä asetettuina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sensibilité et la zone morte restent telles que réglées sur la PS5."
