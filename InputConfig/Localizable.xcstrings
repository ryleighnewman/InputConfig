    "InputConfig is built on the same foundation as YapToText, my free on-device dictation tool." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بُني InputConfig على الأساس نفسه الذي بُني عليه YapToText، أداة الإملاء المجانية على الجهاز التي طورتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig je postaven na stejném základu jako YapToText, můj bezplatný nástroj pro diktování na zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig er bygget på samme fundament som YapToText, mit gratis diktérværktøj på enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig basiert auf derselben Grundlage wie YapToText, mein kostenloses Diktierwerkzeug auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig está construido sobre la misma base que YapToText, mi herramienta gratuita de dictado en el dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig on rakennettu samalle perustalle kuin YapToText, ilmainen laitteella toimiva sanelutyökaluni."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
