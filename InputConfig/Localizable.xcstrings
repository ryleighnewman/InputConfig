          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig 无法读取此预设文件。它可能来自较新的版本：请更新 InputConfig，或重新索取该文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig 無法讀取此預設檔案。它可能來自較新的版本：請更新 InputConfig，或重新索取該檔案。"
          }
        }
      }
    },
