    "Rows keep options written by a newer version of InputConfig when the preset is saved here" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الصفوف بالخيارات التي كتبها إصدار أحدث من InputConfig عند حفظ الإعداد المسبق هنا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řádky si ponechají volby zapsané novější verzí InputConfig, když se předvolba uloží zde"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rækker beholder indstillinger skrevet af en nyere version af InputConfig, når forudindstillingen gemmes her"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeilen behalten Optionen, die von einer neueren Version von InputConfig geschrieben wurden, wenn das Preset hier gesichert wird"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las filas conservan las opciones escritas por una versión más reciente de InputConfig cuando el preajuste se guarda aquí"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivit säilyttävät InputConfigin uudemman version kirjoittamat asetukset, kun esiasetus tallennetaan täällä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes conservent les options écrites par une version plus récente d’InputConfig quand le préréglage est enregistré ici"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שורות שומרות אפשרויות שנכתבו על ידי גרסה חדשה יותר של InputConfig כשהפריסט נשמר כאן"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sorok megtartják az InputConfig újabb verziója által írt beállításokat, amikor az előbeállítást itt mentik"
          }
        },
        "id" : {
          "stringUnit" : {
