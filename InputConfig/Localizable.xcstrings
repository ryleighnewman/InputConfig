    "Time between presses. 100 ms is ten per second; 1000 ms is one per second." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزمن بين الضغطات. 100 ms تعني عشر ضغطات في الثانية؛ و1000 ms ضغطة واحدة في الثانية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doba mezi stisky. 100 ms je deset za sekundu; 1000 ms je jeden za sekundu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid mellem tryk. 100 ms er ti i sekundet. 1000 ms er ét i sekundet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeit zwischen Tastendrücken. 100 ms sind zehn pro Sekunde; 1000 ms ist einer pro Sekunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiempo entre pulsaciones. 100 ms son diez por segundo; 1000 ms es una por segundo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aika painallusten välillä. 100 ms on kymmenen sekunnissa; 1000 ms on yksi sekunnissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée entre les appuis. 100 ms correspond à dix par seconde ; 1000 ms à un par seconde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזמן בין לחיצות. 100 אלפיות שנייה הן עשר בשנייה; 1000 אלפיות שנייה הן אחת בשנייה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenyomások közötti idő. A 100 ms másodpercenként tíz, az 1000 ms másodpercenként egy."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu antar penekanan. 100 ms adalah sepuluh per detik; 1000 ms adalah satu per detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo tra le pressioni. 100 ms sono dieci al secondo; 1000 ms è uno al secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押下の間隔。100 msは毎秒10回、1000 msは毎秒1回です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누르기 사이의 시간. 100 ms는 초당 10회이고 1000 ms는 초당 1회입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tid mellom trykk. 100 ms er ti per sekund, 1000 ms er ett per sekund."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijd tussen drukken. 100 ms is tien per seconde; 1000 ms is één per seconde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas między naciśnięciami. 100 ms to dziesięć na sekundę, 1000 ms to jedno na sekundę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
