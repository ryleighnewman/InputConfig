    "Open Motion Calibration: a careful multi-second capture, live sensor readings, and a controller button for re-zeroing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح معايرة الحركة: التقاط دقيق يستغرق عدة ثوانٍ وقراءات مستشعرات مباشرة وزر في ذراع التحكم لإعادة التصفير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřít Kalibraci pohybu: pečlivé několikasekundové snímání, živé hodnoty senzorů a tlačítko ovladače pro opětovné vynulování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Bevægelseskalibrering: en omhyggelig optagelse over flere sekunder, live-sensoraflæsninger og en controllerknap til nulstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegungskalibrierung öffnen: eine sorgfältige Aufnahme über mehrere Sekunden, Live-Sensorwerte und eine Controller-Taste zum Nullen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Calibración de movimiento: una captura cuidadosa de varios segundos, lecturas de sensores en vivo y un botón del mando para poner a cero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Liikekalibrointi: huolellinen usean sekunnin tallennus, reaaliaikaiset anturilukemat ja ohjaimen painike nollaamiseen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir le calibrage du mouvement : une capture soignée de plusieurs secondes, des relevés de capteurs en direct et un bouton de manette pour la remise à zéro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתח כיול תנועה: לכידה זהירה של כמה שניות, קריאות חיישנים חיות ולחצן בשלט לאיפוס מחדש."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozgáskalibrálás megnyitása: gondos, több másodperces rögzítés, élő érzékelőértékek és egy vezérlőgomb az újranullázáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Kalibrasi Gerakan: penangkapan seksama selama beberapa detik, pembacaan sensor langsung, dan tombol pengontrol untuk menolkan ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Calibrazione del movimento: un’acquisizione accurata di vari secondi, letture dei sensori in tempo reale e un pulsante del controller per azzerare di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モーションのキャリブレーションを開く: 数秒間の慎重な取り込み、ライブのセンサ値、再ゼロ用のコントローラボタン。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모션 보정을 엽니다: 몇 초간의 세심한 캡처, 실시간 센서 값, 다시 0점을 맞추는 컨트롤러 버튼이 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne Bevegelseskalibrering: en nøye opptak over flere sekunder, live sensoravlesninger og en kontrollerknapp for nullstilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Bewegingskalibratie: een zorgvuldige opname van meerdere seconden, live sensorwaarden en een controllerknop om opnieuw op nul te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Kalibrację ruchu: staranne kilkusekundowe przechwycenie, odczyty czujników na żywo i przycisk kontrolera do ponownego zerowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir Calibração de movimento: uma captura cuidadosa de vários segundos, leituras de sensor ao vivo e um botão do controle para zerar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте «Калибровку движения»: аккуратный захват в несколько секунд, показания датчиков в реальном времени и кнопка контроллера для повторного обнуления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoriť Kalibráciu pohybu: starostlivé viacsekundové zachytenie, živé hodnoty senzorov a tlačidlo ovládača na opätovné vynulovanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Rörelsekalibrering: en noggrann inspelning på flera sekunder, live-sensoravläsningar och en spelkontrollknapp för nollställning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดการปรับเทียบการเคลื่อนไหว: การบันทึกอย่างระมัดระวังหลายวินาที ค่าเซนเซอร์สด และปุ่มคอนโทรลเลอร์สำหรับตั้งศูนย์ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket Kalibrasyonu’nu açın: dikkatli, birkaç saniyelik bir yakalama, canlı sensör okumaları ve yeniden sıfırlama için bir kumanda düğmesi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрити «Калібрування руху»: ретельний багатосекундний запис, показання датчиків наживо та кнопка контролера для повторного обнулення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở Hiệu chỉnh chuyển động: một lần ghi cẩn thận kéo dài vài giây, số đọc cảm biến trực tiếp và một nút bộ điều khiển để đặt lại về không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开运动校准：数秒的仔细捕获、实时传感器读数，以及用于重新校零的控制器按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「動態校準」：數秒的仔細擷取、即時感應器讀數，以及用於重新歸零的控制器按鈕。"
          }
        }
      }
    },
