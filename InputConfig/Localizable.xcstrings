            "value" : "Nakreslete na touchpad oblasti pro klepnutí; každá funguje jako tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegn tryk-områder på touchpadden; hvert virker som en knap."
          }
        },
        "de" : {
