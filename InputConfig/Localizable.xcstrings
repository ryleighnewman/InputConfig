    "Pick a color with the picker, set brightness, or run an RGB cycle on DualSense controllers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر لونًا بالمنتقي، أو اضبط السطوع، أو شغّل دورة RGB على أذرع DualSense."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte barvu výběrem, nastavte jas nebo spusťte cyklus RGB na ovladačích DualSense."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en farve med vælgeren, indstil lysstyrken, eller kør en RGB-cyklus på DualSense-controllere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle mit der Farbauswahl eine Farbe, stelle die Helligkeit ein oder starte einen RGB-Zyklus auf DualSense-Controllern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un color con el selector, ajusta el brillo o ejecuta un ciclo RGB en los mandos DualSense."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse väri valitsimella, aseta kirkkaus tai suorita RGB-kierto DualSense-ohjaimilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une couleur avec le sélecteur, réglez la luminosité ou lancez un cycle RVB sur les manettes DualSense."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר צבע בבורר, קבע בהירות, או הפעל מחזור RGB בשלטי DualSense."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon színt a színválasztóval, állítsa be a fényerőt, vagy futtasson RGB-váltást DualSense vezérlőkön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih warna dengan pemilih, atur kecerahan, atau jalankan siklus RGB pada pengontrol DualSense."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un colore con il selettore, imposta la luminosità o avvia un ciclo RGB sui controller DualSense."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カラーピッカーで色を選ぶ、明るさを設定する、またはDualSenseコントローラでRGBサイクルを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택기로 색상을 고르거나 밝기를 설정하거나, DualSense 컨트롤러에서 RGB 순환을 실행하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en farge med velgeren, angi lysstyrke eller kjør en RGB-syklus på DualSense-kontrollere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een kleur met de kleurkiezer, stel de helderheid in of laat een RGB-cyclus lopen op DualSense-controllers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz kolor selektorem, ustaw jasność albo uruchom cykl RGB na kontrolerach DualSense."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma cor com o seletor, defina o brilho ou execute um ciclo RGB em controles DualSense."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите цвет в палитре, задайте яркость или запустите цикл RGB на контроллерах DualSense."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte farbu výberom, nastavte jas alebo spustite cyklus RGB na ovládačoch DualSense."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en färg med väljaren, ställ in ljusstyrka eller kör en RGB-cykel på DualSense-kontroller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสีด้วยตัวเลือกสี ตั้งความสว่าง หรือเรียกใช้การวนสี RGB บนคอนโทรลเลอร์ DualSense"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçiciyle bir renk seçin, parlaklığı ayarlayın ya da DualSense kumandalarında bir RGB döngüsü çalıştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть колір у засобі вибору, задайте яскравість або запустіть цикл RGB на контролерах DualSense."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn màu bằng bộ chọn, đặt độ sáng, hoặc chạy chu kỳ RGB trên bộ điều khiển DualSense."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用取色器选取颜色、设置亮度，或在 DualSense 控制器上运行 RGB 循环。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用選擇器挑選顏色、設定亮度，或在 DualSense 控制器上執行 RGB 循環。"
          }
        }
      }
    },
    "Pick a connected controller for this group to read, or a model from its maker's menu to draw it as. Automatic draws the connected controller as itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ذراع تحكم متصلًا لتقرأه هذه المجموعة، أو طرازًا من قائمة شركته المصنّعة لرسمه. «تلقائي» يرسم ذراع التحكم المتصل كما هو."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte připojený ovladač, který má tato skupina číst, nebo model z nabídky výrobce, jako který se má kreslit. Automaticky kreslí připojený ovladač jako sám sebe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en forbundet controller, som denne gruppe skal læse, eller en model fra producentens menu, som den skal tegnes som. Automatisk tegner den forbundne controller som sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen verbundenen Controller, den diese Gruppe lesen soll, oder ein Modell aus dem Menü seines Herstellers, als das sie gezeichnet werden soll. „Automatisch“ zeichnet den verbundenen Controller als sich selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un mando conectado para que este grupo lo lea, o un modelo del menú de su fabricante para dibujarlo como tal. Automático dibuja el mando conectado tal como es."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse yhdistetty ohjain, jota tämä ryhmä lukee, tai malli valmistajan valikosta, jona se piirretään. Automaattinen piirtää yhdistetyn ohjaimen omana itsenään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une manette connectée que ce groupe doit lire, ou un modèle dans le menu de son fabricant pour le dessiner ainsi. Automatique dessine la manette connectée telle quelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר שלט מחובר שהקבוצה הזו תקרא, או דגם מתפריט היצרן שלו כדי לצייר אותו כך. ״אוטומטי״ מצייר את השלט המחובר כפי שהוא."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon egy csatlakoztatott vezérlőt, amelyet ez a csoport olvas, vagy egy modellt a gyártója menüjéből, amelyként megrajzolja. Az Automatikus a csatlakoztatott vezérlőt önmagaként rajzolja meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih pengontrol yang terhubung untuk dibaca grup ini, atau model dari menu pembuatnya untuk digambar sebagai. Otomatis menggambar pengontrol yang terhubung sebagai dirinya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un controller collegato che questo gruppo deve leggere, oppure un modello dal menu del suo produttore con cui disegnarlo. Automatico disegna il controller collegato com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループが読み取る接続中のコントローラ、またはそのメーカーのメニューからモデルを選んで、そのモデルとして描画します。「自動」は、接続中のコントローラをそのコントローラ自身として描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹이 읽을 연결된 컨트롤러를 고르거나, 제조사 메뉴에서 그려질 모델을 고르세요. 자동은 연결된 컨트롤러를 그 모습 그대로 그립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en tilkoblet kontroller som denne gruppen skal lese, eller en modell fra produsentens meny som den skal tegnes som. Automatisk tegner den tilkoblede kontrolleren som seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een verbonden controller die deze groep leest, of een model uit het menu van de fabrikant om de groep als dat model te tekenen. Automatisch tekent de verbonden controller als zichzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz podłączony kontroler, który ma odczytywać ta grupa, albo model z menu jego producenta, w jakim ma być rysowany. Automatycznie rysuje podłączony kontroler jako on sam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um controle conectado para este grupo ler, ou um modelo no menu do fabricante para desenhá-lo. Automático desenha o controle conectado como ele mesmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите подключённый контроллер, который будет читать эта группа, или модель из меню производителя, в виде которой её нарисовать. «Автоматически» рисует подключённый контроллер таким, какой он есть."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte pripojený ovládač, ktorý má táto skupina čítať, alebo model z ponuky jeho výrobcu, ako sa má kresliť. Automaticky nakreslí pripojený ovládač ako on sám."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en ansluten spelkontroll som den här gruppen ska läsa, eller en modell från tillverkarens meny att rita den som. Automatiskt ritar den anslutna spelkontrollen som sig själv."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกคอนโทรลเลอร์ที่เชื่อมต่อให้กลุ่มนี้อ่าน หรือรุ่นจากเมนูของผู้ผลิตเพื่อวาดเป็นรุ่นนั้น อัตโนมัติวาดคอนโทรลเลอร์ที่เชื่อมต่ออยู่เป็นรุ่นของมันเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu grubun okuyacağı bağlı bir kumanda seçin ya da çizileceği bir modeli üreticisinin menüsünden seçin. Otomatik, bağlı kumandayı kendisi olarak çizer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть підключений контролер, який зчитуватиме ця група, або модель із меню її виробника, якою його малювати. «Автоматично» малює підключений контролер таким, який він є."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một bộ điều khiển đã kết nối cho nhóm này đọc, hoặc một kiểu máy từ menu của nhà sản xuất để vẽ theo. Tự động vẽ bộ điều khiển đã kết nối đúng như chính nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此组选取要读取的已连接控制器，或从厂商菜单中选取要绘制成的型号。“自动”会将已连接的控制器绘制为其本身。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為此群組選擇要讀取的已連接控制器，或從其製造商的選單選擇要繪製的機型。「自動」會將已連接的控制器繪製成它本身。"
          }
        }
      }
    },
