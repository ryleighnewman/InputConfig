    "Higher contrast text in Settings brightens hints and status lines, and turns on with the Mac's Increase Contrast" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضيء النص عالي التباين في الإعدادات التلميحات وأسطر الحالة، ويعمل مع «زيادة التباين» في Mac"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text s vyšším kontrastem v Nastavení zesvětlí nápovědy a stavové řádky a zapíná se s volbou Zvýšit kontrast na Macu"
          }
        },
        "da" : {
          "stringUnit" : {
