          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выводы сочетаний клавиш с модификаторами (Cmd+C и подобные) теперь срабатывают как настоящие комбинации"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
