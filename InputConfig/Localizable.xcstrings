          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout s’exécute et reste sur votre Mac. Aucune télémétrie, aucun compte, rien n’est envoyé."
          }
        },
        "he" : {
