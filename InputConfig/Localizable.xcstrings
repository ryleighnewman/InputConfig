            "value" : "InputConfig побудовано на тій самій основі, що й YapToText, мій безкоштовний інструмент диктування на пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig được xây dựng trên cùng nền tảng với YapToText, công cụ đọc chính tả miễn phí trên thiết bị của tôi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
