    "%@ was disconnected after %lld minutes unused, to save its battery" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فُصلت %@ بعد %lld دقيقة دون استخدام لتوفير بطاريتها"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ byl odpojen po %lld minutách nečinnosti, aby šetřil baterii"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blev afbrudt efter %lld minutter uden brug for at spare batteri"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde nach %lld Minuten ohne Nutzung getrennt, um den Akku zu schonen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se desconectó tras %lld minutos sin uso, para ahorrar batería"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ irrotettiin %lld minuutin käyttämättömyyden jälkeen akun säästämiseksi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a été déconnectée après %lld minutes sans usage, pour économiser sa batterie"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ נותק אחרי %lld דקות ללא שימוש, כדי לחסוך בסוללה"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ leválasztva %lld perc használaton kívüliség után, hogy kímélje az akkumulátort"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ diputus setelah %lld menit tidak dipakai, untuk menghemat baterainya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato disconnesso dopo %lld minuti di inutilizzo, per risparmiare la batteria"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は%lld分間使われなかったため、バッテリー節約のため接続を解除しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리를 아끼기 위해 %lld분 동안 사용하지 않은 %@의 연결을 끊었습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ble koblet fra etter %lld minutter uten bruk for å spare batteri"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is verbroken na %lld minuten zonder gebruik, om de batterij te sparen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ rozłączono po %lld min bez użycia, aby oszczędzić baterię"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi desconectado após %lld minutos sem uso, para poupar a bateria"
          }
        },
