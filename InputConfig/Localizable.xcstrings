    "Re-read the permission after switching it on" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد قراءة الإذن بعد تشغيله"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu načíst oprávnění po jeho zapnutí"
          }
        },
