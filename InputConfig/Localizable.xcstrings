            "value" : "%@ đã được dùng để bật và tắt cài đặt sẵn gần nhất. Hãy chọn tổ hợp phím khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已用于开启和关闭上一个预设。请选择其他组合键。"
          }
        },
        "zh-Hant" : {
