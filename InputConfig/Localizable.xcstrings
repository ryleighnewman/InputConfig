        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access Controlleren tartsa nyomva a 7. foglalatot (Options). Különálló Joy-Conon tartsa nyomva a Minus vagy a Plus gombot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada Access Controller, tahan soket 7 (Options). Pada satu Joy-Con, tahan Minus atau Plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su un Access Controller, tieni premuta la presa 7 (Options). Su un singolo Joy-Con, tieni premuto Meno o Più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
