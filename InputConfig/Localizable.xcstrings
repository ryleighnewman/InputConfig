    "Regions belong to a preset. Open a preset in the editor, or run one, to add regions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي المناطق إلى إعداد مسبق. افتح إعدادًا مسبقًا في المحرر، أو شغّله، لإضافة مناطق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti patří předvolbě. Otevřete předvolbu v editoru nebo ji spusťte a přidejte oblasti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Områder hører til en forudindstilling. Åbn en forudindstilling i editoren, eller kør en, for at tilføje områder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereiche gehören zu einem Preset. Öffne ein Preset im Editor oder starte eines, um Bereiche hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las regiones pertenecen a un preajuste. Abre un preajuste en el editor, o ejecuta uno, para añadir regiones."
