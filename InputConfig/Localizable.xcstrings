    "A two-finger click on a PlayStation touchpad no longer also counts as a two-finger tap" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد الضغط بإصبعين على لوحة لمس PlayStation يُحتسب أيضًا نقرًا بإصبعين"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutí dvěma prsty na touchpad PlayStation se už nepočítá navíc i jako klepnutí dvěma prsty"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et klik med to fingre på et PlayStation-touchpad tæller ikke længere også som et tap med to fingre"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Zwei-Finger-Klick auf einem PlayStation-Touchpad zählt nicht mehr zusätzlich als Zwei-Finger-Tippen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic con dos dedos en el panel táctil de PlayStation ya no cuenta también como un toque con dos dedos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahden sormen napsautus PlayStationin kosketuslevyllä ei enää lasketa samalla kahden sormen napautukseksi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic à deux doigts sur un pavé tactile PlayStation ne compte plus aussi comme un toucher à deux doigts"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה בשתי אצבעות על משטח מגע של PlayStation כבר לא נספרת גם כהקשה בשתי אצבעות"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A PlayStation érintőpadján végzett kétujjas kattintás már nem számít egyben kétujjas koppintásnak is"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik dua jari pada touchpad PlayStation tidak lagi dihitung juga sebagai ketukan dua jari"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un clic con due dita sul touchpad PlayStation non viene più conteggiato anche come tocco con due dita"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStationのタッチパッドでの2本指クリックが、2本指タップとしても数えられることがなくなりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation 터치패드를 두 손가락으로 클릭해도 더 이상 두 손가락 탭으로 함께 인식되지 않음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tofingerklikk på en PlayStation-berøringsflate teller ikke lenger også som et tofingertrykk"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een klik met twee vingers op een PlayStation-touchpad telt niet langer ook als een tik met twee vingers"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknięcie dwoma palcami na gładziku PlayStation nie jest już liczone także jako stuknięcie dwoma palcami"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um clique com dois dedos no touchpad do PlayStation não conta mais também como um toque com dois dedos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клик двумя пальцами на тачпаде PlayStation больше не считается также касанием двумя пальцами"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknutie dvoma prstami na touchpade PlayStation sa už nepočíta aj ako ťuknutie dvoma prstami"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett tvåfingersklick på en PlayStation-pekplatta räknas inte längre också som ett tvåfingertryck"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การคลิกสองนิ้วบนทัชแพดของ PlayStation จะไม่ถูกนับเป็นการแตะสองนิ้วด้วยอีกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation dokunmatik yüzeyinde iki parmakla tıklama artık iki parmakla dokunma olarak da sayılmıyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацання двома пальцями на сенсорній панелі PlayStation більше не враховується також як торкання двома пальцями"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp hai ngón trên bàn di cảm ứng của PlayStation không còn bị tính thêm là chạm hai ngón"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 PlayStation 触摸板上双指点按，不再同时算作双指轻点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 PlayStation 觸控板上雙指按一下，不再同時算作雙指輕點"
          }
        }
      }
    },
    "A What's New popup after each update, so new features are never silently installed" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نافذة «ما الجديد» بعد كل تحديث، فلا تُثبَّت الميزات الجديدة بصمت أبدًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno Co je nového po každé aktualizaci, aby se nové funkce neinstalovaly potichu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pop-up med Nyheder efter hver opdatering, så nye funktioner aldrig installeres uden at du opdager det"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Popup „Neue Funktionen“ nach jedem Update, damit neue Funktionen nie unbemerkt installiert werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ventana emergente de Novedades tras cada actualización, para que las funciones nuevas nunca se instalen sin avisar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uutta-ikkuna jokaisen päivityksen jälkeen, jotta uusia ominaisuuksia ei koskaan asenneta huomaamatta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fenêtre Nouveautés après chaque mise à jour, pour que les nouvelles fonctionnalités ne s’installent jamais sans prévenir"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלון ״מה חדש״ אחרי כל עדכון, כדי שתכונות חדשות לא יותקנו בשקט"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Újdonságok felugró ablak minden frissítés után, hogy az új funkciók ne települjenek észrevétlenül"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popup Yang Baru setelah setiap pembaruan, sehingga fitur baru tidak pernah terpasang secara diam-diam"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un popup Novità dopo ogni aggiornamento, così le nuove funzioni non vengono mai installate in silenzio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートのたびに「新機能」ポップアップを表示し、新機能が知らないうちにインストールされることがなくなりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 후 ‘새로운 기능’ 팝업이 표시되어 새 기능이 모르는 사이에 설치되는 일이 없음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et vindu med nyheter etter hver oppdatering, slik at nye funksjoner aldri installeres i det stille"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een pop-up Wat is er nieuw na elke update, zodat nieuwe functies nooit ongemerkt worden geïnstalleerd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno Co nowego po każdej aktualizacji, aby nowe funkcje nigdy nie instalowały się po cichu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pop-up de Novidades após cada atualização, para que novos recursos nunca sejam instalados em silêncio"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
