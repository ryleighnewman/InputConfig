    "Which display the map shows. Follow the pointer switches as the pointer moves between displays." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشاشة التي تعرضها الخريطة. «اتباع المؤشر» يتبدل مع انتقال المؤشر بين الشاشات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Který displej mapa zobrazuje. Sledovat ukazatel přepíná, jak se ukazatel pohybuje mezi displeji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken skærm kortet viser. Følg markøren skifter, når markøren flytter sig mellem skærme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welches Display die Karte zeigt. „Dem Zeiger folgen“ wechselt, wenn der Zeiger zwischen Displays wandert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué pantalla muestra el mapa. Seguir el puntero cambia cuando el puntero se mueve entre pantallas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä näyttöä kartta näyttää. Seuraa osoitinta vaihtaa, kun osoitin siirtyy näyttöjen välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran que la carte affiche. Suivre le pointeur change d’écran quand le pointeur passe d’un écran à l’autre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איזו תצוגה המפה מציגה. ״עקוב אחרי המצביע״ מתחלף כשהמצביע עובר בין תצוגות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melyik kijelzőt mutatja a térkép. A Mutató követése átvált, ahogy a mutató kijelzők között mozog."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layar mana yang ditampilkan peta. Ikuti penunjuk beralih saat penunjuk berpindah antar layar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale display mostra la mappa. Segui il puntatore passa da un display all’altro quando il puntatore si sposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップに表示するディスプレイ。「ポインタに追従」は、ポインタがディスプレイ間を移動するのに合わせて切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맵에 표시할 디스플레이. ‘포인터 따라가기’는 포인터가 디스플레이 사이를 이동할 때 전환됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilken skjerm kartet viser. Følg pekeren bytter når pekeren flytter seg mellom skjermer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welk beeldscherm de kaart toont. Volg de aanwijzer schakelt mee wanneer de aanwijzer tussen beeldschermen beweegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Który wyświetlacz pokazuje mapa. Podążaj za wskaźnikiem przełącza się, gdy wskaźnik przechodzi między wyświetlaczami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual tela o mapa mostra. Seguir o ponteiro troca conforme o ponteiro passa de uma tela para outra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какой дисплей показывает карта. «Следовать за указателем» переключается, когда указатель переходит между дисплеями."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktorý displej mapa ukazuje. Nasledovať ukazovateľ prepína, keď sa ukazovateľ presúva medzi displejmi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilken skärm kartan visar. Följ pekaren byter när pekaren flyttas mellan skärmar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอแสดงผลที่แผนที่แสดง ตามตัวชี้จะสลับเมื่อตัวชี้เคลื่อนระหว่างจอแสดงผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haritanın hangi ekranı gösterdiği. İşaretçiyi takip et, işaretçi ekranlar arasında hareket ettikçe geçiş yapar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Який дисплей показує карта. «Слідувати за вказівником» перемикається, коли вказівник переходить між дисплеями."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình mà bản đồ hiển thị. Theo con trỏ sẽ chuyển khi con trỏ di chuyển giữa các màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图显示哪个显示器。“跟随指针”会随指针在显示器之间移动而切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖顯示哪個顯示器。「跟隨指標」會在指標於顯示器之間移動時切換。"
          }
        }
      }
    },
