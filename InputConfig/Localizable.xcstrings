        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוצר את המנוע ומשחרר כל מקש, לחצן ותו מוחזקים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A motor leállítása, és minden lenyomott billentyű, gomb és hang elengedése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan mesin dan lepaskan setiap tombol dan nada yang ditahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma il motore e rilascia ogni tasto, pulsante e nota tenuti premuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジンを停止し、押されているすべてのキー、ボタン、ノートを解除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진을 중지하고 눌려 있는 모든 키, 버튼, 노트를 해제합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopp motoren og slipp alle holdte taster, knapper og toner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop de engine en laat elke vastgehouden toets, knop en noot los."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymaj silnik i zwolnij każdy przytrzymany klawisz, przycisk i nutę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare o motor e solte cada tecla, botão e nota segurados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливает движок и отпускает все удерживаемые клавиши, кнопки и ноты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaví nástroj a uvoľní každý držaný kláves, tlačidlo a notu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppa motorn och släpp varje hållen tangent, knapp och ton."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดเอนจินและปล่อยทุกแป้น ปุ่ม และโน้ตที่ค้างอยู่"
