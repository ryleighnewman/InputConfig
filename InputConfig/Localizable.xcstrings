    "Some USB controllers that read nothing, because of how their descriptor numbers its reports, now work" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض أذرع التحكم عبر USB التي لم تكن تُقرأ بسبب طريقة ترقيم واصفها لتقاريرها تعمل الآن"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některé USB ovladače, které kvůli číslování hlášení ve svém deskriptoru nic nečetly, teď fungují"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle USB-controllere, der ikke læste noget på grund af, hvordan deres deskriptor nummererer rapporterne, virker nu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige USB-Controller, die wegen der Berichtsnummerierung in ihrem Deskriptor nichts lieferten, funktionieren jetzt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos mandos USB que no leían nada por cómo su descriptor numera sus informes ahora funcionan"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotkin USB-ohjaimet, jotka eivät lukeneet mitään kuvaajansa raporttinumeroinnin vuoksi, toimivat nyt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines manettes USB qui ne renvoyaient rien à cause de la numérotation des rapports de leur descripteur fonctionnent désormais"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חלק מבקרי ה-USB שלא נקראו בגלל האופן שבו המתאר שלהם ממספר את הדוחות עובדים עכשיו"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Néhány USB-vezérlő, amely a leírója jelentésszámozása miatt semmit sem olvasott, most működik"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa pengontrol USB yang tidak terbaca karena cara deskriptornya menomori laporan kini berfungsi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni controller USB che non leggevano nulla per come il loro descrittore numera i report ora funzionano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクリプタのレポート番号の付け方のせいで何も読み取れなかった一部のUSBコントローラが動作するようになりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크립터가 리포트 번호를 매기는 방식 때문에 아무것도 읽히지 않던 일부 USB 컨트롤러가 이제 작동합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen USB-kontrollere som ikke leste noe på grunn av hvordan beskrivelsen deres nummererer rapportene, virker nå"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige USB-controllers die niets lazen door hoe hun descriptor de rapporten nummert, werken nu"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre kontrolery USB, które nic nie odczytywały z powodu numeracji raportów w ich deskryptorze, teraz działają"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns controles USB que não liam nada por causa de como o descritor numera os relatórios agora funcionam"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые USB-контроллеры, которые ничего не передавали из-за нумерации отчётов в их дескрипторе, теперь работают"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektoré USB ovládače, ktoré kvôli číslovaniu hlásení vo svojom deskriptore nič nečítali, teraz fungujú"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa USB-kontroller som inte läste något på grund av hur deras deskriptor numrerar rapporterna fungerar nu"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คอนโทรลเลอร์ USB บางรุ่นที่อ่านค่าไม่ได้เพราะวิธีที่ตัวอธิบายกำหนดหมายเลขรายงาน ตอนนี้ใช้งานได้แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanımlayıcılarının raporları numaralandırma biçimi yüzünden hiçbir şey okumayan bazı USB kumandalar artık çalışıyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі USB-контролери, які нічого не передавали через нумерацію звітів у їхньому дескрипторі, тепер працюють"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số tay cầm USB trước đây không đọc được gì do cách bộ mô tả đánh số báo cáo nay đã hoạt động"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些因描述符给报告编号的方式而读不到任何内容的 USB 控制器现在可以使用了"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些因描述元給報告編號的方式而讀不到任何內容的 USB 控制器現在可以使用了"
          }
        }
      }
    },
