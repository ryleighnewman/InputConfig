          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appui active la sortie et la laisse activée. L’appui suivant la désactive."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה אחת מפעילה את הפלט ומשאירה אותו פועל. הלחיצה הבאה מכבה אותו."
