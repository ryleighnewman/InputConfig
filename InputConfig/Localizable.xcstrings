        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can still stop everything by %1$@, or by %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aun así puedes detenerlo todo con %1$@, o con %2$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit silti pysäyttää kaiken: %1$@ tai %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez toujours tout arrêter %1$@, ou %2$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר עדיין לעצור הכול באמצעות %1$@, או באמצעות %2$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindent leállíthat még így: %1$@, vagy így: %2$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda masih dapat menghentikan semuanya dengan %1$@, atau dengan %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi comunque fermare tutto con %1$@, oppure con %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@、または%2$@で、いつでもすべてを停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음으로 계속 모든 것을 중지할 수 있습니다: %1$@ 또는 %2$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fortsatt stoppe alt ved å %1$@, eller ved å %2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt nog steeds alles stoppen met %1$@, of met %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko nadal możesz zatrzymać, %1$@ lub %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda pode parar tudo %1$@ ou %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остановить всё равно можно так: %1$@ или %2$@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stále môžete všetko zastaviť pomocou %1$@ alebo pomocou %2$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan fortfarande stoppa allt genom att %1$@, eller genom att %2$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณยังหยุดทุกอย่างได้โดย %1$@ หรือ %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yine de her şeyi şunlarla durdurabilirsiniz: %1$@ veya %2$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви все одно можете зупинити все за допомогою %1$@ або %2$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn vẫn có thể dừng mọi thứ bằng %1$@, hoặc bằng %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你仍可通过 %1$@ 或 %2$@ 停止所有操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你仍可透過 %1$@ 或 %2$@ 停止一切。"
          }
        }
      }
    },
