    "Cursor regions and stick regions: fire bindings when the pointer or a stick enters a region you draw" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مناطق المؤشر ومناطق العصا: تطلق عمليات الربط عندما يدخل المؤشر أو عصا منطقة ترسمها"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti kurzoru a oblasti páčky: spouštějí přiřazení, když ukazatel nebo páčka vstoupí do oblasti, kterou nakreslíte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markørområder og stickområder: udløs tildelinger, når markøren eller en stick kommer ind i et område, du tegner"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor-Bereiche und Stick-Bereiche: Belegungen auslösen, wenn der Zeiger oder ein Stick einen von dir gezeichneten Bereich betritt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regiones del cursor y regiones del stick: activan asignaciones cuando el puntero o un stick entra en una región que dibujas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoitinalueet ja sauva-alueet: laukaise määrityksiä, kun osoitin tai sauva siirtyy piirtämääsi alueeseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zones du curseur et zones du stick : déclenchez des affectations quand le pointeur ou un stick entre dans une zone que vous dessinez"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזורי סמן ואזורי ג׳ויסטיק: מפעילים קישורים כשהמצביע או ג׳ויסטיק נכנס לאזור שציירת"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzorterületek és joystickterületek: hozzárendeléseket aktiválnak, amikor a mutató vagy a joystick belép egy Ön által rajzolt területre"
          }
        },
        "id" : {
          "stringUnit" : {
