          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวนับตลอดอายุการใช้งาน บันทึกรายวัน และประวัติต่อพรีเซ็ตจะกลับเป็นศูนย์ทั้งหมด ไม่สามารถเลิกทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaşam boyu sayaçlar, günlük kayıtlar ve ön ayar başına geçmişin tümü sıfıra dönecek. Bu geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лічильники за весь час, щоденні журнали та історія кожного пресета повернуться до нуля. Це неможливо скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ đếm trọn đời, nhật ký theo ngày và lịch sử theo từng cài đặt sẵn đều sẽ về không. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终生计数器、每日日志和每个预设的历史都将归零。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累計計數、每日記錄和各預設的歷史記錄都將歸零。此操作無法復原。"
          }
        }
      }
    },
    "Lifetime counts of presses, motion, scrolls, and MIDI events with most-used inputs and presets. All local, no telemetry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعداد إجمالية للضغطات والحركة والتمريرات وأحداث MIDI مع المدخلات والإعدادات المسبقة الأكثر استخدامًا. كلها محلية، بلا قياس عن بُعد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celoživotní počty stisků, pohybu, posunů a událostí MIDI s nejpoužívanějšími vstupy a předvolbami. Vše místně, žádná telemetrie."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tællere for hele perioden af tryk, bevægelse, rulning og MIDI-hændelser med de mest brugte input og forudindstillinger. Alt er lokalt, ingen telemetri."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtzahlen von Tastendrücken, Bewegung, Scrollen und MIDI-Ereignissen mit den meistgenutzten Eingaben und Presets. Alles lokal, keine Telemetrie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuentos totales de pulsaciones, movimiento, desplazamientos y eventos MIDI con las entradas y preajustes más usados. Todo local, sin telemetría."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painallusten, liikkeen, vierityksen ja MIDI-tapahtumien elinkaarilaskurit sekä eniten käytetyt syötteet ja esiasetukset. Kaikki paikallista, ei telemetriaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compteurs globaux des appuis, mouvements, défilements et événements MIDI, avec les entrées et préréglages les plus utilisés. Tout est local, sans télémétrie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספירות לכל החיים של לחיצות, תנועה, גלילות ואירועי MIDI, עם הקלטים והפריסטים הנפוצים ביותר. הכול מקומי, בלי טלמטריה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élettartam-számlálók a lenyomásokról, mozgásról, görgetésről és MIDI-eseményekről, a leggyakrabban használt bemenetekkel és előbeállításokkal. Mind helyi, telemetria nélkül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitungan seumur hidup untuk penekanan, gerakan, gulir, dan peristiwa MIDI dengan input dan preset yang paling sering digunakan. Semua lokal, tanpa telemetri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteggi complessivi di pressioni, movimento, scorrimenti ed eventi MIDI con gli input e i preset più usati. Tutto locale, nessuna telemetria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押下、動き、スクロール、MIDIイベントの累計回数と、よく使う入力とプリセット。すべてローカルで、テレメトリはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누르기, 움직임, 스크롤, MIDI 이벤트의 누적 횟수와 가장 많이 쓴 입력 및 프리셋. 모두 로컬에 저장되며 원격 측정은 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tellere for hele tiden for trykk, bevegelse, rulling og MIDI-hendelser med mest brukte inndata og forhåndsinnstillinger. Alt lokalt, ingen telemetri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tellingen over de hele levensduur van drukken, beweging, scrolacties en MIDI-gebeurtenissen met meestgebruikte ingangen en presets. Alles lokaal, geen telemetrie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba naciśnięć, ruchów, przewinięć i zdarzeń MIDI z całego okresu, z najczęściej używanymi wejściami i presetami. Wszystko lokalnie, bez telemetrii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contagens de todo o período de pressionamentos, movimento, rolagens e eventos MIDI, com as entradas e presets mais usados. Tudo local, sem telemetria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Счётчики нажатий, движений, прокруток и событий MIDI за всё время с самыми используемыми входами и пресетами. Всё локально, без телеметрии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počty stlačení, pohybu, posúvania a udalostí MIDI za celý čas s najpoužívanejšími vstupmi a predvoľbami. Všetko lokálne, žiadna telemetria."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livstidsantal för tryck, rörelse, rullningar och MIDI-händelser med mest använda indata och förinställningar. Allt lokalt, ingen telemetri."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนการกด การเคลื่อนที่ การเลื่อน และเหตุการณ์ MIDI ตลอดอายุการใช้งาน พร้อมอินพุตและพรีเซ็ตที่ใช้มากที่สุด ทั้งหมดอยู่ในเครื่อง ไม่มีการวัดและส่งข้อมูล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basışların, hareketin, kaydırmaların ve MIDI olaylarının yaşam boyu sayıları; en çok kullanılan girişler ve ön ayarlarla. Hepsi yerel, telemetri yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лічильники натискань, рухів, прокручувань і подій MIDI за весь час з найчастіше використовуваними входами й пресетами. Усе локально, без телеметрії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lần nhấn, chuyển động, cuộn và sự kiện MIDI trọn đời cùng các đầu vào và cài đặt sẵn dùng nhiều nhất. Tất cả đều cục bộ, không đo từ xa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下、移动、滚动和 MIDI 事件的终生计数，以及最常用的输入和预设。全部在本地，无遥测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下、移動、捲動和 MIDI 事件的累計次數，以及最常用的輸入和預設。全部在本機，沒有遙測。"
          }
        }
      }
    },
