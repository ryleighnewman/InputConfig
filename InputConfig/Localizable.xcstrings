    "Every stick row shows its deadzone, and Adjust live sets it while you watch the stick" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كل صف عصا منطقته الميتة، وتضبطها «ضبط مباشر» بينما تراقب العصا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
