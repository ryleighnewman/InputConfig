          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈으로 돌아왔습니다. 여기의 각 카드는 복사해서 내 것으로 만들 수 있는 예시를 엽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
