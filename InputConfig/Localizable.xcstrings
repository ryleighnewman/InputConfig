        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендація YapToText тепер розташована внизу екрана привітання з посиланням на App Store в одне клацання"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời giới thiệu YapToText giờ nằm ở cuối màn hình chào với liên kết App Store một cú nhấp"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎界面底部现在有 YapToText 推荐，带一键 App Store 链接"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
