    "First launch opens with a welcome and the ways to reach out" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ أول تشغيل بترحيب وطرق التواصل"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při prvním spuštění se zobrazí uvítání a způsoby, jak nás kontaktovat"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Første start åbner med en velkomst og måderne at kontakte mig på"
          }
        },
        "de" : {
