    "Inside the red ring nothing happens, so a stick that drifts at rest is ignored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داخل الحلقة الحمراء لا يحدث شيء، لذا يُتجاهل انحراف العصا وهي في وضع الراحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvnitř červeného kruhu se nic neděje, takže drift páčky v klidu se ignoruje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inden for den røde ring sker der intet, så en stick, der driver i hvile, ignoreres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innerhalb des roten Rings passiert nichts, sodass ein Stick, der in Ruhe driftet, ignoriert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro del anillo rojo no pasa nada, así que se ignora la deriva del stick en reposo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punaisen renkaan sisällä mitään ei tapahdu, joten levossa ajelehtiva sauva ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’intérieur de l’anneau rouge, rien ne se passe : la dérive du stick au repos est ignorée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתוך הטבעת האדומה לא קורה דבר, כך שהמערכת מתעלמת מסטייה של ג׳ויסטיק במנוחה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A piros gyűrűn belül nem történik semmi, így a nyugalmi helyzetben elmászó joystickot figyelmen kívül hagyja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di dalam cincin merah tidak terjadi apa pun, jadi stik yang bergeser saat diam diabaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro l’anello rosso non succede nulla, quindi la deriva dello stick a riposo viene ignorata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赤いリングの内側では何も起きないため、静止時のスティックのドリフトは無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빨간 링 안에서는 아무 일도 일어나지 않으므로, 가만히 있을 때 스틱이 흘러도 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innenfor den røde ringen skjer ingenting, så en joystick som driver i hvile, ignoreres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen de rode ring gebeurt niets, dus een stick die in rust afdrijft, wordt genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wewnątrz czerwonego pierścienia nic się nie dzieje, więc dryf drążka w spoczynku jest ignorowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro do anel vermelho nada acontece, então o desvio do stick em repouso é ignorado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутри красного кольца ничего не происходит, поэтому дрейф стика в покое игнорируется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnútri červeného kruhu sa nič nedeje, takže drift páčky v pokoji sa ignoruje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innanför den röda ringen händer ingenting, så en spak som driver i vila ignoreras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภายในวงสีแดงจะไม่มีอะไรเกิดขึ้น จึงไม่สนใจการเลื่อนของจอยสติ๊กขณะปล่อยมือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kırmızı halkanın içinde hiçbir şey olmaz; böylece dururken kayan bir çubuk yok sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усередині червоного кільця нічого не відбувається, тому дрейф джойстика в спокої ігнорується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bên trong vòng đỏ không có gì xảy ra, nên độ trôi của cần khi để yên sẽ bị bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在红色圆环内不会发生任何事，因此摇杆静止时的漂移会被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在紅色圓環內不會發生任何事，因此搖桿靜止時的漂移會被忽略。"
          }
        }
      }
    },
    "Inside the region of row %@, this row waits while that row fires." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داخل منطقة الصف %@، ينتظر هذا الصف بينما يعمل ذلك الصف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvnitř oblasti řádku %@ tento řádek čeká, zatímco se spouští ten řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inden i området for række %@ venter denne række, mens den række udløses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Bereich der Zeile %@ wartet diese Zeile, während jene Zeile auslöst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de la región de la fila %@, esta fila espera mientras se activa esa fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivin %@ alueen sisällä tämä rivi odottaa, kun tuo rivi laukeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la zone de la ligne %@, cette ligne attend pendant que cette autre ligne se déclenche."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתוך האזור של שורה %@, השורה הזו ממתינה בזמן שהשורה ההיא פועלת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@. sor területén belül ez a sor vár, amíg az a sor aktiválódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di dalam wilayah baris %@, baris ini menunggu selagi baris itu aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro la regione della riga %@, questa riga aspetta mentre si attiva quella riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行 %@ の領域の中では、その行が動作する間、この行は待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 행의 영역 안에서는 그 행이 동작하는 동안 이 행이 기다립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne i området til rad %@ venter denne raden mens den raden utløses."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binnen het gebied van rij %@ wacht deze rij terwijl die rij wordt geactiveerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W obszarze wiersza %@ ten wiersz czeka, gdy uruchamia się tamten wiersz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro da região da linha %@, esta linha espera enquanto aquela linha dispara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В области строки %@ эта строка ждёт, пока срабатывает та строка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnútri oblasti riadka %@ tento riadok čaká, kým sa spúšťa ten riadok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne i regionen för rad %@ väntar den här raden medan den raden utlöses."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในพื้นที่ของแถว %@ แถวนี้จะรอขณะที่แถวนั้นทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ satırının bölgesinde, o satır çalışırken bu satır bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У області рядка %@ цей рядок чекає, поки спрацьовує той рядок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong vùng của hàng %@, hàng này chờ trong lúc hàng kia kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在第 %@ 行的区域内，那一行触发时这一行会等待。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在第 %@ 列的區域內，那一列觸發時這一列會等待。"
          }
        }
      }
    },
