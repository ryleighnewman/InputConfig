    "Answer a few quick questions and we'll build a tailored preset for your game, app, or workflow" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن بضعة أسئلة سريعة وسننشئ إعدادًا مسبقًا مخصصًا للعبتك أو تطبيقك أو سير عملك"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovězte na pár rychlých otázek a my vytvoříme předvolbu na míru vaší hře, aplikaci nebo pracovnímu postupu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besvar et par hurtige spørgsmål, så bygger vi en skræddersyet forudindstilling til dit spil, din app eller din arbejdsgang"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte ein paar kurze Fragen, und wir erstellen ein maßgeschneidertes Preset für dein Spiel, deine App oder deinen Workflow"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde unas preguntas rápidas y crearemos un preajuste a medida para tu juego, app o flujo de trabajo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaa muutamaan nopeaan kysymykseen, niin rakennamme räätälöidyn esiasetuksen pelillesi, apillesi tai työnkulullesi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à quelques questions rapides et nous créerons un préréglage sur mesure pour votre jeu, votre app ou votre flux de travail"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ענה על כמה שאלות קצרות ונבנה פריסט מותאם למשחק, לאפליקציה או לתהליך העבודה שלך"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszoljon néhány gyors kérdésre, és személyre szabott előbeállítást készítünk a játékához, appjához vagy munkafolyamatához"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jawab beberapa pertanyaan singkat dan kami akan membuat preset yang disesuaikan untuk game, app, atau alur kerja Anda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi ad alcune domande rapide e creeremo un preset su misura per il tuo gioco, la tua app o il tuo workflow"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの簡単な質問に答えるだけで、ゲーム、App、ワークフローに合わせたプリセットを作成します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 가지 간단한 질문에 답하면 게임, 앱 또는 워크플로에 맞는 프리셋을 만들어 드립니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar på noen raske spørsmål, så bygger vi en skreddersydd forhåndsinnstilling for spillet, appen eller arbeidsflyten din"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantwoord een paar korte vragen en we maken een preset op maat voor je game, app of workflow"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedz na kilka krótkich pytań, a przygotujemy preset dopasowany do Twojej gry, aplikacji lub przepływu pracy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda a algumas perguntas rápidas e criaremos um preset sob medida para seu jogo, app ou fluxo de trabalho"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответьте на несколько вопросов, и мы создадим подходящий пресет для вашей игры, приложения или рабочего процесса"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovedzte na niekoľko rýchlych otázok a vytvoríme predvoľbu na mieru pre vašu hru, aplikáciu alebo pracovný postup"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svara på några snabba frågor så bygger vi en skräddarsydd förinställning för ditt spel, din app eller ditt arbetsflöde"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอบคำถามสั้นๆ ไม่กี่ข้อ แล้วเราจะสร้างพรีเซ็ตที่เหมาะกับเกม แอป หรือเวิร์กโฟลว์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç kısa soruyu yanıtlayın, oyununuz, uygulamanız veya iş akışınız için size özel bir ön ayar oluşturalım"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте відповідь на кілька швидких запитань, і ми створимо пресет для вашої гри, програми чи робочого процесу"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trả lời vài câu hỏi nhanh và chúng tôi sẽ tạo một cài đặt sẵn phù hợp cho trò chơi, ứng dụng hoặc quy trình của bạn"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答几个简单问题，我们会为你的游戏、App 或工作流程构建量身定制的预设"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答幾個簡單的問題，我們就會為你的遊戲、App 或工作流程建立量身打造的預設"
          }
        }
      }
    },
