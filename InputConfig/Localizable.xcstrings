    "Sets the inner deadzone for every axis binding in this joystick in one move. Individual bindings can still be fine-tuned afterwards in their Options." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط المنطقة الميتة الداخلية لكل ربط محور في عصا التحكم هذه دفعة واحدة. لا يزال بإمكان ضبط عمليات الربط الفردية بدقة لاحقًا في خياراتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví vnitřní mrtvou zónu pro všechna přiřazení os v tomto joysticku najednou. Jednotlivá přiřazení lze poté dál doladit v jejich Možnostech."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstiller den indre dødzone for hver aksetildeling i dette joystick i ét hug. Enkelte tildelinger kan stadig finjusteres bagefter i deres Valgmuligheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt die innere Totzone für jede Achsenbelegung in diesem Joystick in einem Zug fest. Einzelne Belegungen lassen sich danach in ihren Optionen weiter feinabstimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define la zona muerta interior de todas las asignaciones de eje de este joystick de una vez. Las asignaciones individuales aún se pueden ajustar después en sus Opciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa sisemmän kuolleen alueen jokaiselle tämän ohjaussauvan akselimääritykselle kerralla. Yksittäisiä määrityksiä voi silti hienosäätää jälkeenpäin niiden Valinnoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle la zone morte intérieure de chaque affectation d’axe de ce joystick en une seule fois. Les affectations individuelles peuvent ensuite être ajustées dans leurs options."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובע את האזור המת הפנימי לכל קישורי הצירים בג׳ויסטיק הזה בבת אחת. אפשר עדיין לכוונן קישורים בודדים אחר כך באפשרויות שלהם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy lépésben beállítja a belső holttért a joystick minden tengelyhozzárendeléséhez. Az egyes hozzárendelések utána még finomhangolhatók a Beállításaikban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengatur zona mati dalam untuk setiap pemetaan sumbu di joystick ini sekaligus. Pemetaan individual masih dapat disetel halus setelahnya di Opsi-nya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la zona morta interna per ogni assegnazione di asse in questo joystick in un colpo solo. Le singole assegnazioni si possono comunque affinare in seguito nelle loro Opzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このジョイスティックのすべての軸バインディングの内側のデッドゾーンを一度に設定します。個々のバインディングは、あとで「オプション」で微調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 조이스틱의 모든 축 바인딩의 내부 데드존을 한 번에 설정합니다. 개별 바인딩은 나중에 옵션에서 계속 세밀하게 조정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setter den indre dødsonen for hver aksetilordning i denne joysticken i ett grep. Enkelttilordninger kan fortsatt finjusteres etterpå i Valg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt de binnenste dode zone in voor elke astoewijzing in deze joystick in één keer. Afzonderlijke toewijzingen kunnen achteraf nog worden verfijnd in hun Opties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia wewnętrzną martwą strefę dla każdego przypisania osi w tym joysticku za jednym razem. Poszczególne przypisania można potem nadal dostroić w ich Opcjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define a zona morta interna de todos os mapeamentos de eixo deste joystick de uma vez. Os mapeamentos individuais ainda podem ser ajustados depois em suas Opções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт внутреннюю мёртвую зону для каждой привязки оси этого джойстика за один шаг. Отдельные привязки потом можно тонко настроить в их параметрах."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví vnútornú mŕtvu zónu pre každé priradenie osi v tomto joysticku naraz. Jednotlivé priradenia možno potom stále doladiť v ich Možnostiach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställer in den inre dödzonen för varje axeltilldelning i den här joysticken i ett svep. Enskilda tilldelningar kan fortfarande finjusteras efteråt i sina Alternativ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งเดดโซนด้านในสำหรับทุกการผูกแกนในจอยสติ๊กนี้ในครั้งเดียว ยังปรับละเอียดแต่ละการผูกได้ภายหลังในตัวเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu joystick’teki her eksen ataması için iç ölü bölgeyi tek hamlede ayarlar. Tek tek atamalar daha sonra Seçenekleri’nde yine ince ayarlanabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задає внутрішню мертву зону для кожної прив’язки осі в цьому джойстику одним кроком. Окремі прив’язки згодом можна точніше налаштувати в їхніх параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt vùng chết trong cho mọi mục gán trục trong cần điều khiển này trong một lần. Từng mục gán vẫn có thể tinh chỉnh sau trong Tùy chọn của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性设置此摇杆中每个轴绑定的内死区。之后仍可在各绑定的“选项”中单独微调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次為此搖桿中的每個軸綁定設定內側死區。之後仍可在各綁定的「選項」中個別微調。"
          }
        }
      }
    },
    "Sets the resting zero for the gyroscope and accelerometer so motion presets do not drift. Rest the controller on a flat surface first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط صفر السكون للجيروسكوب ومقياس التسارع حتى لا تنحرف إعدادات الحركة المسبقة. ضع ذراع التحكم على سطح مستوٍ أولًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví klidovou nulu pro gyroskop a akcelerometr, aby pohybové předvolby neujížděly. Nejdřív položte ovladač na rovný povrch."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstiller hvilenulpunktet for gyroskopet og accelerometeret, så bevægelsesforudindstillinger ikke driver. Læg først controlleren på en flad overflade."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt den Ruhenullpunkt für Gyroskop und Beschleunigungsmesser fest, damit Bewegungs-Presets nicht driften. Lege den Controller zuerst auf eine ebene Fläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define el cero de reposo del giroscopio y el acelerómetro para que los preajustes de movimiento no deriven. Deja primero el mando en reposo sobre una superficie plana."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa gyroskoopin ja kiihtyvyysmittarin lepo-nollapisteen, jotta liike-esiasetukset eivät ajaudu. Aseta ohjain ensin tasaiselle pinnalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit le zéro de repos du gyroscope et de l’accéléromètre pour que les préréglages de mouvement ne dérivent pas. Posez d’abord la manette sur une surface plane."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קובע את אפס המנוחה של הג׳יירוסקופ ומד התאוצה כדי שפריסטי תנועה לא יסחפו. הנח קודם את השלט על משטח שטוח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítja a giroszkóp és a gyorsulásmérő nyugalmi nullapontját, hogy a mozgás-előbeállítások ne sodródjanak. Előbb helyezze a vezérlőt sík felületre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengatur nol diam untuk giroskop dan akselerometer agar preset gerakan tidak drift. Letakkan pengontrol di permukaan datar terlebih dahulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta lo zero di riposo per giroscopio e accelerometro così i preset di movimento non derivano. Appoggia prima il controller su una superficie piana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャイロスコープと加速度計の静止時のゼロ点を設定し、モーションのプリセットがずれないようにします。先に、コントローラを平らな面に置いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모션 프리셋이 흐트러지지 않도록 자이로스코프와 가속도계의 기본 영점을 설정합니다. 먼저 컨트롤러를 평평한 표면에 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setter hvilenullpunktet for gyroskopet og akselerometeret slik at bevegelsesforhåndsinnstillinger ikke driver. Legg kontrolleren på en flat overflate først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt het rustnulpunt in voor de gyroscoop en versnellingsmeter zodat bewegingspresets niet afdrijven. Leg de controller eerst op een vlak oppervlak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia zero spoczynkowe dla żyroskopu i akcelerometru, aby presety ruchu nie dryfowały. Najpierw połóż kontroler na płaskiej powierzchni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define o zero de repouso do giroscópio e do acelerômetro para que os presets de movimento não derivem. Deixe o controle em uma superfície plana primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задаёт нулевое положение покоя для гироскопа и акселерометра, чтобы пресеты движения не дрейфовали. Сначала положите контроллер на ровную поверхность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastaví nulu v pokoji pre gyroskop a akcelerometer, aby predvoľby pohybu nedriftovali. Najprv položte ovládač na rovný povrch."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställer in viloläget noll för gyroskopet och accelerometern så att rörelseförinställningar inte driver. Lägg spelkontrollen på en plan yta först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งศูนย์ตอนพักของไจโรสโคปและมาตรความเร่งเพื่อไม่ให้พรีเซ็ตการเคลื่อนไหวเลื่อน วางคอนโทรลเลอร์บนพื้นผิวราบก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hareket ön ayarları kaymasın diye jiroskop ve ivmeölçer için dinlenme sıfırını ayarlar. Önce kumandayı düz bir yüzeyde dinlendirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задає нуль спокою для гіроскопа й акселерометра, щоб пресети руху не дрейфували. Спершу покладіть контролер на рівну поверхню."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt điểm không khi nghỉ cho con quay và gia tốc kế để cài đặt sẵn chuyển động không bị lệch. Hãy đặt bộ điều khiển nghỉ trên bề mặt phẳng trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置陀螺仪和加速度计的静止零点，使运动预设不会漂移。请先将控制器放在平面上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定陀螺儀和加速度計的靜止零點，讓動態預設不會漂移。請先將控制器放在平面上。"
          }
        }
      }
