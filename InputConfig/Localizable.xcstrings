    "Automatic follows System Settings. The last one picks any color." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«تلقائي» يتبع إعدادات النظام. الأخير يختار أي لون."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky se řídí Nastavením systému. Poslední volba vybere libovolnou barvu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk følger Systemindstillinger. Den sidste vælger en vilkårlig farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ folgt den Systemeinstellungen. Die letzte Option wählt eine beliebige Farbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático sigue Ajustes del Sistema. El último elige cualquier color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen seuraa Järjestelmäasetuksia. Viimeinen valitsee minkä tahansa värin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique suit les réglages Système. La dernière option permet de choisir n’importe quelle couleur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״אוטומטי״ עוקב אחרי ״הגדרות המערכת״. האחרון בוחר כל צבע."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Automatikus a Rendszerbeállításokat követi. Az utolsó bármilyen színt választhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatis mengikuti Pengaturan Sistem. Yang terakhir memilih warna apa saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico segue Impostazioni di Sistema. L’ultimo permette di scegliere qualsiasi colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は「システム設定」に従います。最後の項目では任意の色を選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘자동’은 시스템 설정을 따릅니다. 마지막 항목은 아무 색상이나 고를 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk følger Systeminnstillinger. Den siste velger hvilken som helst farge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch volgt Systeeminstellingen. De laatste kiest een willekeurige kleur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyczny kolor jest zgodny z Ustawieniami systemowymi. Ostatni pozwala wybrać dowolny kolor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático segue os Ajustes do Sistema. A última opção escolhe qualquer cor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматический режим следует «Системным настройкам». Последний вариант позволяет выбрать любой цвет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaticky sleduje Systémové nastavenia. Posledná možnosť vyberie ľubovoľnú farbu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiskt följer Systeminställningar. Den sista väljer vilken färg som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัตโนมัติจะทำตามการตั้งค่าระบบ ตัวสุดท้ายเลือกสีใดก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik, Sistem Ayarları’nı izler. Sonuncusu herhangi bir rengi seçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматичний варіант слідує налаштуванню в розділі «Системні параметри». Останній вибирає будь-який колір."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động sẽ theo Cài đặt hệ thống. Tùy chọn cuối cùng cho phép chọn bất kỳ màu nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”跟随“系统设置”。最后一个可选取任意颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會跟隨「系統設定」。最後一個可選取任何顏色。"
          }
        }
      }
    },
