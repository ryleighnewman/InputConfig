          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวชี้เคลื่อนตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmleç takip eder"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вказівник слідує"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con trỏ đi theo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指针跟随移动"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指標跟著移動"
          }
        }
      }
    },
    "The pointer is free whenever InputConfig is in front." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحرر المؤشر كلما كان InputConfig في المقدمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukazatel je volný, kdykoli je InputConfig v popředí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markøren er fri, når InputConfig er forrest."
          }
        },
        "de" : {
          "stringUnit" : {
