        }
      }
    },
    "Dragging with a controller works: holding a mapped click while moving the stick now sends real drag events, so window moves, text selection, sliders, and drag and drop all work" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السحب بذراع تحكم يعمل: إبقاء نقرة معيّنة مع تحريك العصا يرسل الآن أحداث سحب حقيقية، فيعمل نقل النوافذ وتحديد النص والمنزلقات والسحب والإفلات كلها"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tažení ovladačem funguje: podržení namapovaného kliknutí při pohybu páčky nyní odesílá skutečné události tažení, takže funguje přesun oken, výběr textu, posuvníky i přetahování"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk virker med en controller: Når du holder et tildelt klik nede, mens du flytter stikken, sendes nu rigtige trækhændelser, så flytning af vinduer, tekstmarkering, skydere og træk og slip virker"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen mit einem Controller funktioniert: Wird eine belegte Klicktaste gehalten, während du den Stick bewegst, werden jetzt echte Ziehereignisse gesendet, sodass Fenster verschieben, Text auswählen, Regler und Drag & Drop alle funktionieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastrar con un mando funciona: mantener un clic asignado mientras mueves el stick ahora envía eventos de arrastre reales, así que mover ventanas, seleccionar texto, deslizadores y arrastrar y soltar funcionan"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetäminen ohjaimella toimii: määritetyn napsautuksen pitäminen sauvaa liikutettaessa lähettää nyt oikeita vetotapahtumia, joten ikkunoiden siirto, tekstin valinta, liukusäätimet sekä vedä ja pudota toimivat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le glisser-déposer avec une manette fonctionne : maintenir un clic affecté tout en déplaçant le stick envoie désormais de vrais événements de glissement, donc le déplacement de fenêtres, la sélection de texte, les curseurs et le glisser-déposer fonctionnent tous"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרירה עם שלט עובדת: החזקת לחיצה ממופה בזמן הזזת הג׳ויסטיק שולחת עכשיו אירועי גרירה אמיתיים, ולכן הזזת חלונות, בחירת טקסט, מחוונים וגרור ושחרר כולם עובדים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vezérlővel való húzás működik: a leképezett kattintás nyomva tartása a joystick mozgatása közben mostantól valódi húzási eseményeket küld, így az ablakmozgatás, szövegkijelölés, csúszkák és a fogd és vidd mind működik"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyeret dengan pengontrol berfungsi: menahan klik yang dipetakan sambil menggerakkan stik kini mengirim peristiwa seret sungguhan, sehingga memindahkan jendela, memilih teks, penggeser, dan seret lalu lepas semuanya berfungsi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trascinamento con un controller funziona: tenendo premuto un clic assegnato mentre muovi lo stick vengono ora inviati veri eventi di trascinamento, quindi spostamento di finestre, selezione del testo, cursori e trascinamento funzionano tutti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントローラでのドラッグに対応: 割り当てたクリックを押したままスティックを動かすと、本物のドラッグイベントを送信するようになり、ウインドウの移動、テキスト選択、スライダ、ドラッグ&ドロップがすべて動作します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤러로 드래그할 수 있음: 매핑된 클릭을 누른 채 스틱을 움직이면 이제 실제 드래그 이벤트를 보내므로 윈도우 이동, 텍스트 선택, 슬라이더, 드래그 앤 드롭이 모두 작동함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra med en kontroller fungerer: å holde et tilordnet klikk mens du flytter joysticken sender nå ekte dra-hendelser, så flytting av vinduer, tekstvalg, glidere og dra og slipp fungerer alle"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slepen met een controller werkt: een toegewezen klik ingedrukt houden terwijl je de stick beweegt, stuurt nu echte sleepgebeurtenissen, zodat vensters verplaatsen, tekst selecteren, schuifregelaars en slepen en neerzetten allemaal werken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciąganie kontrolerem działa: przytrzymanie przypisanego kliknięcia podczas ruchu drążkiem wysyła teraz prawdziwe zdarzenia przeciągania, więc przesuwanie okien, zaznaczanie tekstu, suwaki oraz przeciągnij i upuść działają"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastar com um controle funciona: segurar um clique mapeado enquanto move o stick agora envia eventos de arrasto reais, então mover janelas, selecionar texto, controles deslizantes e arrastar e soltar funcionam"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивание с контроллера работает: удержание назначенного клика при движении стика теперь отправляет настоящие события перетаскивания, поэтому перемещение окон, выделение текста, ползунки и drag and drop работают"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťahanie ovládačom funguje: podržanie namapovaného kliknutia počas pohybu páčky teraz posiela skutočné udalosti ťahania, takže presúvanie okien, výber textu, posuvníky a drag and drop fungujú"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att dra med en spelkontroll fungerar: att hålla ett mappat klick medan du rör spaken skickar nu riktiga dragningshändelser, så fönsterflyttning, textmarkering, reglage och dra och släpp fungerar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การลากด้วยคอนโทรลเลอร์ใช้งานได้: การกดคลิกที่แมปไว้ค้างขณะขยับจอยสติ๊กจะส่งเหตุการณ์ลากจริง การย้ายหน้าต่าง การเลือกข้อความ แถบเลื่อน และการลากแล้ววางจึงใช้งานได้ทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumandayla sürükleme çalışıyor: atanmış bir tıklamayı basılı tutarken çubuğu hareket ettirmek artık gerçek sürükleme olayları gönderiyor; böylece pencere taşıma, metin seçme, sürgüler ve sürükle ve bırak çalışıyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягування контролером працює: утримання призначеного клацання під час руху джойстика тепер надсилає справжні події перетягування, тож переміщення вікон, виділення тексту, повзунки й перетягування працюють"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo bằng bộ điều khiển đã hoạt động: giữ một lần nhấp đã ánh xạ trong khi di chuyển cần giờ gửi sự kiện kéo thật, nên di chuyển cửa sổ, chọn văn bản, thanh trượt, và kéo thả đều hoạt động"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在可用控制器拖移：移动摇杆时按住已映射的点按，会发送真实的拖移事件，因此移动窗口、选择文本、滑块以及拖放都能正常工作"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在可以用控制器拖移：按住已對應的點按並移動搖桿時，會送出真正的拖移事件，因此移動視窗、選取文字、滑桿以及拖放都能運作"
          }
        }
      }
    },
