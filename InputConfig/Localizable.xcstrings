    "Keeps the pointer away from the screen edges, so the menu bar, the Dock and hot corners are out of reach" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبعد المؤشر عن حواف الشاشة، فيصبح شريط القوائم وDock والزوايا النشطة بعيدة المنال"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drží ukazatel mimo okraje obrazovky, takže řádek nabídek, Dock a aktivní rohy jsou mimo dosah"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder markøren væk fra skærmkanterne, så menulinjen, Dock og aktive hjørner er uden for rækkevidde"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält den Zeiger von den Bildschirmrändern fern, sodass Menüleiste, Dock und Hot Corners außer Reichweite sind"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene el puntero lejos de los bordes de la pantalla, así que la barra de menús, el Dock y las esquinas activas quedan fuera de alcance"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitää osoittimen poissa näytön reunoilta, joten valikkorivi, Dock ja aktiiviset kulmat ovat ulottumattomissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éloigne le pointeur des bords de l’écran, de sorte que la barre des menus, le Dock et les coins actifs sont hors d’atteinte"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מרחיק את המצביע מקצוות המסך, כך ששורת התפריטים, ה-Dock והפינות הפעילות מחוץ להישג יד"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Távol tartja a mutatót a képernyő szélétől, így a menüsor, a Dock és az aktív sarkok elérhetetlenek"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjauhkan penunjuk dari tepi layar, sehingga bar menu, Dock, dan sudut aktif tidak terjangkau"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene il puntatore lontano dai bordi dello schermo, quindi barra dei menu, Dock e angoli attivi sono fuori portata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタを画面の端に近づけないため、メニューバー、Dock、ホットコーナーには届きません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터가 화면 가장자리에 가지 못하게 하므로 메뉴 막대, Dock, 핫 코너에 닿을 수 없습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holder pekeren unna skjermkantene, så menylinjen, Dock og aktive hjørner er utenfor rekkevidde"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houdt de aanwijzer weg van de schermranden, zodat de menubalk, het Dock en hotcorners buiten bereik zijn"
