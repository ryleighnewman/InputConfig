        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備好後點按「啟用」，控制器就會照預設行事。再次點按即可停止。"
          }
        }
      }
    },
    "Click Add Region, then drag on the bar, or choose Place in Center and type its range." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر «إضافة منطقة» ثم اسحب على الشريط، أو اختر «وضع في المركز» واكتب نطاقها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikněte na Přidat oblast, pak táhněte po pruhu, nebo zvolte Umístit do středu a zadejte jeho rozsah."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på Tilføj område, og træk på bjælken, eller vælg Placér i midten og skriv dens interval."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Bereich hinzufügen“ und ziehe dann auf der Leiste, oder wähle „In der Mitte platzieren“ und gib den Bereich ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Añadir región y arrastra sobre la barra, o elige Colocar en el centro y escribe su rango."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napsauta Lisää alue ja vedä sitten palkissa tai valitse Aseta keskelle ja kirjoita sen väli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Ajouter une zone, puis faites glisser sur la barre, ou choisissez Placer au centre et saisissez sa plage."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ על ״הוסף אזור״, ואז גרור על הסרגל, או בחר ״מקם במרכז״ והקלד את הטווח שלו."
          }
        },
        "hu" : {
