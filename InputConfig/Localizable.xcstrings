{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\nand %lld more; open it in the editor to see them all." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nو%lld أخرى؛ افتحه في المحرر لرؤيتها كلها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\na dalších: %lld; všechny uvidíte po otevření v editoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nog %lld flere. Åbn den i editoren for at se dem alle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nund %lld weitere; öffne es im Editor, um alle zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\ny %lld más; ábrelo en el editor para verlos todos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nja %lld muuta; avaa se muokkaimessa nähdäksesi kaikki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\net %lld de plus ; ouvrez-le dans l’éditeur pour tout voir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nועוד %lld; פתח אותו בעורך כדי לראות את כולם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nés még %lld; nyissa meg a szerkesztőben, hogy mindet lássa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\ndan %lld lainnya; buka di editor untuk melihat semuanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\ne altri %lld; aprilo nell’editor per vederli tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nほか%lld件。エディタで開くとすべて確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n외 %lld개 더 있습니다. 편집기에서 열어 모두 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nog %lld til; åpne den i editoren for å se alle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nen nog %lld; open het in de editor om ze allemaal te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\ni jeszcze %lld; otwórz w edytorze, aby zobaczyć wszystkie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\ne mais %lld; abra-o no editor para ver todos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nи ещё %lld; откройте это в редакторе, чтобы увидеть все."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\na ďalšie: %lld. Otvorte ich v editore a zobrazíte všetky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\noch %lld till. Öppna den i redigeraren för att se alla."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nและอีก %lld รายการ เปิดในตัวแก้ไขเพื่อดูทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nve %lld tane daha; hepsini görmek için düzenleyicide açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nта ще %lld; відкрийте його в редакторі, щоб побачити всі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nvà %lld mục khác; hãy mở trong trình chỉnh sửa để xem tất cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n还有 %lld 项；在编辑器中打开即可查看全部。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n還有 %lld 個；請在編輯器中開啟以查看全部。"
          }
        }
      }
    },
