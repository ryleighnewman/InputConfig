        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤러 길게 누르기로 중지되었습니다. 프리셋을 다시 시작하려면 다시 길게 누르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppet av kontrollerholdet. Hold den igjen for å starte forhåndsinnstillingen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
