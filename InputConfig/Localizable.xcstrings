          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend chaque défilement de ce préréglage plus rapide ou plus lent. ×1,00 correspond au réglage de chaque ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאיץ או מאט כל גלילה בפריסט הזה. ‎×1.00 הוא כפי שכל שורה מוגדרת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyorsabbá vagy lassabbá teszi az előbeállítás minden görgetését. A ×1,00 az, ahogy az egyes sorok be vannak állítva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat setiap gulir dalam preset ini lebih cepat atau lebih lambat. ×1.00 sesuai pengaturan setiap baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende più veloce o più lento ogni scorrimento in questo preset. ×1,00 corrisponde all’impostazione di ogni riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプリセット内のすべてのスクロールを速く、または遅くします。×1.00は各行の設定どおりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프리셋의 모든 스크롤을 더 빠르거나 느리게 합니다. ×1.00은 각 행에 설정된 값 그대로입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør hver rulling i denne forhåndsinnstillingen raskere eller tregere. ×1,00 er slik hver rad er satt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt elke scrolbeweging in deze preset sneller of langzamer. ×1,00 is zoals elke rij is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyspiesza lub spowalnia każde przewijanie w tym presecie. ×1.00 oznacza ustawienie każdego wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa cada rolagem neste preset mais rápida ou mais lenta. ×1,00 é como cada linha está definida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускоряет или замедляет каждую прокрутку в этом пресете. ×1.00 означает, как задано в каждой строке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrýchli alebo spomalí každé posúvanie v tejto predvoľbe. ×1,00 je tak, ako je nastavený každý riadok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör varje rullning i den här förinställningen snabbare eller långsammare. ×1,00 är som varje rad är inställd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้ทุกการเลื่อนในพรีเซ็ตนี้เร็วขึ้นหรือช้าลง ×1.00 คือตามที่ตั้งไว้ในแต่ละแถว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ön ayardaki her kaydırmayı daha hızlı veya yavaş yapar. ×1,00, her satırın ayarlandığı gibidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робить кожне прокручування в цьому пресеті швидшим або повільнішим. ×1.00 означає, як налаштовано кожен рядок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mọi lần cuộn trong cài đặt sẵn này nhanh hơn hoặc chậm hơn. ×1.00 là như mỗi hàng đã đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让此预设中的每次滚动更快或更慢。×1.00 表示按各行的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓此預設中的所有捲動變快或變慢。×1.00 表示維持每列的設定。"
          }
        }
      }
    },
