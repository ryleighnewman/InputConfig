    "Editing a preset while it is running now takes effect straight away, instead of waiting for a restart" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديل إعداد مسبق أثناء تشغيله يسري الآن فورًا، بدل انتظار إعادة التشغيل"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úpravy předvolby za běhu se nyní projeví okamžitě, bez čekání na restart"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigering af en forudindstilling, mens den kører, træder nu i kraft med det samme i stedet for først efter en genstart"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bearbeiten eines laufenden Presets wirkt jetzt sofort, statt auf einen Neustart zu warten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar un preajuste mientras está en marcha ahora surte efecto de inmediato, en lugar de esperar a un reinicio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnissä olevan esiasetuksen muokkaus tulee nyt voimaan heti eikä vasta uudelleenkäynnistyksen jälkeen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier un préréglage pendant son exécution prend désormais effet immédiatement, sans attendre un redémarrage"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עריכת פריסט בזמן שהוא פועל נכנסת עכשיו לתוקף מיד, במקום להמתין להפעלה מחדש"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A futó előbeállítás szerkesztése mostantól azonnal érvénybe lép, nem kell újraindításra várni"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengedit preset saat berjalan kini berlaku langsung, tanpa menunggu mulai ulang"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificare un preset mentre è in esecuzione ora ha effetto subito, senza attendere un riavvio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のプリセットを編集すると、再起動を待たずにすぐに反映されるようになりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행 중인 프리셋을 편집하면 이제 다시 시작할 때까지 기다리지 않고 바로 적용됨"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigering av en forhåndsinnstilling mens den kjører, trer nå i kraft med en gang i stedet for å vente på en omstart"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wijzigen van een preset terwijl die draait, werkt nu direct, in plaats van op een herstart te wachten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edycja działającego presetu działa teraz od razu, zamiast czekać na ponowne uruchomienie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar um preset enquanto ele está em execução agora tem efeito imediato, em vez de esperar uma reinicialização"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения пресета во время его работы теперь вступают в силу сразу, без перезапуска"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úprava predvoľby počas behu sa teraz prejaví okamžite, bez čakania na reštart"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att redigera en förinställning medan den körs får nu effekt direkt, i stället för att vänta på en omstart"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแก้ไขพรีเซ็ตขณะที่ทำงานอยู่มีผลทันทีแล้ว แทนที่จะรอเริ่มใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
