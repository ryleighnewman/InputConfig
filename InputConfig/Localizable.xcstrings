        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stick met vier ringgebieden die om de beurt oplichten, een trigger met twee banden en een gebaar van twee flicks naar achteren"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drążek z czterema obszarami pierścieniowymi zapalającymi się po kolei, spust z dwoma pasmami i gest z dwóch machnięć do tyłu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um stick com quatro regiões em anel acendendo em sequência, um gatilho com duas faixas e um gesto de dois flicks para trás"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стик с четырьмя кольцевыми областями, загорающимися по очереди, триггер с двумя полосами и жест из двух рывков назад"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páčka so štyrmi prstencovými oblasťami, ktoré sa rozsvecujú postupne, spúšť s dvoma pásmami a gesto z dvoch švihnutí dozadu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En spak med fyra ringregioner som lyser i tur och ordning, en avtryckare med två band och en gest med två ryck bakåt"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอยสติ๊กที่มีพื้นที่วงแหวนสี่พื้นที่สว่างทีละพื้นที่ ทริกเกอร์ที่มีสองช่วง และท่าทางที่ดีดถอยหลังสองครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırayla yanan dört halka bölgeli bir çubuk, iki bantlı bir tetik ve iki kez geriye fiskeden oluşan bir jest"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джойстик із чотирма кільцевими областями, що світяться по черзі, тригер із двома смугами та жест із двох ривків назад"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một cần với bốn vùng vòng sáng lên lần lượt, một cò với hai dải, và một cử chỉ gồm hai cú hất về phía sau"
