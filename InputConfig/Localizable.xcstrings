    "−" : {

    },
    "0 degrees is right and 90 is up; the ring runs counterclockwise from From to To. The same From and To make a whole ring." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏0 درجة هي اليمين و90 هي الأعلى؛ تمتد الحلقة عكس اتجاه عقارب الساعة من «من» إلى «إلى». إذا تطابقت قيمتا «من» و«إلى» تكوّنت حلقة كاملة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 stupňů je vpravo a 90 je nahoru; prstenec se táhne proti směru hodinových ručiček od hodnoty „Od“ do hodnoty „Do“. Stejné hodnoty „Od“ a „Do“ dají celý prstenec."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 grader er til højre og 90 er op. Ringen løber mod uret fra Fra til Til. Samme Fra og Til giver en hel ring."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 Grad ist rechts und 90 ist oben; der Ring verläuft gegen den Uhrzeigersinn von „Von“ bis „Bis“. Gleiche Werte bei „Von“ und „Bis“ ergeben einen ganzen Ring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 grados es la derecha y 90 es arriba; el anillo va en sentido antihorario de Desde a Hasta. Si Desde y Hasta son iguales, el anillo es completo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 astetta on oikealla ja 90 on ylhäällä; rengas kulkee vastapäivään kohdasta Alku kohtaan Loppu. Jos Alku ja Loppu ovat samat, rengas on kokonainen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 degré correspond à la droite et 90 au haut ; l’anneau tourne dans le sens inverse des aiguilles d’une montre de De à À. Un même De et À donnent un anneau complet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏0 מעלות הוא ימין ו-90 הוא למעלה; הטבעת נעה נגד כיוון השעון מ״התחלה״ עד ״סיום״. אותם ערכי התחלה וסיום יוצרים טבעת שלמה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 0 fok jobbra, a 90 fok felfelé van; a gyűrű az óramutató járásával ellentétesen halad a Kezdet és a Vég között. Azonos Kezdet és Vég teljes gyűrűt ad."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 derajat adalah kanan dan 90 adalah atas; cincin berjalan berlawanan arah jarum jam dari Dari ke Hingga. Dari dan Hingga yang sama membentuk cincin utuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 gradi è destra e 90 è su; l’anello procede in senso antiorario da Da ad A. Se Da e A sono uguali, l’anello è completo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0度は右、90度は上です。リングは「開始」から「終了」まで反時計回りに続きます。開始と終了が同じなら、リング全体になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0도는 오른쪽, 90도는 위쪽입니다. 링은 시작부터 끝까지 반시계 방향으로 이어집니다. 시작과 끝이 같으면 링 전체가 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 grader er mot høyre og 90 er opp. Ringen går mot klokken fra Fra til Til. Samme Fra og Til gir en hel ring."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 graden is rechts en 90 is omhoog; de ring loopt tegen de klok in van Van naar Tot. Als Van en Tot gelijk zijn, is het een hele ring."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 stopni to prawo, a 90 to góra. Pierścień biegnie przeciwnie do ruchu wskazówek zegara od wartości „Od” do wartości „Do”. Takie same wartości „Od” i „Do” dają cały pierścień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 grau é a direita e 90 é para cima; o anel segue no sentido anti-horário de De até Até. Se De e Até forem iguais, o anel é completo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 градусов это вправо, 90 это вверх; кольцо идет против часовой стрелки от значения «От» до значения «До». Одинаковые «От» и «До» дают полное кольцо."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 stupňov je vpravo a 90 je nahor; prstenec sa ťahá proti smeru hodinových ručičiek od hodnoty „Od“ po hodnotu „Do“. Rovnaké hodnoty „Od“ a „Do“ dajú celý prstenec."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 grader är åt höger och 90 är uppåt. Ringen går moturs från Från till Till. Samma Från och Till ger en hel ring."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 องศาคือทางขวาและ 90 คือขึ้นบน วงแหวนวนทวนเข็มนาฬิกาจากจุดเริ่มถึงจุดสิ้นสุด ถ้าจุดเริ่มกับจุดสิ้นสุดเหมือนกันจะได้วงแหวนเต็มวง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 derece sağ, 90 derece yukarıdır; halka Başlangıç değerinden Bitiş değerine saat yönünün tersine uzanır. Başlangıç ve Bitiş aynı olursa tam bir halka oluşur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 градусів це праворуч, 90 це вгору; кільце йде проти годинникової стрілки від значення «Від» до значення «До». Однакові «Від» і «До» дають повне кільце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 độ là bên phải và 90 là hướng lên; vòng chạy ngược chiều kim đồng hồ từ Từ đến Đến. Từ và Đến giống nhau sẽ tạo thành cả vòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 度为右，90 度为上；圆环沿逆时针方向从起点延伸到终点。起点与终点相同则为整圈圆环。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 度為右，90 度為上；圓環沿逆時針方向從起點延伸到終點。起點與終點相同則為整圈圓環。"
          }
        }
      }
    },
