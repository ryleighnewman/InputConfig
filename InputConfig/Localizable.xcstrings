    "This input device reads its controller by this name. A new name reads the controller in its own slot instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ جهاز الإدخال هذا ذراع التحكم الخاص به بهذا الاسم. أما الاسم الجديد فيقرأ ذراع التحكم في خانته الخاصة بدلًا من ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto vstupní zařízení čte svůj ovladač podle tohoto názvu. Nový název místo toho čte ovladač v jeho vlastním slotu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne inputenhed læser sin controller ud fra dette navn. Et nyt navn læser i stedet controlleren på dens egen plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Eingabegerät liest seinen Controller anhand dieses Namens. Ein neuer Name liest den Controller stattdessen in seinem eigenen Slot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo de entrada lee su mando por este nombre. Un nombre nuevo lee el mando en su propia ranura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä syöttölaite lukee ohjaintaan tällä nimellä. Uusi nimi lukee ohjaimen sen omassa paikassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce périphérique d’entrée lit sa manette grâce à ce nom. Un nouveau nom lit à la place la manette dans son propre emplacement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התקן הקלט הזה קורא את השלט שלו לפי השם הזה. שם חדש קורא את השלט בחריץ משלו במקום זאת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a beviteli eszköz ezen a néven olvassa a vezérlőjét. Egy új név ehelyett a vezérlőt a saját helyén olvassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat input ini membaca pengontrolnya dengan nama ini. Nama baru membaca pengontrol di slotnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo di input legge il suo controller con questo nome. Un nome nuovo legge il controller nel suo slot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この入力デバイスは、この名前でコントローラを読み取ります。新しい名前にすると、コントローラは専用のスロットで読み取られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 입력 기기는 이 이름으로 컨트롤러를 읽습니다. 새 이름을 지정하면 컨트롤러를 자체 슬롯에서 읽습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne inndataenheten leser kontrolleren sin med dette navnet. Et nytt navn leser kontrolleren i sin egen plass i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit invoerapparaat leest zijn controller onder deze naam. Een nieuwe naam leest de controller in plaats daarvan in een eigen slot."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie wejściowe odczytuje swój kontroler pod tą nazwą. Nowa nazwa odczytuje kontroler we własnym gnieździe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo de entrada lê o controle com este nome. Um novo nome lê o controle em um slot próprio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это устройство ввода считывает свой контроллер под этим именем. При новом имени контроллер считывается в отдельном слоте."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto vstupné zariadenie číta svoj ovládač pod týmto názvom. Nový názov číta ovládač vo vlastnom slote."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här indataenheten läser sin spelkontroll med det här namnet. Ett nytt namn läser i stället spelkontrollen på dess egen plats."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์อินพุตนี้อ่านคอนโทรลเลอร์ด้วยชื่อนี้ ชื่อใหม่จะอ่านคอนโทรลเลอร์ในช่องของตัวเองแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu giriş aygıtı kumandasını bu adla okur. Yeni bir ad, kumandayı bunun yerine kendi yuvasında okur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей пристрій введення зчитує свій контролер за цією назвою. Нова назва натомість зчитує контролер у власному слоті."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị đầu vào này đọc bộ điều khiển của nó theo tên này. Tên mới sẽ đọc bộ điều khiển trong ô riêng của nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此输入设备按此名称读取其控制器。新名称则改为在其自己的槽位中读取该控制器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此輸入裝置以此名稱讀取其控制器。新名稱則改為在其自己的欄位中讀取該控制器。"
          }
        }
      }
    },
    "This is a touchpad input. Auto-map sends mouse motion in the matching direction. If your touchpad hasn't been calibrated yet, calibrating first will make the cursor speed feel right." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا مدخل لوحة لمس. يرسل التعيين التلقائي حركة الماوس في الاتجاه المطابق. إذا لم تُعايَر لوحة اللمس بعد، فستجعل المعايرة أولًا سرعة المؤشر مناسبة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je vstup touchpadu. Automatické mapování odesílá pohyb myši ve stejném směru. Pokud touchpad ještě nebyl kalibrován, nejdřív kalibrace zajistí správnou rychlost kurzoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er et touchpad-input. Auto-tildel sender musebevægelse i den tilsvarende retning. Hvis din touchpad ikke er kalibreret endnu, vil kalibrering først få markørhastigheden til at føles rigtig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist eine Touchpad-Eingabe. „Automatisch zuordnen“ sendet Mausbewegung in die passende Richtung. Wurde dein Touchpad noch nicht kalibriert, fühlt sich die Cursorgeschwindigkeit nach dem Kalibrieren richtig an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es una entrada de panel táctil. Asignar automáticamente envía movimiento del ratón en la dirección correspondiente. Si tu panel táctil aún no se ha calibrado, calibrarlo primero hará que la velocidad del cursor se sienta bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on kosketuslevysyöte. Automaattinen kohdistus lähettää hiiren liikkeen vastaavaan suuntaan. Jos kosketuslevyä ei ole vielä kalibroitu, kalibrointi ensin saa osoittimen nopeuden tuntumaan oikealta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est une entrée de pavé tactile. Le mappage automatique envoie le mouvement de la souris dans la direction correspondante. Si votre pavé tactile n’a pas encore été calibré, le calibrer d’abord rendra la vitesse du curseur plus naturelle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה קלט של משטח מגע. מיפוי אוטומטי שולח תנועת עכבר בכיוון המתאים. אם משטח המגע עדיין לא כויל, כיול קודם יגרום למהירות הסמן להרגיש נכונה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez érintőpad-bemenet. Az automatikus leképezés egérmozgást küld a megfelelő irányba. Ha az érintőpad még nincs kalibrálva, az előzetes kalibrálás megfelelővé teszi a kurzor sebességét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah input touchpad. Peta otomatis mengirim gerakan tetikus ke arah yang sesuai. Jika touchpad Anda belum dikalibrasi, mengkalibrasi terlebih dahulu membuat kecepatan kursor terasa pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è un input del touchpad. Mappa automatica invia il movimento del mouse nella direzione corrispondente. Se il touchpad non è ancora stato calibrato, calibrarlo prima farà sentire giusta la velocità del cursore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはタッチパッドの入力です。自動マップは、対応する方向にマウスの動きを送信します。タッチパッドをまだキャリブレーションしていない場合は、先にキャリブレーションすると、カーソルの速度が適切に感じられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 터치패드 입력입니다. 자동 매핑은 마우스 움직임을 같은 방향으로 보냅니다. 터치패드가 아직 보정되지 않았다면 먼저 보정해야 커서 속도가 알맞게 느껴집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en berøringsflateinndata. Automatisk tilordning sender musebevegelse i tilsvarende retning. Hvis berøringsflaten ikke er kalibrert ennå, vil kalibrering først gjøre at pekerhastigheten føles riktig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een touchpadingang. Auto-toewijzen stuurt muisbeweging in de bijbehorende richting. Als je touchpad nog niet is gekalibreerd, voelt de cursorsnelheid goed aan als je eerst kalibreert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jest wejście gładzika. Automapowanie wysyła ruch myszy w odpowiednim kierunku. Jeśli gładzik nie został jeszcze skalibrowany, najpierw skalibruj go, aby prędkość kursora była odpowiednia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é uma entrada de touchpad. O mapeamento automático envia movimento do mouse na direção correspondente. Se o touchpad ainda não foi calibrado, calibrá-lo primeiro deixará a velocidade do cursor mais natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это вход тачпада. Автоназначение отправляет движение мыши в соответствующем направлении. Если тачпад ещё не откалиброван, сначала откалибруйте его, чтобы скорость курсора ощущалась правильно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je vstup touchpadu. Automatické mapovanie posiela pohyb myši v zodpovedajúcom smere. Ak touchpad ešte nie je kalibrovaný, jeho kalibrácia najprv zabezpečí správny pocit z rýchlosti kurzora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är en pekplatteindata. Automappa skickar musrörelse i motsvarande riktning. Om din pekplatta inte har kalibrerats än får du rätt känsla för markörhastigheten om du kalibrerar först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คืออินพุตทัชแพด แมปอัตโนมัติส่งการเคลื่อนเมาส์ในทิศทางที่ตรงกัน หากยังไม่ได้ปรับเทียบทัชแพด การปรับเทียบก่อนจะทำให้ความเร็วเคอร์เซอร์รู้สึกถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir dokunmatik yüzey girişidir. Otomatik eşleme, fare hareketini eşleşen yönde gönderir. Dokunmatik yüzeyiniz henüz kalibre edilmediyse önce kalibre etmek imleç hızının doğru hissettirmesini sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це вхід сенсорної панелі. Автоперетворення надсилає рух миші у відповідному напрямку. Якщо вашу сенсорну панель ще не відкалібровано, спершу калібрування зробить швидкість курсора комфортною."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là đầu vào bàn di cảm ứng. Tự ánh xạ gửi chuyển động chuột theo hướng tương ứng. Nếu bàn di cảm ứng của bạn chưa được hiệu chỉnh, hiệu chỉnh trước sẽ làm tốc độ con trỏ có cảm giác đúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是触摸板输入。“自动映射”会向对应方向发送鼠标移动。如果触摸板尚未校准，先校准可让光标速度手感合适。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是觸控板輸入。「自動對應」會朝相符的方向送出滑鼠移動。如果你的觸控板尚未校準，先校準會讓游標速度感覺更合適。"
          }
        }
      }
    },
    "This is a whole InputConfig backup, not a preset. A backup replaces settings and adds presets without review, so restore only one you made yourself, in Settings, Advanced, Restore from Backup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه نسخة احتياطية كاملة من InputConfig، وليست إعدادًا مسبقًا. تستبدل النسخة الاحتياطية الإعدادات وتضيف إعدادات مسبقة دون مراجعة، فلا تستعد إلا نسخة أنشأتها بنفسك، في الإعدادات، متقدم، استعادة من نسخة احتياطية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je celá záloha InputConfig, ne předvolba. Záloha nahradí nastavení a přidá předvolby bez kontroly, proto obnovujte jen tu, kterou jste vytvořili sami, v Nastavení, Pokročilé, Obnovit ze zálohy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en hel InputConfig-backup, ikke en forudindstilling. En backup erstatter indstillinger og tilføjer forudindstillinger uden gennemgang, så gendan kun en, du selv har lavet, i Indstillinger, Avanceret, Gendan fra backup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein vollständiges InputConfig-Backup, kein Preset. Ein Backup ersetzt Einstellungen und fügt Presets ohne Prüfung hinzu, stelle daher nur eines wieder her, das du selbst erstellt hast, in „Einstellungen“ > „Erweitert“ > „Aus Backup wiederherstellen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es una copia de seguridad completa de InputConfig, no un preajuste. Una copia de seguridad sustituye los ajustes y añade preajustes sin revisión, así que restaura solo una que hayas hecho tú, en Ajustes, Avanzado, Restaurar desde copia de seguridad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä on kokonainen InputConfig-varmuuskopio, ei esiasetus. Varmuuskopio korvaa asetukset ja lisää esiasetuksia ilman tarkistusta, joten palauta vain itse tekemäsi, kohdassa Asetukset, Lisäasetukset, Palauta varmuuskopiosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit d’une sauvegarde complète d’InputConfig, pas d’un préréglage. Une sauvegarde remplace les réglages et ajoute des préréglages sans vérification, donc ne restaurez qu’une sauvegarde que vous avez créée vous-même, dans Réglages, Avancé, Restaurer depuis une sauvegarde."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה גיבוי שלם של InputConfig, לא פריסט. גיבוי מחליף הגדרות ומוסיף פריסטים בלי סקירה, ולכן שחזר רק גיבוי שיצרת בעצמך, ב״הגדרות״, ״מתקדם״, ״שחזר מגיבוי״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez egy teljes InputConfig-mentés, nem előbeállítás. A mentés felülvizsgálat nélkül cseréli a beállításokat és ad hozzá előbeállításokat, ezért csak saját magának készítettet állítson vissza, a Beállítások, Speciális, Visszaállítás mentésből részen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah cadangan InputConfig lengkap, bukan preset. Cadangan menggantikan pengaturan dan menambahkan preset tanpa tinjauan, jadi pulihkan hanya yang Anda buat sendiri, di Pengaturan, Lanjutan, Pulihkan dari Cadangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è un backup completo di InputConfig, non un preset. Un backup sostituisce le impostazioni e aggiunge preset senza revisione, quindi ripristina solo uno creato da te, in Impostazioni, Avanzate, Ripristina da backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはInputConfig全体のバックアップで、プリセットではありません。バックアップは、確認なしで設定を置き換え、プリセットを追加します。ご自身で作成したものだけを、「設定」>「詳細」>「バックアップから復元」で復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 전체 InputConfig 백업이며 프리셋이 아닙니다. 백업은 검토 없이 설정을 바꾸고 프리셋을 추가하므로, 직접 만든 백업만 설정 > 고급 > 백업에서 복원에서 복원하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en hel InputConfig-sikkerhetskopi, ikke en forhåndsinnstilling. En sikkerhetskopi erstatter innstillinger og legger til forhåndsinnstillinger uten gjennomgang, så gjenopprett bare en du laget selv, i Innstillinger, Avansert, Gjenopprett fra sikkerhetskopi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een volledige InputConfig-back-up, geen preset. Een back-up vervangt instellingen en voegt presets zonder controle toe, dus herstel alleen een back-up die je zelf hebt gemaakt, via Instellingen, Geavanceerd, Herstel vanuit back-up."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jest pełna kopia zapasowa InputConfig, a nie preset. Kopia zapasowa zastępuje ustawienia i dodaje presety bez przeglądu, więc przywracaj tylko taką, którą sam utworzyłeś, w: Ustawienia, Zaawansowane, Przywróć z kopii zapasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é um backup completo do InputConfig, não um preset. Um backup substitui os ajustes e adiciona presets sem revisão, então restaure somente um que você mesmo fez, em Ajustes, Avançado, Restaurar de um backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это полная резервная копия InputConfig, а не пресет. Резервная копия заменяет настройки и добавляет пресеты без проверки, поэтому восстанавливайте только ту, которую сделали сами, в «Настройки» > «Дополнительно» > «Восстановить из резервной копии»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je celá záloha InputConfig, nie predvoľba. Záloha nahradí nastavenia a pridá predvoľby bez kontroly, preto obnovujte iba tú, ktorú ste vytvorili sami, v Nastaveniach, Rozšírené, Obnoviť zo zálohy."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är en hel InputConfig-säkerhetskopia, inte en förinställning. En säkerhetskopia ersätter inställningar och lägger till förinställningar utan granskning, så återställ bara en som du har gjort själv, i Inställningar, Avancerat, Återställ från säkerhetskopia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือข้อมูลสำรอง InputConfig ทั้งชุด ไม่ใช่พรีเซ็ต ข้อมูลสำรองจะแทนที่การตั้งค่าและเพิ่มพรีเซ็ตโดยไม่ตรวจสอบ ดังนั้นให้กู้คืนเฉพาะข้อมูลที่คุณสร้างเองในการตั้งค่า > ขั้นสูง > กู้คืนจากข้อมูลสำรอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bir ön ayar değil, InputConfig yedeğinin tamamı. Yedek, ayarları değiştirir ve ön ayarları incelemeden ekler; bu yüzden yalnızca kendi yaptığınızı geri yükleyin, Ayarlar, Gelişmiş, Yedekten Geri Yükle’den."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це повна резервна копія InputConfig, а не пресет. Резервна копія замінює параметри й додає пресети без перегляду, тож відновлюйте лише ту, яку створили самі, в «Параметри» > «Додатково» > «Відновити з резервної копії»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là một bản sao lưu InputConfig đầy đủ, không phải một cài đặt sẵn. Bản sao lưu thay thế cài đặt và thêm cài đặt sẵn mà không xem lại, nên chỉ khôi phục bản do chính bạn tạo, trong Cài đặt, Nâng cao, Khôi phục từ bản sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是完整的 InputConfig 备份，不是预设。备份会替换设置并在不经审阅的情况下添加预设，因此请仅恢复你自己制作的备份，位置在“设置”>“高级”>“从备份恢复”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是整份 InputConfig 備份，而不是預設。備份會取代設定並未經檢閱就新增預設，因此請只復原你自己製作的備份，位置在「設定」>「進階」>「從備份復原」。"
          }
        }
      }
    },
    "This key will no longer type anywhere on the Mac. A function key avoids that." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يكتب هذا المفتاح بعد الآن في أي مكان على Mac. يتجنب مفتاح وظيفي ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato klávesa už nebude nikde na Macu psát. Funkční klávesa tomu zabrání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tast vil ikke længere skrive noget nogen steder på Mac. En funktionstast undgår det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Taste tippt dann nirgendwo auf dem Mac mehr. Eine Funktionstaste vermeidet das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tecla dejará de escribir en cualquier parte del Mac. Una tecla de función lo evita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä näppäin ei enää kirjoita mitään missään Macissa. Toimintonäppäin välttää tämän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette touche ne saisira plus rien nulle part sur le Mac. Une touche de fonction évite cela."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המקש הזה כבר לא יקליד בשום מקום ב-Mac. מקש פונקציה נמנע מכך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a billentyű többé nem fog gépelni sehol a Macen. Egy funkcióbillentyű ezt elkerüli."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol ini tidak akan lagi mengetik di mana pun di Mac. Tombol fungsi menghindarinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo tasto non digiterà più da nessuna parte sul Mac. Un tasto funzione evita il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーは、Mac上のどこでも入力されなくなります。ファンクションキーなら、それを避けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키는 Mac 어디에서도 더 이상 입력되지 않습니다. 기능 키를 사용하면 이를 피할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne tasten vil ikke lenger skrive noe sted på Macen. En funksjonstast unngår det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze toets typt nergens meer op de Mac. Een functietoets voorkomt dat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten klawisz nie będzie już nigdzie wpisywał znaków na Macu. Klawisz funkcyjny tego unika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tecla deixará de digitar em qualquer lugar do Mac. Uma tecla de função evita isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта клавиша больше не будет печатать нигде на Mac. Функциональная клавиша этого избегает."
