    "The one thing to know before a preset takes the keyboard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشيء الوحيد الذي يجب معرفته قبل أن يتحكم إعداد مسبق في لوحة المفاتيح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To jediné, co je třeba vědět, než předvolba převezme klávesnici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ene, du bør vide, før en forudindstilling overtager tastaturet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Eine, das du wissen solltest, bevor ein Preset die Tastatur übernimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo único que debes saber antes de que un preajuste tome el teclado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi asia, joka kannattaa tietää ennen kuin esiasetus ottaa näppäimistön haltuunsa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seule chose à savoir avant qu’un préréglage prenne le contrôle du clavier."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדבר האחד שכדאי לדעת לפני שפריסט משתלט על המקלדת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyetlen tudnivaló, mielőtt egy előbeállítás átveszi a billentyűzetet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu hal yang perlu diketahui sebelum preset mengambil alih papan ketik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’unica cosa da sapere prima che un preset prenda il controllo della tastiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットがキーボードを使用する前に、知っておくべき唯一のこと。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋이 키보드를 사용하기 전에 알아야 할 한 가지."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det eneste du bør vite før en forhåndsinnstilling tar over tastaturet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het enige wat je moet weten voordat een preset het toetsenbord overneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna rzecz, którą warto wiedzieć, zanim preset przejmie klawiaturę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A única coisa a saber antes de um preset assumir o teclado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Единственное, что нужно знать, прежде чем пресет возьмёт управление клавиатурой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
