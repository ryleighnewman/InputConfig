    "Typed exactly as written when the input is pressed. Capitals, symbols, and any language work." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُكتب تمامًا كما كُتب عند الضغط على المدخل. تعمل الأحرف الكبيرة والرموز وأي لغة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napíše se přesně tak, jak je zadáno, když se vstup stiskne. Fungují velká písmena, symboly i libovolný jazyk."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrives præcis som angivet, når inputtet trykkes. Store bogstaver, symboler og alle sprog virker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird genau wie geschrieben getippt, wenn die Eingabe gedrückt wird. Großbuchstaben, Symbole und jede Sprache funktionieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se escribe exactamente como está escrito cuando se pulsa la entrada. Mayúsculas, símbolos y cualquier idioma funcionan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoitetaan täsmälleen kuten kirjoitettu, kun syötettä painetaan. Isot kirjaimet, symbolit ja mikä tahansa kieli toimii."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisi exactement tel qu’écrit quand l’entrée est actionnée. Majuscules, symboles et toutes les langues fonctionnent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוקלד בדיוק כפי שנכתב כשהקלט נלחץ. אותיות רישיות, סימנים וכל שפה עובדים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontosan úgy gépelődik be, ahogy írták, amikor a bemenetet megnyomják. A nagybetűk, szimbólumok és bármilyen nyelv működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diketik persis seperti ditulis saat input ditekan. Huruf kapital, simbol, dan bahasa apa pun berfungsi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitato esattamente come scritto quando l’input viene premuto. Maiuscole, simboli e qualsiasi lingua funzionano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力が押されたとき、書かれたとおりに入力されます。大文字、記号、どの言語でも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력이 눌릴 때 쓴 그대로 입력됩니다. 대문자, 기호, 모든 언어가 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrives nøyaktig som skrevet når inndataene trykkes. Store bokstaver, symboler og alle språk fungerer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt precies getypt zoals geschreven wanneer de ingang wordt ingedrukt. Hoofdletters, symbolen en elke taal werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisywany dokładnie tak, jak napisano, po naciśnięciu wejścia. Działają wielkie litery, symbole i dowolny język."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitado exatamente como escrito quando a entrada é pressionada. Maiúsculas, símbolos e qualquer idioma funcionam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводится точно как написано при нажатии входа. Работают заглавные буквы, символы и любой язык."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napísané presne tak, ako je zadané, keď sa vstup stlačí. Veľké písmená, symboly a ľubovoľný jazyk fungujú."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivs exakt som det står när indatan trycks. Versaler, symboler och vilket språk som helst fungerar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิมพ์ตรงตามที่เขียนเมื่อกดอินพุต ตัวพิมพ์ใหญ่ สัญลักษณ์ และภาษาใดก็ได้ใช้ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yapıldığında tam olarak yazıldığı gibi yazılır. Büyük harfler, semboller ve her dil çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друкується точно так, як написано, коли натиснуто вхід. Працюють великі літери, символи та будь-яка мова."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được gõ đúng như đã viết khi đầu vào được nhấn. Chữ hoa, ký hiệu và mọi ngôn ngữ đều dùng được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入按下时按原样键入。大写字母、符号和任何语言都可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入被按下時，會依原樣輸入。大寫、符號和任何語言都可以。"
          }
        }
      }
    },
