            "state" : "translated",
            "value" : "PlayStation: Kříž dole"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation: Kryds nederst"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation: Kreuz unten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation: Cruz abajo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation: Risti alhaalla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlayStation : Croix en bas"
          }
        },
        "he" : {
          "stringUnit" : {
