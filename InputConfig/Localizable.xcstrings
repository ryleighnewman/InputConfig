    "Pen tablets: pressure, tilt, pen buttons, eraser and in range are inputs of their own" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألواح الرسم: الضغط والميل وأزرار القلم والممحاة والنطاق مدخلات مستقلة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafické tablety: přítlak, náklon, tlačítka pera, guma a dosah jsou samostatné vstupy"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegneplader: tryk, hældning, penknapper, viskelæder og rækkevidde er selvstændige input"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stifttabletts: Druck, Neigung, Stifttasten, Radierer und Reichweite sind eigene Eingaben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabletas gráficas: presión, inclinación, botones del lápiz, borrador y alcance son entradas propias"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piirtoalustat: paine, kallistus, kynän painikkeet, pyyhekumi ja kantama ovat omia syötteitään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
