    "The app now says so when another app has taken the emergency stop shortcut, instead of failing silently" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكر التطبيق الآن ذلك عندما يستحوذ تطبيق آخر على اختصار إيقاف الطوارئ، بدل الإخفاق بصمت"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace nyní řekne, když zkratku nouzového zastavení převzala jiná aplikace, místo aby tiše selhala"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen siger nu til, når en anden app har taget genvejen til nødstop, i stedet for at fejle i det stille"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App sagt es jetzt, wenn eine andere App den Notstopp-Kurzbefehl belegt hat, statt stillschweigend zu scheitern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app ahora lo indica cuando otra app ha tomado el atajo de la parada de emergencia, en lugar de fallar en silencio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appi kertoo nyt, kun toinen appi on ottanut hätäpysäytyksen oikotien, sen sijaan että epäonnistuisi hiljaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app le signale désormais quand une autre app a pris le raccourci d’arrêt d’urgence, au lieu d’échouer silencieusement"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האפליקציה אומרת עכשיו כשאפליקציה אחרת תפסה את קיצור עצירת החירום, במקום להיכשל בשקט"
