    "Two quick taps send this action instead of the row's normal output. A single tap waits out the time set here before it sends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنقران سريعتان ترسلان هذا الإجراء بدل المخرج المعتاد للصف. تنتظر النقرة الواحدة المدة المضبوطة هنا قبل أن ترسل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvě rychlá klepnutí odešlou tuto akci místo běžného výstupu řádku. Jedno klepnutí počká na zde nastavenou dobu, než odešle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To hurtige tap sender denne handling i stedet for rækkens normale output. Et enkelt tap venter den tid, der er indstillet her, før det sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei schnelle Tipper senden diese Aktion statt der normalen Ausgabe der Zeile. Ein einzelnes Tippen wartet die hier eingestellte Zeit ab, bevor es sendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos toques rápidos envían esta acción en lugar de la salida normal de la fila. Un solo toque espera el tiempo definido aquí antes de enviarse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksi nopeaa napautusta lähettää tämän toiminnon rivin normaalin ulostulon sijaan. Yksittäinen napautus odottaa tässä asetetun ajan ennen lähettämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux touchers rapides envoient cette action à la place de la sortie normale de la ligne. Un toucher simple attend la durée réglée ici avant d’envoyer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שתי הקשות מהירות שולחות את הפעולה הזו במקום הפלט הרגיל של השורה. הקשה בודדת ממתינה את הזמן שנקבע כאן לפני שהיא נשלחת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Két gyors koppintás ezt a műveletet küldi a sor normál kimenete helyett. Az egyszeri koppintás kivárja az itt beállított időt, mielőtt elküldi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dua ketukan cepat mengirim tindakan ini alih-alih output normal baris. Satu ketukan menunggu waktu yang diatur di sini sebelum mengirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due tocchi rapidi inviano questa azione invece dell’uscita normale della riga. Un singolo tocco attende il tempo impostato qui prima di inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "素早く2回タップすると、行の通常の出力の代わりにこのアクションを送信します。1回のタップは、ここで設定した時間待ってから送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠르게 두 번 탭하면 행의 일반 출력 대신 이 동작을 보냅니다. 한 번 탭하면 여기서 설정한 시간만큼 기다린 뒤 보냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To raske trykk sender denne handlingen i stedet for radens vanlige utdata. Et enkelttrykk venter ut tiden som er angitt her før det sendes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee snelle tikken sturen deze actie in plaats van de normale uitvoer van de rij. Een enkele tik wacht de hier ingestelde tijd af voordat hij wordt gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa szybkie dotknięcia wysyłają to działanie zamiast normalnego wyjścia wiersza. Pojedyncze dotknięcie czeka przez ustawiony tu czas, zanim coś wyśle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois toques rápidos enviam esta ação em vez da saída normal da linha. Um único toque espera o tempo definido aqui antes de enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два быстрых касания отправляют это действие вместо обычного вывода строки. Одиночное касание ждёт заданное здесь время, прежде чем отправить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dve rýchle ťuknutia pošlú túto akciu namiesto bežného výstupu riadka. Jedno ťuknutie počká na tu nastavený čas, kým pošle."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Två snabba tryck skickar den här åtgärden i stället för radens normala utdata. Ett enda tryck väntar ut tiden som anges här innan det skickas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแตะเร็วสองครั้งส่งการทำงานนี้แทนเอาต์พุตปกติของแถว การแตะครั้งเดียวรอตามเวลาที่ตั้งไว้ที่นี่ก่อนส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki hızlı dokunma, satırın normal çıkışı yerine bu eylemi gönderir. Tek dokunma, göndermeden önce burada ayarlanan süreyi bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Два швидкі торкання надсилають цю дію замість звичайного виходу рядка. Одиночне торкання вичікує заданий тут час, перш ніж надіслати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai lần chạm nhanh gửi hành động này thay cho đầu ra thông thường của hàng. Một lần chạm đơn chờ hết thời gian đặt tại đây trước khi gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速轻点两下会发送此动作，而不是该行的常规输出。单次轻点会等待此处设置的时间后才发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速輕點兩下會送出此動作，而不是此列的一般輸出。單次輕點會先等完這裡設定的時間才送出。"
          }
        }
      }
    },
