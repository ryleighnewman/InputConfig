          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs tilladelsen igen, når du har slået den til"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechtigung nach dem Einschalten erneut lesen"
          }
        },
