    "Drag a region to move it, or the dots on the selected one to resize it. Right-click a region to rename, duplicate or delete it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب منطقة لنقلها، أو النقاط على المنطقة المحددة لتغيير حجمها. انقر بزر الماوس الأيمن على منطقة لإعادة تسميتها أو تكرارها أو حذفها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením oblasti ji přesunete, přetažením teček na vybrané oblasti změníte její velikost. Kliknutím pravým tlačítkem na oblast ji přejmenujete, zduplikujete nebo smažete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk et område for at flytte det, eller prikkerne på det valgte for at ændre størrelsen. Højreklik på et område for at omdøbe, duplikere eller slette det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe einen Bereich, um ihn zu verschieben, oder die Punkte am ausgewählten, um seine Größe zu ändern. Klicke mit der rechten Maustaste auf einen Bereich, um ihn umzubenennen, zu duplizieren oder zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra una región para moverla, o los puntos de la seleccionada para cambiar su tamaño. Haz clic derecho en una región para renombrarla, duplicarla o eliminarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä aluetta vetämällä sitä, tai muuta valitun alueen kokoa vetämällä sen pisteitä. Napsauta aluetta hiiren oikealla nimetäksesi sen uudelleen, monistaaksesi tai poistaaksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une zone pour la déplacer, ou les points de la zone sélectionnée pour la redimensionner. Cliquez avec le bouton droit sur une zone pour la renommer, la dupliquer ou la supprimer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור אזור כדי להזיז אותו, או את הנקודות של האזור הנבחר כדי לשנות את גודלו. לחץ לחיצה ימנית על אזור כדי לשנות את שמו, לשכפל אותו או למחוק אותו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzzon egy területet az áthelyezéséhez, vagy a kijelölt terület pontjait az átméretezéséhez. Kattintson a jobb gombbal egy területre az átnevezéséhez, megkettőzéséhez vagy törléséhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret wilayah untuk memindahkannya, atau titik pada wilayah yang dipilih untuk mengubah ukurannya. Klik kanan wilayah untuk mengganti nama, menduplikasi, atau menghapusnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina una regione per spostarla, o i punti di quella selezionata per ridimensionarla. Fai clic destro su una regione per rinominarla, duplicarla o eliminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "領域をドラッグすると移動し、選択した領域の点をドラッグするとサイズを変更できます。領域を右クリックすると、名前の変更、複製、削除ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영역을 드래그하면 이동하고, 선택한 영역의 점을 드래그하면 크기가 바뀝니다. 영역을 오른쪽 클릭하면 이름 변경, 복제, 삭제를 할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra et område for å flytte det, eller prikkene på det valgte for å endre størrelsen. Høyreklikk på et område for å gi det nytt navn, duplisere eller slette det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een gebied om het te verplaatsen, of de stippen van het geselecteerde om het te vergroten of verkleinen. Klik met de rechtermuisknop op een gebied om het een andere naam te geven, te dupliceren of te verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij obszar, aby go przesunąć, lub kropki zaznaczonego obszaru, aby zmienić jego rozmiar. Kliknij obszar prawym przyciskiem, aby zmienić jego nazwę, zduplikować go lub usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste uma região para movê-la, ou os pontos da selecionada para redimensioná-la. Clique com o botão direito em uma região para renomeá-la, duplicá-la ou apagá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите область, чтобы переместить её, или точки выбранной области, чтобы изменить её размер. Щёлкните область правой кнопкой, чтобы переименовать, дублировать или удалить её."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím oblasti ju presuniete, potiahnutím bodiek vybranej oblasti zmeníte jej veľkosť. Kliknutím pravým tlačidlom na oblasť ju premenujete, zduplikujete alebo vymažete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en region för att flytta den, eller punkterna på den markerade för att ändra storlek. Högerklicka på en region för att byta namn på, duplicera eller radera den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากพื้นที่เพื่อย้าย หรือลากจุดบนพื้นที่ที่เลือกเพื่อปรับขนาด คลิกขวาที่พื้นที่เพื่อเปลี่ยนชื่อ ทำซ้ำ หรือลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taşımak için bir bölgeyi, yeniden boyutlandırmak için seçili bölgenin noktalarını sürükleyin. Yeniden adlandırmak, çoğaltmak veya silmek için bir bölgeye sağ tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть область, щоб перемістити її, або точки вибраної області, щоб змінити її розмір. Клацніть область правою кнопкою, щоб перейменувати, дублювати або видалити її."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo một vùng để di chuyển, hoặc kéo các chấm của vùng đã chọn để đổi kích thước. Bấm chuột phải vào một vùng để đổi tên, nhân bản hoặc xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移区域可移动它，拖移所选区域上的圆点可调整其大小。右键点按区域可重新命名、复制或删除它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移區域可移動它，拖移所選區域上的圓點可調整其大小。按右鍵點按區域可重新命名、複製或刪除它。"
          }
        }
      }
    },
    "Drag any widget to a new position, or Tab to it and press the arrow keys, or right-click it, to move it a step at a time. The layout saves automatically for this controller model." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب أي عنصر واجهة إلى موضع جديد، أو انتقل إليه بمفتاح Tab واضغط مفاتيح الأسهم، أو انقر عليه بزر الماوس الأيمن، لتحريكه خطوة في كل مرة. يُحفظ التخطيط تلقائيًا لطراز ذراع التحكم هذا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetáhněte libovolný widget na novou pozici, nebo na něj přejděte klávesou Tab a stiskněte šipky, případně na něj klikněte pravým tlačítkem, a posouvejte ho po krocích. Rozvržení se pro tento model ovladače ukládá automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk et modul til en ny position, eller gå til det med Tab og tryk på piletasterne, eller højreklik på det, for at flytte det ét trin ad gangen. Layoutet gemmes automatisk for denne controllermodel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Widget an eine neue Position, oder wähle es mit der Tabulatortaste aus und drücke die Pfeiltasten, oder klicke es mit der rechten Maustaste an, um es schrittweise zu bewegen. Das Layout wird für dieses Controller-Modell automatisch gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra cualquier widget a una nueva posición, o llega a él con Tabulador y pulsa las teclas de flecha, o haz clic derecho en él, para moverlo paso a paso. El diseño se guarda automáticamente para este modelo de mando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä widget uuteen paikkaan tai siirry siihen Sarkain-näppäimellä ja siirrä sitä nuolinäppäimillä tai napsauta sitä oikealla painikkeella, niin voit siirtää sitä askel kerrallaan. Asettelu tallentuu automaattisesti tälle ohjainmallille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser n’importe quel widget vers une nouvelle position, ou accédez-y avec Tab et appuyez sur les touches fléchées, ou faites un clic droit dessus, pour le déplacer pas à pas. La disposition s’enregistre automatiquement pour ce modèle de manette."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור כל ווידג׳ט למיקום חדש, או עבור אליו עם Tab ולחץ על מקשי החצים, או לחץ עליו קליק ימני, כדי להזיז אותו צעד בכל פעם. הפריסה נשמרת אוטומטית עבור דגם השלט הזה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza bármelyik widgetet új helyre, vagy lépjen rá a Tab billentyűvel és használja a nyílbillentyűket, vagy kattintson rá jobb gombbal, hogy lépésenként mozgassa. Az elrendezés automatikusan mentődik ennél a vezérlőmodellnél."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret widget mana pun ke posisi baru, atau Tab ke widget lalu tekan tombol panah, atau klik kanan, untuk memindahkannya selangkah demi selangkah. Tata letak tersimpan otomatis untuk model pengontrol ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un widget in una nuova posizione, oppure raggiungilo con Tab e premi i tasti freccia, oppure fai clic destro su di esso, per spostarlo un passo alla volta. La disposizione viene salvata automaticamente per questo modello di controller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットを新しい位置にドラッグするか、Tabキーでウィジェットに移動して矢印キーを押すか、右クリックして、1ステップずつ動かせます。レイアウトは、このコントローラモデル用に自動で保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯을 새 위치로 드래그하거나, Tab 키로 위젯에 이동해 화살표 키를 누르거나, 위젯을 오른쪽 클릭하면 한 단계씩 옮길 수 있습니다. 레이아웃은 이 컨트롤러 모델용으로 자동 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en modul til en ny posisjon, eller gå til den med Tab og trykk piltastene, eller høyreklikk på den, for å flytte den ett trinn om gangen. Oppsettet lagres automatisk for denne kontrollermodellen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een widget naar een nieuwe positie, of ga er met Tab naartoe en druk op de pijltoetsen, of klik er met de rechtermuisknop op om hem stap voor stap te verplaatsen. De indeling wordt automatisch bewaard voor dit controllermodel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij dowolny widżet w nowe miejsce albo przejdź do niego klawiszem Tab i naciskaj klawisze strzałek, albo kliknij go prawym przyciskiem, aby przesuwać go krok po kroku. Układ zapisuje się automatycznie dla tego modelu kontrolera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste qualquer widget para uma nova posição, ou vá até ele com Tab e pressione as setas, ou clique nele com o botão direito, para movê-lo um passo por vez. O layout é salvo automaticamente para este modelo de controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите любой виджет на новое место либо перейдите к нему клавишей Tab и нажимайте стрелки, или щёлкните по нему правой кнопкой, чтобы смещать его шаг за шагом. Раскладка сохраняется автоматически для этой модели контроллера."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presuňte ľubovoľnú miniaplikáciu na novú pozíciu, alebo na ňu prejdite klávesom Tab a stlačte šípky, prípadne na ňu kliknite pravým tlačidlom, a posúvajte ju po krokoch. Rozloženie sa pre tento model ovládača ukladá automaticky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en widget till en ny position, eller gå till den med Tabb och tryck på piltangenterna, eller högerklicka på den, för att flytta den ett steg i taget. Layouten sparas automatiskt för den här kontrollmodellen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากวิดเจ็ตใดก็ได้ไปยังตำแหน่งใหม่ หรือกด Tab ไปที่วิดเจ็ตแล้วกดแป้นลูกศร หรือคลิกขวาที่วิดเจ็ต เพื่อเลื่อนทีละขั้น เลย์เอาต์จะบันทึกอัตโนมัติสำหรับคอนโทรลเลอร์รุ่นนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir pencere öğesini yeni bir konuma sürükleyin ya da Tab ile ona gelip ok tuşlarına basın veya sağ tıklayın; böylece her seferinde bir adım taşırsınız. Yerleşim bu kumanda modeli için otomatik kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть будь-який віджет на нове місце, або перейдіть до нього клавішею Tab і натискайте стрілки, або клацніть його правою кнопкою, щоб пересувати його крок за кроком. Розкладка зберігається автоматично для цієї моделі контролера."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo bất kỳ tiện ích nào đến vị trí mới, hoặc nhấn Tab để chọn rồi nhấn các phím mũi tên, hoặc nhấp chuột phải vào nó, để di chuyển từng bước một. Bố cục tự động lưu cho kiểu bộ điều khiển này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将任意小组件拖到新位置，或用 Tab 键移到它上面再按方向键，或右键点按它，即可一次移动一步。布局会自动为此控制器型号保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將任何小工具拖到新位置，或用 Tab 鍵移到它上面再按方向鍵，或在它上面按右鍵，即可一次移動一步。此配置會自動為這個控制器機型儲存。"
          }
        }
      }
    },
    "Drag any widget to a new position. The layout saves automatically for this controller model." : {
