    "Generic USB pads and a single Joy-Con number their controls like other controllers; InputConfig offers to update older rows on USB pads" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرقَّم عناصر تحكم أذرع USB العامة وJoy-Con المنفرد مثل أذرع التحكم الأخرى؛ ويعرض InputConfig تحديث الصفوف الأقدم على أذرع USB"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecné gamepady USB a jeden Joy-Con číslují své ovládací prvky jako ostatní ovladače; InputConfig nabídne aktualizaci starších řádků na padech USB"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generiske USB-pads og en enkelt Joy-Con nummererer deres kontroller som andre controllere. InputConfig tilbyder at opdatere ældre rækker på USB-pads"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generische USB-Pads und ein einzelner Joy-Con nummerieren ihre Bedienelemente wie andere Controller; InputConfig bietet an, ältere Zeilen auf USB-Pads zu aktualisieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pads USB genéricos y un solo Joy-Con numeran sus controles como otros mandos; InputConfig ofrece actualizar las filas antiguas en pads USB"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yleiset USB-ohjaimet ja yksittäinen Joy-Con numeroivat ohjauksensa kuten muut ohjaimet; InputConfig tarjoaa päivittämään vanhemmat rivit USB-ohjaimilla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pads USB génériques et un Joy-Con seul numérotent leurs commandes comme les autres manettes ; InputConfig propose de mettre à jour les anciennes lignes sur les pads USB"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משטחי USB כלליים ו-Joy-Con בודד ממספרים את הפקדים שלהם כמו שלטים אחרים; InputConfig מציע לעדכן שורות ישנות במשטחי USB"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az általános USB-s padek és az önálló Joy-Con a többi vezérlőhöz hasonlóan számozza a vezérlőit; az InputConfig felajánlja a régebbi sorok frissítését az USB-s padeken"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pad USB generik dan satu Joy-Con menomori kontrolnya seperti pengontrol lain; InputConfig menawarkan memperbarui baris lama pada pad USB"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pad USB generici e un singolo Joy-Con numerano i loro comandi come gli altri controller; InputConfig offre di aggiornare le righe meno recenti sui pad USB"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汎用USBパッドと単体のJoy-Conは、ほかのコントローラと同じようにコントロールに番号が付きます。InputConfigは、USBパッド上の古い行の更新を提案します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "범용 USB 패드와 단일 Joy-Con은 컨트롤 번호가 다른 컨트롤러와 같게 매겨지며, InputConfig가 USB 패드의 이전 행을 업데이트하도록 제안함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generiske USB-kontrollere og en enkelt Joy-Con nummererer kontrollene sine som andre kontrollere. InputConfig tilbyr å oppdatere eldre rader på USB-kontrollere"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generieke USB-pads en een enkele Joy-Con nummeren hun bedieningen zoals andere controllers; InputConfig biedt aan oudere rijen op USB-pads bij te werken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogólne pady USB i pojedynczy Joy-Con numerują swoje sterowania jak inne kontrolery. InputConfig oferuje aktualizację starszych wierszy na padach USB"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamepads USB genéricos e um único Joy-Con numeram seus controles como outros controles; o InputConfig oferece atualizar linhas antigas em gamepads USB"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальные USB-геймпады и одиночный Joy-Con нумеруют элементы управления, как другие контроллеры; InputConfig предлагает обновить старые строки на USB-геймпадах"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generické USB pady a jeden Joy-Con číslujú svoje ovládacie prvky ako iné ovládače; InputConfig ponúkne aktualizáciu starších riadkov na USB padoch"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generiska USB-kontroller och en enskild Joy-Con numrerar sina kontroller som andra spelkontroller. InputConfig erbjuder att uppdatera äldre rader på USB-kontroller"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แผ่นควบคุม USB ทั่วไปและ Joy-Con เดี่ยวกำหนดหมายเลขตัวควบคุมเหมือนคอนโทรลเลอร์อื่น InputConfig เสนออัปเดตแถวรุ่นเก่าบนแผ่นควบคุม USB"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genel USB oyun kumandaları ve tek bir Joy-Con kontrollerini diğer kumandalar gibi numaralandırır; InputConfig, USB oyun kumandalarındaki eski satırları güncellemeyi önerir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Універсальні USB-геймпади й один Joy-Con нумерують свої елементи керування, як інші контролери; InputConfig пропонує оновити старіші рядки на USB-геймпадах"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tay cầm USB thông dụng và một Joy-Con đơn đánh số điều khiển giống các bộ điều khiển khác; InputConfig đề nghị cập nhật các hàng cũ trên tay cầm USB"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通用 USB 手柄和单个 Joy-Con 的控件编号方式与其他控制器相同；InputConfig 会提供更新 USB 手柄上的旧行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通用 USB 控制器和單一 Joy-Con 的控制項編號方式與其他控制器相同；InputConfig 會為 USB 控制器上較舊的列提供更新"
          }
        }
      }
    },
