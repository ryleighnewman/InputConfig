        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화를 클릭하면 프리셋이 시작되고 Minecraft가 열립니다. 다시 클릭하면 멈춥니다."
          }
        },
        "nb" : {
          "stringUnit" : {
