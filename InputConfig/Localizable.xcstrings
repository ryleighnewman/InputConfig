    "A macro plays several keys in a row from one press. Turn on Macro in a row's Options to add its steps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل الماكرو عدة مفاتيح متتالية بضغطة واحدة. شغّل «ماكرو» في خيارات الصف لإضافة خطواته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro přehraje jedním stiskem několik kláves za sebou. Zapněte Makro v Možnostech řádku a přidejte jeho kroky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En makro spiller flere taster i træk med ét tryk. Slå Makro til i en rækkes Valgmuligheder for at tilføje trinene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Makro spielt mit einem Druck mehrere Tasten nacheinander. Schalte in den Optionen einer Zeile Makro ein, um seine Schritte hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una macro reproduce varias teclas seguidas con una sola pulsación. Activa Macro en las Opciones de una fila para añadir sus pasos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro soittaa yhdellä painalluksella useita näppäimiä peräkkäin. Lisää sen vaiheet ottamalla Makro käyttöön rivin valinnoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une macro joue plusieurs touches à la suite d'un seul appui. Activez Macro dans les Options d'une ligne pour ajouter ses étapes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאקרו מנגן כמה מקשים ברצף בלחיצה אחת. הפעילו ״מאקרו״ באפשרויות של שורה כדי להוסיף את השלבים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A makró egyetlen nyomásra több billentyűt játszik le egymás után. Kapcsold be a Makrót egy sor beállításaiban a lépései hozzáadásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro memainkan beberapa tombol berurutan dengan satu tekanan. Nyalakan Makro di Opsi sebuah baris untuk menambahkan langkahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una macro suona più tasti di fila con una sola pressione. Attiva Macro nelle Opzioni di una riga per aggiungere i suoi passaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロは、1回押すだけで複数のキーを続けて送ります。行のオプションで「マクロ」をオンにして、手順を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로는 한 번 눌러 여러 키를 차례로 보냅니다. 행의 옵션에서 매크로를 켜고 단계를 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En makro spiller flere taster etter hverandre med ett trykk. Slå på Makro i valgene for en rad for å legge til stegene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een macro speelt met één druk meerdere toetsen achter elkaar. Zet Macro aan in de Opties van een rij om de stappen toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro odtwarza kilka klawiszy po kolei jednym naciśnięciem. Włącz Makro w Opcjach wiersza, aby dodać kroki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma macro toca várias teclas em sequência com um só toque. Ative Macro nas Opções de uma linha para adicionar os passos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макрос одним нажатием проигрывает несколько клавиш подряд. Включите «Макрос» в Параметрах строки, чтобы добавить шаги."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro prehrá jedným stlačením niekoľko klávesov za sebou. Zapnite Makro v Možnostiach riadka a pridajte jeho kroky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett makro spelar flera tangenter efter varandra med ett tryck. Slå på Makro i en rads Alternativ för att lägga till stegen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาโครเล่นหลายปุ่มต่อกันด้วยการกดครั้งเดียว เปิดมาโครในตัวเลือกของแถวเพื่อเพิ่มขั้นตอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro, tek basışla birkaç tuşu art arda çalar. Adımlarını eklemek için bir satırın Seçeneklerinde Makro'yu açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макрос одним натисканням програє кілька клавіш поспіль. Увімкніть «Макрос» у Параметрах рядка, щоб додати кроки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macro phát nhiều phím liên tiếp chỉ với một lần bấm. Bật Macro trong Tùy chọn của một hàng để thêm các bước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏会用一次按压连续发送多个按键。在一行的选项中打开“宏”即可添加步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集會用一次按壓連續送出多個按鍵。在一列的選項中打開「巨集」即可加入步驟。"
          }
        }
      }
    },
    "A macro replaces the row's normal output and can have as many steps as you like. For Command V then Command K, add two Tap steps, V and K, each with ⌘ on. Hold down keeps a key held while later steps run, and Release lets it go. To play the whole macro more than once per press, set Repeat under How it fires." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحل الماكرو محل المخرج المعتاد للصف ويمكن أن يضم عدد الخطوات الذي تريده. لتنفيذ Command V ثم Command K، أضف خطوتي نقر، V وK، مع تشغيل ⌘ في كل منهما. تُبقي «إبقاء مضغوطًا» مفتاحًا مضغوطًا أثناء تنفيذ الخطوات اللاحقة، و«تحرير» يتركه. لتشغيل الماكرو كله أكثر من مرة لكل ضغطة، اضبط «التكرار» ضمن «كيفية التفعيل»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro nahradí běžný výstup řádku a může mít libovolný počet kroků. Pro Command V a poté Command K přidejte dva kroky Stisk, V a K, oba se zapnutým ⌘. Podržet drží klávesu stisknutou, zatímco běží další kroky, a Uvolnit ji pustí. Chcete-li přehrát celé makro při jednom stisku vícekrát, nastavte Opakování v části Jak se spouští."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En makro erstatter rækkens normale output og kan have lige så mange trin, som du vil. Til Command V og derefter Command K tilføjer du to Tryk-trin, V og K, hver med ⌘ slået til. Hold nede holder en tast nede, mens senere trin kører, og Slip giver slip. For at afspille hele makroen mere end én gang pr. tryk skal du indstille Gentag under Sådan udløses den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Makro ersetzt die normale Ausgabe der Zeile und kann beliebig viele Schritte haben. Für Befehlstaste-V und dann Befehlstaste-K füge zwei Schritte „Tippen“ hinzu, V und K, jeweils mit eingeschaltetem ⌘. „Gedrückt halten“ hält eine Taste gedrückt, während spätere Schritte laufen, und „Loslassen“ lässt sie los. Um das ganze Makro pro Tastendruck mehrmals abzuspielen, stelle unter „Auslöseverhalten“ die Wiederholung ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una macro sustituye la salida normal de la fila y puede tener tantos pasos como quieras. Para Comando V y luego Comando K, añade dos pasos de Pulsar, V y K, cada uno con ⌘ activado. Mantener pulsado mantiene una tecla pulsada mientras se ejecutan los pasos siguientes, y Soltar la libera. Para reproducir toda la macro más de una vez por pulsación, ajusta Repetir en Cómo se activa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro korvaa rivin normaalin ulostulon, ja siinä voi olla niin monta vaihetta kuin tarvitaan. Jos haluat Komento V ja sitten Komento K, lisää kaksi Napauta-vaihetta, V ja K, kummassakin ⌘ päällä. Pidä painettuna pitää näppäimen painettuna myöhempien vaiheiden ajan, ja Vapauta päästää sen irti. Jos haluat toistaa koko makron useammin kuin kerran painallusta kohden, aseta Toisto kohdassa Miten se laukeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une macro remplace la sortie normale de la ligne et peut comporter autant d’étapes que vous le souhaitez. Pour Commande V puis Commande K, ajoutez deux étapes Toucher, V et K, chacune avec ⌘ activé. Maintenir enfoncé garde une touche enfoncée pendant les étapes suivantes, et Relâcher la libère. Pour jouer toute la macro plusieurs fois par appui, réglez Répéter sous Déclenchement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאקרו מחליף את הפלט הרגיל של השורה ויכול לכלול כמה שלבים שתרצה. עבור Command V ואז Command K, הוסף שני שלבי הקשה, V ו-K, כששניהם עם ⌘ מופעל. ״החזקה״ משאירה מקש לחוץ בזמן שהשלבים הבאים רצים, ו״שחרור״ מרפה אותו. כדי להפעיל את כל המאקרו יותר מפעם אחת בכל לחיצה, הגדר חזרות תחת ״אופן ההפעלה״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A makró lecseréli a sor normál kimenetét, és tetszőleges számú lépésből állhat. A Command V, majd Command K kombinációhoz adjon hozzá két Koppintás lépést, V és K, mindkettő bekapcsolt ⌘-val. A Lenyomva tartás addig tartja lenyomva a billentyűt, amíg a későbbi lépések futnak, a Felengedés pedig elengedi. Ha a teljes makrót egy lenyomásra többször szeretné lejátszani, állítsa be az Ismétlés értéket a Működés módja alatt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro menggantikan output normal baris dan dapat memiliki sebanyak mungkin langkah. Untuk Command V lalu Command K, tambahkan dua langkah Ketuk, V dan K, masing-masing dengan ⌘ menyala. Tahan menjaga tombol tetap ditahan saat langkah berikutnya berjalan, dan Lepas melepaskannya. Untuk memutar seluruh makro lebih dari sekali per penekanan, atur Ulangi di bawah Cara Aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una macro sostituisce l’output normale della riga e può avere tutti i passaggi che vuoi. Per Comando V e poi Comando K, aggiungi due passaggi Tocco, V e K, ciascuno con ⌘ attivo. Tieni premuto mantiene un tasto premuto mentre i passaggi successivi vengono eseguiti, e Rilascia lo lascia andare. Per riprodurre l’intera macro più volte a ogni pressione, imposta Ripeti in Come si attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロは行の通常の出力を置き換え、ステップはいくつでも追加できます。⌘Vのあとに⌘Kを実行するには、どちらも⌘をオンにしたタップステップ（VとK）を2つ追加します。「押し続ける」は、あとのステップを実行している間キーを押したままにし、「離す」でキーを離します。1回の押下でマクロ全体を複数回再生するには、「実行方法」の「繰り返し」を設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로는 행의 일반 출력을 대체하며 단계를 원하는 만큼 둘 수 있습니다. Command V 다음 Command K를 보내려면 V와 K의 탭 단계를 두 개 추가하고 각각 ⌘를 켜세요. 누르고 있기는 이후 단계가 실행되는 동안 키를 계속 누르고 있으며, 떼기는 키를 놓습니다. 한 번 누를 때 매크로 전체를 여러 번 재생하려면 ‘실행 방식’에서 반복을 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En makro erstatter radens vanlige utdata og kan ha så mange trinn du vil. For Kommando V og deretter Kommando K legger du til to Trykk-trinn, V og K, begge med ⌘ på. Hold nede holder en tast nede mens senere trinn kjører, og Slipp slipper den. Hvis du vil spille hele makroen flere ganger per trykk, angir du Gjenta under Hvordan den utløses."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een macro vervangt de normale uitvoer van de rij en kan zoveel stappen hebben als je wilt. Voor Command V en dan Command K voeg je twee Tik-stappen toe, V en K, elk met ⌘ aan. Ingedrukt houden houdt een toets vast terwijl latere stappen worden uitgevoerd, en Loslaten laat hem los. Om de hele macro meer dan één keer per druk af te spelen, stel je Herhaal in onder Hoe het wordt geactiveerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro zastępuje normalne wyjście wiersza i może mieć dowolnie wiele kroków. Aby wykonać Command V, a potem Command K, dodaj dwa kroki Dotknięcie, V i K, każdy z włączonym ⌘. Przytrzymanie utrzymuje klawisz wciśnięty, gdy wykonują się kolejne kroki, a Zwolnienie go puszcza. Aby odtworzyć całe makro więcej niż raz na jedno naciśnięcie, ustaw Powtarzanie w sekcji Sposób uruchamiania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma macro substitui a saída normal da linha e pode ter quantos passos você quiser. Para Command V e depois Command K, adicione dois passos de Toque, V e K, cada um com ⌘ ativado. Manter pressionada mantém uma tecla segurada enquanto os passos seguintes são executados, e Soltar a libera. Para repetir a macro inteira mais de uma vez por pressionamento, defina Repetir em Como é acionada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макрос заменяет обычный вывод строки и может содержать сколько угодно шагов. Для Command V, затем Command K добавьте два шага «Нажатие», V и K, и включите для каждого ⌘. «Удерживать» оставляет клавишу нажатой, пока выполняются следующие шаги, а «Отпустить» отпускает её. Чтобы воспроизвести весь макрос больше одного раза за нажатие, задайте «Повтор» в разделе «Как срабатывает»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro nahrádza bežný výstup riadka a môže mať ľubovoľný počet krokov. Pre Command V a potom Command K pridajte dva kroky Ťuknutie, V a K, každý so zapnutým ⌘. Podržanie drží kláves stlačený, kým sa vykonávajú ďalšie kroky, a Uvoľnenie ho pustí. Ak chcete celé makro prehrať viackrát na jedno stlačenie, nastavte Opakovanie v časti Ako sa spúšťa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett makro ersätter radens normala utdata och kan ha så många steg du vill. För Kommando V och sedan Kommando K lägger du till två Tryck-steg, V och K, vart och ett med ⌘ på. Håll nedtryckt håller en tangent nedtryckt medan senare steg körs, och Släpp släpper den. Om du vill spela hela makrot flera gånger per tryck ställer du in Upprepa under Hur den utlöses."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาโครจะแทนที่เอาต์พุตปกติของแถว และมีกี่ขั้นตอนก็ได้ สำหรับ Command V แล้ว Command K ให้เพิ่มขั้นตอนแตะสองขั้นตอน คือ V และ K โดยเปิด ⌘ ทั้งคู่ กดค้างจะกดแป้นค้างไว้ขณะที่ขั้นตอนถัดไปทำงาน และปล่อยจะปล่อยแป้น หากต้องการเล่นมาโครทั้งชุดมากกว่าหนึ่งครั้งต่อการกดหนึ่งครั้ง ให้ตั้งค่าทำซ้ำใต้วิธีการทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir makro, satırın normal çıkışının yerini alır ve istediğiniz kadar adım içerebilir. Command V ardından Command K için iki Dokunma adımı ekleyin, V ve K, her birinde ⌘ açık. Basılı Tut, sonraki adımlar çalışırken bir tuşu basılı tutar; Bırak onu bırakır. Makronun tamamını her basışta birden fazla çalmak için Nasıl tetiklenir bölümündeki Tekrarla’yı ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макрос замінює звичайний вихід рядка й може мати стільки кроків, скільки потрібно. Для Command V, потім Command K додайте два кроки «Торкання», V і K, кожен із увімкненим ⌘. «Утримувати» тримає клавішу натиснутою, поки виконуються наступні кроки, а «Відпустити» відпускає її. Щоб відтворити весь макрос більше ніж один раз за натискання, задайте «Повторення» в розділі «Як спрацьовує»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macro thay thế đầu ra thông thường của hàng và có thể có bao nhiêu bước tùy ý. Để thực hiện Command V rồi Command K, hãy thêm hai bước Nhấn, V và K, mỗi bước bật ⌘. Nhấn giữ sẽ giữ một phím trong khi các bước sau chạy, và Nhả sẽ thả phím ra. Để phát cả macro nhiều lần cho mỗi lần nhấn, hãy đặt Lặp lại trong Cách kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏会替代该行的常规输出，并且可包含任意多个步骤。要依次执行 Command V 和 Command K，请添加两个“轻点”步骤，V 和 K，并各自开启 ⌘。“按住”会在后续步骤运行时保持按键按下，“释放”则将其松开。要让每次按下时多次播放整个宏，请在“触发方式”下设置“重复”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集會取代此列的一般輸出，且步驟數不限。若要先按 Command-V 再按 Command-K，請新增兩個「輕點」步驟，V 和 K，各自開啟 ⌘。「按住」會在後續步驟執行時保持按鍵被按住，「放開」則會釋放它。若要每次按下時重複播放整個巨集，請在「觸發方式」下設定「重複」。"
          }
        }
      }
    },
    "A modifier key can carry a second job without losing its first. With no output on the plain press, Command, Option, and Shift keep working in every shortcut; only a long hold on its own, or a double tap, fires something: hold Right Command for Spotlight, double tap it for Launchpad, hold Right Option for Dictation, hold Right Shift for Mission Control. The hold time and double tap window are set per row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لمفتاح التعديل أن يؤدي مهمة ثانية دون أن يفقد الأولى. عندما لا يكون للضغطة العادية مخرج، تظل مفاتيح Command وOption وShift تعمل في كل اختصار؛ ولا يُنفَّذ شيء إلا بضغط مطوّل منفرد أو نقر مزدوج: اضغط مطولًا على Command الأيمن لفتح Spotlight، وانقر عليه مرتين لفتح Launchpad، واضغط مطولًا على Option الأيمن للإملاء، واضغط مطولًا على Shift الأيمن لفتح Mission Control. يُضبط زمن الضغط ومهلة النقر المزدوج لكل صف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifikační klávesa může mít druhou funkci, aniž by ztratila první. Bez výstupu na prostý stisk fungují Command, Option a Shift dál ve všech zkratkách; něco spustí jen dlouhé podržení samotné klávesy nebo dvojité klepnutí: podržte pravý Command pro Spotlight, klepněte na něj dvakrát pro Launchpad, podržte pravý Option pro Diktování, podržte pravý Shift pro Mission Control. Doba podržení a okno dvojitého klepnutí se nastavují pro každý řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En modifikatortast kan have et ekstra job uden at miste det første. Uden output på det almindelige tryk fungerer Command, Alternativ og Skift stadig i alle genveje. Kun et langt tryk alene eller et dobbelttap udløser noget: hold Højre Command nede for Spotlight, dobbelttap på den for Launchpad, hold Højre Alternativ nede for Diktering, hold Højre Skift nede for Mission Control. Holdetiden og vinduet for dobbelttap indstilles pr. række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sondertaste kann eine zweite Aufgabe übernehmen, ohne die erste zu verlieren. Ohne Ausgabe beim einfachen Drücken funktionieren Befehls-, Wahl- und Umschalttaste weiterhin in jedem Kurzbefehl; nur ein langes Halten allein oder ein Doppeltippen löst etwas aus: Halte die rechte Befehlstaste für Spotlight, tippe sie doppelt für Launchpad, halte die rechte Wahltaste für Diktieren, halte die rechte Umschalttaste für Mission Control. Haltezeit und Doppeltipp-Zeitfenster werden pro Zeile festgelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una tecla modificadora puede tener una segunda función sin perder la primera. Sin salida en la pulsación simple, Comando, Opción y Mayúsculas siguen funcionando en todos los atajos; solo una pulsación larga por sí sola, o un doble toque, activa algo: mantén Comando derecho para Spotlight, púlsala dos veces para Launchpad, mantén Opción derecha para Dictado, mantén Mayúsculas derecha para Mission Control. El tiempo de pulsación y la ventana del doble toque se ajustan por fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muokkausnäppäimellä voi olla toinenkin tehtävä menettämättä ensimmäistä. Kun tavallisella painalluksella ei ole ulostuloa, Komento, Optio ja Vaihto toimivat edelleen kaikissa oikoteissä. Vain pitkä pito yksinään tai kaksoisnapautus laukaisee jotain: pidä oikeaa Komentoa painettuna Spotlightia varten, napauta sitä kahdesti Launchpadia varten, pidä oikeaa Optiota painettuna Sanelua varten, pidä oikeaa Vaihtoa painettuna Mission Controlia varten. Pitoaika ja kaksoisnapautuksen aikaikkuna asetetaan rivikohtaisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une touche de modification peut avoir une seconde fonction sans perdre la première. Sans sortie sur l’appui simple, Commande, Option et Maj continuent de fonctionner dans tous les raccourcis ; seul un maintien prolongé de la touche seule, ou un double toucher, déclenche une action : maintenez Commande droite pour Spotlight, touchez-la deux fois pour Launchpad, maintenez Option droite pour la dictée, maintenez Maj droite pour Mission Control. La durée de maintien et l’intervalle du double toucher se règlent par ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מקש צירוף יכול למלא תפקיד שני בלי לאבד את הראשון. כשאין פלט ללחיצה רגילה, Command, Option ו-Shift ממשיכים לעבוד בכל קיצור; רק החזקה ארוכה לבדה או הקשה כפולה מפעילות משהו: החזק Command ימני עבור Spotlight, הקש עליו פעמיים עבור Launchpad, החזק Option ימני עבור הכתבה, החזק Shift ימני עבור Mission Control. זמן ההחזקה וחלון ההקשה הכפולה נקבעים לכל שורה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A módosítóbillentyű második feladatot is kaphat az első elvesztése nélkül. Ha a sima lenyomáshoz nincs kimenet, a Command, az Option és a Shift minden billentyűparancsban a megszokott módon működik; csak az önmagában tartott hosszú nyomás vagy a dupla koppintás indít el valamit: a jobb oldali Command nyomva tartása a Spotlightot, dupla koppintása a Launchpadet, a jobb oldali Option nyomva tartása a Diktálást, a jobb oldali Shift nyomva tartása a Mission Controlt. A nyomvatartási idő és a dupla koppintás időablaka soronként állítható."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol pengubah dapat memiliki fungsi kedua tanpa kehilangan fungsi pertamanya. Tanpa output pada penekanan biasa, Command, Option, dan Shift tetap berfungsi di setiap pintasan; hanya penahanan lama sendirian, atau ketukan dua kali, yang memicu sesuatu: tahan Command kanan untuk Spotlight, ketuk dua kali untuk Launchpad, tahan Option kanan untuk Dikte, tahan Shift kanan untuk Mission Control. Waktu penahanan dan jeda ketuk dua kali diatur per baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un tasto modificatore può svolgere una seconda funzione senza perdere la prima. Senza alcun output sulla semplice pressione, Comando, Opzione e Maiuscole continuano a funzionare in ogni scorciatoia; solo una pressione prolungata da solo, o un doppio tocco, attiva qualcosa: tieni premuto Comando a destra per Spotlight, toccalo due volte per Launchpad, tieni premuto Opzione a destra per la Dettatura, tieni premuto Maiuscole a destra per Mission Control. Il tempo di pressione e l’intervallo del doppio tocco si impostano per ogni riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーに、本来の役割を失わずに2つ目の役割を持たせられます。通常の押下に出力を設定しなければ、Command、Option、Shiftはどのショートカットでも通常どおり使え、単独での長押しかダブルタップだけが動作を実行します。右Commandを長押しでSpotlight、ダブルタップでLaunchpad、右Optionを長押しで音声入力、右Shiftを長押しでMission Control。長押しの時間とダブルタップの受付時間は行ごとに設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수정자 키는 원래 기능을 잃지 않고 두 번째 역할을 맡을 수 있습니다. 기본 누르기에 출력이 없으면 Command, Option, Shift는 모든 단축키에서 계속 작동하며, 단독으로 길게 누르거나 두 번 탭할 때만 동작이 실행됩니다. 오른쪽 Command를 길게 누르면 Spotlight, 두 번 탭하면 Launchpad, 오른쪽 Option을 길게 누르면 받아쓰기, 오른쪽 Shift를 길게 누르면 Mission Control이 실행됩니다. 누르고 있는 시간과 두 번 탭 간격은 행마다 설정합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En modifikatortast kan ha en ekstra jobb uten å miste den første. Uten utdata på vanlig trykk fungerer Kommando, Valg og Skift i alle snarveier som før. Bare en lang holding alene eller et dobbelttrykk utløser noe: hold høyre Kommando for Spotlight, dobbelttrykk for Launchpad, hold høyre Valg for Diktering, hold høyre Skift for Mission Control. Holdetiden og dobbelttrykkvinduet angis per rad."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wijzigingstoets kan een tweede taak hebben zonder de eerste te verliezen. Zonder uitvoer op de gewone druk blijven Command, Option en Shift in elke sneltoets werken; alleen lang ingedrukt houden op zichzelf, of een dubbeltik, activeert iets: houd de rechter Command ingedrukt voor Spotlight, tik er twee keer op voor Launchpad, houd de rechter Option ingedrukt voor Dicteren, houd de rechter Shift ingedrukt voor Mission Control. De ingedrukt-tijd en het dubbeltikvenster worden per rij ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klawisz modyfikujący może pełnić drugą funkcję bez utraty pierwszej. Bez wyjścia przypisanego do zwykłego naciśnięcia klawisze Command, Option i Shift nadal działają w każdym skrócie. Coś uruchamia tylko długie przytrzymanie samego klawisza lub dwukrotne dotknięcie: przytrzymaj prawy Command, aby otworzyć Spotlight, dotknij go dwukrotnie dla Launchpada, przytrzymaj prawy Option dla Dyktowania, przytrzymaj prawy Shift dla Mission Control. Czas przytrzymania i okno dwukrotnego dotknięcia ustawia się osobno dla każdego wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma tecla modificadora pode ter uma segunda função sem perder a primeira. Sem saída no pressionamento simples, Command, Option e Shift continuam funcionando em todos os atalhos; só um toque longo sozinha, ou um toque duplo, aciona algo: segure Command direito para o Spotlight, toque duas vezes para o Launchpad, segure Option direito para o Ditado, segure Shift direito para o Mission Control. O tempo de pressão e a janela do toque duplo são definidos por linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиша-модификатор может выполнять вторую функцию, не теряя первую. Если у обычного нажатия нет вывода, Command, Option и Shift продолжают работать во всех сочетаниях; срабатывает только долгое удержание самой клавиши или двойное нажатие: удерживайте правый Command для Spotlight, дважды нажмите его для Launchpad, удерживайте правый Option для диктовки, удерживайте правый Shift для Mission Control. Время удержания и интервал двойного нажатия задаются для каждой строки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifikačný kláves môže mať druhú úlohu bez straty prvej. Bez výstupu pri obyčajnom stlačení fungujú Command, Option a Shift naďalej v každej skratke; iba dlhé podržanie samotného klávesu alebo dvojité ťuknutie niečo spustí: podržte pravý Command pre Spotlight, dvakrát naň ťuknite pre Launchpad, podržte pravý Option pre Diktovanie, podržte pravý Shift pre Mission Control. Čas podržania a okno dvojitého ťuknutia sa nastavujú pre každý riadok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En modifieringstangent kan ha ett andra jobb utan att förlora det första. Utan någon utdata vid ett vanligt tryck fortsätter Kommando, Alternativ och Skift att fungera i alla genvägar. Bara ett långt håll ensamt, eller ett dubbeltryck, utlöser något: håll höger Kommando för Spotlight, dubbeltryck på den för Launchpad, håll höger Alternativ för Diktering, håll höger Skift för Mission Control. Håll-tiden och tidsfönstret för dubbeltryck ställs in per rad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แป้นตัวปรับเปลี่ยนสามารถมีหน้าที่ที่สองได้โดยไม่เสียหน้าที่แรก เมื่อไม่มีเอาต์พุตสำหรับการกดธรรมดา Command, Option และ Shift จะยังใช้งานได้ในทุกแป้นพิมพ์ลัด มีเพียงการกดค้างนานๆ ตามลำพัง หรือการแตะสองครั้งเท่านั้นที่ทำงานบางอย่าง: กด Command ขวาค้างเพื่อเปิด Spotlight แตะสองครั้งเพื่อเปิด Launchpad กด Option ขวาค้างเพื่อเปิดการป้อนด้วยเสียง กด Shift ขวาค้างเพื่อเปิด Mission Control เวลากดค้างและช่วงเวลาแตะสองครั้งตั้งค่าได้ทีละแถว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir değiştirici tuş, ilk işlevini kaybetmeden ikinci bir işi de taşıyabilir. Düz basışta çıkış yokken Command, Option ve Shift her kısayolda çalışmaya devam eder; yalnızca tek başına uzun basma ya da çift dokunma bir şey tetikler: Spotlight için sağ Command’ı basılı tutun, Launchpad için çift dokunun, Dikte için sağ Option’ı basılı tutun, Mission Control için sağ Shift’i basılı tutun. Basılı tutma süresi ve çift dokunma aralığı satır başına ayarlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавіша-модифікатор може виконувати другу роль, не втрачаючи першої. Якщо для звичайного натискання вихід не задано, Command, Option і Shift продовжують працювати в кожному скороченні; лише довге утримання самої клавіші або подвійне торкання запускає дію: утримуйте правий Command для Spotlight, двічі торкніться його для Launchpad, утримуйте правий Option для диктування, утримуйте правий Shift для Mission Control. Час утримання та вікно подвійного торкання задаються для кожного рядка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một phím bổ trợ có thể đảm nhận công việc thứ hai mà không mất đi công việc đầu tiên. Khi lần nhấn thường không có đầu ra, Command, Option và Shift vẫn hoạt động trong mọi phím tắt; chỉ khi giữ lâu một mình hoặc nhấn đúp mới kích hoạt một việc gì đó: giữ Command bên phải để mở Spotlight, nhấn đúp để mở Launchpad, giữ Option bên phải để mở Đọc chính tả, giữ Shift bên phải để mở Mission Control. Thời gian giữ và khoảng thời gian nhấn đúp được đặt riêng cho từng hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修饰键可以在不失去原有功能的同时承担第二项任务。在普通按下未设置输出时，Command、Option 和 Shift 在所有快捷键中照常工作；只有单独长按或连按两次才会触发操作：长按右 Command 打开聚焦，连按两次打开启动台，长按右 Option 开始听写，长按右 Shift 打开调度中心。按住时间和连按间隔按行分别设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾鍵可以在不失去原有功能的情況下兼具第二項功能。在單獨按下時沒有輸出的情況下，Command、Option 和 Shift 在所有快速鍵中仍可運作；只有單獨長按或連點兩下時才會觸發動作：長按右 Command 開啟 Spotlight，連點兩下開啟 Launchpad，長按右 Option 開啟聽寫，長按右 Shift 開啟 Mission Control。長按時間和連點兩下的時限依每列設定。"
          }
        }
      }
    },
    "A mouse side button can be kept from also going Back in a browser" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن منع زر الماوس الجانبي من الرجوع أيضًا في المتصفح"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lze zabránit tomu, aby boční tlačítko myši v prohlížeči zároveň vracelo zpět"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En museknap på siden kan forhindres i også at gå tilbage i en browser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine seitliche Maustaste kann daran gehindert werden, in einem Browser zusätzlich „Zurück“ auszulösen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se puede evitar que un botón lateral del ratón también haga Atrás en un navegador"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiiren sivupainike voidaan estää toimimasta samalla Takaisin-painikkeena selaimessa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton latéral de souris peut ne plus déclencher aussi Retour dans un navigateur"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר למנוע מלחצן צד בעכבר לחזור אחורה גם בדפדפן"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egér oldalsó gombja megakadályozható abban, hogy böngészőben egyúttal Vissza műveletet is indítson"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol samping tetikus dapat dicegah agar tidak juga berfungsi sebagai Kembali di browser"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si può evitare che un pulsante laterale del mouse esegua anche Indietro in un browser"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスのサイドボタンが、ブラウザで「戻る」としても動作しないようにできます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스 측면 버튼이 브라우저에서 ‘뒤로’로도 동작하지 않게 할 수 있음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En museknapp på siden kan hindres i også å gå Tilbake i en nettleser"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zijknop van de muis kan voorkomen dat hij in een browser ook Terug uitvoert"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boczny przycisk myszy można powstrzymać przed jednoczesnym cofaniem w przeglądarce"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão lateral do mouse pode ser impedido de também acionar Voltar no navegador"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Боковую кнопку мыши можно сделать так, чтобы она не вызывала ещё и «Назад» в браузере"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bočnému tlačidlu myši sa dá zabrániť, aby v prehliadači zároveň fungovalo ako Späť"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sidoknapp på musen kan hindras från att också gå Bakåt i en webbläsare"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้องกันไม่ให้ปุ่มด้านข้างของเมาส์ทำงานเป็นย้อนกลับในเบราว์เซอร์ด้วยได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fare yan düğmesinin tarayıcıda aynı zamanda Geri işlevi görmesi engellenebilir"
          }
        },
        "uk" : {
          "stringUnit" : {
