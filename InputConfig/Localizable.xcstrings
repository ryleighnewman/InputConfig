          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴급 정지. 모든 동작이 중지되었습니다. 컨트롤러 긴급 정지를 다시 길게 누르면 프리셋이 다시 시작됩니다."
          }
