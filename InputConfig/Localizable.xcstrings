          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream Deck +, + XL, Studio és Module 15: a tárcsák és az érintősáv olvashatók; az app által még nem olvasható Elgato modellek szerepelnek a listán, de nem ajánljuk fel őket"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stream Deck +, + XL, Studio, dan Module 15: kenop dan strip sentuh dibaca; model Elgato yang belum bisa dibaca aplikasi tercantum, tidak ditawarkan"
          }
        },
        "it" : {
          "stringUnit" : {
