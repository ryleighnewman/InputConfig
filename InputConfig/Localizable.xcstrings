    "Turn the travel over before checking the band, so a band at the top fires at the bottom." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقلب المشوار قبل فحص النطاق، بحيث يعمل النطاق الموجود في الأعلى عند الأسفل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Převrátit zdvih před kontrolou pásma, takže pásmo nahoře se spustí dole."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vend udslaget om, før båndet kontrolleres, så et bånd øverst udløses nederst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe den Weg um, bevor der Bereich geprüft wird, sodass ein Bereich oben unten auslöst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da la vuelta al recorrido antes de comprobar la banda, de modo que una banda arriba se active abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käännä liikerata ylösalaisin ennen alueen tarkistamista, jolloin ylhäällä oleva alue laukeaa alhaalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retourne la course avant de vérifier la bande, donc une bande en haut se déclenche en bas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפוך את המהלך לפני בדיקת הפס, כך שפס שבחלק העליון מופעל בחלק התחתון."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megfordítja az utat a sáv ellenőrzése előtt, így a felül lévő sáv alul aktiválódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membalik jarak gerak sebelum memeriksa pita, sehingga pita di atas aktif di bawah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capovolgi la corsa prima di controllare la fascia, così una fascia in alto si attiva in basso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帯を判定する前に可動範囲を上下反転させるため、上端の帯が下端で動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구간을 확인하기 전에 이동 범위를 뒤집으므로, 맨 위 구간이 맨 아래에서 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snu utslaget før båndet sjekkes, så et bånd øverst utløses nederst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draai de beweging om voordat het gebied wordt gecontroleerd, zodat een gebied bovenaan onderaan wordt geactiveerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwróć skok przed sprawdzeniem pasma, aby pasmo na górze uruchamiało się na dole."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vire o curso do avesso antes de verificar a faixa, de modo que uma faixa no topo dispare embaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевернуть ход перед проверкой полосы, чтобы полоса вверху срабатывала внизу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevrátiť zdvih pred kontrolou pásma, takže pásmo hore sa spustí dole."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänd på utslaget innan bandet kontrolleras, så att ett band högst upp utlöses längst ned."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลับระยะเคลื่อนที่ก่อนตรวจช่วง ช่วงที่อยู่ด้านบนจึงทำงานที่ด้านล่าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandı kontrol etmeden önce yolu ters çevirin; böylece üstteki bir bant altta tetiklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевернути хід перед перевіркою смуги, щоб смуга вгорі спрацьовувала внизу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đảo ngược hành trình trước khi kiểm tra dải, để dải ở trên cùng kích hoạt ở dưới cùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在检查区段之前先翻转行程，因此位于顶部的区段会在底部触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在檢查區段之前先翻轉行程，因此位於頂部的區段會在底部觸發。"
          }
        }
      }
    },
