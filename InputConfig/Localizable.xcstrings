    "These buttons at the top take you home, open your Statistics, and open Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الأزرار في الأعلى تعيدك إلى الصفحة الرئيسية، وتفتح الإحصاءات، وتفتح الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítka nahoře vás vrátí na úvod, otevřou statistiky a otevřou nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med knapperne øverst kommer du til forsiden, åbner din statistik og åbner indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesen Tasten oben kommst du zur Startseite, zu deinen Statistiken und zu den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos botones de arriba te llevan al inicio, abren tus estadísticas y abren los ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylhäällä olevista painikkeista pääset alkuun, tilastoihin ja asetuksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
