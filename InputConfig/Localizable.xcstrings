        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nová skupina Prístupnosť v Systémovej funkcii: Spustiť diktovanie, Prečítať výber, Priblíženie zap. / vyp., Priblížiť a Oddialiť, takže skratky prístupnosti už netreba skladať ručne z kombinácií klávesov"
