        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバインディングを記録するには、コントローラのボタン、キー、軸を操作してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 바인딩을 기록하려면 컨트롤러의 버튼, 키 또는 축을 누르세요"
          }
        },
        "nb" : {
          "stringUnit" : {
