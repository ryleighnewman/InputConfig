          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här tangenten skriver inte längre något någonstans på Macen. En funktionstangent undviker det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แป้นนี้จะไม่พิมพ์ที่ใดบน Mac อีกต่อไป แป้นฟังก์ชันหลีกเลี่ยงได้"
