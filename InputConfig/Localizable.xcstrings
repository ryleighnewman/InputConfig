    "How to get a clean reading" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيفية الحصول على قراءة نظيفة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jak získat čisté čtení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
