    "Settings: choose the menu bar icon, a spoken feedback voice, Next and Previous Preset, and Reset Settings" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإعدادات: اختر أيقونة شريط القوائم، وصوت التغذية الراجعة المنطوقة، والإعداد المسبق التالي والسابق، و«إعادة ضبط الإعدادات»"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení: vyberte ikonu v řádku nabídek, hlas mluvené odezvy, Další a Předchozí předvolbu a Resetovat nastavení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger: vælg symbolet i menulinjen, en stemme til oplæst feedback, Næste og Forrige forudindstilling og Nulstil indstillinger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen: Menüleistensymbol wählen, eine Stimme für gesprochenes Feedback, nächstes und vorheriges Preset sowie Einstellungen zurücksetzen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes: elige el icono de la barra de menús, una voz de respuesta hablada, Preajuste siguiente y anterior, y Restablecer ajustes"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asetukset: valitse valikkorivin kuvake, puhutun palautteen ääni, Seuraava ja Edellinen esiasetus sekä Nollaa asetukset"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages : choisissez l’icône de la barre des menus, une voix de retour parlé, Préréglage suivant et précédent, et Réinitialiser les réglages"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות: בחר את סמל שורת התפריטים, קול למשוב קולי, הפריסט הבא והקודם, ואיפוס הגדרות"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beállítások: válassza ki a menüsorikont, a hangos visszajelzés hangját, a Következő és Előző előbeállítást, valamint a Beállítások visszaállítását"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan: pilih ikon bar menu, suara umpan balik lisan, Preset Berikutnya dan Sebelumnya, dan Reset Pengaturan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni: scegli l’icona nella barra dei menu, una voce per il feedback parlato, Preset successivo e precedente, e Reimposta impostazioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定: メニューバーアイコン、音声フィードバックの声、次のプリセットと前のプリセット、設定のリセットを選べます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정: 메뉴 막대 아이콘, 음성 피드백 음성, 다음 및 이전 프리셋, 설정 재설정을 선택"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger: velg ikonet i menylinjen, en stemme for talt tilbakemelding, Neste og Forrige forhåndsinnstilling, og Nullstill innstillinger"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen: kies het menubalkicoon, een stem voor gesproken feedback, Volgende en Vorige preset, en Stel instellingen opnieuw in"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia: wybierz ikonę na pasku menu, głos komunikatów mówionych, Następny i Poprzedni preset oraz Resetuj ustawienia"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes: escolha o ícone da barra de menus, uma voz de resposta falada, Próximo e Anterior preset e Redefinir ajustes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки: выбор значка в строке меню, голоса озвучивания, «Следующий» и «Предыдущий пресет» и «Сбросить настройки»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavenia: vyberte ikonu lišty ponuky, hlas hovorenej odozvy, Ďalšiu a Predchádzajúcu predvoľbu a Obnoviť nastavenia"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar: välj menyradsikon, en röst för talad återkoppling, Nästa och Föregående förinställning samt Återställ inställningar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
