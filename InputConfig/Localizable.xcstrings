    "One press fires key + click + MIDI + speech in parallel. Different from a macro: all at once, not in sequence." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغطة واحدة تُطلق مفتاحًا ونقرة وMIDI وكلامًا بالتوازي. يختلف عن الماكرو: دفعة واحدة، لا بالتسلسل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden stisk spustí současně klávesu + kliknutí + MIDI + řeč. Na rozdíl od makra: vše najednou, ne po sobě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ét tryk udløser tast + klik + MIDI + tale parallelt. Forskelligt fra en makro: alt på én gang, ikke i rækkefølge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Drücken löst Taste + Klick + MIDI + Sprache parallel aus. Anders als ein Makro: alles auf einmal, nicht nacheinander."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pulsación activa tecla + clic + MIDI + voz en paralelo. Distinto de una macro: todo a la vez, no en secuencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi painallus laukaisee näppäimen + napsautuksen + MIDIn + puheen yhtä aikaa. Eri asia kuin makro: kaikki kerralla, ei peräkkäin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un appui déclenche touche + clic + MIDI + voix en parallèle. À la différence d’une macro : tout en même temps, pas en séquence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה אחת מפעילה מקש + לחיצה + MIDI + דיבור במקביל. שונה ממאקרו: הכול בבת אחת, לא ברצף."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy lenyomás billentyűt + kattintást + MIDI-t + beszédet aktivál párhuzamosan. Eltér a makrótól: egyszerre, nem sorban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu tekanan memicu tombol + klik + MIDI + ucapan secara paralel. Berbeda dari makro: sekaligus, bukan berurutan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pressione attiva tasto + clic + MIDI + voce in parallelo. Diverso da una macro: tutto insieme, non in sequenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回の押下で、キー、クリック、MIDI、読み上げを並行して実行します。マクロとは異なり、順番ではなく同時に実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 누르면 키 + 클릭 + MIDI + 음성이 동시에 실행됩니다. 순서대로 실행하는 매크로와 달리 모두 한꺼번에 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett trykk utløser tast + klikk + MIDI + tale parallelt. Annerledes enn en makro: alt samtidig, ikke i rekkefølge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén druk activeert toets + klik + MIDI + spraak parallel. Anders dan een macro: allemaal tegelijk, niet achter elkaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno naciśnięcie uruchamia równolegle klawisz, kliknięcie, MIDI i mowę. W odróżnieniu od makra: wszystko naraz, a nie po kolei."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pressionamento dispara tecla + clique + MIDI + fala em paralelo. Diferente de uma macro: tudo ao mesmo tempo, não em sequência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно нажатие запускает клавишу, клик, MIDI и речь одновременно. В отличие от макроса: всё сразу, а не по порядку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno stlačenie spustí kláves + kliknutie + MIDI + reč paralelne. Líši sa od makra: všetko naraz, nie postupne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett tryck utlöser tangent + klick + MIDI + tal parallellt. Annorlunda än ett makro: allt på en gång, inte i sekvens."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกดครั้งเดียวสั่งแป้น + คลิก + MIDI + เสียงพูดพร้อมกัน ต่างจากมาโคร: ทั้งหมดในครั้งเดียว ไม่ใช่ตามลำดับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek basış tuş + tıklama + MIDI + konuşmayı paralel tetikler. Makrodan farklı: sırayla değil, hepsi bir arada."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одне натискання запускає клавішу + клацання + MIDI + мовлення паралельно. Відрізняється від макросу: усе одразу, а не послідовно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lần nhấn kích hoạt phím + nhấp + MIDI + giọng nói song song. Khác với macro: tất cả cùng lúc, không theo trình tự."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次按下会同时触发按键 + 点按 + MIDI + 语音。与宏不同：同时发生，而非依次进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次按下同時觸發按鍵、點按、MIDI 和語音。與巨集不同：全部同時，而不是依序。"
          }
        }
      }
    },
    "One press turns the output on and leaves it on. The next press turns it off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضغطة واحدة تشغّل المخرج وتتركه قيد التشغيل. الضغطة التالية توقفه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden stisk výstup zapne a nechá zapnutý. Další stisk ho vypne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ét tryk slår outputtet til og lader det være til. Næste tryk slår det fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Drücken schaltet die Ausgabe ein und lässt sie an. Das nächste Drücken schaltet sie aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pulsación activa la salida y la deja activada. La siguiente pulsación la desactiva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
