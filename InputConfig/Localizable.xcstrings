    "Same as the system follows System Settings, General, Language and Region, where you can also set a language for InputConfig alone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«مثل النظام» يتبع إعدادات النظام، عام، اللغة والمنطقة، حيث يمكنك أيضًا ضبط لغة لـ InputConfig وحده."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stejně jako systém se řídí Nastavením systému, Obecné, Jazyk a oblast, kde můžete nastavit i jazyk jen pro InputConfig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samme som systemet følger Systemindstillinger, Generelt, Sprog og region, hvor du også kan angive et sprog kun til InputConfig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wie das System“ folgt den Systemeinstellungen unter „Allgemein“ > „Sprache & Region“, wo du auch eine Sprache nur für InputConfig festlegen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igual que el sistema sigue Ajustes del Sistema, General, Idioma y región, donde también puedes establecer un idioma solo para InputConfig."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama kuin järjestelmä seuraa kohtaa Järjestelmäasetukset, Yleiset, Kieli ja alue, jossa voi asettaa kielen myös pelkälle InputConfigille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identique au système suit Réglages Système, Général, Langue et région, où vous pouvez aussi définir une langue pour InputConfig seul."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״כמו המערכת״ עוקב אחרי ״הגדרות המערכת״, ״כללי״, ״שפה ואזור״, שם אפשר גם להגדיר שפה ל-InputConfig בלבד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mint a rendszeré a Rendszerbeállítások, Általános, Nyelv és terület beállítást követi, ahol az InputConfignak külön nyelvet is megadhat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sama seperti sistem mengikuti Pengaturan Sistem, Umum, Bahasa & Wilayah, tempat Anda juga dapat mengatur bahasa untuk InputConfig saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come il sistema segue Impostazioni di Sistema, Generali, Lingua e zona, dove puoi anche impostare una lingua solo per InputConfig."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システムと同じ」は「システム設定」>「一般」>「言語と地域」に従います。そこでInputConfigだけの言語を設定することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
