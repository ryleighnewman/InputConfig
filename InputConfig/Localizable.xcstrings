    "Read the tilt the other way round: this row fires when the controller moves opposite to its named direction." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ الإمالة بالعكس: يُطلق هذا الصف عندما يتحرك ذراع التحكم عكس اتجاهه المسمى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Číst náklon obráceně: tento řádek se spustí, když se ovladač pohne proti pojmenovanému směru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs hældningen omvendt: denne række udløses, når controlleren bevæger sig modsat sin angivne retning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies die Neigung andersherum: Diese Zeile löst aus, wenn sich der Controller entgegen seiner benannten Richtung bewegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee la inclinación al revés: esta fila se activa cuando el mando se mueve en sentido opuesto a su dirección indicada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue kallistus toisinpäin: tämä rivi laukeaa, kun ohjain liikkuu vastakkaiseen suuntaan kuin sen nimetty suunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire l’inclinaison dans l’autre sens : cette ligne se déclenche quand la manette bouge à l’opposé de la direction indiquée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרא את ההטיה בכיוון ההפוך: השורה הזו מופעלת כשהשלט זז בכיוון ההפוך לכיוון בשמו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A dőlés olvasása fordítva: ez a sor akkor aktiválódik, amikor a vezérlő a megnevezett iránnyal ellentétesen mozog."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca kemiringan dengan cara sebaliknya: baris ini aktif saat pengontrol bergerak berlawanan dengan arah yang disebutkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi l’inclinazione al contrario: questa riga si attiva quando il controller si muove in direzione opposta a quella indicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傾きを逆向きに読み取ります: この行は、コントローラが名前の付いた方向と反対に動いたときに動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기울기를 반대로 읽습니다: 컨트롤러가 이름 붙은 방향의 반대로 움직일 때 이 행이 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les helningen motsatt vei: denne raden utløses når kontrolleren beveger seg motsatt av retningen den er oppkalt etter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees de kanteling andersom: deze rij wordt geactiveerd wanneer de controller beweegt tegengesteld aan de genoemde richting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuj przechył w drugą stronę: ten wiersz uruchamia się, gdy kontroler porusza się przeciwnie do nazwanego kierunku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ler a inclinação ao contrário: esta linha dispara quando o controle se move no sentido oposto ao da direção nomeada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читать наклон наоборот: эта строка срабатывает, когда контроллер движется противоположно названному направлению."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čítať náklon opačne: tento riadok sa spustí, keď sa ovládač pohne opačne k svojmu pomenovanému smeru."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs lutningen åt andra hållet: den här raden utlöses när spelkontrollen rör sig motsatt sin namngivna riktning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านการเอียงในทิศตรงข้าม: แถวนี้ทำงานเมื่อคอนโทรลเลอร์เคลื่อนตรงข้ามกับทิศทางที่ระบุ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eğimi ters okuyun: bu satır, kumanda adlandırılan yönün tersine hareket ettiğinde tetiklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зчитувати нахил навпаки: цей рядок спрацьовує, коли контролер рухається проти названого напрямку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc độ nghiêng theo chiều ngược lại: hàng này kích hoạt khi bộ điều khiển di chuyển ngược với hướng đã đặt tên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
