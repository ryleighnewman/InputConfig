    "Macro steps can send keyboard shortcuts, a row can repeat a held key like a real keyboard, and a repeating macro waits between passes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لخطوات الماكرو إرسال اختصارات لوحة المفاتيح، ويمكن لصف تكرار مفتاح مضغوط كلوحة مفاتيح حقيقية، وينتظر الماكرو المتكرر بين الدورات"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky makra mohou odesílat klávesové zkratky, řádek může opakovat drženou klávesu jako skutečná klávesnice a opakující se makro čeká mezi průchody"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makrotrin kan sende tastaturgenveje, en række kan gentage en holdt tast som et rigtigt tastatur, og en gentagende makro venter mellem gennemløb"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makroschritte können Tastaturkurzbefehle senden, eine Zeile kann eine gehaltene Taste wie eine echte Tastatur wiederholen, und ein sich wiederholendes Makro wartet zwischen den Durchläufen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pasos de una macro pueden enviar atajos de teclado, una fila puede repetir una tecla mantenida como un teclado real, y una macro repetida espera entre pasadas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makrovaiheet voivat lähettää näppäimistöoikoteitä, rivi voi toistaa pidettyä näppäintä kuten oikea näppäimistö, ja toistuva makro odottaa kierrosten välillä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes d’une macro peuvent envoyer des raccourcis clavier, une ligne peut répéter une touche maintenue comme un vrai clavier, et une macro répétée attend entre les passages"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלבי מאקרו יכולים לשלוח קיצורי מקלדת, שורה יכולה לחזור על מקש מוחזק כמו מקלדת אמיתית, ומאקרו חוזר ממתין בין מעברים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A makrólépések billentyűparancsokat küldhetnek, a sor ismételhet egy nyomva tartott billentyűt, mint egy valódi billentyűzet, az ismétlődő makró pedig vár a menetek között"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah makro dapat mengirim pintasan papan ketik, baris dapat mengulang tombol yang ditahan seperti papan ketik sungguhan, dan makro berulang menunggu di antara putaran"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I passaggi delle macro possono inviare scorciatoie da tastiera, una riga può ripetere un tasto tenuto premuto come una vera tastiera, e una macro ripetuta attende tra un passaggio e l’altro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロのステップでキーボードショートカットを送信できるようになり、行は押し続けたキーを本物のキーボードのように繰り返せ、繰り返すマクロは各回の間で待機します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로 단계가 키보드 단축키를 보낼 수 있고, 행이 실제 키보드처럼 누르고 있는 키를 반복할 수 있으며, 반복되는 매크로는 반복 사이에 대기함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makrotrinn kan sende tastatursnarveier, en rad kan gjenta en holdt tast som et ekte tastatur, og en repeterende makro venter mellom gjennomkjøringene"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macrostappen kunnen sneltoetsen sturen, een rij kan een ingedrukte toets herhalen zoals een echt toetsenbord, en een herhalende macro wacht tussen de rondes"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroki makra mogą wysyłać skróty klawiszowe, wiersz może powtarzać przytrzymany klawisz jak prawdziwa klawiatura, a powtarzane makro czeka między przebiegami"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os passos de macro podem enviar atalhos de teclado, uma linha pode repetir uma tecla segurada como um teclado de verdade, e uma macro repetida espera entre as passagens"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаги макроса могут отправлять сочетания клавиш, строка может повторять удерживаемую клавишу, как настоящая клавиатура, а повторяющийся макрос ждёт между проходами"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kroky makra môžu posielať klávesové skratky, riadok môže opakovať podržaný kláves ako skutočná klávesnica a opakujúce sa makro čaká medzi prechodmi"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makrosteg kan skicka tangentbordsgenvägar, en rad kan upprepa en hållen tangent som ett riktigt tangentbord, och ett upprepande makro väntar mellan varven"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขั้นตอนมาโครส่งแป้นพิมพ์ลัดได้ แถวทำซ้ำแป้นที่กดค้างได้เหมือนแป้นพิมพ์จริง และมาโครที่ทำซ้ำจะรอระหว่างรอบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro adımları klavye kısayolları gönderebilir, bir satır basılı tuşu gerçek bir klavye gibi tekrarlayabilir ve tekrarlayan bir makro geçişler arasında bekler"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кроки макросу можуть надсилати клавішні скорочення, рядок може повторювати утримувану клавішу, як справжня клавіатура, а макрос, що повторюється, чекає між проходами"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bước macro có thể gửi phím tắt bàn phím, một hàng có thể lặp lại phím được giữ như bàn phím thật, và macro lặp sẽ chờ giữa các lượt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏步骤可以发送键盘快捷键，一行可以像真实键盘一样重复按住的按键，重复的宏会在每轮之间等待"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集步驟可送出鍵盤快速鍵，列可像真正的鍵盤一樣重複按住的按鍵，而重複的巨集會在每輪之間等待"
          }
        }
      }
    },
    "macro, %lld steps" : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
