        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋이 활성화되면 자동으로 적용되고, 중지하면 되돌려집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes automatisk når forhåndsinnstillingen aktiveres. Tilbakestilles ved stopp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch toegepast wanneer de preset wordt geactiveerd; wordt teruggezet bij stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stosuje się automatycznie po aktywacji presetu i wraca do poprzedniego stanu po zatrzymaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicado automaticamente quando o preset é ativado; revertido ao parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется автоматически при включении пресета; отменяется при остановке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije sa automaticky pri aktivácii predvoľby; po zastavení sa vráti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillämpas automatiskt när förinställningen aktiveras och återställs när den stoppas."
          }
        },
