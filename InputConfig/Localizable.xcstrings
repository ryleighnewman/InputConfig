    "Fires anywhere past the deadzone, or only inside a region you pick." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل في أي مكان بعد المنطقة الميتة، أو داخل منطقة تختارها فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí se kdekoli za mrtvou zónou, nebo jen uvnitř oblasti, kterou vyberete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløses overalt uden for dødzonen, eller kun inde i et område, du vælger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst überall jenseits der Totzone aus oder nur in einem Bereich, den du wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activa en cualquier lugar pasada la zona muerta, o solo dentro de una región que elijas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laukeaa missä tahansa kuolleen alueen ulkopuolella tai vain valitsemasi alueen sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déclenche partout au-delà de la zone morte, ou seulement dans une zone que vous choisissez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מופעל בכל מקום מעבר לאזור המת, או רק בתוך אזור שתבחר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A holtzónán túl bárhol működik, vagy csak egy általad választott területen belül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktif di mana saja di luar zona mati, atau hanya di dalam wilayah yang kamu pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta ovunque oltre la zona morta, o solo dentro una regione che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デッドゾーンを越えればどこでも、または選んだ領域の中だけで実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데드존을 지나면 어디서나, 또는 고른 영역 안에서만 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløses overalt utenfor dødsonen, eller bare inne i et område du velger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat overal voorbij de dode zone af, of alleen binnen een gebied dat je kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa wszędzie poza martwą strefą albo tylko w wybranym obszarze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispara em qualquer lugar além da zona morta, ou só dentro de uma região que você escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срабатывает везде за мёртвой зоной или только внутри выбранной области."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí sa kdekoľvek za mŕtvou zónou alebo len vo vybranej oblasti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utlöses var som helst utanför dödzonen, eller bara inuti en region du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานทุกที่ที่เลยเดดโซน หรือเฉพาะในพื้นที่ที่คุณเลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ölü bölgenin ötesinde her yerde ya da yalnızca seçtiğiniz bir bölgede çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрацьовує будь-де за мертвою зоною або лише в області, яку ви виберете."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kích hoạt ở bất kỳ đâu ngoài vùng chết, hoặc chỉ bên trong vùng bạn chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越过死区后在任意位置触发，或只在你选的区域内触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越過死區後在任意位置觸發，或只在你選的區域內觸發。"
          }
        }
      }
    },
    "Fires only while %@ are held. A plain row on the same control stays quiet while the chord is held." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطلق فقط أثناء الضغط على %@. يبقى الصف العادي على عنصر التحكم نفسه صامتًا أثناء ضغط التركيبة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí se jen při podržení %@. Běžný řádek na stejném ovládacím prvku zůstává tichý, dokud je kombinace držena."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udløses kun, mens %@ holdes nede. En almindelig række på samme kontrol forholder sig stille, mens tastekombinationen holdes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst nur aus, solange %@ gehalten werden. Eine einfache Zeile am selben Bedienelement bleibt ruhig, solange die Tastenkombination gehalten wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se activa solo mientras se mantienen %@. Una fila normal en el mismo control permanece en silencio mientras se mantiene la combinación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laukeaa vain, kun %@ on pidettynä. Saman ohjauksen tavallinen rivi pysyy hiljaa yhdistelmän ollessa pidettynä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se déclenche uniquement tant que %@ sont maintenus. Une ligne simple sur la même commande reste silencieuse pendant le maintien de la combinaison."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מופעל רק בזמן ש-%@ לחוצים. שורה רגילה על אותו פקד נשארת שקטה בזמן שהצירוף לחוץ."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak akkor aktiválódik, amíg %@ nyomva van. Ugyanazon a vezérlőn egy sima sor nem szólal meg, amíg a kombináció nyomva van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktif hanya saat %@ ditahan. Baris biasa pada kontrol yang sama tetap diam saat kombinasi ditahan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si attiva solo mentre %@ sono tenuti premuti. Una riga semplice sullo stesso comando resta inattiva mentre la combinazione è tenuta premuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を押している間のみ動作します。同じコントロールの通常の行は、キーの組み合わせを押している間は何もしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 키를 누르고 있는 동안에만 실행됩니다. 같은 컨트롤의 일반 행은 조합을 누르고 있는 동안 작동하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utløses bare mens %@ holdes. En vanlig rad på samme kontroll er stille mens tastekombinasjonen holdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt alleen geactiveerd zolang %@ ingedrukt worden gehouden. Een gewone rij op dezelfde bediening blijft stil zolang de toetscombinatie wordt vastgehouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia się tylko przy przytrzymaniu: %@. Zwykły wiersz na tym samym sterowaniu milczy, gdy kombinacja jest przytrzymana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispara somente enquanto %@ estão seguradas. Uma linha simples no mesmo controle fica quieta enquanto a combinação está segurada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срабатывает, только пока удерживаются %@. Обычная строка для того же элемента управления молчит, пока удерживается сочетание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí sa iba počas podržania %@. Obyčajný riadok na rovnakom ovládacom prvku zostane počas podržania kombinácie ticho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utlöses bara medan %@ hålls. En vanlig rad på samma kontroll är tyst medan tangentkombinationen hålls."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานเฉพาะขณะกด %@ ค้างไว้ แถวธรรมดาบนตัวควบคุมเดียวกันจะเงียบขณะที่ชุดแป้นถูกกดค้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca %@ basılı tutulurken tetiklenir. Tuş birleşimi basılıyken aynı kontroldeki düz bir satır sessiz kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрацьовує, лише поки утримуються %@. Звичайний рядок на тому самому елементі керування мовчить, поки утримується комбінація."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ kích hoạt khi %@ đang được giữ. Một hàng thường trên cùng điều khiển sẽ im lặng khi tổ hợp đang được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在按住 %@ 时触发。同一控件上的普通行在按住组合键期间保持静默。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在按住 %@ 時觸發。同一個控制項上的一般列在按住組合鍵時保持安靜。"
          }
        }
      }
    },
    "Fires only while %@ is held. A plain row on the same control stays quiet while the chord is held." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطلق فقط أثناء الضغط على %@. يبقى الصف العادي على عنصر التحكم نفسه صامتًا أثناء ضغط التركيبة."
          }
        },
        "cs" : {
          "stringUnit" : {
