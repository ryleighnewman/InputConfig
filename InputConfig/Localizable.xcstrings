    "MIDI notes and knobs are added by playing them: add a row and click Scan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُضاف نوتات MIDI ومقابضه بعزفها: أضف صفًا وانقر «فحص»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noty a knoflíky MIDI se přidávají jejich zahráním: přidejte řádek a klikněte na Skenovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI-toner og drejeknapper tilføjes ved at spille dem: tilføj en række, og klik på Scan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI-Noten und -Regler werden durch Spielen hinzugefügt: Füge eine Zeile hinzu und klicke auf „Scannen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas y perillas MIDI se añaden tocándolas: añade una fila y haz clic en Escanear."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI-nuotit ja nupit lisätään soittamalla niitä: lisää rivi ja napsauta Skannaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes et boutons MIDI s’ajoutent en les jouant : ajoutez une ligne et cliquez sur Scanner."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תווים וכפתורי MIDI נוספים בנגינה עליהם: הוסף שורה ולחץ על ״סריקה״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A MIDI-hangok és gombok lejátszással adhatók hozzá: adjon hozzá egy sort, és kattintson a Beolvasásra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada dan kenop MIDI ditambahkan dengan memainkannya: tambahkan baris dan klik Pindai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le note e le manopole MIDI si aggiungono suonandole: aggiungi una riga e fai clic su Scansiona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDIのノートとノブは演奏して追加します。行を追加して「スキャン」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI 노트와 노브는 연주해서 추가합니다: 행을 추가하고 스캔을 클릭하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI-toner og knapper legges til ved å spille dem: legg til en rad og klikk på Skann."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI-noten en knoppen voeg je toe door ze te spelen: voeg een rij toe en klik op Scan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuty i gałki MIDI dodaje się, grając je: dodaj wiersz i kliknij Skanuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas e botões MIDI são adicionados tocando-os: adicione uma linha e clique em Escanear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ноты и ручки MIDI добавляются игрой на них: добавьте строку и нажмите «Сканировать»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noty a ovládače MIDI sa pridávajú ich zahraním: pridajte riadok a kliknite na Skenovať."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI-toner och rattar läggs till genom att spela dem: lägg till en rad och klicka på Skanna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มโน้ตและปุ่มหมุน MIDI โดยการเล่น: เพิ่มแถวแล้วคลิกสแกน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI notaları ve düğmeleri çalınarak eklenir: bir satır ekleyin ve Tara’yı tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ноти й регулятори MIDI додаються їх відтворенням: додайте рядок і натисніть «Сканувати»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nốt và núm MIDI được thêm bằng cách chơi chúng: thêm một hàng và nhấp Quét."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过弹奏来添加 MIDI 音符和旋钮：添加一行并点按“扫描”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI 音符和旋鈕是透過彈奏或轉動來新增的：新增一列並按「掃描」。"
          }
        }
      }
    },
    "MIDI notes, CC, and pitch bend outputs through a built-in virtual MIDI port" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرجات نوتات MIDI وCC وانحناء النغمة عبر منفذ MIDI افتراضي مدمج"
