    "Stop the active preset. Change the rate, then click Resume to start it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف الإعداد المسبق النشط. غيّر المعدل، ثم انقر «استئناف» لبدئه مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastavte aktivní předvolbu. Změňte frekvenci a kliknutím na Pokračovat ji spusťte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop den aktive forudindstilling. Ændr frekvensen, og klik derefter på Genoptag for at starte den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das aktive Preset stoppen. Ändere die Rate und klicke dann auf „Fortsetzen“, um es erneut zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene el preajuste activo. Cambia la frecuencia y haz clic en Reanudar para volver a iniciarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysäytä aktiivinen esiasetus. Muuta taajuutta ja käynnistä se uudelleen napsauttamalla Jatka."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez le préréglage actif. Modifiez la fréquence, puis cliquez sur Reprendre pour le redémarrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצור את הפריסט הפעיל. שנה את הקצב, ואז לחץ על ״המשך״ כדי להפעיל אותו שוב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsa le az aktív előbeállítást. Módosítsa a gyakoriságot, majd kattintson a Folytatásra az újraindításhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan preset aktif. Ubah laju, lalu klik Lanjutkan untuk memulainya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma il preset attivo. Cambia la frequenza, poi fai clic su Riprendi per avviarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなプリセットを停止します。レートを変更してから、「再開」をクリックして再び開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 프리셋을 중지합니다. 속도를 바꾼 다음 재개를 클릭해 다시 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopp den aktive forhåndsinnstillingen. Endre frekvensen, og klikk deretter på Gjenoppta for å starte den igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop de actieve preset. Wijzig de frequentie en klik op Hervat om hem weer te starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymaj aktywny preset. Zmień częstotliwość, a potem kliknij Wznów, aby uruchomić go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare o preset ativo. Mude a taxa e depois clique em Retomar para iniciá-lo de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановите активный пресет. Измените частоту, затем нажмите «Продолжить», чтобы запустить его снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastavte aktívnu predvoľbu. Zmeňte frekvenciu a potom kliknutím na Pokračovať ju spustite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppa den aktiva förinställningen. Ändra frekvensen och klicka sedan på Återuppta för att starta den igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดพรีเซ็ตที่ใช้งานอยู่ เปลี่ยนอัตรา แล้วคลิกทำต่อเพื่อเริ่มอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin ön ayarı durdurun. Hızı değiştirin, ardından yeniden başlatmak için Sürdür’ü tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зупиніть активний пресет. Змініть частоту, потім натисніть «Відновити», щоб запустити його знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dừng cài đặt sẵn đang hoạt động. Đổi tốc độ, rồi nhấp Tiếp tục để bắt đầu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止已启用的预设。更改速率，然后点按“继续”再次启动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止使用中的預設。更改速率後，按「恢復」再次啟動。"
          }
        }
      }
    },
    "Stop the engine and release every held key, button, and note." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف المحرك وحرر كل مفتاح وزر ونوتة مضغوطة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastavit jádro a uvolnit každou drženou klávesu, tlačítko a notu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
