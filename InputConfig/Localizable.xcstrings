    "Press, hold, and double-tap each fire their own outputs. One button, three actions, adjustable timing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضغط والضغط المطوّل والنقر المزدوج يُطلق كل منها مخرجاته الخاصة. زر واحد، ثلاثة إجراءات، وتوقيت قابل للضبط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stisk, podržení a dvojité klepnutí spouštějí každé vlastní výstupy. Jedno tlačítko, tři akce, nastavitelné časování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk, hold og dobbelttap udløser hver deres output. Én knap, tre handlinger, justerbar timing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken, Halten und Doppeltippen lösen jeweils eigene Ausgaben aus. Eine Taste, drei Aktionen, einstellbares Timing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsar, mantener y doble toque activan cada uno sus propias salidas. Un botón, tres acciones, tiempos ajustables."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Painallus, pito ja kaksoisnapautus laukaisevat kukin omat ulostulonsa. Yksi painike, kolme toimintoa, säädettävä ajoitus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appui, le maintien et le double toucher déclenchent chacun leurs propres sorties. Un bouton, trois actions, minutage réglable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחיצה, החזקה והקשה כפולה מפעילות כל אחת פלטים משלה. לחצן אחד, שלוש פעולות, תזמון שאפשר לכוונן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lenyomás, a tartás és a dupla koppintás mind a saját kimenetét aktiválja. Egy gomb, három művelet, állítható időzítés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan, tahan, dan ketuk dua kali masing-masing memicu outputnya sendiri. Satu tombol, tiga tindakan, waktu yang dapat diatur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione, pressione prolungata e doppio tocco attivano ciascuno le proprie uscite. Un pulsante, tre azioni, tempi regolabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押す、長押し、ダブルタップが、それぞれ独自の出力を実行します。1つのボタンで3つのアクション、タイミングも調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누르기, 길게 누르기, 두 번 탭이 각각 자체 출력을 실행합니다. 버튼 하나, 동작 세 개, 조정 가능한 타이밍."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk, hold og dobbelttrykk utløser hver sine utdata. Én knapp, tre handlinger, justerbar timing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drukken, ingedrukt houden en dubbeltikken geven elk hun eigen uitvoer. Eén knop, drie acties, instelbare timing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnięcie, przytrzymanie i dwukrotne dotknięcie uruchamiają własne wyjścia. Jeden przycisk, trzy działania, regulowany czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressionar, segurar e tocar duas vezes disparam, cada um, suas próprias saídas. Um botão, três ações, tempo ajustável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие, удержание и двойное касание вызывают каждое свой вывод. Одна кнопка, три действия, настраиваемое время."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlačenie, podržanie a dvojité ťuknutie spúšťajú každé vlastné výstupy. Jedno tlačidlo, tri akcie, nastaviteľné časovanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck, håll och dubbeltryck utlöser var sin utdata. En knapp, tre åtgärder, justerbar timing."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กด กดค้าง และแตะสองครั้งแต่ละแบบสั่งเอาต์พุตของตัวเอง ปุ่มเดียว สามการทำงาน จังหวะที่ปรับได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basma, basılı tutma ve çift dokunma her biri kendi çıkışını tetikler. Tek düğme, üç eylem, ayarlanabilir zamanlama."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натискання, утримання й подвійне торкання запускають власні виходи. Одна кнопка, три дії, регульований час."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn, giữ và chạm đúp đều kích hoạt đầu ra riêng. Một nút, ba hành động, thời gian điều chỉnh được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下、按住和连按两次各触发自己的输出。一个按钮，三种动作，时序可调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下、長按和連點兩下各自觸發自己的輸出。一個按鈕，三種動作，時間可調。"
          }
        }
      }
    },
