    "Optional extras: auto-launch an app, confine, recenter, or hide the cursor. Expand to set up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافات اختيارية: تشغيل تطبيق تلقائيًا، أو حصر المؤشر أو إعادة توسيطه أو إخفاؤه. وسّع للإعداد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volitelné doplňky: automatické spuštění aplikace, omezení, vracení do středu nebo skrytí kurzoru. Rozbalením je nastavíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrie ekstrafunktioner: start en app automatisk, begræns, centrér eller skjul markøren. Udvid for at indstille."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Extras: eine App automatisch starten, den Cursor begrenzen, zentrieren oder ausblenden. Zum Einrichten ausklappen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extras opcionales: inicio automático de una app, confinar, recentrar u ocultar el cursor. Expande para configurar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinnaisia lisäyksiä: käynnistä appi automaattisesti, rajaa, keskitä uudelleen tai piilota osoitin. Määritä laajentamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extras facultatifs : lancer automatiquement une app, confiner, recentrer ou masquer le curseur. Développez pour configurer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוספות אופציונליות: הפעלה אוטומטית של אפליקציה, הגבלה, מרכוז או הסתרה של הסמן. הרחב כדי להגדיר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcionális extrák: app automatikus indítása, a kurzor korlátozása, középre állítása vagy elrejtése. A beállításhoz bontsa ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahan opsional: buka app otomatis, kurung, pusatkan ulang, atau sembunyikan kursor. Perluas untuk mengatur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra facoltativi: avvio automatico di un’app, confinamento, ricentratura o nascondimento del cursore. Espandi per configurare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意の追加機能: Appの自動起動、カーソルの制限、中央に戻す、カーソルを隠す。展開して設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 사항: 앱 자동 실행, 커서 가두기, 다시 중앙에 놓기, 숨기기. 펼쳐서 설정하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrie ekstrafunksjoner: start en app automatisk, begrens, sentrer på nytt eller skjul pekeren. Utvid for å sette opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionele extra's: een app automatisch starten, de cursor beperken, hercentreren of verbergen. Klap uit om in te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne dodatki: automatyczne uruchamianie aplikacji, ograniczanie, wyśrodkowywanie lub ukrywanie kursora. Rozwiń, aby skonfigurować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extras opcionais: abrir um app automaticamente, confinar, recentralizar ou ocultar o cursor. Expanda para configurar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необязательные дополнения: автозапуск приложения, ограничение, возврат в центр или скрытие курсора. Разверните для настройки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voliteľné extra: automatické spustenie aplikácie, obmedzenie, opätovné vycentrovanie alebo skrytie kurzora. Rozbaľte a nastavte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valfria extrafunktioner: starta en app automatiskt, begränsa, centrera om eller dölj markören. Fäll ut för att ställa in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่วนเสริมที่ไม่บังคับ: เปิดแอปอัตโนมัติ จำกัด จัดกึ่งกลางใหม่ หรือซ่อนเคอร์เซอร์ ขยายเพื่อตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İsteğe bağlı ekstralar: uygulama otomatik başlatma, imleci sınırlama, yeniden ortalama veya gizleme. Ayarlamak için genişletin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необов’язкові додатки: автозапуск програми, обмеження, повернення в центр або приховування курсора. Розгорніть, щоб налаштувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiện ích bổ sung tùy chọn: tự mở một ứng dụng, giới hạn, đưa về giữa hoặc ẩn con trỏ. Mở rộng để thiết lập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选附加项：自动启动 App、限制、回中或隐藏光标。展开即可设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選用附加功能：自動啟動 App、限制、重新置中或隱藏游標。展開即可設定。"
          }
        }
      }
    },
