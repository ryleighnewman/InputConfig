    "Live joystick visualizer with a draggable trail and slider to find the perfect deadzone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عارض عصا التحكم المباشر مع أثر قابل للسحب ومنزلق لإيجاد المنطقة الميتة المثالية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živý vizualizér joysticku s přetahovatelnou stopou a posuvníkem pro nalezení dokonalé mrtvé zóny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-joystickvisualisering med et spor, der kan trækkes, og en skyder til at finde den perfekte dødzone."
