          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đầu thấp của hành trình nằm ở dưới cùng. Chứa các dải và một đường tại giá trị đo trực tiếp của trục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行程的低端在底部。包含各区段，以及一条标示该轴实时读数的线。"
