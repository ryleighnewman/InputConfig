        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur während dieses Preset läuft, und pausiert, sobald InputConfig oder der Finder im Vordergrund ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo mientras este preset está activo, y en pausa siempre que InputConfig o el Finder estén delante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain kun tämä esiasetus on käynnissä, ja tauolla aina, kun InputConfig tai Finder on edessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement pendant que ce préréglage tourne, et en pause dès qu’InputConfig ou le Finder est au premier plan."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק בזמן שההגדרה הזו פועלת, ומושהה בכל פעם ש InputConfig או Finder בחזית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak amíg ez a beállítás fut, és szünetel, amikor az InputConfig vagy a Finder van elöl."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya saat preset ini berjalan, dan dijeda setiap kali InputConfig atau Finder di depan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo mentre questo preset è attivo, e in pausa quando InputConfig o il Finder sono in primo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプリセットの実行中だけ。InputConfig か Finder が前面にあるときは一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프리셋이 실행 중일 때만 작동하며, InputConfig나 Finder가 앞에 있으면 일시 정지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare mens denne forhåndsinnstillingen kjører, og satt på pause når InputConfig eller Finder er foran."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen terwijl deze voorinstelling draait, en gepauzeerd zodra InputConfig of de Finder vooraan staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko gdy to ustawienie działa, i wstrzymane, gdy InputConfig lub Finder jest na wierzchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só enquanto este preset está ativo, e pausado sempre que o InputConfig ou o Finder estão à frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только пока работает этот пресет; приостанавливается, когда на переднем плане InputConfig или Finder."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Len keď táto predvoľba beží, a pozastavené, kedykoľvek je v popredí InputConfig alebo Finder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara medan förinställningen körs, och pausad när InputConfig eller Finder ligger överst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะตอนที่พรีเซ็ตนี้ทำงาน และหยุดชั่วคราวเมื่อ InputConfig หรือ Finder อยู่ด้านหน้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca bu ön ayar çalışırken; InputConfig veya Finder öndeyken duraklatılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише поки працює цей пресет, і призупиняється, коли на передньому плані InputConfig або Finder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ khi cài đặt sẵn này đang chạy, và tạm dừng mỗi khi InputConfig hoặc Finder ở phía trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在此预设运行时有效，InputConfig 或访达在前台时暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在此預設執行時有效，InputConfig 或 Finder 在前景時暫停。"
          }
        }
      }
    },
