    "Twist a knob or move a slider: every control appears here live." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدر مقبضًا أو حرّك منزلقًا: يظهر كل عنصر تحكم هنا مباشرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otočte knoflíkem nebo pohněte posuvníkem: každý ovládací prvek se zde zobrazí živě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drej en drejeknap, eller flyt en skyder: hver kontrol vises her live."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe an einem Regler oder bewege einen Fader: Jedes Bedienelement erscheint hier live."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira una perilla o mueve un deslizador: cada control aparece aquí en vivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käännä nuppia tai liikuta liukusäädintä: jokainen ohjaus ilmestyy tähän reaaliajassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez un bouton ou déplacez un curseur : chaque commande apparaît ici en direct."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סובב כפתור או הזז מחוון: כל פקד מופיע כאן בזמן אמת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgasson meg egy gombot vagy mozgasson egy csúszkát: minden vezérlő élőben megjelenik itt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar kenop atau gerakkan penggeser: setiap kontrol muncul di sini secara langsung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota una manopola o muovi un cursore: ogni comando compare qui dal vivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノブを回すかスライダを動かすと、すべてのコントロールがここにライブで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노브를 돌리거나 슬라이더를 움직이세요: 모든 컨트롤이 여기에 실시간으로 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vri på en knapp eller flytt en glider: hver kontroll vises her live."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draai aan een knop of beweeg een schuifregelaar: elke bediening verschijnt hier live."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekręć gałkę lub przesuń suwak: każde sterowanie pojawi się tutaj na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire um botão ou mova um controle deslizante: cada controle aparece aqui ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покрутите ручку или подвигайте ползунок: здесь сразу появится каждый элемент управления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otočte ovládačom alebo pohnite posuvníkom: každý ovládací prvok sa tu zobrazí naživo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrid på en ratt eller flytta ett reglage: varje kontroll visas här live."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บิดปุ่มหมุนหรือเลื่อนแถบเลื่อน: ทุกตัวควบคุมปรากฏที่นี่สดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir düğmeyi çevirin ya da bir sürgüyü hareket ettirin: her kontrol burada canlı görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крутніть регулятор або посуньте повзунок: кожен елемент керування з’явиться тут наживо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoay một núm hoặc di chuyển một thanh trượt: mọi điều khiển hiện ở đây trực tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转动旋钮或移动滑块：每个控件都会实时显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉動旋鈕或移動滑桿：每個控制項都會即時顯示在這裡。"
          }
        }
      }
    },
