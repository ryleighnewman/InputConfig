    "Steam Controller in Bluetooth mode: connect it with its USB cable or the wireless dongle to use it in InputConfig" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Steam Controller في وضع Bluetooth: صِله بكابل USB الخاص به أو بالمستقبل اللاسلكي لاستخدامه في InputConfig"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller v režimu Bluetooth: připojte ho kabelem USB nebo bezdrátovým přijímačem, abyste ho mohli používat v InputConfig"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller i Bluetooth-tilstand: tilslut den med dens USB-kabel eller den trådløse modtager for at bruge den i InputConfig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller im Bluetooth-Modus: Verbinde ihn mit seinem USB-Kabel oder dem Funkempfänger, um ihn in InputConfig zu verwenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller en modo Bluetooth: conéctalo con su cable USB o con el receptor inalámbrico para usarlo en InputConfig"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller Bluetooth-tilassa: liitä se USB-kaapelilla tai langattomalla vastaanottimella, niin voit käyttää sitä InputConfigissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller en mode Bluetooth : branchez-le avec son câble USB ou le récepteur sans fil pour l'utiliser dans InputConfig"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Steam Controller במצב Bluetooth: חברו אותו בכבל ה-USB שלו או במקלט האלחוטי כדי להשתמש בו ב-InputConfig"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller Bluetooth módban: csatlakoztasd az USB-kábelével vagy a vezeték nélküli vevővel, hogy használhasd az InputConfigban"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller dalam mode Bluetooth: hubungkan dengan kabel USB-nya atau penerima nirkabel untuk menggunakannya di InputConfig"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller in modalità Bluetooth: collegalo con il suo cavo USB o con il ricevitore wireless per usarlo in InputConfig"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth モードの Steam Controller: InputConfig で使うには、USB ケーブルまたはワイヤレスレシーバーで接続してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth 모드의 Steam Controller: InputConfig에서 사용하려면 USB 케이블이나 무선 수신기로 연결하세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller i Bluetooth-modus: koble den til med USB-kabelen eller den trådløse mottakeren for å bruke den i InputConfig"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller in Bluetooth-modus: sluit hem aan met zijn USB-kabel of de draadloze ontvanger om hem in InputConfig te gebruiken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller w trybie Bluetooth: podłącz go kablem USB lub odbiornikiem bezprzewodowym, aby używać go w InputConfig"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller no modo Bluetooth: conecte-o com o cabo USB ou o receptor sem fio para usá-lo no InputConfig"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller в режиме Bluetooth: подключите его кабелем USB или через беспроводной приёмник, чтобы использовать в InputConfig"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller v režime Bluetooth: pripojte ho káblom USB alebo bezdrôtovým prijímačom, aby ste ho mohli používať v InputConfig"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller i Bluetooth-läge: anslut den med dess USB-kabel eller den trådlösa mottagaren för att använda den i InputConfig"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller ในโหมด Bluetooth: เชื่อมต่อด้วยสาย USB หรือตัวรับสัญญาณไร้สายเพื่อใช้งานใน InputConfig"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth modunda Steam Controller: InputConfig'de kullanmak için USB kablosuyla veya kablosuz alıcıyla bağlayın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller у режимі Bluetooth: під'єднайте його кабелем USB або через бездротовий приймач, щоб користуватися ним в InputConfig"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steam Controller ở chế độ Bluetooth: kết nối bằng cáp USB hoặc bộ thu không dây để dùng trong InputConfig"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处于蓝牙模式的 Steam Controller：请用 USB 线或无线接收器连接，才能在 InputConfig 中使用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處於藍牙模式的 Steam Controller：請用 USB 線或無線接收器連接，才能在 InputConfig 中使用"
          }
        }
      }
    },
