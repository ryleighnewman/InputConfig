    "%@ is connected by cable. Unplug it to disconnect it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ متصل بكابل. افصل الكابل لفصله."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zařízení %@ je připojeno kabelem. Odpojíte je vytažením kabelu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er forbundet med kabel. Tag stikket ud for at afbryde forbindelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist per Kabel verbunden. Ziehe das Kabel ab, um die Verbindung zu trennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está conectado por cable. Desenchúfalo para desconectarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on yhdistetty kaapelilla. Katkaise yhteys irrottamalla kaapeli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est connectée par câble. Débranchez-la pour la déconnecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ מחובר בכבל. נתק את הכבל כדי לנתק אותו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ kábellel csatlakozik. A leválasztáshoz húzza ki a kábelt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terhubung dengan kabel. Cabut kabelnya untuk memutuskan koneksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è collegato tramite cavo. Scollegalo per disconnetterlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はケーブルで接続されています。接続を解除するには、ケーブルを抜いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 케이블로 연결되어 있습니다. 연결을 해제하려면 케이블을 뽑으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er koblet til med kabel. Trekk ut kabelen for å koble den fra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is met een kabel verbonden. Haal de kabel eruit om het apparaat los te koppelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest połączony kablem. Odłącz kabel, aby go rozłączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está conectado por cabo. Desconecte o cabo para desconectá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ подключён кабелем. Отсоедините кабель, чтобы отключить его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ je pripojené káblom. Ak ho chcete odpojiť, odpojte kábel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är ansluten med kabel. Dra ur kabeln för att koppla från den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เชื่อมต่อด้วยสาย ถอดสายเพื่อตัดการเชื่อมต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kabloyla bağlı. Bağlantısını kesmek için kabloyu çıkarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ підключено кабелем. Щоб відключити його, від’єднайте кабель."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ được kết nối bằng cáp. Hãy rút cáp để ngắt kết nối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 通过线缆连接。拔下线缆即可断开连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 以線材連接。拔除線材即可中斷連線。"
          }
        }
      }
    },
    "%@ is not an InputConfig backup. To add a single preset, use Import Preset File." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ ليس نسخة احتياطية من InputConfig. لإضافة إعداد مسبق واحد، استخدم «استيراد ملف إعداد مسبق»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ není záloha InputConfig. Chcete-li přidat jednu předvolbu, použijte Importovat soubor předvolby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er ikke en InputConfig-backup. Brug Importér forudindstillingsfil for at tilføje en enkelt forudindstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist kein InputConfig-Backup. Verwende „Preset-Datei importieren“, um ein einzelnes Preset hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una copia de seguridad de InputConfig. Para añadir un solo preajuste, usa Importar archivo de preajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ei ole InputConfig-varmuuskopio. Voit lisätä yksittäisen esiasetuksen valitsemalla Tuo esiasetustiedosto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas une sauvegarde d’InputConfig. Pour ajouter un seul préréglage, utilisez « Importer un fichier de préréglage »."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ אינו גיבוי של InputConfig. כדי להוסיף פריסט בודד, השתמש ב״ייבוא קובץ פריסט״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ nem InputConfig-mentés. Egyetlen előbeállítás hozzáadásához használja az Előbeállításfájl importálása parancsot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bukan cadangan InputConfig. Untuk menambahkan satu preset, gunakan Impor File Preset."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è un backup di InputConfig. Per aggiungere un singolo preset, usa Importa file preset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はInputConfigのバックアップではありません。プリセットを1つ追加するには、「プリセットファイルを読み込む」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 파일은 InputConfig 백업이 아닙니다. 프리셋 하나를 추가하려면 프리셋 파일 가져오기를 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er ikke en InputConfig-sikkerhetskopi. Bruk Importer forhåndsinnstillingsfil for å legge til én forhåndsinnstilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is geen InputConfig-back-up. Gebruik Importeer presetbestand om één preset toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie jest kopią zapasową InputConfig. Aby dodać pojedynczy preset, użyj opcji Importuj plik presetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não é um backup do InputConfig. Para adicionar um único preset, use Importar arquivo de preset."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не является резервной копией InputConfig. Чтобы добавить один пресет, используйте «Импорт файла пресета»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie je záloha InputConfig. Ak chcete pridať jednu predvoľbu, použite Importovať súbor predvoľby."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är inte en säkerhetskopia från InputConfig. Använd Importera förinställningsfil om du vill lägga till en enskild förinställning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ไม่ใช่ข้อมูลสำรองของ InputConfig หากต้องการเพิ่มพรีเซ็ตเดียว ให้ใช้นำเข้าไฟล์พรีเซ็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir InputConfig yedeği değil. Tek bir ön ayar eklemek için Ön Ayar Dosyasını İçe Aktar’ı kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не є резервною копією InputConfig. Щоб додати один пресет, скористайтеся командою «Імпортувати файл пресета»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không phải là bản sao lưu InputConfig. Để thêm một cài đặt sẵn, hãy dùng Nhập tệp cài đặt sẵn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 InputConfig 备份。要添加单个预设，请使用“导入预设文件”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不是 InputConfig 備份。若要新增單一預設，請使用「輸入預設檔案」。"
          }
        }
      }
    },
    "%@ is not in your library. Settings, Advanced, Restore Built-in Presets puts it back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ ليس في مكتبتك. تعيده الإعدادات، متقدم، استعادة الإعدادات المسبقة المضمّنة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ není ve vaší knihovně. Vrátí ji Nastavení, Pokročilé, Obnovit vestavěné předvolby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ findes ikke i dit bibliotek. Indstillinger, Avanceret, Gendan indbyggede forudindstillinger lægger den tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht in deiner Bibliothek. „Einstellungen“, „Erweitert“, „Integrierte Presets wiederherstellen“ legt es zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está en tu biblioteca. Ajustes, Avanzado, Restaurar preajustes integrados lo devuelve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ei ole kirjastossasi. Asetukset, Lisäasetukset, Palauta sisäänrakennetut esiasetukset palauttaa sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas dans votre bibliothèque. Réglages, Avancé, Restaurer les préréglages intégrés le remet en place."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ לא נמצא בספרייה שלך. הגדרות, מתקדם, שחזר פריסטים מובנים מחזיר אותו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ nincs a könyvtárában. A Beállítások, Speciális, Beépített előbeállítások visszaállítása visszahelyezi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak ada di pustaka Anda. Pengaturan, Lanjutan, Pulihkan Preset Bawaan mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è nella tua libreria. Impostazioni, Avanzate, Ripristina preset integrati lo rimette a posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はライブラリにありません。「設定」>「詳細」>「組み込みプリセットを復元」で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 보관함에 없습니다. 설정 > 고급 > 내장 프리셋 복원으로 되돌릴 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ finnes ikke i biblioteket ditt. Innstillinger, Avansert, Gjenopprett innebygde forhåndsinnstillinger setter den tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ staat niet in je bibliotheek. Instellingen, Geavanceerd, Herstel ingebouwde presets zet het terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie ma w Twojej bibliotece. Przywróci go Ustawienia, Zaawansowane, Przywróć wbudowane presety."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está na sua biblioteca. Ajustes, Avançado, Restaurar presets integrados traz de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ нет в вашей библиотеке. Чтобы вернуть, откройте Настройки, Дополнительно, Восстановить встроенные пресеты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie je vo vašej knižnici. Vráti ju Nastavenia, Rozšírené, Obnoviť vstavané predvoľby."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ finns inte i ditt bibliotek. Inställningar, Avancerat, Återställ inbyggda förinställningar lägger tillbaka den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ไม่อยู่ในคลังของคุณ การตั้งค่า, ขั้นสูง, กู้คืนพรีเซ็ตในตัว จะนำกลับมาให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kitaplığınızda yok. Ayarlar, Gelişmiş, Yerleşik Ön Ayarları Geri Yükle onu geri getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ немає у вашій бібліотеці. Щоб повернути, відкрийте Параметри, Додатково, Відновити вбудовані пресети."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không có trong thư viện của bạn. Để đặt lại, hãy mở Cài đặt, Nâng cao, Khôi phục cài đặt sẵn tích hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不在你的资料库中。“设置”>“高级”>“恢复内置预设”可将其放回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不在你的資料庫中。「設定」>「進階」>「恢復內建預設」可將其放回。"
          }
        }
      }
    },
    "%@ is running, but macOS will not deliver its keys and clicks until InputConfig is on in System Settings, Privacy & Security, Accessibility." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ قيد التشغيل، لكن macOS لن يسلّم مفاتيحه ونقراته حتى يتم تشغيل InputConfig في إعدادات النظام، الخصوصية والأمن، تسهيلات الاستخدام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Běží: %@, ale macOS nebude předávat jeho klávesy a kliknutí, dokud InputConfig nezapnete v Nastavení systému, Soukromí a zabezpečení, Zpřístupnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kører, men macOS leverer ikke dens taster og klik, før InputConfig er slået til i Systemindstillinger, Anonymitet & sikkerhed, Tilgængelighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft, aber macOS liefert seine Tasten und Klicks erst aus, wenn InputConfig in den Systemeinstellungen unter „Datenschutz & Sicherheit“ > „Bedienungshilfen“ aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se está ejecutando, pero macOS no entregará sus teclas y clics hasta que InputConfig esté activado en Ajustes del Sistema, Privacidad y seguridad, Accesibilidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on käynnissä, mutta macOS ei välitä sen näppäimiä ja napsautuksia, ennen kuin InputConfig on otettu käyttöön kohdassa Järjestelmäasetukset, Tietosuoja ja suojaus, Käyttöapu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est en cours d’exécution, mais macOS ne transmettra ses touches et ses clics que lorsque InputConfig sera activé dans Réglages Système, Confidentialité et sécurité, Accessibilité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ פועל, אבל macOS לא ימסור את המקשים והלחיצות שלו עד ש-InputConfig יופעל ב״הגדרות המערכת״, ״פרטיות ואבטחה״, ״נגישות״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ fut, de a macOS nem továbbítja a billentyűleütéseit és kattintásait, amíg az InputConfig nincs bekapcsolva itt: Rendszerbeállítások, Adatvédelem és biztonság, Kisegítő lehetőségek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sedang berjalan, tetapi macOS tidak akan mengirimkan tombol dan kliknya sampai InputConfig dinyalakan di Pengaturan Sistem, Privasi & Keamanan, Aksesibilitas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione, ma macOS non recapiterà i suoi tasti e clic finché InputConfig non sarà attivo in Impostazioni di Sistema, Privacy e sicurezza, Accessibilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は実行中ですが、「システム設定」>「プライバシーとセキュリティ」>「アクセシビリティ」でInputConfigをオンにするまで、macOSはそのキー入力とクリックを送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 실행 중이지만, 시스템 설정 > 개인정보 보호 및 보안 > 손쉬운 사용에서 InputConfig를 켜기 전까지 macOS가 키와 클릭을 전달하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kjører, men macOS leverer ikke tastene og klikkene før InputConfig er slått på i Systeminnstillinger, Personvern og sikkerhet, Tilgjengelighet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is actief, maar macOS levert de toetsen en klikken pas af zodra InputConfig is ingeschakeld in Systeeminstellingen, Privacy en beveiliging, Toegankelijkheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jest uruchomiony, ale macOS nie przekaże jego klawiszy i kliknięć, dopóki InputConfig nie zostanie włączony w: Ustawienia systemowe, Prywatność i ochrona, Dostępność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em execução, mas o macOS não entregará suas teclas e cliques até que o InputConfig esteja ativado em Ajustes do Sistema, Privacidade e Segurança, Acessibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ работает, но macOS не будет передавать его нажатия клавиш и клики, пока InputConfig не включён в разделе «Системные настройки» > «Конфиденциальность и безопасность» > «Универсальный доступ»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beží, ale macOS nebude doručovať jeho klávesy a kliknutia, kým nezapnete InputConfig (Systémové nastavenia, Súkromie a bezpečnosť, Prístupnosť)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ körs, men macOS levererar inte dess tangenttryckningar och klick förrän InputConfig är påslaget i Systeminställningar, Integritet och säkerhet, Hjälpmedel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ กำลังทำงานอยู่ แต่ macOS จะไม่ส่งแป้นและการคลิกจนกว่าจะเปิด InputConfig ในการตั้งค่าระบบ > ความเป็นส่วนตัวและความปลอดภัย > การช่วยการเข้าถึง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ çalışıyor, ancak InputConfig, Sistem Ayarları’nda Gizlilik ve Güvenlik, Erişilebilirlik bölümünde açılana kadar macOS tuşlarını ve tıklamalarını iletmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ працює, але macOS не передаватиме його натискання клавіш і клацання, доки InputConfig не буде ввімкнено в розділі «Системні параметри» > «Приватність і безпека» > «Доступність»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang chạy, nhưng macOS sẽ không chuyển các phím và lượt nhấp của nó cho đến khi InputConfig được bật trong Cài đặt hệ thống, Quyền riêng tư & Bảo mật, Trợ năng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行，但在“系统设置”>“隐私与安全性”>“辅助功能”中开启 InputConfig 之前，macOS 不会传递它的按键和点按。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在執行，但在 InputConfig 於「系統設定」>「隱私權與安全性」>「輔助使用」中開啟之前，macOS 不會傳送其按鍵和點按。"
          }
        }
      }
    },
