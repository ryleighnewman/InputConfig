    "Save keeps your changes and Cancel drops them. The tour closes the editor without saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«حفظ» يبقي تغييراتك و«إلغاء» يتخلص منها. تغلق الجولة المحرر دون حفظ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložit ponechá změny a Zrušit je zahodí. Prohlídka zavře editor bez uložení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem beholder dine ændringer, og Annuller kasserer dem. Rundturen lukker editoren uden at gemme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichern behält deine Änderungen, Abbrechen verwirft sie. Die Tour schließt den Editor, ohne zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar conserva tus cambios y Cancelar los descarta. El tour cierra el editor sin guardar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna pitää muutokset ja Peruuta hylkää ne. Kierros sulkee editorin tallentamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer garde vos modifications et Annuler les abandonne. La visite ferme l'éditeur sans enregistrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״שמור״ שומר את השינויים ו״ביטול״ זורק אותם. הסיור סוגר את העורך בלי לשמור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mentés megtartja a módosításokat, a Mégse elveti őket. A bemutató mentés nélkül zárja be a szerkesztőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan menyimpan perubahan Anda dan Batalkan membuangnya. Tur menutup editor tanpa menyimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva tiene le modifiche e Annulla le scarta. Il tour chiude l'editor senza salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「保存」は変更を残し、「キャンセル」は破棄します。ツアーでは保存せずにエディタを閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장은 변경 사항을 남기고 취소는 버립니다. 둘러보기는 저장하지 않고 편집기를 닫습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre beholder endringene, og Avbryt forkaster dem. Omvisningen lukker redigeringsvinduet uten å lagre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar houdt je wijzigingen, Annuleren gooit ze weg. De rondleiding sluit de editor zonder te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz zachowuje zmiany, a Anuluj je odrzuca. Wycieczka zamyka edytor bez zapisywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvar guarda suas alterações e Cancelar as descarta. O tour fecha o editor sem salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сохранить» оставляет изменения, а «Отмена» их отбрасывает. Обзор закрывает редактор без сохранения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložiť ponechá zmeny a Zrušiť ich zahodí. Prehliadka zavrie editor bez uloženia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara behåller dina ändringar och Avbryt slänger dem. Rundturen stänger redigeraren utan att spara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกจะเก็บการเปลี่ยนแปลง และยกเลิกจะทิ้งไป ทัวร์จะปิดตัวแก้ไขโดยไม่บันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydet değişikliklerinizi saklar, Vazgeç onları atar. Tur, düzenleyiciyi kaydetmeden kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Зберегти» залишає зміни, а «Скасувати» їх відкидає. Огляд закриває редактор без збереження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu giữ thay đổi của bạn và Hủy bỏ chúng. Chuyến tham quan đóng trình chỉnh sửa mà không lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“保存”会保留更改，“取消”会放弃更改。导览会不保存直接关闭编辑器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「儲存」會保留變更，「取消」會放棄變更。導覽會不儲存直接關閉編輯器。"
          }
        }
      }
    },
