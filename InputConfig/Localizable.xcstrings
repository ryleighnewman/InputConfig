        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekoppelte Controller beim Öffnen von InputConfig, beim Aufwachen des Mac und beim Start eines Presets erneut verbinden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
