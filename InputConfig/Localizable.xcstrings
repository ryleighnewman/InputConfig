    "Quick Zero is not available for this controller; it zeroes itself when it rests" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«تصفير سريع» غير متاح لذراع التحكم هذا؛ فهو يصفّر نفسه عند السكون"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rychlé vynulování není pro tento ovladač k dispozici; vynuluje se samo, když je v klidu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hurtig nulstilling er ikke tilgængelig for denne controller. Den nulstiller sig selv, når den hviler"
