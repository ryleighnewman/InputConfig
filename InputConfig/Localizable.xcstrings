    "An Accessibility area in Settings: app-wide text size, bold text, reduced transparency, and reduced motion" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قسم تسهيلات الاستخدام في الإعدادات: حجم النص على مستوى التطبيق والنص العريض وتقليل الشفافية وتقليل الحركة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblast Zpřístupnění v Nastavení: velikost textu v celé aplikaci, tučný text, omezená průhlednost a omezený pohyb"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et område for Tilgængelighed i Indstillinger: tekststørrelse, fed tekst, reduceret gennemsigtighed og reduceret bevægelse for hele appen"
