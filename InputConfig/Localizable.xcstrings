    "The YapToText shoutout now lives at the bottom of the welcome screen with a one-click App Store link" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صارت إشادة YapToText في أسفل شاشة الترحيب مع رابط App Store بنقرة واحدة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmínka o YapToText je nyní dole na úvodní obrazovce s odkazem do App Store jedním kliknutím"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omtalen af YapToText ligger nu nederst på velkomstskærmen med et link til App Store, der kun kræver ét klik"
