        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Умный конструктор пресетов» умеет добавлять тачпад как трекпад, точное прицеливание гироскопом и вибрацию триггеров"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvorca inteligentných predvolieb môže pridať touchpad ako trackpad, jemné mierenie gyroskopom a vibrácie spúšte"
