    "Try to reconnect paired controllers when InputConfig opens, when the Mac wakes and when a preset starts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولة إعادة توصيل وحدات التحكم المقترنة عند فتح InputConfig وعند تنبيه الـ Mac وعند بدء إعداد مسبق"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkoušet znovu připojit spárované ovladače při otevření InputConfig, probuzení Macu a spuštění předvolby"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv at forbinde parrede controllere igen, når InputConfig åbner, når Macen vågner, og når en forudindstilling starter"
