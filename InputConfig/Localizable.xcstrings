    "Accessibility is off, so this preset's keys and clicks go nowhere. Turn it on in System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسهيلات الاستخدام متوقفة، لذا لا تذهب مفاتيح هذا الإعداد المسبق ونقراته إلى أي مكان. شغّلها في إعدادات النظام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zpřístupnění je vypnuto, takže klávesy a kliknutí této předvolby nikam nepůjdou. Zapněte ho v Nastavení systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgængelighed er slået fra, så denne forudindstillings taster og klik går ingen steder. Slå det til i Systemindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen sind deaktiviert, daher laufen Tasten und Klicks dieses Presets ins Leere. Aktiviere sie in den Systemeinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesibilidad está desactivada, así que las teclas y los clics de este preajuste no van a ninguna parte. Actívala en Ajustes del Sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttöapu on pois päältä, joten tämän esiasetuksen näppäimet ja napsautukset eivät mene minnekään. Ota se käyttöön Järjestelmäasetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accessibilité est désactivée : les touches et les clics de ce préréglage ne vont nulle part. Activez-la dans Réglages Système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הנגישות כבויה, ולכן המקשים והלחיצות של הפריסט הזה לא עושים דבר. הפעל אותה ב״הגדרות המערכת״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Kisegítő lehetőségek ki van kapcsolva, ezért az előbeállítás billentyűleütései és kattintásai nem jutnak sehova. Kapcsolja be a Rendszerbeállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksesibilitas nonaktif, sehingga tombol dan klik preset ini tidak ke mana-mana. Nyalakan di Pengaturan Sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accessibilità è disattivata, quindi i tasti e i clic di questo preset non vanno da nessuna parte. Attivala in Impostazioni di Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティがオフのため、このプリセットのキー入力とクリックはどこにも届きません。「システム設定」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용이 꺼져 있어 이 프리셋의 키와 클릭이 어디에도 전달되지 않습니다. 시스템 설정에서 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgjengelighet er av, så tastene og klikkene i denne forhåndsinnstillingen går ingen steder. Slå den på i Systeminnstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegankelijkheid staat uit, dus de toetsen en klikken van deze preset gaan nergens heen. Schakel het in via Systeeminstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępność jest wyłączona, więc klawisze i kliknięcia tego presetu nigdzie nie trafiają. Włącz ją w Ustawieniach systemowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Acessibilidade está desativada, então as teclas e os cliques deste preset não vão a lugar nenhum. Ative-a em Ajustes do Sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Универсальный доступ выключен, поэтому нажатия клавиш и клики этого пресета никуда не попадают. Включите его в разделе «Системные настройки»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístupnosť je vypnutá, takže klávesy a kliknutia tejto predvoľby nikam nejdú. Zapnite ju v aplikácii Systémové nastavenia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjälpmedel är av, så den här förinställningens tangenttryckningar och klick leder ingenstans. Slå på det i Systeminställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การช่วยการเข้าถึงปิดอยู่ แป้นและการคลิกของพรีเซ็ตนี้จึงไม่ไปที่ใด เปิดในการตั้งค่าระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişilebilirlik kapalı olduğundan bu ön ayarın tuşları ve tıklamaları hiçbir yere gitmez. Sistem Ayarları’nda açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступність вимкнено, тому клавіші та клацання цього пресета нікуди не потрапляють. Увімкніть її в розділі «Системні параметри»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trợ năng đang tắt, nên các phím và lượt nhấp của cài đặt sẵn này không có tác dụng. Hãy bật trong Cài đặt hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能已关闭，因此此预设的按键和点按不会生效。请在“系统设置”中开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輔助使用已關閉，因此此預設的按鍵和點按都不會有作用。請在「系統設定」中開啟。"
          }
        }
      }
    },
