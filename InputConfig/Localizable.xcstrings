          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자이로스코프가 보고하지 않습니다. 유선 연결을 시도하거나 컨트롤러를 다시 페어링하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
