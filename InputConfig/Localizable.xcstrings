    "Variable speed is produced by pulsing the key on and off; this sets how smooth that pulsing is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتج السرعة المتغيرة بنبض المفتاح تشغيلًا وإيقافًا؛ يضبط هذا مدى نعومة النبض."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proměnná rychlost vzniká pulzováním klávesy; toto nastavuje, jak plynulé pulzování je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabel hastighed frembringes ved at pulsere tasten til og fra. Dette angiver, hvor jævn pulseringen er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variable Geschwindigkeit entsteht durch pulsierendes Ein- und Ausschalten der Taste; hiermit stellst du ein, wie gleichmäßig dieses Pulsieren ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La velocidad variable se produce pulsando la tecla de forma intermitente; esto define lo suave que es esa intermitencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuttuva nopeus tuotetaan pulssittamalla näppäintä päälle ja pois; tämä asettaa pulssin tasaisuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vitesse variable est produite en activant et désactivant la touche par impulsions ; ce réglage définit la fluidité de ces impulsions."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מהירות משתנה נוצרת על ידי הפעלה וכיבוד של המקש בפולסים; ההגדרה הזו קובעת עד כמה הפולסים חלקים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A változó sebességet a billentyű be- és kikapcsolgatása hozza létre; ez azt állítja, mennyire sima ez az ütemezés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecepatan variabel dihasilkan dengan menyalakan dan mematikan tombol secara berdenyut; ini mengatur seberapa mulus denyut itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La velocità variabile si ottiene pulsando il tasto on e off; questo imposta quanto è fluida la pulsazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可変速度は、キーのオンとオフをパルスさせることで生成されます。ここでは、そのパルスのなめらかさを設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가변 속도는 키를 껐다 켜는 펄스로 만들어지며, 이 설정은 그 펄스가 얼마나 부드러운지를 정합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabel hastighet lages ved å pulsere tasten av og på. Dette angir hvor jevn pulseringen er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabele snelheid ontstaat door de toets aan en uit te pulseren; hiermee stel je in hoe soepel dat pulseren is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmienna prędkość powstaje przez pulsowanie klawisza wł. i wył. Ta opcja ustawia płynność tego pulsowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A velocidade variável é produzida ligando e desligando a tecla em pulsos; isto define o quanto esses pulsos são suaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переменная скорость создаётся включением и выключением клавиши импульсами; здесь задаётся плавность этих импульсов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premenlivá rýchlosť vzniká pulzovaním klávesu zap. a vyp.; toto nastavuje, aké plynulé pulzovanie je."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variabel hastighet skapas genom att pulsera tangenten på och av. Det här ställer in hur mjuk den pulsen är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความเร็วแปรผันเกิดจากการเปิดปิดแป้นเป็นจังหวะ การตั้งค่านี้กำหนดความนุ่มนวลของจังหวะนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişken hız, tuşu açıp kapatarak titreştirmekle elde edilir; bu, titreşimin ne kadar akıcı olduğunu ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінна швидкість створюється імпульсним вмиканням і вимиканням клавіші; це задає, наскільки плавні ці імпульси."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tốc độ biến thiên được tạo bằng cách bật tắt phím theo xung; mục này đặt độ mượt của xung đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可变速度通过让按键反复开关来实现；这里设置该脉冲的平滑程度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可變速度是透過讓按鍵反覆開關脈衝產生的；此項設定脈衝的平滑程度。"
          }
        }
      }
    },
