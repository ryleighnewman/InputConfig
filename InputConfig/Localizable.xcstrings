    "Moves rows recorded on a controller before 1.6 to the controls 1.6 reads." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل الصفوف المسجلة على ذراع تحكم قبل 1.6 إلى عناصر التحكم التي يقرؤها 1.6."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přesune řádky zaznamenané na ovladači před verzí 1.6 na ovládací prvky, které čte verze 1.6."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter rækker optaget på en controller før 1.6 til de kontroller, 1.6 læser."
