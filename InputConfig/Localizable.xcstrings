    "Hide built-in presets, in Settings, Advanced, Data & storage, takes the shipped folders out of the sidebar, its search and the menu bar" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء الإعدادات المسبقة المضمّنة، في الإعدادات، متقدم، البيانات والتخزين، يزيل المجلدات المرفقة من الشريط الجانبي وبحثه وشريط القائمة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrýt vestavěné předvolby, v Nastavení, Pokročilé, Data a úložiště, odebere dodané složky z bočního panelu, jeho hledání a řádku nabídek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul indbyggede forudindstillinger, i Indstillinger, Avanceret, Data & lager, fjerner de medfølgende mapper fra indholdsoversigten, dens søgning og menulinjen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integrierte Presets ausblenden, in Einstellungen, Erweitert, Daten & Speicher, nimmt die mitgelieferten Ordner aus der Seitenleiste, ihrer Suche und der Menüleiste"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar preajustes integrados, en Ajustes, Avanzado, Datos y almacenamiento, quita las carpetas incluidas de la barra lateral, de su búsqueda y de la barra de menús"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilota sisäänrakennetut esiasetukset, kohdassa Asetukset, Lisäasetukset, Data ja tallennustila, poistaa mukana tulevat kansiot sivupalkista, sen hausta ja valikkoriviltä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les préréglages intégrés, dans Réglages, Avancé, Données et stockage, retire les dossiers fournis de la barre latérale, de sa recherche et de la barre des menus"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסתרת פריסטים מובנים, בהגדרות, מתקדם, נתונים ואחסון, מסירה את התיקיות המצורפות מסרגל הצד, מהחיפוש שלו ומשורת התפריטים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Beépített előbeállítások elrejtése a Beállítások, Speciális, Adatok és tárhely alatt kiveszi a mellékelt mappákat az oldalsávból, annak keresőjéből és a menüsorból"
          }
        },
        "id" : {
          "stringUnit" : {
