        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bant %@ satırlarıyla çakışıyor. Kontrol bandın içindeyken yalnızca bu satır çalışır; o satırlar kontrol banttan çıkana kadar bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця смуга перетинається з рядками %@. Поки елемент керування в ній, спрацьовує лише цей рядок; ті рядки чекають, доки він не покине смугу."
          }
