    "Desktop Navigation: A clicks, and Select All moved to the right stick press" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Desktop Navigation: A ينقر، ونُقل «تحديد الكل» إلى ضغط العصا اليمنى"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigace po ploše: A klikne a Vybrat vše se přesunulo na stisk pravé páčky"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivebordsnavigation: A klikker, og Markér alt er flyttet til tryk på højre stick"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desktop-Navigation: A klickt, und „Alles auswählen“ liegt jetzt auf dem Druck des rechten Sticks"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegación por el escritorio: A hace clic, y Seleccionar todo pasó a la pulsación del stick derecho"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työpöydän navigointi: A napsauttaa, ja Valitse kaikki siirrettiin oikean sauvan painallukseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigation sur le bureau : A clique, et Tout sélectionner est passé sur l’appui du stick droit"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניווט בשולחן העבודה: A לוחץ, ו״בחר הכול״ הועבר ללחיצה על הג׳ויסטיק הימני"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asztali navigáció: az A kattint, a Mindent kijelöl pedig a jobb joystick lenyomására került"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigasi Desktop: A mengklik, dan Pilih Semua dipindahkan ke tekan stik kanan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desktop Navigation: A fa clic, e Seleziona tutto è passato alla pressione dello stick destro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desktop Navigation: Aボタンでクリックし、「すべてを選択」を右スティックの押し込みに移動しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크탑 탐색: A는 클릭이며, 모두 선택은 오른쪽 스틱 누르기로 이동함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivebordsnavigering: A klikker, og Marker alt er flyttet til trykk på høyre joystick"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bureaubladnavigatie: A klikt, en Alles selecteren is verplaatst naar de druk op de rechterstick"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawigacja po pulpicie: A klika, a Zaznacz wszystko przeniesiono na kliknięcie prawego drążka"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegação na mesa: A clica, e Selecionar tudo foi movido para o clique do stick direito"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desktop Navigation: A делает клик, а «Выбрать все» перенесено на нажатие правого стика"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigácia po ploche: A klikne a Vybrať všetko sa presunulo na stlačenie pravej páčky"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivbordsnavigering: A klickar, och Markera allt flyttades till högerspakens tryck"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การนำทางเดสก์ท็อป: A คลิก และเลือกทั้งหมดย้ายไปที่การกดจอยสติ๊กขวา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masaüstü Gezintisi: A tıklar ve Tümünü Seç sağ çubuk basışına taşındı"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навігація робочим столом: A клацає, а «Вибрати все» переміщено на натискання правого джойстика"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều hướng màn hình nền: A để nhấp, và Chọn tất cả được chuyển sang nhấn cần phải"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌面导航：A 键用于点按，“全选”移到右摇杆按下"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌面導覽：A 可點按，且「全選」移到右搖桿按下"
          }
        }
      }
    },
