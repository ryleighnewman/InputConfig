    "Rows sit under section headings, and Automatically insert available inputs adds a row for every control the device has" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقع الصفوف تحت عناوين الأقسام، وتضيف «إدراج المدخلات المتاحة تلقائيًا» صفًا لكل عنصر تحكم في الجهاز"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řádky jsou pod nadpisy sekcí a Automaticky vkládat dostupné vstupy přidá řádek pro každý ovládací prvek zařízení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rækker står under sektionsoverskrifter, og Indsæt tilgængelige input automatisk tilføjer en række for hver kontrol, enheden har"
          }
        },
        "de" : {
          "stringUnit" : {
