        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuifregelaars voor aanwijzersnelheid en scrolsnelheid op de presetpagina, Aanloop op aanwijzerrijen, een D-pad die één richting tegelijk kan nemen, en de aanwijzer stopt op het moment dat je de stick loslaat"
