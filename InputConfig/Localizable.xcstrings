    "Mirror the stick before checking the region, so the region is entered from the opposite side." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعكس العصا قبل التحقق من المنطقة، فيتم دخول المنطقة من الجهة المقابلة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
