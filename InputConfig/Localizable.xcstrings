    "Uses less CPU and energy while nothing is moving" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستهلك CPU وطاقة أقل بينما لا يتحرك شيء"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotřebuje méně CPU a energie, dokud se nic nehýbe"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger mindre CPU og energi, mens intet bevæger sig"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbraucht weniger CPU und Energie, solange sich nichts bewegt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa menos CPU y energía mientras nada se mueve"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää vähemmän CPU:ta ja energiaa, kun mikään ei liiku"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consomme moins de CPU et d’énergie quand rien ne bouge"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמש בפחות CPU ואנרגיה כשדבר לא זז"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kevesebb CPU-t és energiát használ, amíg semmi sem mozog"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan lebih sedikit CPU dan energi saat tidak ada yang bergerak"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa meno CPU ed energia quando nulla si muove"
          }
        },
        "ja" : {
