    "Ends the run after this many presses. 0 means it keeps going until you release, or press again in toggle mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينهي التشغيل بعد هذا العدد من الضغطات. القيمة 0 تعني أنه يستمر حتى تترك الزر، أو تضغط مرة أخرى في وضع التبديل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončí běh po tolika stiscích. 0 znamená, že pokračuje, dokud nepustíte, nebo v režimu přepínače dokud znovu nestisknete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslutter kørslen efter så mange tryk. 0 betyder, at den fortsætter, indtil du slipper, eller trykker igen i skiftetilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet den Lauf nach dieser Anzahl von Tastendrücken. 0 bedeutet, dass er weiterläuft, bis du loslässt oder im Umschaltmodus erneut drückst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina la ejecución tras este número de pulsaciones. 0 significa que continúa hasta que sueltes, o pulses de nuevo en modo alternar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päättää ajon tähän määrään painalluksia. 0 tarkoittaa, että se jatkuu, kunnes päästetään irti tai painetaan uudelleen kytkintilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine la série après ce nombre d’appuis. 0 signifie qu’elle continue jusqu’au relâchement, ou à un nouvel appui en mode bascule."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיים את הריצה אחרי מספר הלחיצות הזה. 0 פירושו שהיא נמשכת עד שתרפה, או שתלחץ שוב במצב החלפה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennyi lenyomás után fejezi be a futást. A 0 azt jelenti, hogy addig folytatja, amíg el nem engedi, vagy váltó módban újra meg nem nyomja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengakhiri proses setelah sekian penekanan. 0 berarti terus berjalan sampai Anda melepas, atau menekan lagi dalam mode toggle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina la sequenza dopo questo numero di pressioni. 0 significa che continua finché non rilasci, o finché non premi di nuovo in modalità interruttore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この回数だけ押したところで実行を終了します。0の場合は、離すまで、またはトグルモードで再び押すまで続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 횟수만큼 누르면 실행을 끝냅니다. 0이면 손을 떼거나 토글 모드에서 다시 누를 때까지 계속됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutter kjøringen etter så mange trykk. 0 betyr at den fortsetter til du slipper, eller trykker igjen i vekslemodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beëindigt de reeks na dit aantal drukken. 0 betekent dat hij doorgaat tot je loslaat, of in de modus Schakelen opnieuw drukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kończy serię po tylu naciśnięciach. 0 oznacza, że trwa do puszczenia albo do ponownego naciśnięcia w trybie przełączania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra a execução após este número de pressionamentos. 0 significa que continua até você soltar, ou pressionar de novo no modo alternar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершает серию после стольких нажатий. 0 означает, что она продолжается, пока вы не отпустите или не нажмёте снова в режиме переключения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončí sériu po tomto počte stlačení. 0 znamená, že pokračuje, kým nepustíte, alebo nestlačíte znova v režime prepínania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutar körningen efter så här många tryck. 0 betyder att den fortsätter tills du släpper, eller trycker igen i växlingsläge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จบการทำงานหลังกดครบจำนวนนี้ 0 หมายถึงทำต่อไปจนกว่าคุณจะปล่อย หรือกดอีกครั้งในโหมดสลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kadar basıştan sonra çalışmayı bitirir. 0, bırakana ya da aç/kapat modunda yeniden basana kadar sürmesi demektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершує серію після такої кількості натискань. 0 означає, що вона триває, доки ви не відпустите або не натиснете знову в режимі перемикання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết thúc lượt chạy sau số lần nhấn này. 0 nghĩa là tiếp tục cho đến khi bạn thả, hoặc nhấn lần nữa ở chế độ bật tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下这么多次后结束运行。0 表示一直持续到你松开，或在切换模式下再次按下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在按下這麼多次後結束執行。0 表示持續到你放開為止，或在切換模式下再按一次。"
          }
        }
      }
    },
