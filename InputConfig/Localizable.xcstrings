    "Mirror the stick before reading the gesture: a flick up counts as down and a flick left as right." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعكس العصا قبل قراءة الإيماءة: تُحتسب النفضة للأعلى كنفضة للأسفل، والنفضة لليسار كنفضة لليمين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrcadlit páčku před čtením gesta: švihnutí nahoru se počítá jako dolů a švihnutí doleva jako doprava."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spejl stikken, før bevægelsen aflæses: et ryk op tæller som ned og et ryk til venstre som til højre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiegle den Stick, bevor die Geste gelesen wird: Ein Flick nach oben zählt als nach unten und ein Flick nach links als nach rechts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refleja el stick antes de leer el gesto: un flick hacia arriba cuenta como hacia abajo y uno hacia la izquierda como hacia la derecha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peilaa sauva ennen eleen lukemista: ylös näpäytys lasketaan alas näpäytykseksi ja vasemmalle näpäytys oikealle näpäytykseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inverse le stick avant de lire le geste : un coup de stick vers le haut compte comme vers le bas, et vers la gauche comme vers la droite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שקף את הג׳ויסטיק לפני קריאת המחווה: הצלפה למעלה נספרת כהצלפה למטה והצלפה שמאלה כהצלפה ימינה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tükrözi a joysticket a mozdulat olvasása előtt: a felfelé pöccintés lefelé, a balra pöccintés jobbra számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerminkan stik sebelum membaca gestur: sentakan ke atas dihitung sebagai ke bawah dan sentakan ke kiri sebagai ke kanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispecchia lo stick prima di leggere il gesto: un flick in su conta come in giù e un flick a sinistra come a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジェスチャを判定する前にスティックを反転させます。上へのフリックは下、左へのフリックは右として扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제스처를 읽기 전에 스틱을 반전합니다. 위로 플릭하면 아래로, 왼쪽으로 플릭하면 오른쪽으로 처리됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speilvend joysticken før bevegelsen leses: et rykk opp teller som ned og et rykk til venstre som til høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiegel de stick voordat het gebaar wordt gelezen: een flick omhoog telt als omlaag en een flick naar links als naar rechts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odbij drążek przed odczytem gestu: machnięcie w górę liczy się jako w dół, a machnięcie w lewo jako w prawo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espelhe o stick antes de ler o gesto: um flick para cima conta como para baixo e um flick para a esquerda como para a direita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отразить стик перед чтением жеста: рывок вверх считается рывком вниз, а рывок влево рывком вправо."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrkadliť páčku pred čítaním gesta: švihnutie nahor sa počíta ako nadol a švihnutie doľava ako doprava."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spegelvänd spaken innan gesten läses: ett ryck uppåt räknas som nedåt och ett ryck åt vänster som åt höger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สะท้อนจอยสติ๊กก่อนอ่านท่าทาง การดีดขึ้นจะนับเป็นลง และการดีดซ้ายจะนับเป็นขวา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesti okumadan önce çubuğu yansıtın: yukarı fiske aşağı, sola fiske sağa sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Віддзеркалити джойстик перед читанням жесту: ривок угору вважається ривком униз, а ривок ліворуч ривком праворуч."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lật gương cần trước khi đọc cử chỉ: hất lên được tính là xuống và hất sang trái được tính là sang phải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在读取手势之前镜像摇杆：向上轻拨算作向下，向左轻拨算作向右。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在讀取手勢之前先鏡射搖桿：向上輕撥算作向下，向左輕撥算作向右。"
          }
        }
      }
    },
