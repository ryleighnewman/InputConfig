    "Touchpad Mouse works, with one-finger tap, two-finger tap, and double tap as inputs" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل «ماوس لوحة اللمس»، مع النقر بإصبع والنقر بإصبعين والنقر المزدوج كمدخلات"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpad jako myš funguje, s klepnutím jedním prstem, klepnutím dvěma prsty a dvojitým klepnutím jako vstupy"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpad som mus virker, med tap med én finger, tap med to fingre og dobbelttap som input"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpad-Maus funktioniert, mit Tippen mit einem Finger, Tippen mit zwei Fingern und Doppeltippen als Eingaben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Ratón del panel táctil funciona, con toque de un dedo, toque de dos dedos y doble toque como entradas"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosketuslevyhiiri toimii, ja yhden sormen napautus, kahden sormen napautus ja kaksoisnapautus ovat syötteitä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La souris du pavé tactile fonctionne, avec le toucher à un doigt, le toucher à deux doigts et le double toucher comme entrées"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עכבר משטח מגע עובד, עם הקשה באצבע אחת, הקשה בשתי אצבעות והקשה כפולה כקלטים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Érintőpad egér működik, egyujjas koppintással, kétujjas koppintással és dupla koppintással bemenetként"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikus Touchpad berfungsi, dengan ketuk satu jari, ketuk dua jari, dan ketuk dua kali sebagai input"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse da touchpad funziona, con tocco a un dito, tocco a due dita e doppio tocco come input"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タッチパッドマウスが動作し、1本指タップ、2本指タップ、ダブルタップを入力として使えます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터치패드 마우스가 작동하며, 한 손가락 탭, 두 손가락 탭, 두 번 탭을 입력으로 사용함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berøringsflatemus fungerer, med enfingertrykk, tofingertrykk og dobbelttrykk som inndata"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpadmuis werkt, met tik met één vinger, tik met twee vingers en dubbeltik als ingangen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mysz z gładzika działa, z dotknięciem jednym palcem, dotknięciem dwoma palcami i dwukrotnym dotknięciem jako wejściami"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mouse por touchpad funciona, com toque com um dedo, toque com dois dedos e toque duplo como entradas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Тачпад как мышь» работает, с касанием одним пальцем, касанием двумя пальцами и двойным касанием в качестве входов"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchpad ako myš funguje, s ťuknutím jedným prstom, ťuknutím dvoma prstami a dvojitým ťuknutím ako vstupmi"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekplattemus fungerar, med ettfingertryck, tvåfingertryck och dubbeltryck som indata"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมาส์ทัชแพดทำงานแล้ว โดยมีการแตะหนึ่งนิ้ว แตะสองนิ้ว และแตะสองครั้งเป็นอินพุต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokunmatik Yüzey Faresi çalışıyor; tek parmakla dokunma, iki parmakla dokunma ve çift dokunma giriş olarak"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Миша на сенсорній панелі працює, із торканням одним пальцем, торканням двома пальцями та подвійним торканням як входами"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuột bàn di cảm ứng hoạt động, với chạm một ngón, chạm hai ngón và chạm đúp làm đầu vào"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
