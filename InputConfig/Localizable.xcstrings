    "New regions belong to this display. Every display means the same area of whichever screen the pointer is on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتمي المناطق الجديدة إلى هذه الشاشة. «كل شاشة» تعني المساحة نفسها من أي شاشة يوجد عليها المؤشر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové oblasti patří tomuto displeji. Každý displej znamená stejnou oblast kterékoli obrazovky, na které je ukazatel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye områder hører til denne skærm. Alle skærme betyder det samme område på den skærm, markøren er på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Bereiche gehören zu diesem Display. „Jedes Display“ bedeutet denselben Bereich des Bildschirms, auf dem sich der Zeiger gerade befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las regiones nuevas pertenecen a esta pantalla. Todas las pantallas significa la misma zona de cualquier pantalla en la que esté el puntero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet alueet kuuluvat tälle näytölle. Kaikki näytöt tarkoittaa samaa aluetta siitä näytöstä, jolla osoitin on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles zones appartiennent à cet écran. Tous les écrans désigne la même zone de l’écran où se trouve le pointeur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזורים חדשים שייכים לתצוגה הזו. ״כל התצוגות״ פירושו אותו אזור בכל מסך שהמצביע נמצא בו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új területek ehhez a kijelzőhöz tartoznak. A Minden kijelző ugyanazt a területet jelenti annak a képernyőnek, amelyiken a mutató éppen van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah baru milik layar ini. Setiap layar berarti area yang sama dari layar mana pun tempat penunjuk berada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove regioni appartengono a questo display. Ogni display significa la stessa area di qualunque schermo su cui si trovi il puntatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい領域はこのディスプレイに属します。「すべてのディスプレイ」は、ポインタがある画面の同じエリアを意味します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 영역은 이 디스플레이에 속합니다. ‘모든 디스플레이’는 포인터가 있는 화면의 같은 영역을 의미합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye områder hører til denne skjermen. Alle skjermer betyr det samme området på den skjermen pekeren er på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe gebieden horen bij dit beeldscherm. Elk beeldscherm betekent hetzelfde gebied van het scherm waarop de aanwijzer staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe obszary należą do tego wyświetlacza. Każdy wyświetlacz oznacza ten sam obszar ekranu, na którym jest wskaźnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As novas regiões pertencem a esta tela. Todas as telas significa a mesma área de qualquer tela em que o ponteiro estiver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые области принадлежат этому дисплею. «Все дисплеи» означает одну и ту же область того экрана, на котором находится указатель."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové oblasti patria tomuto displeju. Každý displej znamená rovnakú oblasť ktorejkoľvek obrazovky, na ktorej je ukazovateľ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya regioner tillhör den här skärmen. Alla skärmar betyder samma område på den skärm som pekaren är på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ใหม่เป็นของจอแสดงผลนี้ ทุกจอแสดงผลหมายถึงพื้นที่เดียวกันของหน้าจอใดก็ตามที่ตัวชี้อยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bölgeler bu ekrana aittir. Her ekran, işaretçinin bulunduğu ekranın aynı alanı anlamına gelir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові області належать цьому дисплею. «Кожен дисплей» означає ту саму ділянку будь-якого екрана, на якому перебуває вказівник."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng mới thuộc về màn hình này. Mọi màn hình nghĩa là cùng một khu vực của màn hình mà con trỏ đang ở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新区域属于此显示器。“每个显示器”指指针所在屏幕的相同区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新區域屬於此顯示器。「所有顯示器」表示指標所在螢幕的相同區域。"
          }
        }
      }
    },
