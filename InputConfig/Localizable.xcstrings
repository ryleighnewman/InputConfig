        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: pilih zona di menu arah baris stik atau pemicu, di samping plus dan minus. Opsi baris dan lembar zona mati juga menampilkan zona."
          }
        },
        "it" : {
          "stringUnit" : {
