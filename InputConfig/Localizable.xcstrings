    "1 built-in preset from the backup added beside this Mac’s copy, named “(from backup)”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إضافة إعداد مسبق مضمّن واحد من النسخة الاحتياطية بجانب نسخة جهاز Mac هذا، باسم “(من النسخة الاحتياطية)”"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 vestavěná předvolba ze zálohy byla přidána vedle kopie v tomto Macu a nazvána „(ze zálohy)“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 indbygget forudindstilling fra backuppen er tilføjet ved siden af denne Macs kopi og hedder “(fra backup)”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 integriertes Preset aus dem Backup neben der Kopie dieses Mac hinzugefügt, benannt „(aus Backup)“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha añadido 1 preajuste integrado de la copia de seguridad junto a la copia de este Mac, con el nombre “(de la copia de seguridad)”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 sisäänrakennettu esiasetus lisätty varmuuskopiosta tämän Macin kopion viereen nimellä ”(varmuuskopiosta)”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 préréglage intégré de la sauvegarde ajouté à côté de la copie de ce Mac, nommé « (de la sauvegarde) »"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פריסט מובנה אחד מהגיבוי נוסף לצד העותק של ה-Mac הזה, בשם “(מהגיבוי)”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 beépített előbeállítás a mentésből hozzáadva a Mac meglévő példánya mellé, „(mentésből)” névvel"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 preset bawaan dari cadangan ditambahkan di samping salinan di Mac ini, bernama “(dari cadangan)”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 preset integrato dal backup aggiunto accanto alla copia di questo Mac, con il nome “(dal backup)”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの組み込みプリセット1個を、このMacのコピーの隣に「（バックアップから）」という名前で追加しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업의 내장 프리셋 1개를 이 Mac의 사본 옆에 “(백업에서)”라는 이름으로 추가함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 innebygd forhåndsinnstilling fra sikkerhetskopien lagt til ved siden av kopien på denne Macen, med navnet «(fra sikkerhetskopi)»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 ingebouwde preset uit de back-up is toegevoegd naast de kopie op deze Mac, met de naam “(uit back-up)”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 wbudowany preset z kopii zapasowej dodano obok kopii na tym Macu, z nazwą „(z kopii zapasowej)”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 preset integrado do backup adicionado ao lado da cópia deste Mac, chamado “(do backup)”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 встроенный пресет из резервной копии добавлен рядом с копией на этом Mac с пометкой «(из резервной копии)»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 vstavaná predvoľba zo zálohy sa pridala vedľa kópie v tomto Macu s názvom „(zo zálohy)“"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 inbyggd förinställning från säkerhetskopian har lagts till bredvid den här Macens kopia, med namnet ”(från säkerhetskopia)”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มพรีเซ็ตที่มากับระบบ 1 รายการจากข้อมูลสำรองไว้ข้างสำเนาของ Mac เครื่องนี้ โดยตั้งชื่อว่า “(จากข้อมูลสำรอง)”"
          }
        },
        "tr" : {
          "stringUnit" : {
