          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のタイミングでキー入力をつなげたり、設定可能なレートで任意のボタンを連打したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 타이밍으로 키 입력을 연결하거나, 어떤 버튼이든 지정한 속도로 연사합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjed sammen tastetrykk med egen timing, eller gjenta en hvilken som helst knapp raskt med en justerbar frekvens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel toetsaanslagen met aangepaste timing, of herhaal een knop snel met een instelbare snelheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łącz naciśnięcia klawiszy z własnym czasem albo powtarzaj dowolny przycisk z ustawianą częstotliwością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encadeie teclas com tempo personalizado, ou dispare qualquer botão rapidamente em uma taxa configurável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связывайте нажатия клавиш в цепочки с настраиваемым временем или заставьте любую кнопку срабатывать очень часто с настраиваемой частотой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reťazte stlačenia klávesov s vlastným časovaním alebo rýchlo opakujte ľubovoľné tlačidlo nastaviteľnou rýchlosťou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedja tangenttryckningar med egen timing, eller tryck snabbt i serie på valfri knapp med valfri frekvens."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่อแป้นกดเป็นลูกโซ่ด้วยจังหวะที่กำหนดเอง หรือกดปุ่มใดก็ได้รัวด้วยอัตราที่กำหนดได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuş vuruşlarını özel zamanlamayla zincirleyin ya da herhangi bir düğmeyi ayarlanabilir bir hızla seri atış yaptırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зв’язуйте натискання клавіш у ланцюжок з окремим часом або швидко повторюйте будь-яку кнопку з налаштовуваною частотою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nối các lần nhấn phím với thời gian tùy chỉnh, hoặc bấm liên tục bất kỳ nút nào với tốc độ có thể cấu hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串联按键并设置自定义时序，或以可配置的速率让任何按钮快速连发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "串接按鍵並自訂時間，或以可調整的速率快速連按任何按鈕。"
          }
        }
      }
    },
