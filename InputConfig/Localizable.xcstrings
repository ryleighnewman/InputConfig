    "Click Grant Access, then turn on InputConfig under Privacy and Security, Accessibility." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر «منح الوصول» ثم شغّل InputConfig في الخصوصية والأمن، تسهيلات الاستخدام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
