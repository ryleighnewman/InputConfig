    "Name every button the Xbox, PlayStation, Nintendo, Stadia, GameCube, or Steam Controller way for each preset, or North, South, East, and West in Settings" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سمِّ كل زر بطريقة Xbox أو PlayStation أو Nintendo أو Stadia أو GameCube أو Steam Controller لكل إعداد مسبق، أو شمال وجنوب وشرق وغرب في الإعدادات"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pojmenujte každé tlačítko způsobem Xbox, PlayStation, Nintendo, Stadia, GameCube nebo Steam Controller pro každou předvolbu, nebo Sever, Jih, Východ a Západ v Nastavení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navngiv hver knap efter Xbox-, PlayStation-, Nintendo-, Stadia-, GameCube- eller Steam Controller-måden for hver forudindstilling, eller Nord, Syd, Øst og Vest i Indstillinger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne jede Taste für jedes Preset wie bei Xbox, PlayStation, Nintendo, Stadia, GameCube oder Steam Controller, oder Nord, Süd, Ost und West in den Einstellungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombra cada botón a la manera de Xbox, PlayStation, Nintendo, Stadia, GameCube o Steam Controller para cada preajuste, o Norte, Sur, Este y Oeste en Ajustes"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimeä jokainen painike Xboxin, PlayStationin, Nintendon, Stadian, GameCuben tai Steam Controllerin tapaan esiasetuskohtaisesti, tai Pohjoinen, Etelä, Itä ja Länsi Asetuksissa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nommez chaque bouton à la manière Xbox, PlayStation, Nintendo, Stadia, GameCube ou Steam Controller pour chaque préréglage, ou Nord, Sud, Est et Ouest dans les réglages"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תן שם לכל לחצן בסגנון Xbox, PlayStation, Nintendo, Stadia, GameCube או Steam Controller לכל פריסט, או צפון, דרום, מזרח ומערב בהגדרות"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevezze el az összes gombot az Xbox, PlayStation, Nintendo, Stadia, GameCube vagy Steam Controller módján előbeállításonként, vagy Észak, Dél, Kelet és Nyugat néven a Beállításokban"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri nama setiap tombol dengan cara Xbox, PlayStation, Nintendo, Stadia, GameCube, atau Steam Controller untuk setiap preset, atau Utara, Selatan, Timur, dan Barat di Pengaturan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna un nome a ogni pulsante alla maniera di Xbox, PlayStation, Nintendo, Stadia, GameCube o Steam Controller per ogni preset, oppure Nord, Sud, Est e Ovest nelle Impostazioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットごとに、すべてのボタンをXbox、PlayStation、Nintendo、Stadia、GameCube、またはSteam Controllerの呼び方で名付けられます。設定では、北、南、東、西でも表示できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋마다 모든 버튼에 Xbox, PlayStation, Nintendo, Stadia, GameCube, Steam Controller 방식의 이름을 붙이거나, 설정에서 북, 남, 동, 서로 이름 붙이기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi hver knapp navn på Xbox-, PlayStation-, Nintendo-, Stadia-, GameCube- eller Steam Controller-måten for hver forhåndsinnstilling, eller nord, sør, øst og vest i Innstillinger"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef elke knop de naam zoals Xbox, PlayStation, Nintendo, Stadia, GameCube of Steam Controller dat doen, per preset, of Noord, Zuid, Oost en West in Instellingen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwij każdy przycisk w stylu Xbox, PlayStation, Nintendo, Stadia, GameCube lub Steam Controller dla każdego presetu albo Północ, Południe, Wschód i Zachód w Ustawieniach"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomeie cada botão ao jeito do Xbox, PlayStation, Nintendo, Stadia, GameCube ou Steam Controller para cada preset, ou Norte, Sul, Leste e Oeste nos Ajustes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Называйте каждую кнопку, как на Xbox, PlayStation, Nintendo, Stadia, GameCube или Steam Controller, для каждого пресета, или Север, Юг, Восток и Запад в настройках"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomenujte každé tlačidlo spôsobom Xbox, PlayStation, Nintendo, Stadia, GameCube alebo Steam Controller pre každú predvoľbu, alebo Sever, Juh, Východ a Západ v Nastaveniach"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namnge varje knapp på Xbox-, PlayStation-, Nintendo-, Stadia-, GameCube- eller Steam Controller-sättet för varje förinställning, eller Nord, Syd, Öst och Väst i Inställningar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งชื่อทุกปุ่มตามแบบ Xbox, PlayStation, Nintendo, Stadia, GameCube หรือ Steam Controller สำหรับแต่ละพรีเซ็ต หรือเหนือ ใต้ ตะวันออก และตะวันตกในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her düğmeyi her ön ayar için Xbox, PlayStation, Nintendo, Stadia, GameCube veya Steam Controller tarzında adlandırın ya da Ayarlar’da Kuzey, Güney, Doğu ve Batı olarak"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Називайте кожну кнопку на манер Xbox, PlayStation, Nintendo, Stadia, GameCube чи Steam Controller для кожного пресета, або Північ, Південь, Схід і Захід у Параметрах"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt tên mọi nút theo cách của Xbox, PlayStation, Nintendo, Stadia, GameCube hoặc Steam Controller cho từng cài đặt sẵn, hoặc Bắc, Nam, Đông và Tây trong Cài đặt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 Xbox、PlayStation、Nintendo、Stadia、GameCube 或 Steam Controller 的方式为每个预设命名每个按钮，或在“设置”中使用北、南、东、西"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依 Xbox、PlayStation、Nintendo、Stadia、GameCube 或 Steam Controller 的方式為每個預設命名每個按鈕，或在「設定」中使用北、南、東、西"
          }
        }
      }
    },
