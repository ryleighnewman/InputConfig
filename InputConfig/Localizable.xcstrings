            "value" : "Slå på InputConfig i Personvern og sikkerhet → Tilgjengelighet for å sende tastatur- og museinndata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel InputConfig in via Privacy en beveiliging → Toegankelijkheid om toetsenbord- en muisinvoer te sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz InputConfig w: Prywatność i ochrona → Dostępność, aby wysyłać wejście klawiatury i myszy."
