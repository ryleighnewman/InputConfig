    "A group no longer warns about a missing controller when nothing in it needs one" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تعد المجموعة تحذر من غياب ذراع تحكم عندما لا يحتاج إليه أي شيء فيها"
