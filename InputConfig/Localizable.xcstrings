          "stringUnit" : {
            "state" : "translated",
            "value" : "Mematikan preset aktif dan melepas setiap tombol, tombol tetikus, dan nada yang ditahannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattiva il preset attivo e rilascia ogni tasto, pulsante del mouse e nota che teneva premuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクティブなプリセットをオフにし、押さえていたすべてのキー、マウスボタン、ノートを解除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 프리셋을 끄고 프리셋이 누르고 있던 모든 키, 마우스 버튼, 노트를 해제합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slår av den aktive forhåndsinnstillingen og slipper alle taster, museknapper og toner den holdt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de actieve preset uit en laat elke toets, muisknop en noot los die hij vasthield."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącza aktywny preset i zwalnia każdy klawisz, przycisk myszy i nutę, które przytrzymywał."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativa o preset ativo e solta cada tecla, botão do mouse e nota que ele estava segurando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключает активный пресет и отпускает все клавиши, кнопки мыши и ноты, которые он удерживал."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypne aktívnu predvoľbu a uvoľní každý kláves, tlačidlo myši a notu, ktoré držala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger av den aktiva förinställningen och släpper varje tangent, musknapp och ton som den höll."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดพรีเซ็ตที่ใช้งานอยู่ และปล่อยทุกแป้น ปุ่มเมาส์ และโน้ตที่มันกดค้างไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin ön ayarı kapatır ve tuttuğu her tuşu, fare düğmesini ve notayı bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимикає активний пресет і відпускає кожну клавішу, кнопку миші та ноту, які він утримував."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt cài đặt sẵn đang hoạt động và nhả mọi phím, nút chuột và nốt mà nó đang giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭已启用的预设，并释放它按住的每个按键、鼠标按钮和音符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉使用中的預設，並放開它所按住的每個按鍵、滑鼠按鈕和音符。"
          }
        }
      }
    },
