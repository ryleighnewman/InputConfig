        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksi app baru menyalakan dan mematikan gerakan dengan satu tekanan, atau membuatnya menggerakkan penunjuk hanya saat tombol ditahan, dari input apa pun, termasuk tombol keyboard atau pedal kaki"
