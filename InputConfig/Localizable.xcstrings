    "Three quick taps send this action instead of the row's normal output. One or two taps wait out the time set here before they send." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثلاث نقرات سريعة ترسل هذا الإجراء بدلًا من مخرج الصف العادي. نقرة أو نقرتان تنتظران المدة المحددة هنا قبل الإرسال."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tři rychlé stisky pošlou tuto akci místo běžného výstupu řádku. Jeden nebo dva stisky počkají zde nastavený čas, než pošlou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre hurtige tryk sender denne handling i stedet for rækkens normale output. Et eller to tryk venter den tid, der er sat her, før de sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei schnelle Tipps senden diese Aktion statt der normalen Ausgabe der Zeile. Ein oder zwei Tipps warten die hier eingestellte Zeit ab, bevor sie senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres toques rápidos envían esta acción en lugar de la salida normal de la fila. Uno o dos toques esperan el tiempo fijado aquí antes de enviar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolme nopeaa napautusta lähettää tämän toiminnon rivin tavallisen lähdön sijaan. Yksi tai kaksi napautusta odottaa tähän asetetun ajan ennen lähetystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois appuis rapides envoient cette action à la place de la sortie normale de la ligne. Un ou deux appuis attendent le délai réglé ici avant d'envoyer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלוש הקשות מהירות שולחות פעולה זו במקום הפלט הרגיל של השורה. הקשה אחת או שתיים ממתינות את הזמן שנקבע כאן לפני השליחה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három gyors koppintás ezt a műveletet küldi a sor szokásos kimenete helyett. Egy vagy két koppintás kivárja az itt beállított időt a küldés előtt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga ketukan cepat mengirim tindakan ini alih-alih keluaran normal baris. Satu atau dua ketukan menunggu waktu yang diatur di sini sebelum mengirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre tocchi rapidi inviano questa azione al posto dell'uscita normale della riga. Uno o due tocchi attendono il tempo impostato qui prima di inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "素早く3回タップすると、行の通常の出力の代わりにこの動作を送ります。1回または2回のタップは、ここで設定した時間を待ってから送ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠르게 세 번 누르면 행의 일반 출력 대신 이 동작을 보냅니다. 한 번 또는 두 번 누르면 여기서 설정한 시간을 기다린 뒤 보냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre raske trykk sender denne handlingen i stedet for radens vanlige utgang. Ett eller to trykk venter ut tiden som er satt her før de sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie snelle tikken sturen deze actie in plaats van de normale uitvoer van de rij. Een of twee tikken wachten de hier ingestelde tijd af voordat ze sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzy szybkie naciśnięcia wysyłają to działanie zamiast zwykłego wyjścia wiersza. Jedno lub dwa naciśnięcia czekają ustawiony tu czas, zanim wyślą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três toques rápidos enviam esta ação no lugar da saída normal da linha. Um ou dois toques esperam o tempo definido aqui antes de enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три быстрых нажатия отправляют это действие вместо обычного выхода строки. Одно или два нажатия ждут заданное здесь время перед отправкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tri rýchle stlačenia pošlú túto akciu namiesto bežného výstupu riadku. Jedno alebo dve stlačenia počkajú tu nastavený čas, kým pošlú."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre snabba tryck skickar den här åtgärden i stället för radens vanliga utgång. Ett eller två tryck väntar ut tiden som är satt här innan de skickar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเร็ว ๆ สามครั้งจะส่งการทำงานนี้แทนเอาต์พุตปกติของแถว การแตะหนึ่งหรือสองครั้งจะรอเวลาที่ตั้งไว้ที่นี่ก่อนส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç hızlı dokunuş, satırın normal çıkışı yerine bu eylemi gönderir. Bir veya iki dokunuş göndermeden önce burada ayarlanan süreyi bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три швидкі натискання надсилають цю дію замість звичайного виходу рядка. Одне або два натискання чекають заданий тут час перед надсиланням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba lần nhấn nhanh gửi hành động này thay cho đầu ra thường của hàng. Một hoặc hai lần nhấn chờ hết thời gian đặt ở đây rồi mới gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速三击会发送此操作而不是该行的常规输出。单击或双击会等待此处设置的时间后再发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速連按三下會送出此動作而不是該列的一般輸出。按一下或兩下會等待此處設定的時間後再送出。"
          }
        }
      }
    },
