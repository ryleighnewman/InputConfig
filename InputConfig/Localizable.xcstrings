    "Cancel in the editor asks before throwing away changes, and Empty Trash and deleting a folder ask first" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل «إلغاء» في المحرر قبل تجاهل التغييرات، ويسأل «إفراغ سلة المحذوفات» وحذف المجلد أولًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrušit v editoru se před zahozením změn zeptá, a také Vysypat koš a smazání složky se nejprve zeptají"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuller i editoren spørger, før ændringer kasseres, og Tøm papirkurv og sletning af en mappe spørger først"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Abbrechen“ im Editor fragt nach, bevor Änderungen verworfen werden, und „Papierkorb leeren“ sowie das Löschen eines Ordners fragen zuerst nach"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar en el editor pregunta antes de descartar los cambios, y Vaciar papelera y eliminar una carpeta preguntan primero"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peruuta muokkaimessa kysyy ennen muutosten hylkäämistä, ja Tyhjennä Roskakori sekä kansion poisto kysyvät ensin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuler dans l’éditeur demande confirmation avant d’abandonner les modifications, et Vider la corbeille et la suppression d’un dossier demandent aussi confirmation"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביטול בעורך שואל לפני שמשליכים שינויים, וגם ריקון האשפה ומחיקת תיקייה שואלים קודם"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerkesztőben a Mégse rákérdez a módosítások eldobása előtt, a Kuka ürítése és egy mappa törlése pedig szintén rákérdez"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan di editor bertanya sebelum membuang perubahan, dan Kosongkan Sampah serta menghapus folder bertanya terlebih dahulu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulla nell’editor chiede conferma prima di scartare le modifiche, e così fanno Svuota cestino ed Elimina cartella"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタで「キャンセル」を押すと、変更を破棄する前に確認され、ゴミ箱を空にするときやフォルダを削除するときも先に確認されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집기에서 취소하면 변경 내용을 버리기 전에 묻고, 휴지통 비우기와 폴더 삭제도 먼저 확인함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbryt i editoren spør før endringer kastes, og Tøm papirkurv og sletting av en mappe spør først"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annuleren in de editor vraagt eerst of je wijzigingen wilt weggooien, en ook Prullenmand legen en het verwijderen van een map vragen eerst om bevestiging"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuluj w edytorze pyta przed odrzuceniem zmian, a Opróżnij kosz i usunięcie folderu też pytają najpierw"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancelar no editor pergunta antes de descartar as alterações, e Esvaziar lixeira e excluir uma pasta também perguntam antes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Отмена» в редакторе спрашивает перед отбрасыванием изменений, а «Очистить корзину» и удаление папки тоже спрашивают заранее"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrušiť v editore sa pred zahodením zmien spýta a Vysypať Kôš a odstránenie priečinka sa tiež najprv spýtajú"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avbryt i redigeraren frågar innan ändringar kastas, och Töm papperskorgen och radering av en mapp frågar först"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยกเลิกในตัวแก้ไขจะถามก่อนทิ้งการเปลี่ยนแปลง และล้างถังขยะกับการลบโฟลเดอร์จะถามก่อนเช่นกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyicide Vazgeç, değişiklikleri atmadan önce sorar; Çöp Sepetini Boşalt ve bir klasörü silme de önce sorar"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Скасувати» в редакторі запитує перед відкиданням змін, а «Очистити Смітник» і видалення папки також запитують спершу"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hủy trong trình chỉnh sửa sẽ hỏi trước khi bỏ các thay đổi, và Dọn sạch Thùng rác cũng như xóa thư mục đều hỏi trước"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在编辑器中点按“取消”会先询问再放弃更改；“清倒废纸篓”和删除文件夹也会先询问"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在編輯器中按「取消」會先詢問再捨棄變更，而「清倒垃圾桶」和刪除檔案夾也會先詢問"
          }
        }
      }
    },
