    "Opening a second copy of InputConfig now says a copy is already running, instead of closing at once" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فتح نسخة ثانية من InputConfig يعرض الآن رسالة بأن نسخة قيد التشغيل بالفعل، بدلًا من الإغلاق فورًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevření druhé kopie InputConfig nyní oznámí, že kopie už běží, místo aby se okamžitě zavřela"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du åbner endnu en kopi af InputConfig, får du nu besked om, at en kopi allerede kører, i stedet for at den lukker med det samme"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
