    "Switches the Live Visualizer between controller, keyboard, touchpad, and mouse layouts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدّل العارض المباشر بين تخطيطات ذراع التحكم ولوحة المفاتيح ولوحة اللمس والماوس"
          }
        },
        "cs" : {
          "stringUnit" : {
