    "(open to edit how it fires, hold, double or triple tap, macro and feedback)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(افتح لتحرير طريقة التشغيل والضغط المطوّل والنقر المزدوج أو الثلاثي والماكرو والتغذية الراجعة)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(otevřete pro úpravu spouštění, podržení, dvojitého či trojitého stisku, makra a odezvy)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(åbn for at redigere, hvordan den udløses, hold, dobbelt- eller tredobbelt tryk, makro og feedback)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(öffnen für Auslösung, Halten, Doppel- oder Dreifachtipp, Makro und Rückmeldung)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(abrir para editar cómo se dispara, mantener, doble o triple toque, macro y respuesta)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(avaa muokataksesi laukaisua, pitoa, kaksois- tai kolmoisnapautusta, makroa ja palautetta)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(ouvrir pour le déclenchement, le maintien, le double ou triple appui, la macro et le retour)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(פתחו לעריכת אופן ההפעלה, לחיצה ממושכת, הקשה כפולה או משולשת, מאקרו ומשוב)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(nyisd meg a kioldás, a nyomva tartás, a dupla vagy tripla koppintás, a makró és a visszajelzés szerkesztéséhez)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(buka untuk mengedit cara memicu, tahan, ketuk dua atau tiga kali, makro, dan umpan balik)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(apri per modificare come scatta, pressione prolungata, doppio o triplo tocco, macro e feedback)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(開くと発火の仕方、長押し、ダブルまたはトリプルタップ、マクロ、フィードバックを編集できます)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(열어서 작동 방식, 길게 누르기, 두 번 또는 세 번 누르기, 매크로, 피드백을 편집)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(åpne for å redigere hvordan den utløses, hold, dobbelt- eller trippeltrykk, makro og tilbakemelding)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(open om te bewerken hoe het afgaat, vasthouden, twee- of driemaal tikken, macro en feedback)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(otwórz, aby edytować wyzwalanie, przytrzymanie, podwójne lub potrójne naciśnięcie, makro i informację zwrotną)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(abra para editar como dispara, segurar, toque duplo ou triplo, macro e feedback)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(откройте, чтобы настроить срабатывание, удержание, двойное или тройное нажатие, макрос и отклик)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(otvorte na úpravu spúšťania, podržania, dvojitého či trojitého stlačenia, makra a odozvy)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(öppna för att ändra hur den utlöses, håll, dubbel- eller trippeltryck, makro och återkoppling)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(เปิดเพื่อแก้ไขวิธีทำงาน การกดค้าง การแตะสองหรือสามครั้ง มาโคร และการตอบสนอง)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(nasıl tetiklendiğini, basılı tutmayı, çift veya üç dokunmayı, makroyu ve geri bildirimi düzenlemek için açın)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(відкрийте, щоб налаштувати спрацьовування, утримання, подвійне чи потрійне натискання, макрос і відгук)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(mở để sửa cách kích hoạt, giữ, nhấn đúp hoặc ba lần, macro và phản hồi)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(打开以编辑触发方式、长按、双击或三击、宏和反馈)"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(打開以編輯觸發方式、長按、連按兩下或三下、巨集和回饋)"
          }
        }
      }
    },
    "(open to edit the deadzone, 25% now, sensitivity and inversion)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
