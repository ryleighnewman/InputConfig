    "Optimized for macOS 27, with a new app icon made for the Dark, Clear, and Tinted styles" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محسَّن لـ macOS 27، مع أيقونة تطبيق جديدة مصممة للأنماط الداكن والشفاف والملوّن"
          }
        },
        "cs" : {
          "stringUnit" : {
