    "Turn Step setting per binding: Fine, Normal, Coarse, or Chunky nudge sensitivity for Turn mode" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد خطوة الدوران لكل ربط: دفعة دقيقة أو عادية أو خشنة أو غليظة لحساسية وضع الدوران"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení kroku otáčení pro každé přiřazení: Jemné, Normální, Hrubé nebo Velmi hrubé citlivosti impulsů pro režim Otáčení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstilling for drejetrin pr. tildeling: Fin, Normal, Grov eller Stor følsomhed for skub i Drej-tilstand"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellung „Drehschritt“ pro Belegung: Fein, Normal, Grob oder Sehr grob als Impulsempfindlichkeit für den Drehmodus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste de paso de Giro por asignación: sensibilidad de ajuste Fino, Normal, Grueso o Muy grueso para el modo Giro"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kierron askel -asetus määrityskohtaisesti: Hieno, Normaali, Karkea tai Iso töytäisyherkkyys Kierto-tilalle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglage du pas de rotation par affectation : sensibilité d’impulsion Fine, Normale, Grossière ou Épaisse pour le mode Rotation"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרת צעד סיבוב לכל קישור: רגישות הזזה עדינה, רגילה, גסה או גסה מאוד עבור מצב סיבוב"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgatási lépés beállítás hozzárendelésenként: Finom, Normál, Durva vagy Tömör lökésérzékenység Forgatás módhoz"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengaturan Langkah Putar per pemetaan: sensitivitas dorongan Halus, Normal, Kasar, atau Besar untuk mode Putar"
          }
        },
        "it" : {
          "stringUnit" : {
