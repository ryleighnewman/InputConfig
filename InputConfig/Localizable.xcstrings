        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be az InputConfiget itt: Adatvédelem és biztonság → Kisegítő lehetőségek a billentyűzet- és egérbemenet küldéséhez."
