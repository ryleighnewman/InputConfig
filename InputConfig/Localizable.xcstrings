    "Free forever. A tip is never expected, but would truly mean the world." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاني للأبد. لا يُتوقع إكرامية أبدًا، لكنها ستعني الكثير حقًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navždy zdarma. Spropitné se nikdy nečeká, ale opravdu by mnoho znamenalo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis for altid. Et drikkepenge forventes aldrig, men ville betyde utroligt meget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für immer kostenlos. Ein Trinkgeld wird nie erwartet, würde aber unglaublich viel bedeuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis para siempre. Nunca se espera una propina, pero significaría muchísimo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmainen ikuisesti. Tippiä ei koskaan odoteta, mutta se merkitsisi todella paljon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit pour toujours. Un pourboire n’est jamais attendu, mais compterait énormément."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חינם לתמיד. טיפ לעולם לא נדרש, אבל יהיה לו משמעות עצומה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örökre ingyenes. Borravaló soha nem elvárt, de igazán sokat jelentene."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis selamanya. Tip tidak pernah diharapkan, tetapi akan sangat berarti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis per sempre. Una mancia non è mai richiesta, ma significherebbe moltissimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久に無料です。チップは必須ではありませんが、いただけたらこの上なくうれしいです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영원히 무료입니다. 팁은 기대하지 않지만, 받는다면 정말 큰 힘이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis for alltid. Et tips forventes aldri, men ville betydd alt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor altijd gratis. Een fooi wordt nooit verwacht, maar zou echt heel veel betekenen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpłatna na zawsze. Napiwek nigdy nie jest oczekiwany, ale znaczyłby naprawdę wiele."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito para sempre. Uma gorjeta nunca é esperada, mas significaria muito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатно навсегда. Чаевые не обязательны, но стали бы настоящей поддержкой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navždy zadarmo. Sponzorský dar sa nikdy neočakáva, ale znamenal by pre mňa celý svet."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis för alltid. En slant förväntas aldrig, men skulle betyda otroligt mycket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟรีตลอดไป ไม่คาดหวังทิป แต่จะมีความหมายมากจริงๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonsuza dek ücretsiz. Bahşiş hiçbir zaman beklenmez ama dünyalar kadar anlam taşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безкоштовно назавжди. Чайові ніколи не очікуються, але справді багато б означали."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miễn phí mãi mãi. Không bao giờ yêu cầu tiền boa, nhưng nếu có sẽ thực sự có ý nghĩa rất lớn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久免费。从不要求打赏，但你的支持将意义非凡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永遠免費。不期待小費，但若你願意，將是莫大的心意。"
          }
        }
      }
    },
    "Freeze watchdog and cursor guard for a safer always-on experience" : {
      "localizations" : {
