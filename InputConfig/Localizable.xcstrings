        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím này sẽ không còn gõ được ở bất kỳ đâu trên Mac. Một phím chức năng tránh được điều đó."
          }
        },
        "zh-Hans" : {
