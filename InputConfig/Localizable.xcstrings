    "Xbox One (1537), Elite Series 1, Adaptive or third party Xbox pad: macOS does not read it over USB; use Bluetooth or the pad's other mode" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox One (1537) أو Elite Series 1 أو Adaptive أو ذراع Xbox من طرف ثالث: لا يقرؤها macOS عبر USB؛ استخدم Bluetooth أو الوضع الآخر للذراع"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
