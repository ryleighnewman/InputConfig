        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "側邊欄可以搜尋，並可依名稱或預設的編輯或建立時間排序；新資料庫從 A 到 Z 開始排列，既有資料庫保留自己的順序"
          }
        }
      }
    },
