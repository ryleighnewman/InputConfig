    "Sticks and triggers can send MIDI notes and CC dials straight into GarageBand, Logic, or Ableton." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للعصي والزنادات إرسال نوتات MIDI وأقراص CC مباشرة إلى GarageBand أو Logic أو Ableton."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páčky a spouště mohou posílat noty MIDI a kolečka CC přímo do GarageBandu, Logicu nebo Abletonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticks og triggere kan sende MIDI-toner og CC-drejeknapper direkte ind i GarageBand, Logic eller Ableton."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticks und Trigger können MIDI-Noten und CC-Regler direkt an GarageBand, Logic oder Ableton senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sticks y gatillos pueden enviar notas MIDI y diales CC directamente a GarageBand, Logic o Ableton."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvat ja liipaisimet voivat lähettää MIDI-nuotteja ja CC-valitsimia suoraan GarageBandiin, Logiciin tai Abletoniin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sticks et les gâchettes peuvent envoyer des notes MIDI et des cadrans CC directement dans GarageBand, Logic ou Ableton."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ג׳ויסטיקים והדקים יכולים לשלוח תווי MIDI וחוגות CC ישר אל GarageBand, Logic או Ableton."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A joystickok és ravaszok MIDI-hangokat és CC-tárcsákat küldhetnek közvetlenül a GarageBandnek, a Logicnak vagy az Abletonnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stik dan pemicu dapat mengirim nada MIDI dan dial CC langsung ke GarageBand, Logic, atau Ableton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stick e grilletti possono inviare note MIDI e manopole CC direttamente a GarageBand, Logic o Ableton."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スティックとトリガは、MIDIノートとCCダイヤルを、GarageBand、Logic、Abletonに直接送れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스틱과 트리거는 GarageBand, Logic, Ableton에 MIDI 노트와 CC 다이얼을 바로 보낼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joysticker og avtrekkere kan sende MIDI-toner og CC-dialer rett inn i GarageBand, Logic eller Ableton."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticks en triggers kunnen MIDI-noten en CC-draaiknoppen rechtstreeks naar GarageBand, Logic of Ableton sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drążki i spusty mogą wysyłać nuty MIDI i pokrętła CC prosto do GarageBand, Logic lub Ableton."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sticks e gatilhos podem enviar notas MIDI e dials de CC direto para o GarageBand, Logic ou Ableton."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стики и триггеры могут отправлять ноты MIDI и ручки CC прямо в GarageBand, Logic или Ableton."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páčky a spúšte môžu posielať noty MIDI a ovládače CC priamo do GarageBand, Logic alebo Ableton."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spakar och avtryckare kan skicka MIDI-toner och CC-vred direkt till GarageBand, Logic eller Ableton."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จอยสติ๊กและทริกเกอร์ส่งโน้ต MIDI และหน้าปัด CC ตรงเข้า GarageBand, Logic หรือ Ableton ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubuklar ve tetikler MIDI notalarını ve CC kadranlarını doğrudan GarageBand’e, Logic’e veya Ableton’a gönderebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Джойстики й тригери можуть надсилати ноти MIDI та регулятори CC прямо в GarageBand, Logic або Ableton."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần và cò có thể gửi nốt MIDI và núm CC thẳng vào GarageBand, Logic hoặc Ableton."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摇杆和扳机可将 MIDI 音符和 CC 旋盘直接发送到 GarageBand、Logic 或 Ableton。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搖桿和扳機可將 MIDI 音符和 CC 轉盤直接送入 GarageBand、Logic 或 Ableton。"
          }
        }
      }
    },
