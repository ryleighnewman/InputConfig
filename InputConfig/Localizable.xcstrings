        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Předvolba Access Controller se řídí základním profilem Sony: střední tlačítko klikne, zdířka 5 klikne pravým a zdířka 7 otevře Spotlight"
