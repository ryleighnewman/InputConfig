        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik Aktifkan untuk memulai preset, dan Minecraft terbuka untuk Anda. Klik lagi untuk berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Attiva per avviare il preset, che apre Minecraft per te. Fai di nuovo clic per fermarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「有効化」をクリックするとプリセットが始まり、Minecraftが開きます。もう一度クリックすると止まります。"
