    "A Cancel button on the scan overlay, so a scan can be canceled without a keyboard" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر «إلغاء» في طبقة الفحص، ليمكن إلغاء الفحص دون لوحة مفاتيح"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítko Zrušit na překryvu skenování, aby šlo skenování zrušit bez klávesnice"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Annuller-knap på scanningsoverlayet, så en scanning kan annulleres uden et tastatur"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Abbrechen-Taste im Scan-Overlay, damit ein Scan auch ohne Tastatur abgebrochen werden kann"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un botón Cancelar en la superposición de escaneo, para poder cancelar un escaneo sin teclado"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannauksen peittokuvassa on Peruuta-painike, joten skannaus voidaan peruuttaa ilman näppäimistöä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bouton Annuler sur la superposition de scan, pour annuler un scan sans clavier"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחצן ביטול בשכבת הסריקה, כדי שאפשר יהיה לבטל סריקה בלי מקלדת"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mégse gomb a beolvasási rétegen, így a beolvasás billentyűzet nélkül is megszakítható"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol Batalkan pada hamparan pemindaian, sehingga pemindaian dapat dibatalkan tanpa papan ketik"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pulsante Annulla sulla sovrapposizione di scansione, così una scansione può essere annullata senza tastiera"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンのオーバーレイに「キャンセル」ボタンを追加。キーボードがなくてもスキャンを取り消せます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔 오버레이의 취소 버튼으로, 키보드 없이도 스캔을 취소할 수 있음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Avbryt-knapp på skanneoverlegget, slik at en skanning kan avbrytes uten tastatur"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een knop Annuleren op de scan-overlay, zodat een scan zonder toetsenbord kan worden geannuleerd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przycisk Anuluj na nakładce skanowania, aby można było anulować skanowanie bez klawiatury"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um botão Cancelar na sobreposição de escaneamento, para que um escaneamento possa ser cancelado sem teclado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Отмена» на экране сканирования, чтобы сканирование можно было отменить без клавиатуры"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačidlo Zrušiť na prekryve skenovania, aby sa skenovanie dalo zrušiť bez klávesnice"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Avbryt-knapp på skanningsöverlägget, så att en skanning kan avbrytas utan tangentbord"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปุ่มยกเลิกบนหน้าจอสแกน เพื่อให้ยกเลิกการสแกนได้โดยไม่ต้องใช้แป้นพิมพ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarama katmanında bir İptal düğmesi; böylece tarama klavye olmadan iptal edilebilir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Скасувати» на накладці сканування, щоб сканування можна було скасувати без клавіатури"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nút Hủy trên lớp phủ quét, để có thể hủy quét mà không cần bàn phím"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描叠层上有“取消”按钮，因此无需键盘即可取消扫描"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描覆蓋層上的「取消」按鈕，讓你不用鍵盤也能取消掃描"
          }
        }
      }
    },
    "A control this row waits for. Pick a controller button here, or Scan to use anything: a key, a mouse button, a MIDI pad, an accessory switch, a tap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنصر تحكم ينتظره هذا الصف. اختر زر ذراع تحكم هنا، أو استخدم «فحص» لاستخدام أي شيء: مفتاح أو زر ماوس أو لوحة MIDI أو مفتاح تسهيلات أو نقرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládací prvek, na který tento řádek čeká. Zde vyberte tlačítko ovladače, nebo pomocí Skenovat použijte cokoli: klávesu, tlačítko myši, pad MIDI, spínač pro usnadnění, klepnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontrol, som denne række venter på. Vælg en controllerknap her, eller brug Scan til at bruge hvad som helst: en tast, en museknap, en MIDI-pad, en tilbehørskontakt eller et tryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bedienelement, auf das diese Zeile wartet. Wähle hier eine Controller-Taste oder verwende „Scannen“, um beliebige Eingaben zu nutzen: eine Taste, eine Maustaste, ein MIDI-Pad, einen Zubehörschalter, ein Tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un control que espera esta fila. Elige aquí un botón del mando, o usa Escanear para usar cualquier cosa: una tecla, un botón del ratón, un pad MIDI, un conmutador de accesibilidad, un toque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjaus, jota tämä rivi odottaa. Valitse tästä ohjaimen painike tai käytä Skannaa mille tahansa: näppäin, hiiren painike, MIDI-pad, apukytkin tai napautus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une commande que cette ligne attend. Choisissez ici un bouton de manette, ou utilisez Scanner pour employer n’importe quoi : une touche, un bouton de souris, un pad MIDI, un contacteur d’accessibilité, un toucher."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פקד שהשורה הזו ממתינה לו. בחר כאן לחצן בשלט, או סרוק כדי להשתמש בכל דבר: מקש, לחצן עכבר, משטח MIDI, מתג נגישות, הקשה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy vezérlő, amelyre ez a sor vár. Válasszon itt egy vezérlőgombot, vagy használja a Beolvasást bármihez: billentyűhöz, egérgombhoz, MIDI-padhez, kisegítő kapcsolóhoz, koppintáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrol yang ditunggu baris ini. Pilih tombol pengontrol di sini, atau Pindai untuk menggunakan apa saja: tombol, tombol tetikus, pad MIDI, sakelar aksesori, ketukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un comando che questa riga attende. Scegli qui un pulsante del controller, oppure usa Scansiona per usare qualsiasi cosa: un tasto, un pulsante del mouse, un pad MIDI, un interruttore accessorio, un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この行が待機するコントロール。ここでコントローラのボタンを選ぶか、「スキャン」でキー、マウスボタン、MIDIパッド、アクセサリスイッチ、タップなど何でも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 행이 기다리는 컨트롤. 여기서 컨트롤러 버튼을 고르거나 스캔을 눌러 키, 마우스 버튼, MIDI 패드, 보조 스위치, 탭 등 무엇이든 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontroll denne raden venter på. Velg en kontrollerknapp her, eller Skann for å bruke hva som helst: en tast, en museknapp, en MIDI-pad, en tilbehørsbryter, et trykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bediening waarop deze rij wacht. Kies hier een controllerknop, of Scan om iets anders te gebruiken: een toets, een muisknop, een MIDI-pad, een toegankelijkheidsschakelaar, een tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterowanie, na które czeka ten wiersz. Wybierz tutaj przycisk kontrolera albo użyj opcji Skanuj, aby wskazać cokolwiek: klawisz, przycisk myszy, pad MIDI, przełącznik pomocniczy, dotknięcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um controle que esta linha espera. Escolha aqui um botão do controle ou use Escanear para usar qualquer coisa: uma tecla, um botão do mouse, um pad MIDI, um botão de acessibilidade, um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элемент управления, которого ждёт эта строка. Выберите здесь кнопку контроллера или нажмите «Сканировать», чтобы использовать что угодно: клавишу, кнопку мыши, пэд MIDI, адаптивный переключатель, касание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládací prvok, na ktorý tento riadok čaká. Vyberte tu tlačidlo ovládača alebo použite Skenovať pre čokoľvek: kláves, tlačidlo myši, MIDI pad, prepínač príslušenstva, ťuknutie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kontroll som den här raden väntar på. Välj en knapp på spelkontrollen här, eller välj Skanna för att använda vad som helst: en tangent, en musknapp, en MIDI-pad, en hjälpmedelsomkopplare, ett tryck."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การควบคุมที่แถวนี้รออยู่ เลือกปุ่มคอนโทรลเลอร์ที่นี่ หรือสแกนเพื่อใช้สิ่งใดก็ได้: แป้น ปุ่มเมาส์ แพด MIDI สวิตช์เสริม หรือการแตะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu satırın beklediği bir kontrol. Buradan bir kumanda düğmesi seçin ya da Tara ile herhangi bir şeyi kullanın: bir tuş, bir fare düğmesi, bir MIDI pedi, bir erişilebilirlik anahtarı, bir dokunma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Елемент керування, якого чекає цей рядок. Виберіть тут кнопку контролера або натисніть «Сканувати», щоб використати будь-що: клавішу, кнопку миші, пед MIDI, допоміжний перемикач, торкання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một điều khiển mà hàng này chờ. Chọn một nút bộ điều khiển tại đây, hoặc nhấn Quét để dùng bất cứ thứ gì: một phím, một nút chuột, một pad MIDI, một công tắc phụ kiện, một lần chạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此行等待的控件。在此选取控制器按钮，或点按“扫描”以使用任意输入：按键、鼠标按钮、MIDI 键垫、辅助开关或轻点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此列等待的控制項。在此選擇控制器按鈕，或按「掃描」以使用任何東西：按鍵、滑鼠按鈕、MIDI 鼓墊、輔助開關或輕點。"
          }
        }
      }
    },
