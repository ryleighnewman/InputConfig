    "This zone overlaps row %@. While the stick is inside it, only this row fires; that row waits until the stick leaves the zone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتداخل هذه المنطقة مع الصف %@. وما دامت العصا داخلها، يعمل هذا الصف وحده؛ وينتظر ذلك الصف حتى تغادر العصا المنطقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato zóna zasahuje do řádku %@. Dokud je páčka uvnitř ní, spouští se jen tento řádek; ten druhý čeká, dokud páčka zónu neopustí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne zone overlapper række %@. Mens sticken er inden i den, udløses kun denne række. Den række venter, til sticken forlader zonen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zone überschneidet sich mit der Zeile %@. Solange sich der Stick darin befindet, löst nur diese Zeile aus; jene Zeile wartet, bis der Stick die Zone verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta zona se solapa con la fila %@. Mientras el stick está dentro, solo se activa esta fila; esa fila espera hasta que el stick salga de la zona."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä vyöhyke menee päällekkäin rivin %@ kanssa. Kun sauva on sen sisällä, vain tämä rivi laukeaa; tuo rivi odottaa, kunnes sauva poistuu vyöhykkeeltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette zone chevauche la ligne %@. Tant que le stick est dedans, seule cette ligne se déclenche ; l’autre ligne attend que le stick quitte la zone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האזור הזה חופף לשורה %@. כל עוד הג׳ויסטיק בתוכו, רק השורה הזו פועלת; השורה ההיא ממתינה עד שהג׳ויסטיק יוצא מהאזור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a zóna a(z) %@. sort fedi át. Amíg a joystick benne van, csak ez a sor aktiválódik; az a sor addig vár, amíg a joystick el nem hagyja a zónát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona ini tumpang tindih dengan baris %@. Selama stik berada di dalamnya, hanya baris ini yang aktif; baris itu menunggu sampai stik meninggalkan zona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa zona si sovrappone alla riga %@. Finché lo stick è al suo interno, si attiva solo questa riga; quella riga resta in attesa finché lo stick non esce dalla zona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このゾーンは行 %@ と重なっています。スティックがゾーン内にある間は、この行だけが動作し、その行はスティックがゾーンを出るまで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 존은 %@ 행과 겹칩니다. 스틱이 존 안에 있는 동안에는 이 행만 동작하며, 해당 행은 스틱이 존을 벗어날 때까지 대기합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne sonen overlapper rad %@. Mens joysticken er inne i den, utløses bare denne raden. Den raden venter til joysticken forlater sonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze zone overlapt met rij %@. Zolang de stick erin zit, wordt alleen deze rij geactiveerd; die rij wacht tot de stick de zone verlaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta strefa nakłada się na wiersz %@. Gdy drążek jest wewnątrz niej, uruchamia się tylko ten wiersz; tamten wiersz czeka, aż drążek opuści strefę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta zona se sobrepõe à linha %@. Enquanto o stick está dentro dela, só esta linha dispara; aquela linha espera até o stick sair da zona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта зона пересекается со строкой %@. Пока стик находится в ней, срабатывает только эта строка; та строка ждёт, пока стик не покинет зону."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto zóna zasahuje do riadka %@. Kým je páčka vnútri nej, spúšťa sa iba tento riadok; ten druhý čaká, kým páčka zónu neopustí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här zonen överlappar rad %@. Medan spaken är inne i den utlöses bara den här raden. Den raden väntar tills spaken lämnar zonen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โซนนี้ซ้อนกับแถว %@ ขณะที่จอยสติ๊กอยู่ในโซน จะมีเฉพาะแถวนี้ที่ทำงาน แถวนั้นจะรอจนกว่าจอยสติ๊กจะออกจากโซน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölge %@ satırıyla çakışıyor. Çubuk bölgenin içindeyken yalnızca bu satır çalışır; o satır çubuk bölgeden çıkana kadar bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця зона перетинається з рядком %@. Поки джойстик перебуває в ній, спрацьовує лише цей рядок; той рядок чекає, доки джойстик не покине зону."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng này chồng lên hàng %@. Khi cần nằm trong vùng, chỉ hàng này kích hoạt; hàng kia chờ cho đến khi cần rời vùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分区与第 %@ 行重叠。摇杆处于其中时，只有这一行触发；那一行会等到摇杆离开该分区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分區與第 %@ 列重疊。搖桿位於其中時，只有這一列觸發；那一列會等到搖桿離開該分區。"
          }
        }
      }
    },
