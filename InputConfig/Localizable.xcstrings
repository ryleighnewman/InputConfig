    "Press a button, key, or axis on your controller to record this binding" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط زرًا أو مفتاحًا أو حرّك محورًا على ذراع التحكم لتسجيل هذا الربط"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte tlačítko, klávesu nebo osu na ovladači, abyste zaznamenali toto přiřazení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en knap, tast eller akse på din controller for at optage denne tildeling"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke eine Taste oder bewege eine Achse deines Controllers, um diese Belegung aufzuzeichnen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa un botón, una tecla o un eje de tu mando para registrar esta asignación"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina ohjaimen painiketta, näppäintä tai akselia tallentaaksesi tämän määrityksen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un bouton, une touche ou un axe de votre manette pour enregistrer cette affectation"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ על לחצן, מקש או ציר בשלט כדי לתעד את הקישור הזה"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomjon meg egy gombot, billentyűt vagy tengelyt a vezérlőn a hozzárendelés rögzítéséhez"
          }
        },
        "id" : {
          "stringUnit" : {
