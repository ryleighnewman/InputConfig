    "Pointer ramp-up (a short push moves slowly, a held push speeds up)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّج المؤشر (دفعة قصيرة تحرك ببطء، ودفعة مستمرة تتسارع)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náběh ukazatele (krátké vychýlení se pohybuje pomalu, držené zrychluje)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markørens optrapning (et kort skub bevæger langsomt, et holdt skub accelererer)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeiger-Anlauf (ein kurzer Druck bewegt langsam, ein gehaltener Druck beschleunigt)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceleración del puntero (un empujón corto lo mueve despacio, uno mantenido lo acelera)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoittimen kiihtyvyys (lyhyt työntö liikkuu hitaasti, pitkä työntö nopeutuu)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montée en puissance du pointeur (une courte poussée le déplace lentement, une poussée maintenue accélère)"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האצת מצביע (דחיפה קצרה מזיזה לאט, דחיפה מוחזקת מאיצה)"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutató felgyorsítása (rövid nyomás lassan mozgat, a tartott nyomás gyorsít)"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percepatan penunjuk (dorongan singkat bergerak lambat, dorongan yang ditahan semakin cepat)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accelerazione graduale del puntatore (una breve spinta muove lentamente, una spinta mantenuta accelera)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポインタの立ち上がり（短く倒すとゆっくり、倒し続けると加速）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포인터 가속(짧게 밀면 느리게, 계속 밀면 빨라짐)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekeroppstart (et kort dytt flytter sakte, et holdt dytt øker farten)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanloop van de aanwijzer (een korte duw beweegt langzaam, een vastgehouden duw versnelt)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narastanie wskaźnika (krótkie wychylenie porusza powoli, przytrzymane przyspiesza)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceleração do ponteiro (um empurrão curto move devagar, um empurrão segurado acelera)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нарастание скорости указателя (короткое нажатие двигает медленно, удержание ускоряет)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postupné zrýchlenie ukazovateľa (krátke zatlačenie hýbe pomaly, dlhé zatlačenie zrýchľuje)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradvis ökning av pekaren (ett kort tryck rör sig långsamt, ett hållet tryck går snabbare)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเร่งตัวชี้ (ดันสั้นเคลื่อนช้า ดันค้างเร็วขึ้น)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretçi hızlanması (kısa itme yavaş, basılı itme hızlı hareket eder)"
