        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחצו ״הפעל״ כדי להתחיל את הפריסט, והוא יפתח לכם את Minecraft. לחצו שוב כדי לעצור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattints az Aktiválás gombra az előbeállítás indításához, és megnyitja neked a Minecraftot. Kattints újra a leállításhoz."
