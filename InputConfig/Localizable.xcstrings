          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szerkesztő tetején a Név, a Címke, az Aktiválás és a Vészleállítás található, lefelé görgetve pedig az Aktiválás és a Vészleállítás egy sorban marad az előbeállítás neve mellett; a bekapcsolt előbeállítás szerkesztés közben is működik, egy figyelmeztetéssel, amely a kikapcsolását javasolja"
