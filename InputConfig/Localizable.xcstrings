        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sort ad hozzá minden bemenethez, amelyet az eszköz éppen jelent, részek szerint csoportosítva, mindegyik arra vár, hogy kiválassza a kimenetét"
