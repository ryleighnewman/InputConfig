    "Zones on the controller's touchpad. A Touchpad zone input fires while a finger is inside one." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مناطق على لوحة اللمس في وحدة التحكم. يعمل إدخال منطقة لوحة اللمس ما دام إصبع داخل إحدى المناطق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zóny na touchpadu ovladače. Vstup Zóna touchpadu se spustí, dokud je prst uvnitř některé zóny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoner på controllerens touchpad. Et Touchpad-zone-input udløses, mens en finger er inde i en zone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonen auf dem Touchpad des Controllers. Eine Touchpad-Zone-Eingabe löst aus, solange ein Finger in einer Zone ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonas en el panel táctil del mando. Una entrada Zona del panel táctil se activa mientras un dedo está dentro de una."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyöhykkeet ohjaimen kosketuslevyllä. Kosketuslevyn vyöhyke -syöte laukeaa, kun sormi on jonkin vyöhykkeen sisällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des zones sur le pavé tactile de la manette. Une entrée Zone du pavé tactile se déclenche tant qu’un doigt est dans une zone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזורים על משטח המגע של הבקר. קלט אזור משטח מגע מופעל כל עוד אצבע נמצאת בתוך אחד האזורים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zónák a kontroller érintőpadján. Az Érintőpad-zóna bemenet akkor működik, amikor egy ujj valamelyik zónában van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona pada touchpad kontroler. Input Zona touchpad aktif selama jari berada di dalam salah satu zona."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone sul touchpad del controller. Un ingresso Zona del touchpad si attiva finché un dito è dentro una zona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントローラのタッチパッド上のゾーン。タッチパッドゾーン入力は、指がゾーン内にある間だけ働きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤러 터치패드의 존입니다. 터치패드 존 입력은 손가락이 존 안에 있는 동안 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soner på kontrollerens berøringsflate. En Berøringsflatesone-inndata utløses mens en finger er inne i en sone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zones op de touchpad van de controller. Een Touchpadzone-invoer gaat af zolang een vinger in een zone is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strefy na gładziku kontrolera. Wejście Strefa gładzika działa, dopóki palec jest w jednej ze stref."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonas no touchpad do controle. Uma entrada Zona do touchpad dispara enquanto um dedo está dentro de uma zona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зоны на тачпаде контроллера. Ввод «Зона тачпада» срабатывает, пока палец находится в одной из зон."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zóny na touchpade ovládača. Vstup Zóna touchpadu sa spustí, kým je prst v niektorej zóne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoner på handkontrollens pekplatta. En Pekplattezon-indata utlöses medan ett finger är inne i en zon."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โซนบนทัชแพดของคอนโทรลเลอร์ อินพุตโซนทัชแพดทำงานขณะที่นิ้วอยู่ในโซนใดโซนหนึ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetleyicinin dokunmatik yüzeyindeki bölgeler. Dokunmatik yüzey bölgesi girişi, parmak bölgelerden birinin içindeyken çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зони на сенсорній панелі контролера. Ввід «Зона сенсорної панелі» спрацьовує, поки палець у межах однієї із зон."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các vùng trên bàn di cảm ứng của tay cầm. Đầu vào Vùng bàn di cảm ứng kích hoạt khi một ngón tay ở trong vùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制器触摸板上的分区。手指在某个分区内时，触摸板分区输入就会触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制器觸控板上的分區。手指在某個分區內時，觸控板分區輸入就會觸發。"
          }
        }
      }
    },
    "Zones on the controller's touchpad. A Touchpad zone input fires while a finger is inside one. Areas of the display are Screen regions, drawn in their own editor." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مناطق على لوحة لمس ذراع التحكم. يُطلق مدخل «منطقة لوحة اللمس» بينما يكون إصبع داخل إحداها. أجزاء الشاشة هي مناطق الشاشة، وتُرسم في محررها الخاص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zóny na touchpadu ovladače. Vstup Zóna touchpadu se spustí, dokud je uvnitř prst. Oblasti displeje jsou Oblasti obrazovky, kreslené ve vlastním editoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoner på controllerens touchpad. Et Touchpad-zone-input udløses, mens en finger er inden i en. Områder på skærmen er Skærmområder, tegnet i deres eget editorvindue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonen auf dem Touchpad des Controllers. Eine Eingabe „Touchpad-Zone“ löst aus, solange sich ein Finger in einer befindet. Bereiche des Displays sind Bildschirmbereiche, die in einem eigenen Editor gezeichnet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonas del panel táctil del mando. Una entrada de Zona del panel táctil se activa mientras un dedo está dentro de una. Las áreas de la pantalla son Regiones de pantalla, dibujadas en su propio editor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjaimen kosketuslevyn vyöhykkeet. Kosketuslevyvyöhyke-syöte laukeaa sormen ollessa jonkin sisällä. Näytön alueet ovat Näyttöalueita, jotka piirretään omassa muokkaimessaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zones du pavé tactile de la manette. Une entrée Zone du pavé tactile se déclenche tant qu’un doigt se trouve dans l’une d’elles. Les zones de l’écran sont des zones d’écran, dessinées dans leur propre éditeur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזורים במשטח המגע של השלט. קלט אזור משטח מגע מופעל כשאצבע בתוך אחד מהם. שטחים בתצוגה הם אזורי מסך, שמצוירים בעורך משלהם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vezérlő érintőpadjának zónái. Az Érintőpad-zóna bemenet akkor aktiválódik, amikor egy ujj valamelyikben van. A kijelző területei a Képernyőterületek, amelyeket saját szerkesztőjükben rajzolhat meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona pada touchpad pengontrol. Input Zona touchpad aktif saat jari berada di dalam salah satunya. Area layar adalah Wilayah layar, digambar di editornya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone sul touchpad del controller. Un input Zona del touchpad si attiva mentre un dito è all’interno di una di esse. Le aree del display sono Regioni dello schermo, disegnate nel loro editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントローラのタッチパッド上のゾーン。「タッチパッドゾーン」入力は、指が内側にある間に動作します。ディスプレイ上のエリアは「画面領域」で、専用のエディタで描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤러 터치패드의 존. 터치패드 존 입력은 손가락이 존 안에 있는 동안 실행됩니다. 디스플레이의 영역은 화면 영역이며 별도의 편집기에서 그립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soner på kontrollerens berøringsflate. En berøringsflatesone-inndata utløses mens en finger er inni en. Områder av skjermen er Skjermområder, tegnet i sin egen editor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zones op het touchpad van de controller. Een ingang Touchpadzone wordt geactiveerd zolang een vinger erin staat. Gebieden van het beeldscherm zijn Schermgebieden, getekend in hun eigen editor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strefy na gładziku kontrolera. Wejście Strefa gładzika uruchamia się, gdy palec jest w jednej z nich. Fragmenty wyświetlacza to Obszary ekranu, rysowane w osobnym edytorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonas no touchpad do controle. Uma entrada de Zona do touchpad dispara enquanto um dedo está dentro de uma. As áreas da tela são Regiões da tela, desenhadas em seu próprio editor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зоны на тачпаде контроллера. Вход «Зона тачпада» срабатывает, пока палец внутри одной из них. Участки дисплея называются областями экрана и рисуются в отдельном редакторе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zóny na touchpade ovládača. Vstup Zóna touchpadu sa spustí, kým je prst v jednej z nich. Plochy displeja sú Oblasti obrazovky, kreslené vo vlastnom editore."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoner på spelkontrollens pekplatta. En indata för Pekplattezon utlöses medan ett finger är inuti en. Områden på skärmen är Skärmregioner, ritade i sin egen redigerare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โซนบนทัชแพดของคอนโทรลเลอร์ อินพุตโซนทัชแพดทำงานขณะนิ้วอยู่ภายในโซนหนึ่ง พื้นที่ของจอแสดงผลคือพื้นที่หน้าจอ ซึ่งวาดในตัวแก้ไขของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumandanın dokunmatik yüzeyindeki bölgeler. Dokunmatik yüzey bölgesi girişi, bir parmak içindeyken tetiklenir. Ekranın alanları, kendi düzenleyicisinde çizilen Ekran bölgeleridir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зони на сенсорній панелі контролера. Вхід «Зона сенсорної панелі» спрацьовує, поки палець усередині однієї з них. Ділянки дисплея є областями екрана, які малюються в окремому редакторі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các vùng trên bàn di cảm ứng của bộ điều khiển. Đầu vào Vùng bàn di cảm ứng kích hoạt khi một ngón tay nằm trong một vùng. Các khu vực của màn hình là Vùng màn hình, được vẽ trong trình chỉnh sửa riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制器触摸板上的分区。“触摸板分区”输入在手指位于其中一个分区内时触发。显示器的区域是“屏幕区域”，在其自己的编辑器中绘制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制器觸控板上的分區。「觸控板分區」輸入在手指位於其中一個時觸發。顯示器的區域是「螢幕區域」，在各自的編輯器中繪製。"
          }
        }
      }
    },
