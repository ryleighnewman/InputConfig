        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עורך הקישורים נפתח מהר יותר וגולל בצורה חלקה"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
