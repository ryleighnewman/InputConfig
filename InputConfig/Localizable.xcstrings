    "%lld rows could not be read (made by a newer version of InputConfig, or edited by hand) and are left out of the import." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت قراءة %lld من الصفوف (أنشأتها نسخة أحدث من InputConfig، أو عُدّلت يدويًا) وستُستبعد من الاستيراد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
