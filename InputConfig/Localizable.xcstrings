    "Cycle the light bar through every color while this preset runs" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدوير شريط الإضاءة عبر كل الألوان أثناء تشغيل هذا الإعداد المسبق"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
