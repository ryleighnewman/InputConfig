        }
      }
    },
    "Read from the controller over USB-C. Use makes a profile active, the same as the Profile button; Edit opens it beside the drawing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قُرئت من الوحدة عبر USB-C. يجعل «استخدام» ملف تعريف نشطًا كما يفعل زر ملف التعريف؛ ويفتحه «تحرير» بجوار الرسم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načteno z ovladače přes USB-C. Použít aktivuje profil stejně jako tlačítko Profil; Upravit ho otevře vedle nákresu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læst fra controlleren via USB-C. Brug gør en profil aktiv, som Profil-knappen gør; Rediger åbner den ved siden af tegningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Controller über USB-C gelesen. Verwenden macht ein Profil aktiv, genau wie die Profiltaste; Bearbeiten öffnet es neben der Zeichnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leídos del mando por USB-C. Usar activa un perfil, igual que el botón Perfil; Editar lo abre junto al dibujo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luettu ohjaimesta USB-C:llä. Käytä tekee profiilista aktiivisen, kuten Profiili-painike; Muokkaa avaa sen piirroksen viereen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lus depuis la manette en USB-C. Utiliser rend un profil actif, comme le bouton Profil ; Modifier l'ouvre à côté du dessin."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נקרא מהבקר דרך USB-C. שימוש הופך פרופיל לפעיל, כמו כפתור הפרופיל; עריכה פותחת אותו לצד הציור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beolvasva a kontrollerből USB-C-n. A Használat aktiválja a profilt, mint a Profil gomb; a Szerkesztés a rajz mellett nyitja meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibaca dari kontroler lewat USB-C. Gunakan mengaktifkan profil, seperti tombol Profil; Edit membukanya di samping gambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letti dal controller via USB-C. Usa rende attivo un profilo, come il pulsante Profilo; Modifica lo apre accanto al disegno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C経由でコントローラーから読み取りました。「使用」はプロファイルボタンと同じく有効にし、「編集」は図の横で開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C로 컨트롤러에서 읽었습니다. 사용은 프로파일 버튼처럼 프로파일을 활성화하고, 편집은 그림 옆에서 엽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lest fra kontrolleren via USB-C. Bruk gjør en profil aktiv, slik Profil-knappen gjør; Rediger åpner den ved siden av tegningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelezen van de controller via USB-C. Gebruik maakt een profiel actief, net als de Profiel-knop; Bewerk opent het naast de tekening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytane z kontrolera przez USB-C. Użyj uaktywnia profil, tak jak przycisk Profil; Edytuj otwiera go obok rysunku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidos do controle por USB-C. Usar torna um perfil ativo, igual ao botão Perfil; Editar o abre ao lado do desenho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитано с контроллера по USB-C. Использовать делает профиль активным, как кнопка Профиль; Изменить открывает его рядом с рисунком."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načítané z ovládača cez USB-C. Použiť aktivuje profil rovnako ako tlačidlo Profil; Upraviť ho otvorí vedľa nákresu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lästa från kontrollen via USB-C. Använd gör en profil aktiv, som Profil-knappen gör; Redigera öppnar den bredvid ritningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านจากคอนโทรลเลอร์ผ่าน USB-C ใช้ จะทำให้โปรไฟล์ใช้งานเหมือนปุ่มโปรไฟล์; แก้ไข จะเปิดโปรไฟล์ข้างภาพวาด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetleyiciden USB-C ile okundu. Kullan, Profil düğmesinin yaptığı gibi bir profili etkinleştirir; Düzenle onu çizimin yanında açar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитано з контролера по USB-C. Використати робить профіль активним, як кнопка Профіль; Редагувати відкриває його поряд із малюнком."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc từ tay cầm qua USB-C. Dùng kích hoạt một hồ sơ như nút Hồ sơ; Sửa mở nó bên cạnh hình vẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已通过 USB-C 从控制器读取。“使用”会像配置文件按键一样激活一个配置文件；“编辑”会在图示旁打开它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已透過 USB-C 從控制器讀取。「使用」會像設定檔按鈕一樣啟用一個設定檔；「編輯」會在圖示旁開啟它。"
          }
        }
      }
    },
    "Read over USB-C. Hold FN and press the face button to switch on the pad; the pad applies the profile itself, so what it sends is already remapped. Edit them in Sony's PlayStation Accessories app or on a PS5." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت القراءة عبر USB-C. اضغط باستمرار على FN ثم اضغط زر الإجراء للتبديل على ذراع التحكم؛ يطبّق ذراع التحكم ملف التعريف بنفسه، لذا فإن ما يرسله معاد تعيينه بالفعل. عدّلها في تطبيق PlayStation Accessories من Sony أو على PS5."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načteno přes USB-C. Podržte FN a stiskněte akční tlačítko pro přepnutí na ovladači; ovladač profil uplatní sám, takže to, co posílá, je už přemapované. Upravte je v aplikaci PlayStation Accessories od Sony nebo na PS5."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læst via USB-C. Hold FN, og tryk på handlingsknappen for at skifte på controlleren; controlleren anvender selv profilen, så det, den sender, er allerede omlagt. Rediger dem i Sonys app PlayStation Accessories eller på en PS5."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über USB-C gelesen. Halte FN und drücke die Aktionstaste, um am Pad zu wechseln; das Pad wendet das Profil selbst an, daher ist, was es sendet, bereits umbelegt. Bearbeite sie in Sonys App PlayStation Accessories oder an einer PS5."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leído por USB-C. Mantén FN y pulsa el botón de acción para cambiar en el mando; el mando aplica el perfil él mismo, así que lo que envía ya está reasignado. Edítalos en la app PlayStation Accessories de Sony o en una PS5."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luettu USB-C:llä. Pidä FN pohjassa ja paina toimintopainiketta vaihtaaksesi ohjaimessa; ohjain soveltaa profiilia itse, joten sen lähettämä on jo uudelleenmääritetty. Muokkaa niitä Sonyn PlayStation Accessories -apissa tai PS5:llä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lu en USB-C. Maintenez FN et appuyez sur le bouton d'action pour changer sur la manette ; la manette applique le profil elle-même, donc ce qu'elle envoie est déjà remappé. Modifiez-les dans l'app PlayStation Accessories de Sony ou sur une PS5."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נקרא דרך USB-C. החזיקו FN ולחצו על כפתור הפעולה כדי להחליף בשלט; השלט מחיל את הפרופיל בעצמו, כך שמה שהוא שולח כבר ממופה מחדש. ערכו אותם באפליקציה PlayStation Accessories של Sony או ב־PS5."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C-n beolvasva. Tartsd lenyomva az FN-t, és nyomd meg az akciógombot a váltáshoz a kontrolleren; a kontroller maga alkalmazza a profilt, így amit küld, már át van képezve. Szerkeszd őket a Sony PlayStation Accessories appjában vagy egy PS5-ön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibaca lewat USB-C. Tahan FN lalu tekan tombol aksi untuk beralih di kontroler; kontroler menerapkan profil sendiri, jadi yang dikirimnya sudah dipetakan ulang. Edit di aplikasi PlayStation Accessories dari Sony atau di PS5."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letti via USB-C. Tieni premuto FN e premi il pulsante frontale per cambiare sul controller; il controller applica il profilo da solo, quindi ciò che invia è già rimappato. Modificali nell'app PlayStation Accessories di Sony o su una PS5."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C で読み込みました。FN を押しながらフェイスボタンを押すとパッドで切り替わります。パッドが自分でプロファイルを適用するので、送られる内容はすでに割り当て済みです。編集は Sony の PlayStation Accessories アプリか PS5 で行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C로 읽었습니다. 패드에서 바꾸려면 FN을 누른 채 페이스 버튼을 누르세요. 패드가 프로파일을 직접 적용하므로 보내는 내용은 이미 다시 매핑되어 있습니다. Sony의 PlayStation Accessories 앱이나 PS5에서 편집하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lest via USB-C. Hold FN og trykk på handlingsknappen for å bytte på kontrolleren; kontrolleren bruker profilen selv, så det den sender er allerede omtilordnet. Rediger dem i Sonys app PlayStation Accessories eller på en PS5."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelezen via USB-C. Houd FN ingedrukt en druk op de actieknop om op de controller te wisselen; de controller past het profiel zelf toe, dus wat hij stuurt is al omgezet. Wijzig ze in Sony's app PlayStation Accessories of op een PS5."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytane przez USB-C. Przytrzymaj FN i naciśnij przycisk akcji, aby przełączyć na kontrolerze; kontroler sam stosuje profil, więc to, co wysyła, jest już przemapowane. Edytuj je w aplikacji PlayStation Accessories firmy Sony albo na PS5."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidos por USB-C. Segure FN e aperte o botão de ação para trocar no controle; o controle aplica o perfil sozinho, então o que ele envia já vem remapeado. Edite-os no app PlayStation Accessories da Sony ou num PS5."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитано по USB-C. Удерживайте FN и нажмите кнопку действия, чтобы переключить на контроллере; контроллер сам применяет профиль, поэтому то, что он отправляет, уже переназначено. Изменяйте их в приложении Sony PlayStation Accessories или на PS5."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Načítané cez USB-C. Podržte FN a stlačte akčné tlačidlo na prepnutie na ovládači; ovládač profil uplatní sám, takže to, čo posiela, je už premapované. Upravte ich v aplikácii PlayStation Accessories od Sony alebo na PS5."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lästa via USB-C. Håll ned FN och tryck på handlingsknappen för att byta på kontrollen; kontrollen tillämpar profilen själv, så det den skickar är redan ommappat. Redigera dem i Sonys app PlayStation Accessories eller på en PS5."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านผ่าน USB-C กด FN ค้างไว้แล้วกดปุ่มหน้าเพื่อสลับบนจอย จอยจะใช้โปรไฟล์เอง สิ่งที่ส่งออกมาจึงถูกแมปใหม่แล้ว แก้ไขได้ในแอป PlayStation Accessories ของ Sony หรือบน PS5"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C üzerinden okundu. Kumandada değiştirmek için FN'yi basılı tutup eylem düğmesine basın; kumanda profili kendisi uygular, bu yüzden gönderdiği zaten yeniden eşlenmiştir. Bunları Sony'nin PlayStation Accessories uygulamasında ya da bir PS5'te düzenleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитано через USB-C. Утримуйте FN і натисніть кнопку дії, щоб перемкнути на контролері; контролер сам застосовує профіль, тож те, що він надсилає, уже перепризначено. Змінюйте їх у застосунку Sony PlayStation Accessories або на PS5."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc qua USB-C. Giữ FN và nhấn nút hành động để chuyển trên tay cầm; tay cầm tự áp dụng hồ sơ, nên những gì nó gửi đã được gán lại. Sửa chúng trong ứng dụng PlayStation Accessories của Sony hoặc trên PS5."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 USB-C 读取。按住 FN 再按动作按键即可在手柄上切换；手柄会自行应用配置文件，所以它发送的内容已经重新映射。请在 Sony 的 PlayStation Accessories App 或 PS5 上编辑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過 USB-C 讀取。按住 FN 再按動作按鈕即可在手把上切換；手把會自行套用設定檔，所以它送出的內容已經重新對應。請在 Sony 的 PlayStation Accessories App 或 PS5 上編輯。"
          }
        }
      }
    },
    "Read the finger the other way round: a swipe left counts as right and up as down for this row." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ الإصبع بالعكس: يُحتسب التمرير لليسار لليمين ولأعلى لأسفل في هذا الصف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Číst prst obráceně: pro tento řádek se přejetí doleva počítá jako doprava a nahoru jako dolů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs fingeren omvendt: et stryg til venstre tæller som højre og op som ned for denne række."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies den Finger andersherum: Ein Wischen nach links zählt für diese Zeile als rechts und nach oben als unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el dedo al revés: un deslizamiento a la izquierda cuenta como a la derecha, y hacia arriba como hacia abajo, para esta fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue sormi toisinpäin: pyyhkäisy vasemmalle lasketaan oikealle ja ylös alas tälle riville."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire le doigt dans l’autre sens : un balayage vers la gauche compte comme vers la droite et vers le haut comme vers le bas pour cette ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרא את האצבע בכיוון ההפוך: החלקה שמאלה נספרת כימינה ולמעלה כלמטה עבור השורה הזו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ujj olvasása fordítva: a balra csúsztatás jobbnak, a felfelé lefelének számít ennél a sornál."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca jari dengan cara sebaliknya: gesekan ke kiri dihitung sebagai kanan dan ke atas sebagai ke bawah untuk baris ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi il dito al contrario: uno scorrimento a sinistra conta come a destra e in alto come in basso per questa riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指を逆向きに読み取ります: この行では、左へのスワイプが右、上が下として数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락을 반대로 읽습니다: 이 행에서는 왼쪽으로 쓸면 오른쪽, 위로 쓸면 아래로 간주됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fingeren motsatt vei: et sveip til venstre regnes som høyre og opp som ned for denne raden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees de vinger andersom: een veeg naar links telt als rechts en omhoog als omlaag voor deze rij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuj palec w drugą stronę: przesunięcie w lewo liczy się jako w prawo, a w górę jako w dół dla tego wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ler o dedo ao contrário: um deslize para a esquerda conta como para a direita e para cima como para baixo nesta linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читать палец наоборот: для этой строки смахивание влево считается вправо, а вверх считается вниз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čítať prst opačne: potiahnutie doľava sa počíta ako doprava a nahor ako nadol pre tento riadok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs fingret åt andra hållet: ett svep åt vänster räknas som höger och uppåt som nedåt för den här raden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านนิ้วในทิศตรงข้าม: การปัดซ้ายนับเป็นขวาและขึ้นนับเป็นลงสำหรับแถวนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmağı ters okuyun: bu satır için sola kaydırma sağ, yukarı kaydırma aşağı sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зчитувати палець навпаки: свайп ліворуч вважається праворуч, а вгору як вниз для цього рядка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc ngón tay theo chiều ngược lại: vuốt sang trái được tính là phải và lên là xuống cho hàng này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反向读取手指：对此行而言，向左滑动算作向右，向上算作向下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反向讀取手指：對此列而言，向左滑動算作向右，向上算作向下。"
          }
        }
      }
    },
    "Read the stick backwards for this row: pushed left counts as right and up as down, and variable speed follows the reversed value. It is per row, so the row for the other direction is unaffected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ العصا بالعكس لهذا الصف: يُحتسب الدفع لليسار لليمين ولأعلى لأسفل، وتتبع السرعة المتغيرة القيمة المعكوسة. يخص هذا الصف وحده، فلا يتأثر صف الاتجاه الآخر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Číst páčku pozpátku pro tento řádek: vychýlení doleva se počítá jako doprava a nahoru jako dolů a proměnná rychlost sleduje obrácenou hodnotu. Platí pro řádek, takže řádek pro opačný směr se nemění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs sticken baglæns for denne række: skubbet til venstre tæller som højre og op som ned, og variabel hastighed følger den omvendte værdi. Det gælder pr. række, så rækken til den modsatte retning er upåvirket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies den Stick für diese Zeile rückwärts: Nach links gedrückt zählt als rechts und nach oben als unten, und die variable Geschwindigkeit folgt dem umgekehrten Wert. Es gilt pro Zeile, die Zeile für die andere Richtung bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el stick al revés para esta fila: empujado a la izquierda cuenta como a la derecha y hacia arriba como hacia abajo, y la velocidad variable sigue el valor invertido. Es por fila, así que la fila de la otra dirección no se ve afectada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue sauva takaperin tälle riville: vasemmalle työnnetty lasketaan oikealle ja ylös alas, ja muuttuva nopeus seuraa käännettyä arvoa. Se on rivikohtainen, joten toisen suunnan rivi ei muutu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lire le stick à l’envers pour cette ligne : poussé vers la gauche compte comme vers la droite et vers le haut comme vers le bas, et la vitesse variable suit la valeur inversée. C’est par ligne, donc la ligne de l’autre direction n’est pas affectée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קרא את הג׳ויסטיק הפוך עבור השורה הזו: דחיפה שמאלה נספרת כימינה ולמעלה כלמטה, ומהירות משתנה עוקבת אחרי הערך ההפוך. זה לכל שורה, ולכן השורה של הכיוון השני אינה מושפעת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A joystick olvasása fordítva ennél a sornál: a balra tolás jobbnak, a felfelé lefelének számít, és a változó sebesség a megfordított értéket követi. Soronként érvényes, így a másik irány sorát nem érinti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca stik secara terbalik untuk baris ini: didorong ke kiri dihitung sebagai kanan dan ke atas sebagai ke bawah, dan kecepatan variabel mengikuti nilai terbalik. Ini per baris, jadi baris untuk arah lain tidak terpengaruh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi lo stick al contrario per questa riga: spinto a sinistra conta come a destra e in alto come in basso, e la velocità variabile segue il valore invertito. È per riga, quindi la riga per l’altra direzione non è interessata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この行ではスティックを逆向きに読み取ります: 左に倒すと右、上が下として数えられ、可変速度も反転した値に従います。行ごとの設定なので、反対方向の行には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 행에서 스틱을 반대로 읽습니다: 왼쪽으로 밀면 오른쪽, 위로 밀면 아래로 간주되며 가변 속도는 반전된 값을 따릅니다. 행마다 설정되므로 반대 방향의 행은 영향을 받지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les joysticken baklengs for denne raden: skjøvet til venstre regnes som høyre og opp som ned, og variabel hastighet følger den reverserte verdien. Det gjelder per rad, så raden for den andre retningen påvirkes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees de stick achterstevoren voor deze rij: naar links geduwd telt als rechts en omhoog als omlaag, en variabele snelheid volgt de omgekeerde waarde. Het geldt per rij, dus de rij voor de andere richting blijft ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczytuj drążek wstecz dla tego wiersza: wychylenie w lewo liczy się jako w prawo, a w górę jako w dół, a zmienna prędkość podąża za odwróconą wartością. Dotyczy wiersza, więc wiersz dla przeciwnego kierunku pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ler o stick ao contrário nesta linha: empurrado para a esquerda conta como para a direita e para cima como para baixo, e a velocidade variável segue o valor invertido. É por linha, então a linha da outra direção não é afetada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Читать стик наоборот для этой строки: отклонение влево считается вправо, а вверх считается вниз, и переменная скорость следует обращённому значению. Действует для строки, поэтому строка для другого направления не затрагивается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čítať páčku opačne pre tento riadok: zatlačenie doľava sa počíta ako doprava a nahor ako nadol a premenlivá rýchlosť sleduje obrátenú hodnotu. Platí pre jeden riadok, takže riadok pre opačný smer ostáva nedotknutý."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs spaken baklänges för den här raden: tryckt åt vänster räknas som höger och uppåt som nedåt, och variabel hastighet följer det omvända värdet. Det gäller per rad, så raden för den andra riktningen påverkas inte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านจอยสติ๊กย้อนกลับสำหรับแถวนี้: ดันซ้ายนับเป็นขวาและขึ้นนับเป็นลง และความเร็วแปรผันตามค่าที่กลับ เป็นต่อแถว ดังนั้นแถวของทิศทางตรงข้ามไม่ได้รับผลกระทบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu satır için çubuğu ters okuyun: sola itmek sağ, yukarı itmek aşağı sayılır ve değişken hız ters değeri izler. Satır başınadır; diğer yöndeki satır etkilenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зчитувати джойстик навпаки для цього рядка: відхилення ліворуч вважається праворуч, а вгору як вниз, і змінна швидкість відповідає інвертованому значенню. Це для кожного рядка, тож рядок для іншого напрямку не зачіпається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc cần theo chiều ngược cho hàng này: đẩy trái được tính là phải và lên là xuống, và tốc độ biến thiên theo giá trị đã đảo. Áp dụng theo từng hàng, nên hàng cho hướng kia không bị ảnh hưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对此行反向读取摇杆：向左推算作向右，向上算作向下，可变速度也遵循反转后的值。这是按行设置的，因此另一个方向的行不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反向讀取此列的搖桿：向左推算作向右，向上算作向下，可變速度也會跟隨反向的值。這是依列設定的，因此另一個方向的列不受影響。"
          }
        }
      }
    },
