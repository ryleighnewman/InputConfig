    "Ring from %lld to %lld percent of the way out, from %lld to %lld degrees, where 0 is right and 90 is up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حلقة من %1$lld إلى %2$lld بالمئة من المسافة إلى الخارج، ومن %3$lld إلى %4$lld درجة، حيث 0 هو اليمين و90 هو الأعلى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prstenec od %1$lld do %2$lld procent vzdálenosti od středu, od %3$lld do %4$lld stupňů, kde 0 je vpravo a 90 je nahoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ring fra %1$lld til %2$lld procent af vejen ud, fra %3$lld til %4$lld grader, hvor 0 er til højre og 90 er op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ring von %1$lld bis %2$lld Prozent des Wegs nach außen, von %3$lld bis %4$lld Grad, wobei 0 rechts und 90 oben ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ring from %1$lld to %2$lld percent of the way out, from %3$lld to %4$lld degrees, where 0 is right and 90 is up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anillo del %1$lld al %2$lld por ciento hacia fuera, de %3$lld a %4$lld grados, donde 0 es la derecha y 90 es arriba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rengas %1$lld - %2$lld prosentin kohdalla matkalla ulospäin, %3$lld - %4$lld astetta, missä 0 on oikealla ja 90 ylhäällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anneau de %1$lld à %2$lld pour cent vers l’extérieur, de %3$lld à %4$lld degrés, où 0 est la droite et 90 le haut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טבעת מ-%1$lld עד %2$lld אחוזים מהדרך החוצה, מ-%3$lld עד %4$lld מעלות, כאשר 0 הוא ימין ו-90 הוא למעלה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyűrű a kifelé vezető út %1$lld és %2$lld százaléka között, %3$lld és %4$lld fok között, ahol a 0 jobbra, a 90 felfelé van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cincin dari %1$lld sampai %2$lld persen ke arah luar, dari %3$lld sampai %4$lld derajat, dengan 0 adalah kanan dan 90 adalah atas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anello dal %1$lld al %2$lld per cento verso l’esterno, da %3$lld a %4$lld gradi, dove 0 è destra e 90 è su."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外側へ%1$lld〜%2$lldパーセントの位置、%3$lld〜%4$lld度のリング（0度は右、90度は上）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바깥쪽으로 %1$lld~%2$lld퍼센트 지점, %3$lld~%4$lld도의 링(0도는 오른쪽, 90도는 위쪽)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ring fra %1$lld til %2$lld prosent av veien ut, fra %3$lld til %4$lld grader, der 0 er mot høyre og 90 er opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ring van %1$lld tot %2$lld procent van de weg naar buiten, van %3$lld tot %4$lld graden, waarbij 0 rechts is en 90 omhoog."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierścień od %1$lld do %2$lld procent odległości od środka, od %3$lld do %4$lld stopni, gdzie 0 to prawo, a 90 to góra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anel de %1$lld a %2$lld por cento para fora, de %3$lld a %4$lld graus, onde 0 é a direita e 90 é para cima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кольцо от %1$lld до %2$lld процентов пути наружу, от %3$lld до %4$lld градусов, где 0 это вправо, а 90 это вверх."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prstenec od %1$lld do %2$lld percent vzdialenosti od stredu, od %3$lld do %4$lld stupňov, kde 0 je vpravo a 90 je nahor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ring från %1$lld till %2$lld procent av vägen ut, från %3$lld till %4$lld grader, där 0 är åt höger och 90 är uppåt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วงแหวนตั้งแต่ %1$lld ถึง %2$lld เปอร์เซ็นต์ของระยะออกไป ตั้งแต่ %3$lld ถึง %4$lld องศา โดย 0 คือขวาและ 90 คือขึ้นบน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa doğru yüzde %1$lld ile %2$lld arasında, %3$lld ile %4$lld derece arasında halka; 0 sağ, 90 yukarıdır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кільце від %1$lld до %2$lld відсотків шляху назовні, від %3$lld до %4$lld градусів, де 0 це праворуч, а 90 це вгору."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vòng từ %1$lld đến %2$lld phần trăm quãng đường ra ngoài, từ %3$lld đến %4$lld độ, trong đó 0 là bên phải và 90 là hướng lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圆环：从向外百分之 %1$lld 到百分之 %2$lld 处，方向从 %3$lld 度到 %4$lld 度，其中 0 度为右，90 度为上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圓環：從向外百分之 %1$lld 到百分之 %2$lld 處，方向從 %3$lld 度到 %4$lld 度，其中 0 度為右，90 度為上。"
          }
        }
      }
    },
