    "Tips are completely optional. InputConfig is free with no locked features. Tips simply support continued development and future updates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإكراميات اختيارية تمامًا. InputConfig مجاني بلا ميزات مقفلة. تدعم الإكراميات التطوير المستمر والتحديثات المستقبلية فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spropitné je zcela dobrovolné. InputConfig je zdarma a bez zamčených funkcí. Spropitné jen podporuje další vývoj a budoucí aktualizace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drikkepenge er helt valgfrie. InputConfig er gratis uden låste funktioner. Drikkepenge støtter blot den fortsatte udvikling og fremtidige opdateringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinkgelder sind völlig freiwillig. InputConfig ist kostenlos und ohne gesperrte Funktionen. Trinkgelder unterstützen einfach die weitere Entwicklung und künftige Updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las propinas son totalmente opcionales. InputConfig es gratis y no tiene funciones bloqueadas. Las propinas solo apoyan el desarrollo continuo y las futuras actualizaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipit ovat täysin vapaaehtoisia. InputConfig on ilmainen, eikä siinä ole lukittuja ominaisuuksia. Tipit tukevat vain jatkokehitystä ja tulevia päivityksiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pourboires sont entièrement facultatifs. InputConfig est gratuit, sans fonctionnalité verrouillée. Les pourboires soutiennent simplement la suite du développement et les futures mises à jour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טיפים הם אופציונליים לחלוטין. InputConfig חינמי ובלי תכונות נעולות. טיפים פשוט תומכים בהמשך הפיתוח ובעדכונים עתידיים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A borravaló teljesen önkéntes. Az InputConfig ingyenes, zárolt funkciók nélkül. A borravaló egyszerűen támogatja a folyamatos fejlesztést és a jövőbeli frissítéseket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip sepenuhnya opsional. InputConfig gratis tanpa fitur terkunci. Tip hanya mendukung pengembangan berkelanjutan dan pembaruan mendatang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mance sono del tutto facoltative. InputConfig è gratuito, senza funzioni bloccate. Le mance sostengono semplicemente lo sviluppo continuo e i futuri aggiornamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チップはまったく任意です。InputConfigは無料で、機能の制限もありません。チップは、継続的な開発と今後のアップデートを支援するものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁은 완전히 선택 사항입니다. InputConfig는 잠긴 기능 없이 무료입니다. 팁은 계속된 개발과 향후 업데이트를 지원할 뿐입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips er helt valgfrie. InputConfig er gratis uten låste funksjoner. Tips støtter bare videre utvikling og fremtidige oppdateringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fooien zijn helemaal optioneel. InputConfig is gratis zonder vergrendelde functies. Fooien ondersteunen simpelweg de verdere ontwikkeling en toekomstige updates."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napiwki są całkowicie opcjonalne. InputConfig jest bezpłatny i nie ma zablokowanych funkcji. Napiwki po prostu wspierają dalszy rozwój i przyszłe aktualizacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gorjetas são totalmente opcionais. O InputConfig é gratuito, sem recursos bloqueados. As gorjetas apenas apoiam o desenvolvimento contínuo e as atualizações futuras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаевые совершенно необязательны. InputConfig бесплатен, без закрытых функций. Чаевые просто поддерживают дальнейшую разработку и будущие обновления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sponzorské dary sú úplne dobrovoľné. InputConfig je zadarmo bez zamknutých funkcií. Dary jednoducho podporujú ďalší vývoj a budúce aktualizácie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drickspengar är helt frivilliga. InputConfig är gratis utan låsta funktioner. Drickspengar stöder bara fortsatt utveckling och framtida uppdateringar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทิปเป็นทางเลือกทั้งหมด InputConfig ฟรีและไม่มีฟีเจอร์ที่ล็อก ทิปเพียงสนับสนุนการพัฒนาต่อเนื่องและการอัปเดตในอนาคต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahşişler tamamen isteğe bağlıdır. InputConfig ücretsizdir ve kilitli özellik yoktur. Bahşişler yalnızca sürekli geliştirmeyi ve gelecekteki güncellemeleri destekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чайові цілком необов’язкові. InputConfig безкоштовний, без заблокованих функцій. Чайові просто підтримують подальшу розробку та майбутні оновлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiền boa hoàn toàn tùy chọn. InputConfig miễn phí và không khóa tính năng nào. Tiền boa chỉ hỗ trợ việc tiếp tục phát triển và các bản cập nhật tương lai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打赏完全是自愿的。InputConfig 免费，没有任何锁定的功能。打赏只是支持持续开发和未来更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贊助完全是自願的。InputConfig 免費且沒有鎖定任何功能。贊助只是支持持續開發和未來的更新。"
          }
        }
      }
    },
