    "The controller switches to this color while the preset runs and goes back when it stops." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحول ذراع التحكم إلى هذا اللون أثناء تشغيل الإعداد المسبق ويعود عند توقفه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovladač se po dobu běhu předvolby přepne na tuto barvu a po zastavení se vrátí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlleren skifter til denne farve, mens forudindstillingen kører, og vender tilbage, når den stopper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Controller wechselt zu dieser Farbe, solange das Preset läuft, und kehrt zurück, wenn es stoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mando cambia a este color mientras el preajuste está en marcha y vuelve al anterior cuando se detiene."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjain vaihtaa tähän väriin esiasetuksen ollessa käynnissä ja palaa pysäytettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La manette passe à cette couleur pendant l’exécution du préréglage et revient à la normale quand il s’arrête."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השלט עובר לצבע הזה בזמן שהפריסט פועל וחוזר כשהוא נעצר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vezérlő erre a színre vált az előbeállítás futása alatt, és leállításkor visszaáll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengontrol beralih ke warna ini selama preset berjalan dan kembali saat berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il controller passa a questo colore mentre il preset è in esecuzione e torna com’era quando si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットの実行中、コントローラはこの色に切り替わり、停止すると元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋이 실행되는 동안 컨트롤러가 이 색상으로 바뀌고, 중지하면 원래대로 돌아갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrolleren bytter til denne fargen mens forhåndsinnstillingen kjører og går tilbake når den stopper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De controller schakelt over op deze kleur zolang de preset draait en gaat terug wanneer hij stopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontroler zmienia się na ten kolor, gdy preset działa, i wraca do poprzedniego, gdy się zatrzyma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
