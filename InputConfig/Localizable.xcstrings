    "Saves battery; rapid-fire and gyro aim may feel a touch slower." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوفر البطارية؛ وقد يبدو الإطلاق السريع والتصويب بالجيروسكوب أبطأ قليلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šetří baterii; rychlá palba a zamíření gyroskopem mohou působit o něco pomaleji."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparer batteri. Hurtig affyring og gyro-sigte kan føles en smule langsommere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spart Batterie; Schnellfeuer und Gyro-Zielen können sich etwas langsamer anfühlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahorra batería; el disparo rápido y el apuntado por giroscopio pueden notarse algo más lentos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säästää akkua; pikatoisto ja gyrokohdistus voivat tuntua hieman hitaammilta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Économise la batterie ; le tir rapide et la visée au gyroscope peuvent sembler un peu plus lents."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חוסך סוללה; ירי מהיר וכיוון ג׳יירו עלולים להרגיש איטיים במעט."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkumulátort takarít meg; a gyorstüzelés és a giroszkópos célzás kissé lassabbnak érződhet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghemat baterai; tembak cepat dan bidikan giroskop mungkin terasa sedikit lebih lambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risparmia batteria; il fuoco rapido e la mira con giroscopio possono risultare un po’ più lenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリーを節約します。連打とジャイロエイムが少し遅く感じられることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리를 아끼지만 연사와 자이로 조준이 약간 느리게 느껴질 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparer batteri. Hurtigutløsning og gyrosikting kan føles litt tregere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bespaart batterij; snelvuur en richten met gyro voelen mogelijk iets trager."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oszczędza baterię. Szybkie powtarzanie i celowanie żyroskopem mogą działać nieco wolniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Economiza bateria; o disparo rápido e a mira por giroscópio podem parecer um pouco mais lentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экономит заряд; быстрое повторение и прицеливание гироскопом могут ощущаться чуть медленнее."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šetrí batériu; rýchla paľba a mierenie gyroskopom môžu byť o chlp pomalšie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparar batteri. Snabbserie och gyrosiktning kan kännas något långsammare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประหยัดแบตเตอรี่ การยิงรัวและการเล็งด้วยไจโรอาจรู้สึกช้าลงเล็กน้อย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilden tasarruf eder; seri atış ve jiroskop nişanı biraz daha yavaş hissedilebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Економить батарею; швидке повторення й прицілювання гіроскопом можуть здаватися трохи повільнішими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiết kiệm pin; bấm liên tục và ngắm bằng con quay có thể chậm hơn một chút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "节省电量；连发和陀螺仪瞄准可能稍慢一点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "節省電池；快速連發和陀螺儀瞄準可能會稍微變慢一點。"
          }
        }
      }
    },
