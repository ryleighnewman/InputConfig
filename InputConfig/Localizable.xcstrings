        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaaliaikainen ohjaussauvan visualisointi vedettävällä jäljellä ja liukusäätimellä täydellisen kuolleen alueen löytämiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
