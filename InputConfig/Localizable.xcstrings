    "More reliable controller data reading behind the scenes, with an automatic fallback when a Bluetooth session goes quiet" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة أكثر موثوقية لبيانات ذراع التحكم في الخلفية، مع رجوع تلقائي عندما تهدأ جلسة Bluetooth"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spolehlivější čtení dat ovladače na pozadí, s automatickým záložním řešením, když relace Bluetooth ztichne"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere pålidelig aflæsning af controllerdata i baggrunden, med en automatisk reserve, når en Bluetooth-session bliver stille"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuverlässigeres Lesen der Controller-Daten im Hintergrund, mit automatischem Fallback, wenn eine Bluetooth-Sitzung verstummt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lectura de datos del mando más fiable en segundo plano, con un recurso alternativo automático cuando una sesión Bluetooth se queda en silencio"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luotettavampi ohjaindatan luku taustalla, automaattisella varamenetelmällä, kun Bluetooth-istunto hiljenee"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture des données de la manette plus fiable en arrière-plan, avec un repli automatique quand une session Bluetooth devient silencieuse"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קריאת נתוני שלט אמינה יותר מאחורי הקלעים, עם חזרה אוטומטית כשסשן Bluetooth נעשה שקט"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megbízhatóbb vezérlőadat-olvasás a háttérben, automatikus tartalékmegoldással, ha egy Bluetooth-munkamenet elcsendesedik"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembacaan data pengontrol yang lebih andal di balik layar, dengan cadangan otomatis saat sesi Bluetooth menjadi sunyi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lettura più affidabile dei dati del controller dietro le quinte, con un ripiego automatico quando una sessione Bluetooth diventa silenziosa"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "裏側でのコントローラデータの読み取りがより確実になり、Bluetoothセッションが途切れたときは自動でフォールバックします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내부적으로 컨트롤러 데이터를 더 안정적으로 읽고, Bluetooth 세션이 조용해지면 자동으로 대체 경로로 전환함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer pålitelig lesing av kontrollerdata i bakgrunnen, med automatisk reserve når en Bluetooth-økt blir stille"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrouwbaarder lezen van controllergegevens op de achtergrond, met een automatische terugval wanneer een Bluetooth-sessie stil valt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bardziej niezawodny odczyt danych kontrolera w tle, z automatycznym przełączeniem awaryjnym, gdy sesja Bluetooth zamilknie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leitura mais confiável dos dados do controle nos bastidores, com um recurso automático quando uma sessão Bluetooth fica silenciosa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более надёжное чтение данных контроллера в фоновом режиме с автоматическим переключением, когда сеанс Bluetooth замолкает"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoľahlivejšie čítanie údajov ovládača na pozadí, s automatickým záložným riešením, keď sa relácia Bluetooth odmlčí"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer tillförlitlig avläsning av spelkontrolldata i bakgrunden, med automatisk reservlösning när en Bluetooth-session blir tyst"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านข้อมูลคอนโทรลเลอร์เบื้องหลังได้เชื่อถือได้มากขึ้น พร้อมระบบสำรองอัตโนมัติเมื่อเซสชัน Bluetooth เงียบไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda daha güvenilir kumanda verisi okuma, bir Bluetooth oturumu sessizleştiğinde otomatik yedek mekanizmayla"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надійніше зчитування даних контролера за лаштунками з автоматичним переходом, коли сеанс Bluetooth затихає"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc dữ liệu bộ điều khiển đáng tin cậy hơn ở hậu trường, với phương án dự phòng tự động khi phiên Bluetooth im lặng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台更可靠地读取控制器数据，并在蓝牙会话沉默时自动回退"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在背後更可靠地讀取控制器資料，並在藍牙連線沉寂時自動後援"
          }
        }
      }
    },
    "More: sort, undo sort, convert controller type" : {
      "localizations" : {
        "ar" : {
