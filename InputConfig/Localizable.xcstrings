    "Map any button, trigger, or stick to keyboard keys, mouse buttons, mouse motion, or scroll wheel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط أي زر أو زناد أو عصا بمفاتيح لوحة المفاتيح أو أزرار الماوس أو حركة الماوس أو عجلة التمرير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namapujte libovolné tlačítko, spoušť nebo páčku na klávesy, tlačítka myši, pohyb myši nebo kolečko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tildel en vilkårlig knap, trigger eller stick til tastaturtaster, museknapper, musebevægelse eller rullehjul."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belege jede Taste, jeden Trigger und jeden Stick mit Tastaturtasten, Maustasten, Mausbewegung oder Scrollrad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna cualquier botón, gatillo o stick a teclas del teclado, botones del ratón, movimiento del ratón o rueda de desplazamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määritä mikä tahansa painike, liipaisin tai sauva näppäimistön näppäimiin, hiiren painikkeisiin, hiiren liikkeeseen tai vierityspyörään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez n’importe quel bouton, gâchette ou stick à des touches du clavier, des boutons de souris, un mouvement de souris ou la molette de défilement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפה כל לחצן, הדק או ג׳ויסטיק למקשי מקלדת, לחצני עכבר, תנועת עכבר או גלגלת גלילה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendeljen bármely gombot, ravaszt vagy joystickot billentyűkhöz, egérgombokhoz, egérmozgáshoz vagy görgőhöz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petakan tombol, pemicu, atau stik apa pun ke tombol papan ketik, tombol tetikus, gerakan tetikus, atau roda gulir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assegna qualsiasi pulsante, grilletto o stick a tasti della tastiera, pulsanti del mouse, movimento del mouse o rotella di scorrimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あらゆるボタン、トリガ、スティックを、キーボードのキー、マウスボタン、マウスの動き、スクロールホイールに割り当てます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 버튼, 트리거, 스틱이든 키보드 키, 마우스 버튼, 마우스 움직임, 스크롤 휠에 매핑합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilordne en hvilken som helst knapp, avtrekker eller joystick til tastaturtaster, museknapper, musebevegelse eller rullehjul."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijs elke knop, trigger of stick toe aan toetsenbordtoetsen, muisknoppen, muisbeweging of scrolwiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapuj dowolny przycisk, spust lub drążek na klawisze, przyciski myszy, ruch myszy lub kółko przewijania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapeie qualquer botão, gatilho ou stick para teclas do teclado, botões do mouse, movimento do mouse ou roda de rolagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назначайте любую кнопку, триггер или стик на клавиши клавиатуры, кнопки мыши, движение мыши или колесо прокрутки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priraďte ľubovoľné tlačidlo, spúšť alebo páčku ku klávesom, tlačidlám myši, pohybu myši alebo kolieska posúvania."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa vilken knapp, avtryckare eller spak som helst till tangentbordstangenter, musknappar, musrörelse eller rullningshjul."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แมปปุ่ม ทริกเกอร์ หรือจอยสติ๊กใดก็ได้ไปยังแป้นพิมพ์ ปุ่มเมาส์ การเคลื่อนเมาส์ หรือล้อเลื่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir düğmeyi, tetiği veya çubuğu klavye tuşlarına, fare düğmelerine, fare hareketine veya kaydırma tekerleğine eşleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зіставляйте будь-яку кнопку, тригер чи джойстик з клавішами клавіатури, кнопками миші, рухом миші або коліщатком прокручування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ánh xạ bất kỳ nút, cò hoặc cần nào tới phím bàn phím, nút chuột, chuyển động chuột hoặc con lăn cuộn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将任何按钮、扳机或摇杆映射到键盘按键、鼠标按钮、鼠标移动或滚轮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將任何按鈕、扳機或搖桿對應到鍵盤按鍵、滑鼠按鈕、滑鼠移動或滾輪。"
          }
        }
      }
    },
