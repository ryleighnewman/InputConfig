    "Send light commands to any DualSense / DualShock connected on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل أوامر الإضاءة إلى أي ذراع DualSense / DualShock متصل بهذا الـ Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odesílejte příkazy pro osvětlení libovolnému ovladači DualSense / DualShock připojenému k tomuto Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send lyskommandoer til enhver DualSense / DualShock, der er forbundet til denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende Lichtbefehle an jeden DualSense / DualShock, der mit diesem Mac verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
