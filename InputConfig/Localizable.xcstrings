    "Rings and areas on a stick, bands on a trigger, and flicks like back twice, each one a button." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حلقات ومساحات على العصا، ونطاقات على الزناد، ونفضات مثل الخلف مرتين، وكل واحدة زر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prstence a oblasti na páčce, pásma na spoušti a švihnutí, třeba dvakrát zpět, každé jako tlačítko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringe og områder på en stick, bånd på en trigger og ryk som tilbage to gange, hver især en knap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringe und Flächen auf einem Stick, Bereiche auf einem Trigger und Flicks wie zweimal nach hinten, jedes davon eine Taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anillos y áreas en un stick, bandas en un gatillo y flicks como atrás dos veces, cada uno un botón."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renkaat ja alueet sauvalla, alueet liipaisimella ja näpäytykset, kuten kaksi kertaa taaksepäin, kukin painikkeena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des anneaux et des zones sur un stick, des bandes sur une gâchette et des coups de stick comme deux fois vers l’arrière, chacun devenant un bouton."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טבעות ואזורים על ג׳ויסטיק, רצועות על הדק, והצלפות כמו אחורה פעמיים, וכל אחד לחצן."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyűrűk és területek egy joystickon, sávok egy ravaszon, valamint pöccintések, például kétszer hátra, mindegyik egy gomb."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cincin dan area pada stik, pita pada pemicu, dan sentakan seperti ke belakang dua kali, masing-masing menjadi tombol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anelli e aree su uno stick, bande su un grilletto e flick come indietro due volte, ognuno un pulsante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スティック上のリングやエリア、トリガ上の帯、後ろへ2回などのフリック。それぞれがボタンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스틱 위의 링과 영역, 트리거 위의 구간, 뒤로 두 번 같은 플릭이 각각 버튼이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringer og områder på en joystick, bånd på en avtrekker og rykk som bakover to ganger, hver av dem en knapp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringen en vlakken op een stick, gebieden op een trigger en flicks zoals twee keer naar achteren, elk een knop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierścienie i obszary na drążku, pasma na spuście i machnięcia, jak dwa razy do tyłu, każde jako przycisk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anéis e áreas em um stick, faixas em um gatilho e flicks como para trás duas vezes, cada um um botão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кольца и области на стике, полосы на триггере и рывки вроде двух движений назад, каждый как кнопка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prstence a oblasti na páčke, pásma na spúšti a švihnutia, napríklad dvakrát dozadu, každé ako tlačidlo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringar och områden på en spak, band på en avtryckare och ryck som bakåt två gånger, var och en en knapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วงแหวนและพื้นที่บนจอยสติ๊ก ช่วงบนทริกเกอร์ และการดีด เช่น ถอยหลังสองครั้ง แต่ละอย่างเป็นปุ่ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubukta halkalar ve alanlar, tetikte bantlar ve iki kez geri gibi fiskeler; her biri bir düğme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кільця й області на джойстику, смуги на тригері та ривки на кшталт двох рухів назад, кожен як кнопка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các vòng và khu vực trên cần, các dải trên cò, và các cú hất như kéo về phía sau hai lần, mỗi thứ là một nút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摇杆上的圆环和区域、扳机上的区间，以及向后两次这样的轻拨，每一个都是一个按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搖桿上的圓環和區域、扳機上的區間，以及向後兩次這樣的輕撥，每一個都是一個按鈕。"
          }
        }
      }
    },
