    "Star your favorite presets and show only favorites in the sidebar and the menu bar" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع نجمة على إعداداتك المسبقة المفضلة واعرض المفضلة فقط في الشريط الجانبي وشريط القوائم"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označte oblíbené předvolby hvězdičkou a zobrazujte jen oblíbené v postranním panelu a řádku nabídek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjernemarkér dine favoritforudindstillinger, og vis kun favoritter i indholdsoversigten og menulinjen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere deine Lieblings-Presets mit einem Stern und zeige in der Seitenleiste und in der Menüleiste nur Favoriten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaca tus preajustes favoritos y muestra solo los favoritos en la barra lateral y en la barra de menús"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkitse suosikkiesiasetukset tähdellä ja näytä vain suosikit sivupalkissa ja valikkorivillä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez vos préréglages favoris d’une étoile et n’affichez que les favoris dans la barre latérale et la barre des menus"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סמן פריסטים מועדפים בכוכב והצג רק מועדפים בסרגל הצד ובשורת התפריטים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelölje csillaggal a kedvenc előbeállításait, és az oldalsávban és a menüsorban csak a kedvenceket mutassa"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri bintang preset favorit Anda dan tampilkan hanya favorit di bar samping dan bar menu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrassegna con una stella i tuoi preset preferiti e mostra solo i preferiti nella barra laterale e nella barra dei menu"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入りのプリセットにスターを付けると、サイドバーとメニューバーにお気に入りだけを表示できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾는 프리셋에 별표를 달고 사이드바와 메뉴 막대에서 즐겨찾기만 표시"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk favorittforhåndsinnstillingene dine med stjerne og vis bare favoritter i sidepanelet og menylinjen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef je favoriete presets een ster en toon alleen favorieten in de navigatiekolom en de menubalk"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznacz gwiazdką ulubione presety i pokazuj tylko ulubione na pasku bocznym i pasku menu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque seus presets favoritos com estrela e mostre somente os favoritos na barra lateral e na barra de menus"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте избранные пресеты звёздочкой и показывайте только избранные в боковой панели и строке меню"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Označte obľúbené predvoľby hviezdičkou a zobrazte v bočnom paneli a na lište ponuky iba obľúbené"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjärnmärk dina favoritförinställningar och visa bara favoriter i sidofältet och menyraden"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดดาวพรีเซ็ตรายการโปรดของคุณ และแสดงเฉพาะรายการโปรดในแถบด้านข้างและแถบเมนู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Favori ön ayarlarınızı yıldızlayın ve kenar çubuğunda ile menü çubuğunda yalnızca favorileri gösterin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначайте улюблені пресети зірочкою й показуйте лише вибране на бічній панелі та в рядку меню"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gắn sao cho cài đặt sẵn ưa thích và chỉ hiện mục ưa thích trong thanh bên và thanh menu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为你的个人收藏预设加星标，并在边栏和菜单栏中仅显示个人收藏"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為你喜好的預設加星號，並在側邊欄和選單列中僅顯示喜好項目"
          }
        }
      }
    },
