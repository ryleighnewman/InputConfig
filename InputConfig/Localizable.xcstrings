    "Swipe to every edge once so a swipe moves the pointer the same distance in every direction, and draw tap regions." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب إلى كل حافة مرة واحدة ليحرك التمرير المؤشر المسافة نفسها في كل اتجاه، وارسم مناطق النقر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejeďte jednou ke každému okraji, aby přejetí pohnulo ukazatelem stejně daleko ve všech směrech, a kreslete oblasti klepnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til hver kant én gang, så et stryg flytter markøren lige langt i alle retninger, og tegn tapområder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische einmal zu jedem Rand, damit ein Wischen den Zeiger in jede Richtung gleich weit bewegt, und zeichne Tipp-Bereiche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hasta cada borde una vez para que un deslizamiento mueva el puntero la misma distancia en todas las direcciones, y dibuja regiones de toque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyyhkäise kerran jokaiseen reunaan, jotta pyyhkäisy siirtää osoitinta yhtä pitkälle joka suuntaan, ja piirrä napautusalueet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez jusqu’à chaque bord une fois pour qu’un balayage déplace le pointeur sur la même distance dans toutes les directions, et dessinez des zones de toucher."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק לכל קצה פעם אחת כדי שהחלקה תזיז את המצביע באותו מרחק בכל כיוון, וצייר אזורי הקשה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csúsztasson minden szélig egyszer, hogy a csúsztatás minden irányban ugyanakkora távolságra mozgassa a mutatót, és rajzoljon koppintási területeket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesekkan ke setiap tepi sekali agar gesekan menggerakkan penunjuk dengan jarak yang sama ke segala arah, dan gambar wilayah ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri fino a ogni bordo una volta così uno scorrimento sposta il puntatore della stessa distanza in ogni direzione, e disegna le regioni di tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての端まで1回ずつスワイプして、どの方向でもスワイプによるポインタの移動距離が同じになるようにし、タップ領域を描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 가장자리까지 한 번씩 쓸어서 스와이프가 모든 방향에서 포인터를 같은 거리만큼 움직이게 하고, 탭 영역을 그리세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til hver kant én gang slik at et sveip flytter pekeren like langt i alle retninger, og tegn trykkområder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg één keer naar elke rand zodat een veeg de aanwijzer in elke richting even ver verplaatst, en teken tikgebieden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palec do każdej krawędzi raz, aby przesunięcie poruszało wskaźnikiem na tę samą odległość w każdym kierunku, i narysuj obszary dotknięć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize até cada borda uma vez para que um deslize mova o ponteiro a mesma distância em todas as direções, e desenhe regiões de toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите до каждого края один раз, чтобы смахивание сдвигало указатель на одно и то же расстояние во всех направлениях, и нарисуйте области касаний."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raz potiahnite na každý okraj, aby potiahnutie posunulo ukazovateľ rovnako ďaleko v každom smere, a nakreslite oblasti ťuknutia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep till varje kant en gång så att ett svep flyttar pekaren lika långt i alla riktningar, och rita tryckregioner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดไปทุกขอบหนึ่งครั้งเพื่อให้การปัดเลื่อนตัวชี้ไกลเท่ากันทุกทิศทาง และวาดพื้นที่แตะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kaydırmanın işaretçiyi her yönde aynı mesafe hareket ettirmesi ve dokunma bölgeleri çizmek için her kenara bir kez kaydırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть до кожного краю один раз, щоб свайп переміщував вказівник на однакову відстань у кожному напрямку, і намалюйте області торкання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt tới mọi cạnh một lần để một cú vuốt di chuyển con trỏ cùng một khoảng cách theo mọi hướng, và vẽ các vùng chạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向每个边缘各滑动一次，使滑动在每个方向上移动指针的距离相同，并绘制轻点区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "往每個邊緣各滑一次，讓滑動在每個方向移動指標的距離相同，並繪製輕點區域。"
          }
        }
      }
    },
    "Swipe to every edge once so a swipe moves the pointer the same distance in every direction, and draw tap zones." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب إلى كل حافة مرة واحدة ليحرك التمرير المؤشر المسافة نفسها في كل اتجاه، وارسم مناطق النقر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejeďte jednou ke každému okraji, aby přejetí pohnulo ukazatelem stejně daleko ve všech směrech, a kreslete zóny klepnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til hver kant én gang, så et stryg flytter markøren lige langt i alle retninger, og tegn tapzoner."
          }
        },
        "de" : {
          "stringUnit" : {
