    "On an Access Controller, hold socket 7 (Options). On a single Joy-Con, hold Minus or Plus." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Access Controller، اضغط المقبس 7 (Options) مطولًا. وفي Joy-Con منفرد، اضغط Minus أو Plus مطولًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Access Controlleru podržte konektor 7 (Options). Na jednom Joy-Con podržte Minus nebo Plus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold stik 7 (Options) nede på en Access Controller. Hold Minus eller Plus nede på en enkelt Joy-Con."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte an einem Access Controller Buchse 7 (Options) gedrückt. Halte an einem einzelnen Joy-Con Minus oder Plus gedrückt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un Access Controller, mantén pulsada la toma 7 (Options). En un Joy-Con individual, mantén pulsado Menos o Más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä Access Controllerissa pohjassa liitäntää 7 (Options). Pidä yksittäisessä Joy-Conissa pohjassa Miinus- tai Plus-painiketta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur une Access Controller, maintenez la prise 7 (Options). Sur un Joy-Con seul, maintenez Moins ou Plus."
