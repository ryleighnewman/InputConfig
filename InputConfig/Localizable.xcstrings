    "Replace regions with a 4 by 4 grid and bind each to keys 1 to 9, 0, F1 to F6 in the preset being edited" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدل المناطق بشبكة 4 في 4 واربط كلًا منها بالمفاتيح 1 إلى 9 و0 وF1 إلى F6 في الإعداد المسبق قيد التعديل"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradí oblasti mřížkou 4 × 4 a každou přiřadí ke klávesám 1 až 9, 0, F1 až F6 v upravované předvolbě"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstat områder med et 4 gange 4 gitter, og tildel hver til tasterne 1 til 9, 0, F1 til F6 i den forudindstilling, der redigeres"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetze Bereiche durch ein 4-mal-4-Raster und belege jeden mit den Tasten 1 bis 9, 0, F1 bis F6 im bearbeiteten Preset"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye las regiones por una cuadrícula de 4 por 4 y asigna cada una a las teclas 1 a 9, 0, F1 a F6 en el preajuste que se edita"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korvaa alueet 4 x 4 -ruudukolla ja määritä kukin muokattavassa esiasetuksessa näppäimiin 1-9, 0, F1-F6"
          }
        },
        "fr" : {
