    "Plug in a controller to get started. Open the Help menu for setup guides for every supported device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل ذراع تحكم للبدء. افتح قائمة المساعدة للاطلاع على أدلة الإعداد لكل جهاز مدعوم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapojte ovladač a začněte. V nabídce Nápověda najdete průvodce nastavením pro každé podporované zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut en controller til for at komme i gang. Åbn menuen Hjælp for opsætningsguider til alle understøttede enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe einen Controller an, um loszulegen. Öffne das Hilfemenü für Einrichtungsanleitungen zu jedem unterstützten Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un mando para empezar. Abre el menú Ayuda para ver guías de configuración de cada dispositivo compatible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita kytkemällä ohjain. Avaa Ohje-valikko nähdäksesi jokaisen tuetun laitteen käyttöönotto-oppaat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez une manette pour commencer. Ouvrez le menu Aide pour les guides de configuration de chaque appareil pris en charge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חבר שלט כדי להתחיל. פתח את תפריט ״עזרה״ למדריכי הגדרה לכל התקן נתמך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kezdéshez csatlakoztasson egy vezérlőt. Nyissa meg a Súgó menüt a támogatott eszközök beállítási útmutatóihoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colokkan pengontrol untuk memulai. Buka menu Bantuan untuk panduan penyiapan setiap perangkat yang didukung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un controller per iniziare. Apri il menu Aiuto per le guide di configurazione di ogni dispositivo supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントローラを接続して始めましょう。「ヘルプ」メニューには、対応するすべてのデバイスのセットアップガイドがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작하려면 컨트롤러를 연결하세요. 도움말 메뉴에서 지원되는 모든 기기의 설정 가이드를 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til en kontroller for å komme i gang. Åpne Hjelp-menyen for oppsettsveiledninger for alle enheter som støttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit een controller aan om te beginnen. Open het menu Help voor installatiegidsen voor elk ondersteund apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz kontroler, aby zacząć. Otwórz menu Pomoc, aby zobaczyć przewodniki konfiguracji każdego obsługiwanego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte um controle para começar. Abra o menu Ajuda para ver os guias de configuração de cada dispositivo compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите контроллер, чтобы начать. В меню «Справка» есть руководства по настройке для каждого поддерживаемого устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete začať, zapojte ovládač. Otvorte ponuku Pomocník, kde nájdete príručky nastavenia pre každé podporované zariadenie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut en spelkontroll för att komma igång. Öppna menyn Hjälp för installationsguider för alla enheter som stöds."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียบคอนโทรลเลอร์เพื่อเริ่มต้น เปิดเมนูวิธีใช้เพื่อดูคู่มือการตั้งค่าของทุกอุปกรณ์ที่รองรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlamak için bir kumanda takın. Desteklenen her aygıt için kurulum kılavuzları Yardım menüsünde."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть контролер, щоб почати. Відкрийте меню «Довідка», щоб побачити посібники з налаштування для кожного підтримуваного пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắm bộ điều khiển để bắt đầu. Mở menu Trợ giúp để xem hướng dẫn thiết lập cho mọi thiết bị được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插入控制器即可开始。打开“帮助”菜单可查看每种受支持设备的设置指南。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插入控制器即可開始。開啟「說明」選單，可查看每個支援裝置的設定指南。"
          }
        }
      }
    },
    "Plug in a USB controller or pair one over Bluetooth. It will show up here automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل ذراع تحكم USB أو اقرن واحدًا عبر Bluetooth. سيظهر هنا تلقائيًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapojte ovladač USB nebo spárujte jeden přes Bluetooth. Zobrazí se zde automaticky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut en USB-controller til, eller par en via Bluetooth. Den vises her automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe einen USB-Controller an oder koppele einen über Bluetooth. Er erscheint hier automatisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un mando USB o empareja uno por Bluetooth. Aparecerá aquí automáticamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kytke USB-ohjain tai liitä sellainen Bluetoothilla. Se ilmestyy tähän automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez une manette USB ou appairez-en une en Bluetooth. Elle apparaîtra ici automatiquement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חבר שלט USB או צמד אחד דרך Bluetooth. הוא יופיע כאן אוטומטית."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztasson USB-vezérlőt, vagy párosítson egyet Bluetoothon. Automatikusan megjelenik itt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colokkan pengontrol USB atau pasangkan satu melalui Bluetooth. Pengontrol akan muncul di sini secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un controller USB o abbinane uno via Bluetooth. Comparirà qui automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBコントローラを接続するか、Bluetoothでペアリングしてください。自動的にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB 컨트롤러를 연결하거나 Bluetooth로 페어링하세요. 자동으로 여기에 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til en USB-kontroller eller par en over Bluetooth. Den vises her automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit een USB-controller aan of koppel er een via Bluetooth. Hij verschijnt hier automatisch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz kontroler USB lub sparuj go przez Bluetooth. Pojawi się tutaj automatycznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte um controle USB ou pareie um por Bluetooth. Ele aparecerá aqui automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите USB-контроллер или выполните сопряжение по Bluetooth. Он появится здесь автоматически."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapojte ovládač USB alebo spárujte jeden cez Bluetooth. Zobrazí sa tu automaticky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut en USB-spelkontroll eller parkoppla en via Bluetooth. Den visas här automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียบคอนโทรลเลอร์ USB หรือจับคู่ผ่าน Bluetooth จะปรากฏที่นี่โดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir USB kumanda takın ya da Bluetooth üzerinden eşleştirin. Burada kendiliğinden görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть контролер USB або спарте його через Bluetooth. Він з’явиться тут автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắm bộ điều khiển USB hoặc ghép nối một bộ qua Bluetooth. Nó sẽ tự động hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插入 USB 控制器或通过蓝牙配对一个。它会自动显示在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插入 USB 控制器或透過藍牙配對一個。它會自動顯示在這裡。"
          }
        }
      }
    },
    "Plug in any MIDI keyboard, pad controller, or knob box and use it to drive your Mac, with no game controller connected. Notes and pads act like buttons. Knobs get three modes: Switch fires past halfway, Dial speeds up the further you turn from center, and Turn fires a nudge per step in either direction. Pair a knob with the System Volume output and it becomes a hardware volume fader: position equals level, and it only takes over once you actually move it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل أي لوحة مفاتيح MIDI أو ذراع لوحات أو صندوق مقابض واستخدمه لقيادة جهاز Mac، دون ذراع ألعاب متصل. تعمل النوتات واللوحات كأزرار. للمقابض ثلاثة أوضاع: «التبديل» يُطلق بعد منتصف المشوار، و«القرص» يتسارع كلما أدرته بعيدًا عن المركز، و«الدوران» يطلق دفعة لكل خطوة في أي اتجاه. اقرن مقبضًا بمخرج «مستوى صوت النظام» ليصبح منزلق صوت مادّيًا: الموضع يساوي المستوى، ولا يتولى التحكم إلا بعد أن تحركه فعلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapojte libovolnou klávesnici MIDI, pad controller nebo box s knoflíky a ovládejte jím Mac, bez připojeného herního ovladače. Noty a pady fungují jako tlačítka. Knoflíky mají tři režimy: Spínač se spustí po půlce, Kolečko zrychluje, čím dál od středu otočíte, a Otáčení spustí impuls za každý krok v obou směrech. Spojte knoflík s výstupem Hlasitost systému a stane se z něj hardwarový fader hlasitosti: poloha rovná se úrovni a převezme ovládání, až se skutečně pohnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut et vilkårligt MIDI-keyboard, en pad-controller eller en drejeknapboks til, og brug den til at styre din Mac uden en forbundet spilcontroller. Toner og pads fungerer som knapper. Drejeknapper har tre tilstande: Skift udløses efter halvvejs, Drejeknap bliver hurtigere, jo længere du drejer fra midten, og Drej udløser et lille skub pr. trin i begge retninger. Kombinér en drejeknap med outputtet Systemlydstyrke, så bliver den til en hardwarefader til lydstyrke: position svarer til niveau, og den overtager først, når du faktisk flytter den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe ein beliebiges MIDI-Keyboard, einen Pad-Controller oder eine Regler-Box an und steuere damit deinen Mac, ohne Spiele-Controller. Noten und Pads wirken wie Tasten. Regler haben drei Modi: „Schalter“ löst nach der Hälfte aus, „Drehregler“ wird schneller, je weiter du von der Mitte wegdrehst, und „Drehen“ löst pro Schritt in beide Richtungen einen Impuls aus. Kombiniere einen Regler mit der Ausgabe „Systemlautstärke“, und er wird zum Hardware-Lautstärkeregler: Position entspricht Pegel, und er übernimmt erst, wenn du ihn wirklich bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta cualquier teclado MIDI, controlador de pads o caja de perillas y úsalo para manejar tu Mac, sin ningún mando de juego conectado. Las notas y los pads actúan como botones. Las perillas tienen tres modos: Interruptor se activa pasada la mitad, Dial se acelera cuanto más giras desde el centro, y Giro activa un ajuste por paso en cualquier dirección. Combina una perilla con la salida Volumen del sistema y se convierte en un fader de volumen físico: la posición equivale al nivel, y solo toma el control cuando realmente la mueves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kytke mikä tahansa MIDI-koskettimisto, padiohjain tai nuppilaatikko ja ohjaa sillä Maciasi ilman peliohjainta. Nuotit ja padit toimivat kuin painikkeet. Nupeilla on kolme tilaa: Kytkin laukeaa puolivälin yli, Valitsin nopeutuu mitä kauemmas keskikohdasta käännetään, ja Kierto laukaisee töytäisyn jokaisella askeleella kumpaankin suuntaan. Yhdistä nuppi Järjestelmän äänenvoimakkuus -ulostuloon, niin siitä tulee laitteellinen äänenvoimakkuuden liukusäädin: sijainti vastaa tasoa, ja se ottaa ohjauksen vasta, kun sitä todella liikutetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez n’importe quel clavier MIDI, pad contrôleur ou boîtier de boutons et utilisez-le pour piloter votre Mac, sans manette de jeu connectée. Les notes et les pads se comportent comme des boutons. Les boutons rotatifs ont trois modes : Interrupteur se déclenche au-delà de la moitié, Cadran accélère à mesure que vous tournez depuis le centre, et Rotation déclenche une impulsion par cran dans les deux sens. Associez un bouton à la sortie Volume du système et il devient un curseur de volume matériel : position égale niveau, et il ne prend la main que lorsque vous le déplacez réellement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חבר כל מקלדת MIDI, בקר משטחים או קופסת כפתורים והשתמש בהם כדי להפעיל את ה-Mac, בלי שלט משחק מחובר. תווים ומשטחים פועלים כלחצנים. לכפתורים יש שלושה מצבים: ״מתג״ מופעל אחרי חצי הדרך, ״חוגה״ מאיץ ככל שמסובבים רחוק יותר מהמרכז, ו״סיבוב״ מפעיל הזזה בכל צעד בכל כיוון. צמד כפתור עם פלט עוצמת הקול של המערכת והוא הופך לפיידר חומרתי לעוצמת קול: מיקום שווה לרמה, והוא משתלט רק אחרי שהזזת אותו בפועל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztasson bármilyen MIDI-billentyűzetet, padvezérlőt vagy gombdobozt, és vezérelje vele a Macet játékvezérlő nélkül. A hangok és padek gombként működnek. A gombok három módot kapnak: a Kapcsoló félúton túl aktiválódik, a Tárcsa annál gyorsabb, minél messzebb fordítja a középponttól, a Forgatás pedig lépésenként egy lökést ad bármelyik irányban. Párosítson egy gombot a Rendszerhangerő kimenettel, és hardveres hangerőszabályzóvá válik: a pozíció egyenlő a szinttel, és csak akkor veszi át az irányítást, amikor ténylegesen megmozdítja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colokkan papan ketik MIDI, pengontrol pad, atau kotak kenop apa pun dan gunakan untuk menggerakkan Mac Anda, tanpa pengontrol game yang terhubung. Nada dan pad bertindak seperti tombol. Kenop punya tiga mode: Switch aktif setelah melewati setengah, Dial semakin cepat semakin jauh Anda memutar dari tengah, dan Turn memicu dorongan per langkah ke kedua arah. Padukan kenop dengan output Volume Sistem dan menjadi fader volume perangkat keras: posisi sama dengan level, dan baru mengambil alih setelah Anda benar-benar menggerakkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega qualsiasi tastiera MIDI, pad controller o box di manopole e usalo per controllare il Mac, senza alcun controller di gioco collegato. Note e pad agiscono come pulsanti. Le manopole hanno tre modalità: Interruttore si attiva oltre la metà, Manopola accelera quanto più giri dal centro e Rotazione attiva uno scatto per passo in entrambe le direzioni. Abbina una manopola all’uscita Volume di sistema e diventa un fader del volume hardware: la posizione corrisponde al livello, e prende il controllo solo quando la muovi davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDIキーボード、パッドコントローラ、ノブボックスを接続すれば、ゲームコントローラなしでMacを操作できます。ノートとパッドはボタンのように動作します。ノブには3つのモードがあります。「スイッチ」は中間を超えると実行し、「ダイヤル」は中央から回すほど速くなり、「回転」はどちらの方向にもステップごとに微小な動きを実行します。ノブを「システム音量」出力と組み合わせると、ハードウェアの音量フェーダーになります。位置がそのままレベルになり、実際に動かしたときにだけ引き継がれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIDI 키보드, 패드 컨트롤러, 노브 박스를 연결하면 게임 컨트롤러 없이도 Mac을 조작할 수 있습니다. 노트와 패드는 버튼처럼 작동합니다. 노브에는 세 가지 모드가 있습니다: 스위치는 절반을 넘으면 실행되고, 다이얼은 중앙에서 멀리 돌릴수록 빨라지며, 회전은 어느 방향이든 한 단계마다 한 번씩 실행합니다. 노브를 시스템 볼륨 출력과 짝지으면 하드웨어 볼륨 페이더가 됩니다: 위치가 곧 레벨이며, 실제로 움직였을 때만 제어를 넘겨받습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til et hvilket som helst MIDI-tastatur, en pad-kontroller eller en knappeboks og bruk den til å styre Macen, uten tilkoblet spillkontroller. Toner og pads fungerer som knapper. Knapper får tre moduser: Bryter utløses forbi halvveis, Dial går raskere jo lenger du vrir fra midten, og Vri utløser et dytt per trinn i begge retninger. Par en knapp med utdataene Systemvolum, så blir den en maskinvarebasert volumfader: posisjon tilsvarer nivå, og den tar bare over når du faktisk flytter den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit een MIDI-keyboard, padcontroller of knoppenkast aan en bestuur daarmee je Mac, zonder gamecontroller. Noten en pads werken als knoppen. Knoppen krijgen drie modi: Schakelaar activeert voorbij de helft, Draaiknop versnelt naarmate je verder van het midden draait, en Draaien activeert een duwtje per stap in beide richtingen. Combineer een knop met de uitvoer Systeemvolume en hij wordt een hardwarematige volumefader: positie is gelijk aan niveau, en hij neemt pas over zodra je hem echt beweegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz dowolną klawiaturę MIDI, kontroler z padami lub skrzynkę z gałkami i steruj nią Makiem, bez kontrolera do gier. Nuty i pady działają jak przyciski. Gałki mają trzy tryby: Przełącznik uruchamia się po przekroczeniu połowy, Pokrętło przyspiesza im dalej kręcisz od środka, a Obrót wysyła impuls za każdy krok w obu kierunkach. Połącz gałkę z wyjściem Głośność systemu, a stanie się sprzętowym suwakiem głośności: położenie równa się poziomowi i przejmuje kontrolę dopiero po faktycznym poruszeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte qualquer teclado MIDI, controlador de pads ou caixa de botões e use-o para controlar o Mac, sem nenhum controle de jogo conectado. Notas e pads agem como botões. Os botões giratórios têm três modos: Alternar dispara depois da metade, Dial acelera quanto mais você gira a partir do centro, e Girar dispara um toque por passo em qualquer direção. Combine um botão com a saída Volume do sistema e ele vira um fader de volume em hardware: a posição é igual ao nível, e só assume o controle quando você realmente o move."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите любую клавиатуру MIDI, пэд-контроллер или блок ручек и управляйте с их помощью Mac без игрового контроллера. Ноты и пэды работают как кнопки. У ручек три режима: «Порог» срабатывает за серединой, «Ручка» ускоряется по мере удаления от центра, а «Вращение» срабатывает на один шаг в любую сторону. Объедините ручку с выводом громкости системы, и она станет аппаратным фейдером громкости: положение равно уровню, и она вступает в силу, только когда вы действительно ею пошевелите."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapojte ľubovoľnú MIDI klávesnicu, pad kontrolér alebo box s ovládačmi a ovládajte ním Mac bez pripojeného herného ovládača. Noty a pady fungujú ako tlačidlá. Otočné ovládače majú tri režimy: Prepínač sa spustí za polovicou, Otočný ovládač zrýchľuje, čím ďalej od stredu otáčate, a Otáčanie spustí posun na krok v oboch smeroch. Spárujte ovládač s výstupom Systémová hlasitosť a stane sa hardvérovým fadrom hlasitosti: poloha sa rovná úrovni a prevezme ju, až keď ním skutočne pohnete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut vilket MIDI-tangentbord, vilken pad-kontroll eller rattbox som helst och styr din Mac med den, utan någon ansluten spelkontroll. Toner och pads fungerar som knappar. Rattar får tre lägen: Brytare utlöses förbi halvvägs, Vred går snabbare ju längre du vrider från mitten och Vrid utlöser en knuff per steg i endera riktningen. Para en ratt med utdatan Systemvolym så blir den en volymreglage i hårdvara: position motsvarar nivå, och den tar över först när du faktiskt flyttar den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียบคีย์บอร์ด MIDI แพดคอนโทรลเลอร์ หรือกล่องปุ่มหมุนใดก็ได้ แล้วใช้ควบคุม Mac โดยไม่ต้องมีคอนโทรลเลอร์เกม โน้ตและแพดทำงานเหมือนปุ่ม ปุ่มหมุนมีสามโหมด: สลับทำงานเมื่อเกินครึ่ง หน้าปัดเร็วขึ้นเมื่อหมุนห่างจากกึ่งกลาง และหมุนสั่งการขยับหนึ่งครั้งต่อขั้นในทั้งสองทิศทาง จับคู่ปุ่มหมุนกับเอาต์พุตระดับเสียงระบบแล้วมันกลายเป็นเฟเดอร์ระดับเสียงฮาร์ดแวร์: ตำแหน่งเท่ากับระดับ และจะควบคุมเมื่อคุณขยับมันจริงเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir MIDI klavyesi, ped denetleyicisi veya düğme kutusu takın ve hiçbir oyun kumandası bağlı olmadan Mac’inizi sürmek için kullanın. Notalar ve padler düğme gibi davranır. Düğmelerin üç modu vardır: Anahtar yarıyı geçince tetikler, Kadran merkezden ne kadar çevirirseniz o kadar hızlanır ve Çevir her iki yönde adım başına bir dürtme tetikler. Bir düğmeyi Sistem Ses Düzeyi çıkışıyla eşleştirin; donanımsal bir ses fader’ına dönüşür: konum seviyeye eşittir ve yalnızca onu gerçekten hareket ettirdiğinizde devralır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть будь-яку клавіатуру MIDI, контролер з падами чи коробку з регуляторами й керуйте своїм Mac без ігрового контролера. Ноти й педи діють як кнопки. Регулятори мають три режими: «Перемикач» спрацьовує за межею половини, «Регулятор» прискорюється, чим далі ви крутите від центра, а «Обертання» запускає поштовх на кожному кроці в будь-який бік. Поєднайте регулятор із виходом «Гучність системи», і він стане апаратним фейдером гучності: положення дорівнює рівню, і він перебирає керування, лише коли ви його справді зрушите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắm bất kỳ bàn phím MIDI, bộ điều khiển pad hoặc hộp núm nào và dùng nó để điều khiển Mac, không cần bộ điều khiển trò chơi. Nốt và pad hoạt động như nút. Núm có ba chế độ: Công tắc kích hoạt khi vượt quá nửa, Núm xoay tăng tốc khi bạn xoay càng xa tâm, và Xoay kích hoạt một cú nhích mỗi bước theo cả hai hướng. Ghép một núm với đầu ra Âm lượng hệ thống và nó trở thành thanh trượt âm lượng phần cứng: vị trí bằng mức âm lượng, và chỉ tiếp quản khi bạn thực sự di chuyển nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插入任何 MIDI 键盘、键垫控制器或旋钮盒，无需连接游戏控制器即可用它操控 Mac。音符和键垫就像按钮。旋钮有三种模式：“开关”在过半后触发，“旋盘”离中心越远速度越快，“旋转”在任一方向每步触发一次微调。将旋钮与“系统音量”输出配对，它就成为硬件音量推子：位置等于音量，并且只有在你真正移动它之后才会接管。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插入任何 MIDI 鍵盤、鼓墊控制器或旋鈕盒來驅動你的 Mac，不需要連接遊戲控制器。音符和鼓墊就像按鈕。旋鈕有三種模式：「切換」在超過一半時觸發，「轉盤」離中心轉得越遠速度越快，「旋轉」在任一方向每轉一格觸發一次微調。將旋鈕搭配「系統音量」輸出，就成為硬體音量推子：位置即音量，且只有在你真的移動它之後才會接管。"
          }
        }
      }
    },
    "Plug the controller in with its USB cable. Wired DualSense, DualShock 4, Xbox, and 8BitDo show up immediately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل ذراع التحكم بكابل USB الخاص به. تظهر أذرع DualSense وDualShock 4 وXbox و8BitDo السلكية فورًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte ovladač kabelem USB. Kabelové DualSense, DualShock 4, Xbox a 8BitDo se zobrazí okamžitě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slut controlleren til med dens USB-kabel. Kablede DualSense, DualShock 4, Xbox og 8BitDo vises med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe den Controller mit seinem USB-Kabel an. Kabelgebundene DualSense, DualShock 4, Xbox und 8BitDo erscheinen sofort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el mando con su cable USB. Los DualSense, DualShock 4, Xbox y 8BitDo con cable aparecen de inmediato."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kytke ohjain USB-kaapelilla. Langalliset DualSense, DualShock 4, Xbox ja 8BitDo näkyvät heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez la manette avec son câble USB. Les DualSense, DualShock 4, Xbox et 8BitDo filaires apparaissent immédiatement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חבר את השלט בכבל USB שלו. שלטי DualSense, DualShock 4, Xbox ו-8BitDo קוויים מופיעים מיד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztassa a vezérlőt az USB-kábelével. A vezetékes DualSense, DualShock 4, Xbox és 8BitDo azonnal megjelenik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colokkan pengontrol dengan kabel USB-nya. DualSense, DualShock 4, Xbox, dan 8BitDo berkabel langsung muncul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il controller con il suo cavo USB. DualSense, DualShock 4, Xbox e 8BitDo cablati compaiono subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USBケーブルでコントローラを接続してください。有線のDualSense、DualShock 4、Xbox、8BitDoはすぐに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB 케이블로 컨트롤러를 연결하세요. 유선 DualSense, DualShock 4, Xbox, 8BitDo는 즉시 나타납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble kontrolleren til med USB-kabelen. Kablede DualSense, DualShock 4, Xbox og 8BitDo vises med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit de controller aan met de USB-kabel. Bekabelde DualSense, DualShock 4, Xbox en 8BitDo verschijnen direct."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz kontroler kablem USB. Przewodowe DualSense, DualShock 4, Xbox i 8BitDo pojawiają się natychmiast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o controle com o cabo USB. DualSense, DualShock 4, Xbox e 8BitDo com fio aparecem imediatamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите контроллер кабелем USB. Проводные DualSense, DualShock 4, Xbox и 8BitDo появляются сразу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapojte ovládač jeho USB káblom. Káblové DualSense, DualShock 4, Xbox a 8BitDo sa zobrazia okamžite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut spelkontrollen med dess USB-kabel. Trådbundna DualSense, DualShock 4, Xbox och 8BitDo visas direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียบคอนโทรลเลอร์ด้วยสาย USB DualSense, DualShock 4, Xbox และ 8BitDo แบบมีสายจะปรากฏทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumandayı USB kablosuyla takın. Kablolu DualSense, DualShock 4, Xbox ve 8BitDo hemen görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть контролер кабелем USB. Дротові DualSense, DualShock 4, Xbox і 8BitDo з’являються одразу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắm bộ điều khiển bằng cáp USB. DualSense, DualShock 4, Xbox và 8BitDo có dây hiện ngay lập tức."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 USB 线缆连接控制器。有线的 DualSense、DualShock 4、Xbox 和 8BitDo 会立即显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
