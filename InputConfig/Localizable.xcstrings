    "Resistance across the pull while this preset runs; the trigger is let go when it stops." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقاومة على طول السحب أثناء تشغيل هذا الإعداد المسبق؛ ويُحرَّر الزناد عند توقفه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpor po celém zdvihu, dokud tato předvolba běží; spoušť se uvolní, když se zastaví."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modstand gennem hele trækket, mens denne forudindstilling kører; aftrækkeren slippes, når den stopper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widerstand über den ganzen Zug, solange dieses Preset läuft; der Trigger wird freigegeben, wenn es stoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistencia en todo el recorrido mientras este preset está activo; el gatillo se suelta cuando se detiene."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastus koko painalluksen matkalla, kun tämä esiasetus on käynnissä; liipaisin vapautetaan, kun se pysähtyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résistance sur toute la course tant que ce préréglage tourne ; la gâchette est relâchée quand il s'arrête."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התנגדות לאורך כל הלחיצה בזמן שההגדרה פועלת; ההדק משתחרר כשהיא נעצרת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenállás a teljes húzáson, amíg ez a beállítás fut; a ravasz felszabadul, amikor leáll."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hambatan sepanjang tarikan selama preset ini berjalan; pemicu dilepas saat preset berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistenza lungo tutta la corsa mentre questo preset è attivo; il grilletto viene rilasciato quando si ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプリセットの実行中、引きの全体に抵抗をかけます。止まるとトリガーは解放されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프리셋이 실행되는 동안 당기는 전체 구간에 저항을 줍니다. 멈추면 트리거가 풀립니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motstand gjennom hele trykket mens denne forhåndsinnstillingen kjører; avtrekkeren slippes når den stopper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weerstand over de hele slag zolang deze voorinstelling loopt; de trigger wordt losgelaten als ze stopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opór na całym skoku, gdy to ustawienie działa; spust jest zwalniany, gdy się zatrzyma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resistência em todo o curso enquanto este preset roda; o gatilho é liberado quando ele para."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сопротивление по всему ходу, пока работает этот пресет; триггер отпускается, когда он останавливается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpor po celom zdvihu, kým táto predvoľba beží; spúšť sa uvoľní, keď sa zastaví."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motstånd genom hela tryckningen medan den här förinställningen körs; avtryckaren släpps när den stoppas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แรงต้านตลอดระยะการกดขณะพรีเซ็ตนี้ทำงาน ทริกเกอร์จะถูกปล่อยเมื่อพรีเซ็ตหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ön ayar çalışırken tüm çekiş boyunca direnç; durduğunda tetik serbest bırakılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опір на всьому ході, поки працює цей пресет; тригер відпускається, коли він зупиняється."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lực cản trên cả hành trình khi cài đặt sẵn này chạy; cò được thả ra khi nó dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此预设运行时，在整个扣压行程中施加阻力；预设停止时扳机即被释放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此預設執行時，在整個扣壓行程中施加阻力；預設停止時扳機即被釋放。"
          }
        }
      }
    },
