    "Makes every pointer movement in this preset faster or slower. ×1.00 is as each row is set." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجعل كل حركة مؤشر في هذا الإعداد المسبق أسرع أو أبطأ. ×1.00 كما هو مضبوط في كل صف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrychlí nebo zpomalí každý pohyb ukazatele v této předvolbě. ×1,00 je tak, jak je nastaven každý řádek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør hver markørbevægelse i denne forudindstilling hurtigere eller langsommere. ×1.00 er som hver række er indstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht jede Zeigerbewegung in diesem Preset schneller oder langsamer. ×1,00 entspricht der Einstellung jeder Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace que cada movimiento del puntero de este preajuste sea más rápido o más lento. ×1,00 es tal como está ajustada cada fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopeuttaa tai hidastaa jokaista osoittimen liikettä tässä esiasetuksessa. ×1,00 on kunkin rivin asetuksen mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend chaque déplacement du pointeur de ce préréglage plus rapide ou plus lent. ×1,00 correspond au réglage de chaque ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאיץ או מאט כל תנועת מצביע בפריסט הזה. ‎×1.00 הוא כפי שכל שורה מוגדרת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyorsabbá vagy lassabbá teszi az előbeállítás minden mutatómozgását. A ×1,00 az, ahogy az egyes sorok be vannak állítva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat setiap gerakan penunjuk dalam preset ini lebih cepat atau lebih lambat. ×1.00 sesuai pengaturan setiap baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rende più veloce o più lento ogni movimento del puntatore in questo preset. ×1,00 corrisponde all’impostazione di ogni riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプリセット内のすべてのポインタの動きを速く、または遅くします。×1.00は各行の設定どおりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프리셋의 모든 포인터 움직임을 더 빠르거나 느리게 합니다. ×1.00은 각 행에 설정된 값 그대로입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør hver pekerbevegelse i denne forhåndsinnstillingen raskere eller tregere. ×1,00 er slik hver rad er satt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt elke aanwijzerbeweging in deze preset sneller of langzamer. ×1,00 is zoals elke rij is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyspiesza lub spowalnia każdy ruch wskaźnika w tym presecie. ×1.00 oznacza ustawienie każdego wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixa cada movimento do ponteiro neste preset mais rápido ou mais lento. ×1,00 é como cada linha está definida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускоряет или замедляет каждое движение указателя в этом пресете. ×1.00 означает, как задано в каждой строке."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrýchli alebo spomalí každý pohyb ukazovateľa v tejto predvoľbe. ×1,00 je tak, ako je nastavený každý riadok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör varje pekarrörelse i den här förinställningen snabbare eller långsammare. ×1,00 är som varje rad är inställd."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้ทุกการเคลื่อนตัวชี้ในพรีเซ็ตนี้เร็วขึ้นหรือช้าลง ×1.00 คือตามที่ตั้งไว้ในแต่ละแถว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ön ayardaki her işaretçi hareketini daha hızlı veya yavaş yapar. ×1,00, her satırın ayarlandığı gibidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робить кожен рух вказівника в цьому пресеті швидшим або повільнішим. ×1.00 означає, як налаштовано кожен рядок."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mọi chuyển động con trỏ trong cài đặt sẵn này nhanh hơn hoặc chậm hơn. ×1.00 là như mỗi hàng đã đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让此预设中的每次指针移动更快或更慢。×1.00 表示按各行的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓此預設中的所有指標移動變快或變慢。×1.00 表示維持每列的設定。"
          }
        }
      }
    },
