    "This region overlaps row %@. While the stick is inside it, only this row fires; that row waits until the stick leaves the region." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتداخل هذه المنطقة مع الصف %@. وما دامت العصا داخلها، يعمل هذا الصف وحده؛ وينتظر ذلك الصف حتى تغادر العصا المنطقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato oblast zasahuje do řádku %@. Dokud je páčka uvnitř ní, spouští se jen tento řádek; ten druhý čeká, dokud páčka oblast neopustí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette område overlapper række %@. Mens sticken er inden i det, udløses kun denne række. Den række venter, til sticken forlader området."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich überschneidet sich mit der Zeile %@. Solange sich der Stick darin befindet, löst nur diese Zeile aus; jene Zeile wartet, bis der Stick den Bereich verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta región se solapa con la fila %@. Mientras el stick está dentro, solo se activa esta fila; esa fila espera hasta que el stick salga de la región."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä alue menee päällekkäin rivin %@ kanssa. Kun sauva on sen sisällä, vain tämä rivi laukeaa; tuo rivi odottaa, kunnes sauva poistuu alueelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette zone chevauche la ligne %@. Tant que le stick est dedans, seule cette ligne se déclenche ; l’autre ligne attend que le stick quitte la zone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האזור הזה חופף לשורה %@. כל עוד הג׳ויסטיק בתוכו, רק השורה הזו פועלת; השורה ההיא ממתינה עד שהג׳ויסטיק יוצא מהאזור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a terület a(z) %@. sort fedi át. Amíg a joystick benne van, csak ez a sor aktiválódik; az a sor addig vár, amíg a joystick el nem hagyja a területet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah ini tumpang tindih dengan baris %@. Selama stik berada di dalamnya, hanya baris ini yang aktif; baris itu menunggu sampai stik meninggalkan wilayah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa regione si sovrappone alla riga %@. Finché lo stick è al suo interno, si attiva solo questa riga; quella riga resta in attesa finché lo stick non esce dalla regione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この領域は行 %@ と重なっています。スティックが領域内にある間は、この行だけが動作し、その行はスティックが領域を出るまで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 영역은 %@ 행과 겹칩니다. 스틱이 영역 안에 있는 동안에는 이 행만 동작하며, 해당 행은 스틱이 영역을 벗어날 때까지 대기합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette området overlapper rad %@. Mens joysticken er inne i det, utløses bare denne raden. Den raden venter til joysticken forlater området."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit gebied overlapt met rij %@. Zolang de stick erin zit, wordt alleen deze rij geactiveerd; die rij wacht tot de stick het gebied verlaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten obszar nakłada się na wiersz %@. Gdy drążek jest wewnątrz niego, uruchamia się tylko ten wiersz; tamten wiersz czeka, aż drążek opuści obszar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta região se sobrepõe à linha %@. Enquanto o stick está dentro dela, só esta linha dispara; aquela linha espera até o stick sair da região."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта область пересекается со строкой %@. Пока стик находится в ней, срабатывает только эта строка; та строка ждёт, пока стик не покинет область."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Táto oblasť zasahuje do riadka %@. Kým je páčka vnútri nej, spúšťa sa iba tento riadok; ten druhý čaká, kým páčka oblasť neopustí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här regionen överlappar rad %@. Medan spaken är inne i den utlöses bara den här raden. Den raden väntar tills spaken lämnar regionen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่นี้ซ้อนกับแถว %@ ขณะที่จอยสติ๊กอยู่ในพื้นที่ จะมีเฉพาะแถวนี้ที่ทำงาน แถวนั้นจะรอจนกว่าจอยสติ๊กจะออกจากพื้นที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölge %@ satırıyla çakışıyor. Çubuk bölgenin içindeyken yalnızca bu satır çalışır; o satır çubuk bölgeden çıkana kadar bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця область перетинається з рядком %@. Поки джойстик перебуває в ній, спрацьовує лише цей рядок; той рядок чекає, доки джойстик не покине область."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng này chồng lên hàng %@. Khi cần nằm trong vùng, chỉ hàng này kích hoạt; hàng kia chờ cho đến khi cần rời vùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此区域与第 %@ 行重叠。摇杆处于其中时，只有这一行触发；那一行会等到摇杆离开该区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此區域與第 %@ 列重疊。搖桿位於其中時，只有這一列觸發；那一列會等到搖桿離開該區域。"
          }
        }
      }
    },
