        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poziom to sposób, w jaki go trzymasz, nowa opcja dla wierszy przechyłu i wskaźnika, mierzy przechył od twojego chwytu zamiast od pozycji płaskiej"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nível é como você segura, uma nova opção para linhas de inclinação e de ponteiro, mede a inclinação a partir da sua pegada em vez de a partir do plano"
