    "That's the tour! Start it again any time from the Quick Start Guide button or the Help menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت الجولة! ابدأها من جديد متى شئت من زر «دليل البدء السريع» أو قائمة «المساعدة»."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je celá prohlídka! Spusťte ji znovu kdykoli tlačítkem Průvodce rychlým startem nebo z nabídky Nápověda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var rundturen! Start den igen, når du vil, med knappen Hurtigstartguide eller fra menuen Hjælp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war die Tour! Starte sie jederzeit neu über die Taste Schnellstart-Anleitung oder das Menü Hilfe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Fin del tour! Vuelve a empezarlo cuando quieras con el botón Guía de inicio rápido o el menú Ayuda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siinä oli kierros! Aloita se uudelleen milloin tahansa Pika-aloitusopas-painikkeesta tai Ohje-valikosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est la fin de la visite ! Relancez-la quand vous voulez avec le bouton Guide de démarrage rapide ou le menu Aide."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה הסיור! התחילו אותו מחדש מתי שתרצו מכפתור ״מדריך התחלה מהירה״ או מתפריט ״עזרה״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennyi volt a bemutató! Indítsd újra bármikor a Gyorsindítási útmutató gombbal vagy a Súgó menüből."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itulah turnya! Mulai lagi kapan saja dari tombol Panduan Mulai Cepat atau menu Bantuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tour è finito! Fallo ripartire quando vuoi con il pulsante Guida di avvio rapido o dal menu Aiuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツアーはこれで終わりです。「クイックスタートガイド」ボタンや「ヘルプ」メニューから、いつでも始め直せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보기가 끝났습니다! 빠른 시작 가이드 버튼이나 도움말 메뉴에서 언제든 다시 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var omvisningen! Start den igjen når du vil, med knappen Hurtigstartveiledning eller fra Hjelp-menyen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat was de rondleiding! Start hem wanneer je wilt opnieuw met de knop Snelstartgids of via het menu Help."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To koniec wycieczki! Zacznij ją od nowa kiedy chcesz przyciskiem Przewodnik szybkiego startu lub z menu Pomoc."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fim do tour! Recomece quando quiser pelo botão Guia de início rápido ou pelo menu Ajuda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вот и весь обзор! Запустите его снова в любой момент кнопкой «Руководство по быстрому началу» или из меню «Справка»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To je celá prehliadka! Spustite ju znova kedykoľvek tlačidlom Rýchly štart alebo z ponuky Pomocník."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var rundturen! Starta den igen när du vill med knappen Snabbstartsguide eller från Hjälp-menyn."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จบทัวร์แล้ว! เริ่มใหม่ได้ทุกเมื่อจากปุ่มคู่มือเริ่มต้นอย่างรวดเร็วหรือเมนูวิธีใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tur bu kadar! İstediğiniz zaman Hızlı Başlangıç Kılavuzu düğmesinden veya Yardım menüsünden yeniden başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ось і весь огляд! Запустіть його знову будь-коли кнопкою «Посібник швидкого старту» або з меню «Довідка»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyến tham quan đến đây là hết! Bắt đầu lại bất cứ lúc nào từ nút Hướng dẫn bắt đầu nhanh hoặc menu Trợ giúp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导览结束了！随时可以从“快速入门指南”按钮或“帮助”菜单重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "導覽結束了！隨時可以從「快速入門指南」按鈕或「說明」選單重新開始。"
          }
        }
      }
    },
