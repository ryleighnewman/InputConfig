        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi điều khiển ở đúng vị trí của nó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个控件都在其所在的位置"
