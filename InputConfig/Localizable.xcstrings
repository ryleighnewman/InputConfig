          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig non riesce a leggere questo file preset. Potrebbe provenire da una versione più recente: aggiorna InputConfig oppure richiedi di nuovo il file."
          }
        },
        "ja" : {
          "stringUnit" : {
