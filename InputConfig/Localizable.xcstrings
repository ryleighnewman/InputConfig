    "Stopped by the controller hold. Hold it again to start the preset back up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقفه ضغط ذراع التحكم. اضغط مجددًا لبدء الإعداد المسبق من جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaveno podržením na ovladači. Dalším podržením předvolbu znovu spustíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppet af controllerens hold. Hold den nede igen for at starte forudindstillingen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Halten am Controller gestoppt. Halte erneut, um das Preset wieder zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido por la pulsación larga del mando. Mantenla de nuevo para volver a iniciar el preajuste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysäytetty ohjaimen pidolla. Pidä sitä uudelleen käynnistääksesi esiasetuksen takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté par le maintien sur la manette. Maintenez-le à nouveau pour redémarrer le préréglage."
