    "Trigger feel: click L2 or R2 in the Live Visualizer of a DualSense or DualSense Edge for light, medium or firm resistance" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إحساس الزناد: انقر L2 أو R2 في المصوِّر المباشر لوحدة DualSense أو DualSense Edge لمقاومة خفيفة أو متوسطة أو صلبة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpor spouště: klikněte na L2 nebo R2 v živém vizualizéru DualSense nebo DualSense Edge pro lehký, střední nebo tuhý odpor"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triggerfølelse: klik på L2 eller R2 i Live-visualiseringen af en DualSense eller DualSense Edge for let, mellem eller fast modstand"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triggergefühl: L2 oder R2 im Live-Visualizer eines DualSense oder DualSense Edge anklicken für leichten, mittleren oder festen Widerstand"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tacto de los gatillos: haz clic en L2 o R2 en el visualizador en vivo de un DualSense o DualSense Edge para una resistencia ligera, media o firme"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liipaisimen tuntuma: napsauta L2:ta tai R2:ta DualSensen tai DualSense Edgen Live-visualisoijassa kevyttä, keskitason tai jäykkää vastusta varten"
