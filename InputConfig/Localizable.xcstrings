        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regioni del cursore e dello stick: attivano assegnazioni quando il puntatore o uno stick entra in una regione che disegni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソル領域とスティック領域: ポインタまたはスティックが描画した領域に入ると、バインディングを実行します"
          }
        },
        "ko" : {
          "stringUnit" : {
