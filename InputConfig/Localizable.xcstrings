    "The trigger deadzone bar is see-through, so the red inner-deadzone band stays visible while you pull the trigger" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريط المنطقة الميتة للزناد شفاف، فيبقى نطاق المنطقة الميتة الداخلية الأحمر مرئيًا أثناء سحب الزناد"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruh mrtvé zóny spouště je průhledný, takže červené pásmo vnitřní mrtvé zóny zůstává viditelné, zatímco spoušť stiskáváte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dødzonelinjen for triggeren er gennemsigtig, så det røde bånd for den indre dødzone forbliver synligt, mens du trækker i triggeren"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Totzonenleiste des Triggers ist durchsichtig, sodass das rote Band der inneren Totzone sichtbar bleibt, während du den Trigger ziehst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de zona muerta del gatillo es translúcida, para que la banda roja de zona muerta interior siga visible mientras pulsas el gatillo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liipaisimen kuolleen alueen palkki on läpinäkyvä, joten punainen sisemmän kuolleen alueen kaista pysyy näkyvissä liipaisinta vedettäessä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de zone morte de la gâchette est transparente, donc la bande rouge de zone morte intérieure reste visible pendant que vous tirez la gâchette"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סרגל האזור המת של ההדק שקוף, כך שהפס האדום של האזור המת הפנימי נשאר גלוי בזמן שמושכים את ההדק"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ravasz holttér-sávja átlátszó, így a piros belső holttér-sáv látható marad a ravasz meghúzása közben"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bar zona mati pemicu transparan, sehingga pita zona mati dalam yang merah tetap terlihat saat Anda menarik pemicu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra della zona morta del grilletto è trasparente, così la fascia rossa della zona morta interna resta visibile mentre tiri il grilletto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トリガのデッドゾーンバーが透明になり、トリガを引いている間も、赤い内側のデッドゾーンの帯が見えるようになりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트리거 데드존 막대가 투명해져서 트리거를 당기는 동안에도 빨간 내부 데드존 띠가 계속 보임"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dødsonelinjen for avtrekkeren er gjennomsiktig, så det røde indre dødsonebåndet forblir synlig mens du trekker avtrekkeren"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De balk voor de dode zone van de trigger is doorzichtig, zodat de rode band van de binnenste dode zone zichtbaar blijft terwijl je de trigger intrekt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasek martwej strefy spustu jest przezroczysty, więc czerwone pasmo wewnętrznej martwej strefy pozostaje widoczne podczas pociągania spustu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A barra da zona morta do gatilho é transparente, então a faixa vermelha da zona morta interna continua visível enquanto você puxa o gatilho"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полоса мёртвой зоны триггера прозрачна, поэтому красная полоса внутренней мёртвой зоны остаётся видна, пока вы нажимаете триггер"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruh mŕtvej zóny spúšte je priehľadný, takže červené pásmo vnútornej mŕtvej zóny zostáva viditeľné, kým spúšť stláčate"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stapeln för dödzon på avtryckaren är genomskinlig, så att det röda bandet för inre dödzon förblir synligt medan du drar i avtryckaren"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถบเดดโซนของทริกเกอร์โปร่งใส เพื่อให้แถบเดดโซนด้านในสีแดงมองเห็นได้ขณะดึงทริกเกอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetik ölü bölge çubuğu saydamdır; böylece tetiği çekerken kırmızı iç ölü bölge bandı görünür kalır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смуга мертвої зони тригера прозора, тож червона смуга внутрішньої мертвої зони залишається видимою, поки ви натискаєте тригер"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanh vùng chết của cò trong suốt, nên dải vùng chết trong màu đỏ vẫn hiện khi bạn kéo cò"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扳机死区条是透明的，因此拉动扳机时红色的内死区带保持可见"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扳機死區條是透明的，因此在你拉動扳機時，紅色的內側死區帶仍然可見"
          }
        }
      }
    },
