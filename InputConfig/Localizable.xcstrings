    "Got a preset file from a friend? Import it with this button, and check it over before it's added." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلك ملف إعداد مسبق من صديق؟ استورده بهذا الزر وراجعه قبل إضافته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostali jste soubor s předvolbou od kamaráda? Importujte ho tímto tlačítkem a prohlédněte si ho, než se přidá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du fået en forudindstillingsfil af en ven? Importér den med denne knap, og se den igennem, før den tilføjes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Preset-Datei von einer Freundin oder einem Freund bekommen? Importier sie mit dieser Taste und sieh sie dir an, bevor sie hinzugefügt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te han pasado un archivo de preajuste? Impórtalo con este botón y revísalo antes de que se añada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saitko esiasetustiedoston ystävältä? Tuo se tällä painikkeella ja katso se läpi ennen kuin se lisätään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ami vous a envoyé un fichier de préréglage ? Importez-le avec ce bouton, et vérifiez-le avant qu'il soit ajouté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קיבלתם קובץ פריסט מחבר? ייבאו אותו בכפתור הזה ובדקו אותו לפני שהוא נוסף."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaptál egy előbeállítás-fájlt egy barátodtól? Importáld ezzel a gombbal, és nézd át, mielőtt hozzáadódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat file preset dari teman? Impor dengan tombol ini, dan periksa dulu sebelum ditambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un amico ti ha mandato un file di preset? Importalo con questo pulsante e controllalo prima che venga aggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちからプリセットのファイルをもらったら、このボタンで読み込み、追加する前に中身を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구에게 프리셋 파일을 받았나요? 이 버튼으로 가져오고, 추가되기 전에 살펴보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fått en forhåndsinnstillingsfil fra en venn? Importer den med denne knappen, og se gjennom den før den legges til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een presetbestand van een vriend gekregen? Importeer het met deze knop en bekijk het voordat het wordt toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostałeś plik presetu od znajomego? Zaimportuj go tym przyciskiem i przejrzyj, zanim zostanie dodany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
