          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logitech G920 a G923 pro Xbox se zobrazují ve stavovém řádku, Nastavení, nabídce Zařízení a ve všech výběrech ovladačů, s vlastními názvy tlačítek a rychlostmi řadicí páky"
