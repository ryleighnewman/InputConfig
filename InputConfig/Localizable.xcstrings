    "You imported this preset and have not started it before. " : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استوردت هذا الإعداد المسبق ولم تشغّله من قبل. "
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto předvolbu jste importovali a dosud jste ji nespustili. "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du importerede denne forudindstilling og har ikke startet den før. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dieses Preset importiert und noch nicht gestartet. "
