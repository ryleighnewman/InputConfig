    "Disconnect a controller from its entry at the top of the sidebar, or switch it off from its Live Visualizer panel so it reads as idle everywhere, remembered for that controller" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افصل ذراع تحكم من مدخله أعلى الشريط الجانبي، أو أوقفه من لوحته في العارض المباشر ليظهر خاملًا في كل مكان، ويُتذكَّر ذلك لذراع التحكم هذا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpojte ovladač z jeho položky nahoře v postranním panelu, nebo ho vypněte z panelu Živého vizualizéru, aby se všude jevil jako nečinný, což se pro daný ovladač zapamatuje"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbryd forbindelsen til en controller fra dens post øverst i indholdsoversigten, eller slå den fra i dens Live-visualiseringspanel, så den læses som inaktiv overalt, og det huskes for den controller"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenne einen Controller über seinen Eintrag oben in der Seitenleiste oder schalte ihn in seinem Bereich der Live-Visualisierung aus, sodass er überall als inaktiv erscheint; dies wird für diesen Controller gemerkt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconecta un mando desde su entrada en la parte superior de la barra lateral, o apágalo desde su panel del Visualizador en vivo para que se lea como inactivo en todas partes, y se recuerda para ese mando"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katkaise ohjaimen yhteys sen merkinnästä sivupalkin yläreunassa tai kytke se pois sen Live-visualisoinnin paneelista, jolloin se luetaan joutilaaksi kaikkialla, ja valinta muistetaan kyseiselle ohjaimelle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnectez une manette depuis son entrée en haut de la barre latérale, ou désactivez-la depuis son panneau du Visualiseur en direct pour qu’elle soit considérée comme inactive partout, avec ce choix mémorisé pour cette manette"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נתק שלט מהרשומה שלו בראש סרגל הצד, או כבה אותו מחלונית המציג החי שלו כך שייקרא כלא פעיל בכל מקום, וזה נזכר עבור אותו שלט"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon le egy vezérlőt az oldalsáv tetején lévő bejegyzéséről, vagy kapcsolja ki az Élő vizualizáló paneljén, hogy mindenhol tétlenként jelenjen meg, ennek a vezérlőnek megjegyezve"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putuskan koneksi pengontrol dari entrinya di bagian atas bar samping, atau matikan dari panel Visualizer Langsungnya agar terbaca diam di mana-mana, diingat untuk pengontrol itu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnetti un controller dalla sua voce in cima alla barra laterale, oppure spegnilo dal pannello del Visualizzatore dal vivo in modo che risulti inattivo ovunque, con la scelta ricordata per quel controller"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバー上部のコントローラの項目から接続を解除するか、ライブビジュアライザのパネルからオフにすると、どこでもアイドル状態として扱われます。この設定はコントローラごとに記憶されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사이드바 상단의 컨트롤러 항목에서 연결을 해제하거나, 실시간 비주얼라이저 패널에서 끄면 모든 곳에서 유휴 상태로 읽히며 해당 컨트롤러에 대해 기억됨"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble fra en kontroller fra oppføringen øverst i sidepanelet, eller slå den av fra Live-visualiseringspanelet slik at den leses som inaktiv overalt, husket for den kontrolleren"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel een controller los via zijn onderdeel bovenaan de navigatiekolom, of schakel hem uit in het paneel van de Live-visualizer zodat hij overal als inactief wordt gelezen, onthouden voor die controller"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozłącz kontroler z jego wpisu na górze paska bocznego albo wyłącz go z jego panelu Wizualizatora na żywo, aby wszędzie był odczytywany jako bezczynny, co jest zapamiętywane dla tego kontrolera"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconecte um controle a partir da entrada dele no topo da barra lateral, ou desligue-o no painel do Visualizador ao vivo para que ele apareça como inativo em todo lugar, lembrado para aquele controle"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключите контроллер в его записи вверху боковой панели или выключите его на панели «Живого визуализатора», чтобы везде он отображался как неактивный; выбор запоминается для этого контроллера"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpojte ovládač z jeho položky v hornej časti bočného panela alebo ho vypnite z jeho panela v Živom vizualizéri, aby všade vyzeral ako nečinný, s uložením pre daný ovládač"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppla från en spelkontroll från dess post överst i sidofältet, eller stäng av den från dess panel i Live-visualiseraren så att den läses som overksam överallt, och det kommer ihåg för den spelkontrollen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัดการเชื่อมต่อคอนโทรลเลอร์จากรายการของมันที่ด้านบนของแถบด้านข้าง หรือปิดจากแผงตัวแสดงภาพสดเพื่อให้ถือว่าไม่ได้ใช้งานทุกที่ โดยจำไว้สำหรับคอนโทรลเลอร์นั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kumandanın bağlantısını kenar çubuğunun üstündeki girişinden kesin ya da Canlı Görselleştirici panelinden kapatın; böylece her yerde boşta okunur ve o kumanda için hatırlanır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відключіть контролер із його запису вгорі бічної панелі або вимкніть його на панелі «Візуалізатора наживо», щоб він скрізь вважався неактивним; це запам’ятовується для цього контролера"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngắt kết nối bộ điều khiển từ mục của nó ở đầu thanh bên, hoặc tắt nó từ bảng Trình hiển thị trực tiếp để nó được coi là nhàn rỗi ở mọi nơi, và được ghi nhớ cho bộ điều khiển đó"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从边栏顶部的条目断开控制器的连接，或在其实时可视化器面板中将其关闭，使其在所有位置都显示为空闲，并为该控制器记住此设置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從側邊欄頂端的項目中斷控制器的連線，或在其即時視覺化工具面板中將它關閉，讓它在各處都顯示為閒置，並為該控制器記住此設定"
          }
        }
      }
    },
