          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här korta rundturen visar dig runt. Delar av appen lyser upp under tiden. Klicka på Nästa för att börja."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทัวร์สั้น ๆ นี้จะพาคุณดูรอบแอป ส่วนต่าง ๆ ของแอปจะสว่างขึ้นระหว่างทาง คลิกถัดไปเพื่อเริ่ม"
