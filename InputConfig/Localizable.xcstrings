    "In the red band nothing happens, so a light rest on the control is ignored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "داخل الشريط الأحمر لا يحدث شيء، لذا يُتجاهل الضغط الخفيف على عنصر التحكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V červeném pásu se nic neděje, takže lehké položení prstu na ovladač se ignoruje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det røde bånd sker der intet, så en let berøring af kontrollen ignoreres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im roten Band passiert nichts, sodass ein leichtes Auflegen auf das Bedienelement ignoriert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la banda roja no pasa nada, así que se ignora un toque ligero sobre el control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punaisella kaistalla mitään ei tapahdu, joten kevyt kosketus ohjaukseen ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans la bande rouge, rien ne se passe : un léger appui sur la commande est ignoré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ברצועה האדומה לא קורה דבר, כך שהמערכת מתעלמת מנגיעה קלה בפקד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A piros sávban nem történik semmi, így a vezérlő enyhe érintését figyelmen kívül hagyja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di pita merah tidak terjadi apa pun, jadi sentuhan ringan pada kontrol diabaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella banda rossa non succede nulla, quindi un tocco leggero sul comando viene ignorato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赤い帯の中では何も起きないため、コントロールに軽く触れただけでは無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빨간 띠 안에서는 아무 일도 일어나지 않으므로, 컨트롤을 살짝 건드린 것은 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det røde båndet skjer ingenting, så en lett berøring av kontrollen ignoreres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In de rode band gebeurt niets, dus een lichte aanraking van de bediening wordt genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W czerwonym pasie nic się nie dzieje, więc lekki dotyk sterowania jest ignorowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na faixa vermelha nada acontece, então um toque leve no controle é ignorado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В красной полосе ничего не происходит, поэтому лёгкое касание элемента управления игнорируется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V červenom páse sa nič nedeje, takže ľahké položenie prsta na ovládač sa ignoruje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det röda bandet händer ingenting, så en lätt beröring av kontrollen ignoreras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในแถบสีแดงจะไม่มีอะไรเกิดขึ้น จึงไม่สนใจการแตะตัวควบคุมเบาๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kırmızı şeritte hiçbir şey olmaz; böylece kontrole hafifçe dokunmak yok sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У червоній смузі нічого не відбувається, тому легкий дотик до елемента керування ігнорується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong dải đỏ không có gì xảy ra, nên một cú chạm nhẹ vào điều khiển sẽ bị bỏ qua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在红色区段内不会发生任何事，因此轻触控件会被忽略。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在紅色區段內不會發生任何事，因此輕觸控制項會被忽略。"
          }
        }
      }
    },
    "In this mode the controller reports as an Xbox 360 pad, which sends no gyro or touchpad. If it has a PlayStation or Switch mode, switch to that to insert them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في هذا الوضع يُعرّف ذراع التحكم نفسه كذراع Xbox 360، الذي لا يرسل جيروسكوبًا ولا لوحة لمس. إن كان له وضع PlayStation أو Switch، فانتقل إليه لإدراجهما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto režimu se ovladač hlásí jako Xbox 360, který neposílá gyroskop ani touchpad. Pokud má režim PlayStation nebo Switch, přepněte do něj, abyste je mohli vložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I denne tilstand melder controlleren sig som en Xbox 360-controller, der hverken sender gyro eller touchpad. Har den en PlayStation- eller Switch-tilstand, så skift til den for at indsætte dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Modus meldet sich der Controller als Xbox 360 Controller, der weder Gyro noch Touchpad sendet. Hat er einen PlayStation- oder Switch-Modus, wechsle in diesen, um sie einzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este modo, el mando se presenta como un mando de Xbox 360, que no envía giroscopio ni panel táctil. Si tiene un modo PlayStation o Switch, cámbialo a ese para insertarlos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tässä tilassa ohjain ilmoittaa olevansa Xbox 360 -ohjain, joka ei lähetä gyroa eikä kosketuslevyä. Jos siinä on PlayStation- tai Switch-tila, vaihda siihen lisätäksesi ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans ce mode, la manette se présente comme une manette Xbox 360, qui n’envoie ni gyroscope ni pavé tactile. Si elle a un mode PlayStation ou Switch, passez-y pour les insérer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במצב הזה הבקר מזדהה כבקר Xbox 360, שלא שולח ג׳יירו או משטח מגע. אם יש לו מצב PlayStation או Switch, עבור אליו כדי להוסיף אותם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben a módban a vezérlő Xbox 360-vezérlőként jelentkezik, amely nem küld giroszkópot és érintőpadot. Ha van PlayStation vagy Switch módja, váltson arra a beszúrásukhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dalam mode ini pengontrol melapor sebagai pengontrol Xbox 360, yang tidak mengirim giro maupun touchpad. Jika punya mode PlayStation atau Switch, beralihlah ke mode itu untuk menyisipkannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questa modalità il controller si presenta come un controller Xbox 360, che non invia giroscopio né touchpad. Se ha una modalità PlayStation o Switch, passa a quella per inserirli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモードでは、コントローラはXbox 360コントローラとして認識され、ジャイロもタッチパッドも送りません。PlayStationモードやSwitchモードがある場合は、そちらに切り替えると挿入できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모드에서는 컨트롤러가 Xbox 360 컨트롤러로 인식되며, 자이로와 터치패드를 보내지 않습니다. PlayStation 모드나 Switch 모드가 있다면 그 모드로 바꾸면 넣을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I denne modusen melder kontrolleren seg som en Xbox 360-kontroller, som verken sender gyro eller berøringsflate. Har den en PlayStation- eller Switch-modus, bytt til den for å sette dem inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deze modus meldt de controller zich als een Xbox 360-controller, die geen gyro of touchpad stuurt. Heeft hij een PlayStation- of Switch-modus, schakel daarnaar om ze in te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym trybie kontroler zgłasza się jako kontroler Xbox 360, który nie wysyła żyroskopu ani gładzika. Jeśli ma tryb PlayStation lub Switch, przełącz się na niego, aby je wstawić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste modo, o controle se apresenta como um controle de Xbox 360, que não envia giroscópio nem touchpad. Se ele tiver um modo PlayStation ou Switch, mude para ele para inseri-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом режиме контроллер определяется как контроллер Xbox 360, который не передаёт гироскоп и тачпад. Если у него есть режим PlayStation или Switch, переключитесь на него, чтобы вставить их."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto režime sa ovládač hlási ako Xbox 360, ktorý neposiela gyroskop ani touchpad. Ak má režim PlayStation alebo Switch, prepnite doň, aby ste ich mohli vložiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I det här läget anger sig kontrollen som en Xbox 360-kontroll, som varken skickar gyro eller pekplatta. Har den ett PlayStation- eller Switch-läge, byt till det för att infoga dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในโหมดนี้คอนโทรลเลอร์รายงานตัวเป็นคอนโทรลเลอร์ Xbox 360 ซึ่งไม่ส่งไจโรหรือทัชแพด หากมีโหมด PlayStation หรือ Switch ให้สลับไปโหมดนั้นเพื่อแทรก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu modda kumanda kendini Xbox 360 kumandası olarak bildirir; bu da jiroskop ya da dokunmatik yüzey göndermez. PlayStation veya Switch modu varsa, bunları eklemek için o moda geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому режимі контролер визначається як контролер Xbox 360, який не передає гіроскоп і сенсорну панель. Якщо в нього є режим PlayStation або Switch, перемкніться на нього, щоб вставити їх."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở chế độ này, tay cầm báo là tay cầm Xbox 360, loại không gửi con quay hay bàn di cảm ứng. Nếu nó có chế độ PlayStation hoặc Switch, hãy chuyển sang chế độ đó để chèn chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此模式下，控制器会被识别为 Xbox 360 控制器，不发送陀螺仪和触摸板数据。如果它有 PlayStation 或 Switch 模式，请切换到该模式以插入它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此模式下，控制器會被識別為 Xbox 360 控制器，不傳送陀螺儀和觸控板資料。如果它有 PlayStation 或 Switch 模式，請切換到該模式以插入它們。"
          }
        }
      }
    },
    "In Trackpad & Mouse and Keyboard & Mouse Input, the side buttons send Command [ and ] and no longer also go Back on their own" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في Trackpad & Mouse وKeyboard & Mouse Input، ترسل الأزرار الجانبية Command [ و] ولم تعد ترجع من تلقاء نفسها أيضًا"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Trackpad & Mouse a Keyboard & Mouse Input posílají boční tlačítka Command [ a ] a už samy neposílají také Zpět"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Trackpad & Mouse og Keyboard & Mouse Input sender sideknapperne Command [ og ] og går ikke længere også tilbage af sig selv"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In „Trackpad & Mouse“ und „Keyboard & Mouse Input“ senden die Seitentasten Befehlstaste-[ und -] und lösen nicht mehr zusätzlich von selbst „Zurück“ aus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Trackpad y ratón y en Entrada de teclado y ratón, los botones laterales envían Comando [ y ], y ya no hacen también Atrás por sí solos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trackpad & Mouse- ja Keyboard & Mouse Input -esiasetuksissa sivupainikkeet lähettävät Komento [ ja ] eivätkä enää samalla toimi itsekseen Takaisin-painikkeena"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Trackpad et souris et Entrée clavier et souris, les boutons latéraux envoient Commande [ et ] et ne font plus aussi Retour de leur côté"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב״משטח מגע ועכבר״ וב״קלט מקלדת ועכבר״, לחצני הצד שולחים Command [ ו-] ולא חוזרים אחורה גם בעצמם"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Trackpad & Mouse és a Keyboard & Mouse Input előbeállításban az oldalsó gombok Command [ és ] billentyűparancsot küldenek, és már nem lépnek külön Vissza műveletet is"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Trackpad & Tetikus dan Papan Ketik & Input Tetikus, tombol samping mengirim Command [ dan ] dan tidak lagi juga kembali dengan sendirinya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Trackpad & Mouse e Keyboard & Mouse Input, i pulsanti laterali inviano Comando [ e ] e non eseguono più anche Indietro da soli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trackpad & MouseとKeyboard & Mouse Inputでは、サイドボタンがCommand [ と ] を送信し、単独で「戻る」にもならなくなりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trackpad & Mouse와 Keyboard & Mouse Input에서 측면 버튼이 Command [ 및 ]를 보내며, 더 이상 단독으로 뒤로 가기도 하지 않음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Trackpad & Mouse og Keyboard & Mouse Input sender sideknappene Kommando [ og ] og går ikke lenger også Tilbake på egen hånd"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Trackpad & Mouse en Keyboard & Mouse Input sturen de zijknoppen Command [ en ] en gaan ze niet meer ook zelf Terug"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W Trackpad & Mouse i Keyboard & Mouse Input przyciski boczne wysyłają Command [ i ] i nie cofają już dodatkowo same z siebie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Trackpad & Mouse e Keyboard & Mouse Input, os botões laterais enviam Command [ e ] e não voltam mais por conta própria"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Trackpad & Mouse и Keyboard & Mouse Input боковые кнопки отправляют Command [ и ] и больше не вызывают «Назад» сами по себе"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V Trackpad & Mouse a Keyboard & Mouse Input bočné tlačidlá posielajú Command [ a ] a už samy navyše nefungujú ako Späť"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Trackpad & Mouse och Keyboard & Mouse Input skickar sidoknapparna Kommando [ och ] och går inte längre också Bakåt på egen hand"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใน Trackpad & Mouse และ Keyboard & Mouse Input ปุ่มด้านข้างส่ง Command [ และ ] และไม่ย้อนกลับเองอีกต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleme Dörtgeni ve Fare ile Klavye ve Fare Girişi ön ayarlarında yan düğmeler Command [ ve ] gönderir ve artık kendi başlarına Geri de yapmaz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У «Trackpad & Mouse» та «Keyboard & Mouse Input» бічні кнопки надсилають Command [ і ] та більше не виконують окремо ще й «Назад»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong Trackpad & Mouse và Keyboard & Mouse Input, các nút bên gửi Command [ và ] và không còn tự quay lại nữa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“触控板与鼠标”和“键盘与鼠标输入”中，侧键发送 Command [ 和 ]，不再同时自行触发“返回”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「Trackpad & Mouse」和「Keyboard & Mouse Input」中，側邊按鈕會送出 Command-[ 和 Command-]，且不再同時自行執行「返回」"
          }
        }
      }
    },
