          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles draait en blijft op je Mac. Geen telemetrie, geen account, niets wordt geüpload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko działa i pozostaje na Twoim Macu. Bez telemetrii, bez konta, nic nie jest przesyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
