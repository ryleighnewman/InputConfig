        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachte den Stick hier; klicke, um die Vollansicht zu öffnen und die Totzone einzustellen, während du ihn bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa aquí el stick; haz clic para abrir la vista completa y ajustar la zona muerta mientras lo mueves."
