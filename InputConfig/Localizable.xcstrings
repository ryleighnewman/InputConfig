    "Close the editor first, then start the tour." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق المحرر أولًا، ثم ابدأ الجولة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív zavřete editor a pak spusťte prohlídku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luk først editoren, og start derefter introduktionen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe zuerst den Editor und starte dann die Tour."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra primero el editor y luego inicia el tour."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulje ensin editori ja aloita sitten kierros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermez d’abord l’éditeur, puis lancez la visite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סגור קודם את העורך, ואז התחל את הסיור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Előbb zárja be a szerkesztőt, majd indítsa el a bemutatót."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutup editor terlebih dahulu, lalu mulai tur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi prima l’editor, poi avvia il tour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にエディタを閉じてから、ツアーを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 편집기를 닫은 다음 둘러보기를 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukk redigeringen først, og start deretter omvisningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit eerst de editor en start dan de rondleiding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zamknij edytor, potem rozpocznij przewodnik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feche o editor primeiro e depois inicie o tour."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала закройте редактор, затем начните обзор."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv zavrite editor a potom spustite prehliadku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng redigeraren först och starta sedan rundturen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดตัวแก้ไขก่อน แล้วจึงเริ่มทัวร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce düzenleyiciyi kapatın, sonra turu başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу закрийте редактор, потім почніть екскурсію."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đóng trình chỉnh sửa trước, rồi bắt đầu phần tham quan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先关闭编辑器，然后开始导览。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先關閉編輯器，然後開始導覽。"
          }
        }
      }
    },
