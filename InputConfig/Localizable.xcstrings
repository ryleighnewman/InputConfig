    "That push was held out too long to count as a flick." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمرت تلك الدفعة وقتًا طويلًا جدًا فلم تُحتسب نفضة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto vychýlení trvalo příliš dlouho, než aby se počítalo jako švihnutí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det skub blev holdt ude for længe til at tælle som et ryk."
          }
        },
        "de" : {
