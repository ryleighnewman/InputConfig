    "Positioned at %lld percent across, %lld percent down, %lld by %lld percent of the display, %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضعها على بعد %1$lld في المئة أفقيًا و%2$lld في المئة عموديًا، بحجم %3$lld في %4$lld في المئة من الشاشة، %5$@"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umístěno %1$lld procent zleva a %2$lld procent shora, velikost %3$lld × %4$lld procent displeje, %5$@"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeret %1$lld procent henover og %2$lld procent nedad, %3$lld gange %4$lld procent af skærmen, %5$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positioniert bei %1$lld Prozent von links, %2$lld Prozent von oben, %3$lld mal %4$lld Prozent des Displays, %5$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Positioned at %1$lld percent across, %2$lld percent down, %3$lld by %4$lld percent of the display, %5$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Situado al %1$lld por ciento en horizontal y al %2$lld por ciento en vertical, con un tamaño de %3$lld por %4$lld por ciento de la pantalla, %5$@"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijainti %1$lld prosenttia vasemmalta, %2$lld prosenttia ylhäältä, koko %3$lld × %4$lld prosenttia näytöstä, %5$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positionnée à %1$lld pour cent en largeur, %2$lld pour cent en hauteur, %3$lld sur %4$lld pour cent de l’écran, %5$@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממוקם ב-%1$lld אחוז לרוחב, %2$lld אחוז כלפי מטה, %3$lld על %4$lld אחוז מהתצוגה, %5$@"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elhelyezés: %1$lld százalékra balról, %2$lld százalékra felülről, a kijelző %3$lld x %4$lld százaléka, %5$@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diposisikan pada %1$lld persen ke samping, %2$lld persen ke bawah, %3$lld kali %4$lld persen dari layar, %5$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizionata al %1$lld percento in orizzontale e al %2$lld percento in verticale, %3$lld per %4$lld percento del display, %5$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左から%1$lldパーセント、上から%2$lldパーセントの位置、ディスプレイの%3$lld×%4$lldパーセント、%5$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가로 %1$lld퍼센트, 세로 %2$lld퍼센트 위치, 디스플레이의 %3$lld x %4$lld퍼센트 크기, %5$@"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plassert %1$lld prosent bortover, %2$lld prosent nedover, %3$lld ganger %4$lld prosent av skjermen, %5$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplaatst op %1$lld procent van links, %2$lld procent van boven, %3$lld bij %4$lld procent van het beeldscherm, %5$@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Położenie: %1$lld procent w poziomie, %2$lld procent w dół, %3$lld na %4$lld procent wyświetlacza, %5$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posicionado a %1$lld por cento da esquerda, %2$lld por cento do topo, %3$lld por %4$lld por cento da tela, %5$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расположение: %1$lld процентов слева, %2$lld процентов сверху, размер %3$lld на %4$lld процентов дисплея, %5$@"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umiestnené %1$lld percent zľava, %2$lld percent zhora, %3$lld krát %4$lld percent displeja, %5$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placerad %1$lld procent från vänster och %2$lld procent från överkanten, %3$lld gånger %4$lld procent av skärmen, %5$@"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อยู่ที่ %1$lld เปอร์เซ็นต์ไปทางขวา %2$lld เปอร์เซ็นต์ลงมา ขนาด %3$lld คูณ %4$lld เปอร์เซ็นต์ของจอแสดงผล %5$@"
          }
        },
        "tr" : {
          "stringUnit" : {
