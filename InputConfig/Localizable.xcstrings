        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стик в покое на краю мёртвой зоны больше не включается и не выключается в каждом кадре"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páčka v pokoji na okraji svojej mŕtvej zóny už každý snímok necvaká zapnuté a vypnuté"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
