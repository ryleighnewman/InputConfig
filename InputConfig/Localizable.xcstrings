    "Per-preset shortcuts: give any preset its own system-wide key that switches to it, and press it again to stop it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصارات لكل إعداد مسبق: امنح أي إعداد مسبق مفتاحه الخاص على مستوى النظام للتبديل إليه، واضغطه مجددًا لإيقافه"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkratky pro každou předvolbu: dejte libovolné předvolbě vlastní systémovou klávesu, která na ni přepne, a dalším stiskem ji zastavíte"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genveje pr. forudindstilling: giv enhver forudindstilling sin egen systemdækkende tast, der skifter til den, og tryk på den igen for at stoppe den"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle pro Preset: Gib jedem Preset eine eigene systemweite Taste, die zu ihm wechselt, und drücke sie erneut, um es zu stoppen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atajos por preajuste: dale a cualquier preajuste su propia tecla de todo el sistema que cambia a él, y púlsala de nuevo para detenerlo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiasetuskohtaiset oikotiet: anna mille tahansa esiasetukselle oma koko järjestelmän laajuinen näppäin, joka vaihtaa siihen, ja paina sitä uudelleen pysäyttääksesi sen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcis par préréglage : donnez à n’importe quel préréglage sa propre touche système qui bascule vers lui, et appuyez à nouveau pour l’arrêter"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קיצורים לכל פריסט: תן לכל פריסט מקש כלל-מערכתי משלו שעובר אליו, ולחץ עליו שוב כדי לעצור אותו"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Előbeállításonkénti billentyűparancsok: adjon bármely előbeállításnak saját rendszerszintű billentyűt, amely átvált rá, és nyomja meg újra a leállításhoz"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pintasan per preset: beri preset mana pun tombol seluruh sistemnya sendiri yang beralih ke sana, dan tekan lagi untuk menghentikannya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorciatoie per preset: dai a qualsiasi preset il suo tasto valido in tutto il sistema che passa a quel preset, e premilo di nuovo per fermarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットごとのショートカット: 任意のプリセットに、そのプリセットに切り替えるシステム全体のキーを設定でき、もう一度押すと停止します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋별 단축키: 모든 프리셋에 해당 프리셋으로 전환하는 시스템 전체 키를 지정하고, 다시 누르면 중지함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snarveier per forhåndsinnstilling: gi hvilken som helst forhåndsinnstilling sin egen systemomfattende tast som bytter til den, og trykk igjen for å stoppe den"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sneltoetsen per preset: geef elke preset een eigen systeembrede toets die ernaar overschakelt, en druk er nogmaals op om hem te stoppen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skróty dla presetów: nadaj dowolnemu presetowi własny klawisz ogólnosystemowy, który na niego przełącza, i naciśnij go ponownie, aby go zatrzymać"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atalhos por preset: dê a qualquer preset sua própria tecla de todo o sistema que muda para ele, e pressione-a de novo para pará-lo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетания для каждого пресета: дайте любому пресету собственную системную клавишу, которая переключает на него, и нажмите её снова, чтобы остановить"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skratky pre každú predvoľbu: dajte ľubovoľnej predvoľbe vlastný celosystémový kláves, ktorý na ňu prepne, a opätovným stlačením ju zastavíte"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genvägar per förinställning: ge vilken förinställning som helst sin egen systemövergripande tangent som växlar till den, och tryck igen för att stoppa den"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แป้นพิมพ์ลัดต่อพรีเซ็ต: ให้พรีเซ็ตใดก็ได้มีแป้นทั่วทั้งระบบของตัวเองที่สลับมาที่มัน และกดอีกครั้งเพื่อหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ön ayar başına kısayollar: herhangi bir ön ayara kendisine geçen, sistem genelinde bir tuş verin ve durdurmak için yeniden basın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорочення для кожного пресета: надайте будь-якому пресету власну системну клавішу, яка перемикає на нього, а повторне натискання зупиняє його"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phím tắt theo từng cài đặt sẵn: gán cho bất kỳ cài đặt sẵn nào một phím toàn hệ thống riêng để chuyển sang nó, và nhấn lần nữa để dừng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个预设的快捷键：为任何预设设置自己的全系统按键来切换到它，再按一次即可停止"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各預設的快速鍵：為任何預設指定專屬的全系統按鍵來切換到它，再按一次即可停止"
          }
        }
      }
    },
