        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regiões do cursor e regiões do stick: disparam mapeamentos quando o ponteiro ou um stick entra em uma região que você desenha"
          }
        },
        "ru" : {
          "stringUnit" : {
