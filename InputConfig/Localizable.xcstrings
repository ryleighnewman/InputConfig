          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MIDI agora funciona sem nenhum controle de jogo conectado, então um teclado ou controlador de pads MIDI pode controlar o seu Mac sozinho"
          }
        },
        "ru" : {
          "stringUnit" : {
