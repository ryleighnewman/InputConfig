        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vodorovne je tak, ako ho držíte, nová voľba pre riadky naklonenia a ukazovateľa, meria naklonenie od vášho úchopu namiesto od polohy naplocho"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vågrätt är så som du håller den, ett nytt alternativ för lutnings- och pekarrader, mäter lutningen från ditt grepp i stället för från plant läge"
