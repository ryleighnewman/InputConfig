        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ aktiverar redan ”%2$@”. Ge den förinställningen en annan genväg först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ เปิดใช้งาน “%2$@” อยู่แล้ว ให้กำหนดแป้นพิมพ์ลัดอื่นให้พรีเซ็ตนั้นก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zaten “%2$@” öğesini etkinleştiriyor. Önce o ön ayara başka bir kısayol verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ уже активує «%2$@». Спершу призначте цьому пресету інше скорочення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đã kích hoạt “%2$@”. Hãy gán phím tắt khác cho cài đặt sẵn đó trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已用于启用“%2$@”。请先为该预设设置其他快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已用於啟用「%2$@」。請先為該預設指定其他快速鍵。"
          }
        }
      }
    },
    "%@ already turns the last preset on and off. Choose another chord." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ يشغّل آخر إعداد مسبق ويوقفه بالفعل. اختر تركيبة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už zapíná a vypíná poslední předvolbu. Zvolte jinou kombinaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slår allerede den seneste forudindstilling til og fra. Vælg en anden tastekombination."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schaltet bereits das zuletzt verwendete Preset ein und aus. Wähle eine andere Tastenkombination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya activa y desactiva el último preajuste. Elige otra combinación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kytkee jo viimeisen esiasetuksen päälle ja pois. Valitse toinen yhdistelmä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ active et désactive déjà le dernier préréglage. Choisissez une autre combinaison."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ כבר מפעיל וכבה את הפריסט האחרון. בחר צירוף מקשים אחר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ már be- és kikapcsolja az utolsó előbeállítást. Válasszon másik billentyűkombinációt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah menyalakan dan mematikan preset terakhir. Pilih kombinasi tombol lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ attiva e disattiva già l’ultimo preset. Scegli un’altra combinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすでに直前のプリセットのオン/オフに使われています。別のキーの組み合わせを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 조합이 이미 마지막 프리셋을 켜고 끄는 데 사용 중입니다. 다른 키 조합을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slår allerede den siste forhåndsinnstillingen av og på. Velg en annen tastekombinasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schakelt de laatste preset al in en uit. Kies een andere toetscombinatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ już włącza i wyłącza ostatni preset. Wybierz inną kombinację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já liga e desliga o último preset. Escolha outra combinação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже включает и выключает последний пресет. Выберите другое сочетание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ už zapína a vypína poslednú predvoľbu. Vyberte inú kombináciu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ slår redan på och av den senaste förinställningen. Välj en annan tangentkombination."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ เปิดและปิดพรีเซ็ตล่าสุดอยู่แล้ว เลือกชุดแป้นอื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
