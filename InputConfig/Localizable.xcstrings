    "These apply to every preset while it runs, but not over InputConfig, the Finder or System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبَّق هذه على كل إعداد مسبق أثناء تشغيله، لكن ليس فوق InputConfig أو Finder أو إعدادات النظام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí pro každou předvolbu, dokud běží, ale ne nad InputConfig, Finderem ani Nastavením systému."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse gælder for alle forudindstillinger, mens de kører, men ikke oven på InputConfig, Finder eller Systemindstillinger."
