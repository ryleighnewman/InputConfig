    "The Live Visualizer lights the D-pad key line and the 8BitDo Micro's D-pad, and shows the latest MIDI pitch bend and program change" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيء العارض المباشر خط مفتاح لوحة الاتجاهات ولوحة اتجاهات 8BitDo Micro، ويعرض أحدث ثني نغمة MIDI وتغيير برنامج"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živý vizualizér rozsvítí linku klávesy směrového kříže a směrový kříž 8BitDo Micro a ukazuje poslední ohyb výšky MIDI a změnu programu"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Visualizer lyser D-pad-tastlinjen og 8BitDo Micros D-pad op og viser den seneste MIDI-pitchbend og programskift"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Live-Visualizer lässt die Tastenlinie des Steuerkreuzes und das Steuerkreuz des 8BitDo Micro leuchten und zeigt die letzte MIDI-Tonhöhenbeugung und den letzten Programmwechsel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El visualizador en vivo ilumina la línea de tecla de la cruceta y la cruceta del 8BitDo Micro, y muestra el último pitch bend y cambio de programa MIDI"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Visualizer valaisee ristiohjaimen näppäinviivan ja 8BitDo Micron ristiohjaimen sekä näyttää viimeisimmän MIDI-sävelkorkeuden taivutuksen ja ohjelmanvaihdon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le visualiseur en direct allume la ligne de touche de la croix directionnelle et la croix du 8BitDo Micro, et affiche le dernier pitch bend et changement de programme MIDI"
