    "Choose how long Scan waits, up to until canceled, and hear when it times out" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر المدة التي ينتظرها الفحص، حتى الإلغاء، واسمع صوتًا عند انتهاء المهلة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak dlouho Skenovat čeká, až do zrušení, a uslyšíte, když vyprší čas"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvor længe Scan venter, op til indtil den annulleres, og hør, når tiden løber ud"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wie lange der Scan wartet, bis hin zu „bis zum Abbrechen“, und höre, wann er abläuft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuánto espera Escanear, hasta que se cancele, y oye cuando se agota el tiempo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse, kuinka kauan Skannaus odottaa, aina peruutukseen asti, ja kuule, kun aika loppuu"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez combien de temps Scanner attend, jusqu’à l’annulation, et entendez quand le délai expire"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר כמה זמן הסריקה ממתינה, עד לביטול, ושמע כשהזמן נגמר"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassza ki, mennyi ideig vár a Beolvasás, a megszakításig is, és hallja, amikor lejár az idő"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih berapa lama Pindai menunggu, hingga dibatalkan, dan dengar saat waktunya habis"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli per quanto tempo attende Scansiona, fino all’annullamento, e ascolta quando scade il tempo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンの待機時間を（キャンセルするまで続く設定を含めて）選べ、タイムアウトしたときは音で通知します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔 대기 시간을 취소할 때까지로 길게 지정할 수 있고, 시간이 초과되면 소리로 알려 줌"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hvor lenge Skann venter, opptil til den avbrytes, og hør når tiden går ut"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoe lang Scan wacht, tot hij wordt geannuleerd, en hoor wanneer de tijd om is"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, jak długo Skanuj czeka, aż do anulowania, i usłysz, gdy czas minie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha por quanto tempo o Escanear espera, até ser cancelado, e ouça quando o tempo se esgotar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, как долго ждёт сканирование, вплоть до отмены вручную, и услышите сигнал, когда время истечёт"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, ako dlho Skenovať čaká, až do zrušenia, a počujte, keď vyprší čas"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj hur länge Skanna väntar, upp till tills du avbryter, och hör när tiden går ut"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกระยะเวลาที่สแกนรอ สูงสุดจนกว่าจะยกเลิก และได้ยินเสียงเมื่อหมดเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taramanın ne kadar bekleyeceğini, iptal edilene kadar bile, seçin ve zaman aşımına uğradığında duyun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть, як довго чекає сканування, аж до скасування, і почуйте сигнал, коли час вичерпається"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn thời gian Quét chờ, tối đa đến khi bị hủy, và nghe thông báo khi hết thời gian"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取扫描等待多久（最长可到取消为止），并在超时时听到提示"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇「掃描」要等待多久，最長可到取消為止，並在逾時時聽到提示"
          }
        }
      }
    },
