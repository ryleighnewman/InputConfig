    "Triple tap: a row can do something else on three quick taps, beside its hold and double tap actions" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقر الثلاثي: يمكن للصف أن يفعل شيئًا آخر عند ثلاث نقرات سريعة، إلى جانب إجراءي الضغط المطوّل والنقر المزدوج"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trojitý stisk: řádek může při třech rychlých stiscích udělat něco jiného, vedle akcí podržení a dvojitého stisku"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tredobbelt tryk: en række kan gøre noget andet ved tre hurtige tryk, ved siden af sine hold- og dobbelttrykhandlinger"
