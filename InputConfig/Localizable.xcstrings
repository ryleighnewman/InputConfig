    "Picks a key to fire while this region is active. The binding is added to the current preset." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختار مفتاحًا يُطلق أثناء نشاط هذه المنطقة. يُضاف الربط إلى الإعداد المسبق الحالي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vybere klávesu, která se spustí, dokud je tato oblast aktivní. Přiřazení se přidá do aktuální předvolby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælger en tast, der skal udløses, mens dette område er aktivt. Tildelingen føjes til den aktuelle forudindstilling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt eine Taste, die ausgelöst wird, solange dieser Bereich aktiv ist. Die Belegung wird zum aktuellen Preset hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una tecla que activar mientras esta región está activa. La asignación se añade al preajuste actual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsee näppäimen, joka laukeaa tämän alueen ollessa aktiivinen. Määritys lisätään nykyiseen esiasetukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit une touche à déclencher tant que cette zone est active. L’affectation est ajoutée au préréglage actuel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בוחר מקש להפעלה בזמן שהאזור הזה פעיל. הקישור נוסף לפריסט הנוכחי."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiválaszt egy billentyűt, amely akkor aktiválódik, amikor ez a terület aktív. A hozzárendelés a jelenlegi előbeállításhoz kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memilih tombol yang dipicu saat wilayah ini aktif. Pemetaan ditambahkan ke preset saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie un tasto da attivare mentre questa regione è attiva. L’assegnazione viene aggiunta al preset corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この領域が有効な間に実行するキーを選びます。バインディングは現在のプリセットに追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 영역이 활성인 동안 실행할 키를 고릅니다. 바인딩은 현재 프리셋에 추가됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velger en tast som skal utløses mens dette området er aktivt. Tilordningen legges til i gjeldende forhåndsinnstilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiest een toets die wordt geactiveerd zolang dit gebied actief is. De toewijzing wordt aan de huidige preset toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybiera klawisz uruchamiany, gdy ten obszar jest aktywny. Przypisanie jest dodawane do bieżącego presetu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe uma tecla para disparar enquanto esta região está ativa. O mapeamento é adicionado ao preset atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирает клавишу, которая срабатывает, пока эта область активна. Привязка добавляется в текущий пресет."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberie kláves, ktorý sa spustí, kým je táto oblasť aktívna. Priradenie sa pridá do aktuálnej predvoľby."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljer en tangent som utlöses medan den här regionen är aktiv. Tilldelningen läggs till i den aktuella förinställningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกแป้นที่จะทำงานขณะพื้นที่นี้ใช้งานอยู่ การผูกถูกเพิ่มลงในพรีเซ็ตปัจจุบัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölge etkinken tetiklenecek bir tuş seçer. Atama geçerli ön ayara eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибирає клавішу, яка спрацьовує, поки ця область активна. Прив’язку додано до поточного пресета."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một phím để kích hoạt khi vùng này đang hoạt động. Mục gán được thêm vào cài đặt sẵn hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选取此区域活跃时要触发的按键。绑定会添加到当前预设。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇此區域啟用時要觸發的按鍵。綁定會新增到目前的預設。"
          }
        }
      }
    },
