    "Turns the active preset off and releases every key, mouse button, and note it was holding." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف الإعداد المسبق النشط ويحرر كل مفتاح وزر ماوس ونوتة كان يضغطها."
          }
        },
        "cs" : {
          "stringUnit" : {
