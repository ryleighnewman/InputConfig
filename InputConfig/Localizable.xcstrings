          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש ברוב סוגי הקישורים כדי לבחור את התבנית אוטומטית."
          }
        },
        "hu" : {
          "stringUnit" : {
