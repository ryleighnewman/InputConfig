    "Screen regions are areas of a display. Add a Screen region row and draw its regions from the row's Options." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مناطق الشاشة هي أجزاء من العرض. أضف صف «منطقة شاشة» وارسم مناطقه من خيارات الصف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti obrazovky jsou oblasti displeje. Přidejte řádek Oblast obrazovky a nakreslete její oblasti v Možnostech řádku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmområder er områder på en skærm. Tilføj en Skærmområde-række, og tegn dens områder fra rækkens Valgmuligheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmbereiche sind Bereiche eines Displays. Füge eine Zeile „Bildschirmbereich“ hinzu und zeichne ihre Bereiche in den Optionen der Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las regiones de pantalla son áreas de una pantalla. Añade una fila de Región de pantalla y dibuja sus regiones desde las Opciones de la fila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttöalueet ovat näytön alueita. Lisää Näyttöalue-rivi ja piirrä sen alueet rivin Valinnoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones d’écran sont des zones d’un écran. Ajoutez une ligne Zone d’écran et dessinez ses zones depuis les options de la ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזורי מסך הם שטחים בתצוגה. הוסף שורת אזור מסך וצייר את האזורים שלה מהאפשרויות של השורה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyőterületek a kijelző területei. Adjon hozzá egy Képernyőterület sort, és rajzolja meg a területeit a sor Beállításaiból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah layar adalah area pada layar. Tambahkan baris Wilayah layar dan gambar wilayahnya dari Opsi baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regioni dello schermo sono aree di un display. Aggiungi una riga Regione dello schermo e disegna le sue regioni dalle Opzioni della riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面領域はディスプレイ上のエリアです。「画面領域」行を追加し、行の「オプション」から領域を描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 영역은 디스플레이의 영역입니다. 화면 영역 행을 추가하고 행의 옵션에서 영역을 그리세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermområder er deler av en skjerm. Legg til en Skjermområde-rad og tegn områdene fra Valg for raden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermgebieden zijn gebieden van een beeldscherm. Voeg een rij Schermgebied toe en teken de gebieden vanuit de Opties van de rij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obszary ekranu to fragmenty wyświetlacza. Dodaj wiersz Obszar ekranu i narysuj jego obszary z Opcji wiersza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regiões da tela são áreas de uma tela. Adicione uma linha de Região da tela e desenhe suas regiões nas Opções da linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Области экрана: это участки дисплея. Добавьте строку «Область экрана» и нарисуйте её области в параметрах строки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti obrazovky sú plochy displeja. Pridajte riadok Oblasť obrazovky a nakreslite jej oblasti v Možnostiach riadka."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärmregioner är områden på en skärm. Lägg till en rad för Skärmregion och rita dess regioner från radens Alternativ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่หน้าจอคือพื้นที่ของจอแสดงผล เพิ่มแถวพื้นที่หน้าจอแล้ววาดพื้นที่จากตัวเลือกของแถว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran bölgeleri bir ekranın alanlarıdır. Bir Ekran bölgesi satırı ekleyin ve bölgelerini satırın Seçenekleri’nden çizin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Області екрана є ділянками дисплея. Додайте рядок «Область екрана» й намалюйте її області в параметрах рядка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng màn hình là các khu vực của màn hình. Thêm một hàng vùng Màn hình và vẽ các vùng của nó từ Tùy chọn của hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕区域是显示器的区域。添加一个“屏幕区域”行，并从该行的“选项”中绘制其区域。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕區域是顯示器上的區域。新增一個螢幕區域列，並從該列的「選項」繪製其區域。"
          }
        }
      }
    },
    "Screen regions are now their own input: draw an area of any display and it fires while the pointer is inside it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبحت مناطق الشاشة مدخلًا مستقلًا: ارسم جزءًا من أي شاشة فيُطلَق بينما المؤشر داخله"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti obrazovky jsou nyní samostatný vstup: nakreslete oblast libovolného displeje a spustí se, dokud je v ní ukazatel"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmområder er nu deres eget input: tegn et område på en vilkårlig skærm, så udløses det, mens markøren er inden i det"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmbereiche sind jetzt eine eigene Eingabe: Zeichne einen Bereich auf einem beliebigen Display, und er löst aus, solange sich der Zeiger darin befindet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las regiones de pantalla ahora son una entrada propia: dibuja un área de cualquier pantalla y se activa mientras el puntero está dentro"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttöalueet ovat nyt oma syötteensä: piirrä mikä tahansa näytön alue, ja se laukeaa osoittimen ollessa sen sisällä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les zones d’écran sont désormais une entrée à part entière : dessinez une zone sur n’importe quel écran et elle se déclenche tant que le pointeur s’y trouve"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אזורי מסך הם עכשיו קלט בפני עצמם: צייר שטח בכל תצוגה והוא מופעל כשהמצביע בתוכו"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A képernyőterületek mostantól önálló bemenetek: rajzoljon területet bármely kijelzőn, és az aktiválódik, amíg a mutató benne van"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah layar kini menjadi inputnya sendiri: gambar area di layar mana pun dan aktif saat penunjuk berada di dalamnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regioni dello schermo sono ora un input a sé: disegna un’area di qualsiasi display e si attiva mentre il puntatore è al suo interno"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面領域が独立した入力になりました: 任意のディスプレイのエリアを描画すると、ポインタがその内側にある間に動作します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 영역이 이제 독립된 입력이 됨: 디스플레이의 영역을 그리면 포인터가 그 안에 있는 동안 실행됨"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermområder er nå en egen inndata: tegn et område på en hvilken som helst skjerm, så utløses det mens pekeren er inni det"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermgebieden zijn nu een eigen ingang: teken een gebied op een willekeurig beeldscherm en het wordt geactiveerd zolang de aanwijzer erin staat"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obszary ekranu są teraz osobnym wejściem: narysuj fragment dowolnego wyświetlacza, a uruchomi się, gdy wskaźnik jest w jego wnętrzu"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regiões da tela agora são uma entrada própria: desenhe uma área de qualquer tela e ela dispara enquanto o ponteiro está dentro dela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Области экрана теперь отдельный вход: нарисуйте участок любого дисплея, и он срабатывает, пока указатель внутри него"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti obrazovky sú teraz vlastný vstup: nakreslite plochu ľubovoľného displeja a spustí sa, kým je ukazovateľ v nej"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärmregioner är nu en egen indata: rita ett område på vilken skärm som helst så utlöses det medan pekaren är inuti"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่หน้าจอเป็นอินพุตของตัวเองแล้ว: วาดพื้นที่ของจอแสดงผลใดก็ได้ แล้วมันทำงานขณะตัวชี้อยู่ภายใน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran bölgeleri artık kendi girişleri: herhangi bir ekranın bir alanını çizin, işaretçi içindeyken tetiklenir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Області екрана тепер є окремим входом: намалюйте ділянку будь-якого дисплея, і вона спрацьовує, поки вказівник усередині"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng màn hình giờ là một đầu vào riêng: vẽ một khu vực của bất kỳ màn hình nào và nó kích hoạt khi con trỏ nằm bên trong"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕区域现在是独立的输入：绘制任何显示器的某个区域，指针位于其中时就会触发"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕區域現在是獨立的輸入：在任何顯示器上繪製一個區域，指標位於其中時就會觸發"
          }
        }
      }
    },
