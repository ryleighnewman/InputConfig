          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё работает и остаётся на вашем Mac. Никакой телеметрии, никакой учётной записи, ничего не загружается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všetko beží a zostáva vo vašom Macu. Žiadna telemetria, žiadny účet, nič sa nenahráva."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allt körs och stannar på din Mac. Ingen telemetri, inget konto, inget som laddas upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกอย่างทำงานและอยู่บน Mac ของคุณ ไม่มีการวัดและส่งข้อมูล ไม่มีบัญชี ไม่มีการอัปโหลด"
