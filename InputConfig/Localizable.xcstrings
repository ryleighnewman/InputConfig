        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחצו ״הפעל״ כשאתם מוכנים, והשלט יעשה מה שהפריסט אומר. לחצו שוב כדי לעצור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kattints az Aktiválás gombra, ha készen állsz, és a vezérlőd azt teszi, amit az előbeállítás mond. Kattints újra a leállításhoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik Aktifkan saat Anda siap, dan pengontrol Anda melakukan apa yang ditentukan preset. Klik lagi untuk berhenti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Attiva quando sei pronto, e il controller fa quello che dice il preset. Fai di nuovo clic per fermarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたら「有効化」をクリックすると、コントローラがプリセットのとおりに動きます。もう一度クリックすると止まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비가 되면 활성화를 클릭하세요. 컨트롤러가 프리셋대로 작동합니다. 다시 클릭하면 멈춥니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på Aktiver når du er klar, så gjør kontrolleren det forhåndsinnstillingen sier. Klikk igjen for å stoppe."
