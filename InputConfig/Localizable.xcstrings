        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripojte, aktivujte, povoľte jedno oprávnenie. Päť minút."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut, aktivera och ge den enda behörigheten. Fem minuter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อ เปิดใช้งาน และให้สิทธิ์เพียงหนึ่งอย่าง ใช้เวลาห้านาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlayın, etkinleştirin, tek izni verin. Beş dakika."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть, активуйте, надайте єдиний дозвіл. П’ять хвилин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối, kích hoạt, cấp một quyền duy nhất. Năm phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接、启用、授予那一项权限。只需五分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接、啟用、授予那一項權限。五分鐘就好。"
          }
        }
      }
    },
