        }
      }
    },
    "Statistics shows how you use InputConfig, like button presses and time connected. It all stays on your Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض الإحصاءات كيف تستخدم InputConfig، مثل ضغطات الأزرار ومدة الاتصال. كل شيء يبقى على جهاز Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistiky ukazují, jak InputConfig používáte, třeba stisky tlačítek a dobu připojení. Všechno zůstává ve vašem Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistikken viser, hvordan du bruger InputConfig, fx knaptryk og tid forbundet. Det hele bliver på din Mac."
