          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrette una riga semplice e una riga con combinazione sullo stesso pulsante che si illuminavano entrambe nell’editor: una riga si illumina solo quando si attiverebbe, compresi i comandi tenuti premuti"
