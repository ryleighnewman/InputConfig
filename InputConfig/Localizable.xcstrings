        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živý vizualizér ukazuje váš ovládač, keď ho používate. Kliknite na ktorúkoľvek časť a uvidíte, čo robí."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-visualiseraren visar din handkontroll medan du använder den. Klicka på en del för att se vad den gör."
