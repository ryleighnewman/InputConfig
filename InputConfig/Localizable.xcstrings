    "Turn on if you assigned an analog trigger instead of a centered stick. Disables the reverse gesture." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّله إذا عيّنت زنادًا تناظريًا بدل عصا متمركزة. يعطّل الإيماءة العكسية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte, pokud jste místo vycentrované páčky přiřadili analogovou spoušť. Vypne gesto zpětného chodu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå til, hvis du har tildelt en analog trigger i stedet for en centreret stick. Slår den omvendte bevægelse fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschalten, wenn du einen analogen Trigger statt eines zentrierten Sticks zugewiesen hast. Deaktiviert die Rückwärtsgeste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo si asignaste un gatillo analógico en lugar de un stick centrado. Desactiva el gesto inverso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota käyttöön, jos määritit analogisen liipaisimen keskitetyn sauvan sijaan. Poistaa käänteisen eleen käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez si vous avez affecté une gâchette analogique au lieu d’un stick centré. Désactive le geste inversé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעל אם הקצית הדק אנלוגי במקום ג׳ויסטיק ממורכז. משבית את מחוות ההיפוך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsolja be, ha analóg ravaszt rendelt középre álló joystick helyett. Letiltja a fordított mozdulatot."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan jika Anda menetapkan pemicu analog, bukan stik di tengah. Menonaktifkan gestur mundur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivalo se hai assegnato un grilletto analogico invece di uno stick centrato. Disattiva il gesto di retromarcia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中央に戻るスティックではなく、アナログトリガを割り当てた場合にオンにします。後退ジェスチャが無効になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중앙에 두는 스틱 대신 아날로그 트리거를 지정했다면 켜세요. 후진 제스처가 비활성화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på hvis du tilordnet en analog avtrekker i stedet for en sentrert joystick. Deaktiverer bakoverbevegelsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet aan als je een analoge trigger hebt toegewezen in plaats van een gecentreerde stick. Schakelt het omgekeerde gebaar uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz, jeśli przypisano spust analogowy zamiast wyśrodkowanego drążka. Wyłącza gest odwrotny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative se você atribuiu um gatilho analógico em vez de um stick centralizado. Desativa o gesto inverso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите, если вы назначили аналоговый триггер вместо стика с центром. Отключает обратный жест."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapnite, ak ste priradili analógovú spúšť namiesto vycentrovanej páčky. Vypne spätné gesto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på om du tilldelade en analog avtryckare i stället för en centrerad spak. Inaktiverar omvänd gest."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดหากคุณกำหนดทริกเกอร์อนาล็อกแทนจอยสติ๊กที่อยู่กึ่งกลาง ปิดท่าทางย้อนกลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortalanmış bir çubuk yerine analog bir tetik atadıysanız açın. Ters hareketi devre dışı bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть, якщо ви призначили аналоговий тригер замість центрованого джойстика. Вимикає жест заднього ходу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật nếu bạn đã gán một cò analog thay vì một cần ở giữa. Tắt cử chỉ đảo ngược."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你指定的是模拟扳机而不是居中的摇杆，请开启。会停用反向手势。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你指定的是類比扳機而不是置中的搖桿，請開啟。這會停用反向手勢。"
          }
        }
      }
    },
    "Turn on InputConfig in Privacy & Security → Accessibility to send keyboard & mouse input." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل InputConfig في الخصوصية والأمن، تسهيلات الاستخدام لإرسال إدخال لوحة المفاتيح والماوس."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte InputConfig v Soukromí a zabezpečení → Zpřístupnění, aby mohl odesílat vstup z klávesnice a myši."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå InputConfig til i Anonymitet & sikkerhed → Tilgængelighed for at sende tastatur- og musinput."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte InputConfig unter „Datenschutz & Sicherheit“ → „Bedienungshilfen“ ein, um Tastatur- und Mauseingaben zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa InputConfig en Privacidad y seguridad → Accesibilidad para enviar entrada de teclado y ratón."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota InputConfig käyttöön kohdassa Tietosuoja ja suojaus → Käyttöapu lähettääksesi näppäimistö- ja hiirisyötteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez InputConfig dans Confidentialité et sécurité → Accessibilité pour envoyer des saisies clavier et souris."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
