    "A rectangle on the stick's plane, or part of a ring: between two distances from the center and two directions" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستطيل على مستوى العصا، أو جزء من حلقة: بين مسافتين من المركز واتجاهين"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obdélník v rovině páčky, nebo část prstence: mezi dvěma vzdálenostmi od středu a dvěma směry"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et rektangel på stickens flade eller en del af en ring: mellem to afstande fra midten og to retninger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rechteck auf der Stick-Ebene oder ein Teil eines Rings: zwischen zwei Abständen von der Mitte und zwei Richtungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rectángulo en el plano del stick, o parte de un anillo: entre dos distancias desde el centro y dos direcciones"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorakulmio sauvan tasolla tai osa rengasta: kahden keskipisteestä mitatun etäisyyden ja kahden suunnan välissä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rectangle sur le plan du stick, ou une portion d’anneau : entre deux distances du centre et deux directions"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מלבן על מישור הג׳ויסטיק, או חלק מטבעת: בין שני מרחקים מהמרכז ושני כיוונים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téglalap a joystick síkján, vagy egy gyűrű része: a középponttól mért két távolság és két irány között"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persegi panjang pada bidang stik, atau bagian dari cincin: di antara dua jarak dari pusat dan dua arah"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rettangolo sul piano dello stick, o parte di un anello: tra due distanze dal centro e due direzioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スティックの平面上の長方形、またはリングの一部: 中心からの2つの距離と2つの方向で決まります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스틱 평면 위의 사각형 또는 링의 일부: 중심에서의 두 거리와 두 방향 사이"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et rektangel på joystickens flate, eller en del av en ring: mellom to avstander fra midten og to retninger"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rechthoek op het vlak van de stick, of een deel van een ring: tussen twee afstanden vanaf het midden en twee richtingen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostokąt na płaszczyźnie drążka lub część pierścienia: między dwiema odległościami od środka i dwoma kierunkami"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um retângulo no plano do stick, ou parte de um anel: entre duas distâncias a partir do centro e duas direções"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прямоугольник на плоскости стика или часть кольца: между двумя расстояниями от центра и двумя направлениями"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obdĺžnik v rovine páčky alebo časť prstenca: medzi dvoma vzdialenosťami od stredu a dvoma smermi"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rektangel på spakens yta, eller en del av en ring: mellan två avstånd från mitten och två riktningar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สี่เหลี่ยมบนระนาบของจอยสติ๊ก หรือส่วนหนึ่งของวงแหวน: อยู่ระหว่างระยะห่างจากกึ่งกลางสองค่าและสองทิศทาง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çubuğun düzleminde bir dikdörtgen veya halkanın bir parçası: merkezden iki mesafe ve iki yön arasında"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прямокутник на площині джойстика або частина кільця: між двома відстанями від центру та двома напрямками"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hình chữ nhật trên mặt phẳng của cần, hoặc một phần của vòng: giữa hai khoảng cách từ tâm và hai hướng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摇杆平面上的矩形，或圆环的一部分：位于距中心的两个距离和两个方向之间"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搖桿平面上的矩形，或圓環的一部分：位於距中心的兩個距離和兩個方向之間"
          }
        }
      }
    },
