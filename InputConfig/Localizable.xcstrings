    "Needs Accessibility, Spoken Content, Speak selection switched on" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب تشغيل تسهيلات الاستخدام، المحتوى المنطوق، نطق التحديد"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžaduje zapnuté Zpřístupnění, Mluvený obsah, Mluvit výběr"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræver, at Tilgængelighed, Oplæst indhold, Oplæs markering er slået til"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert, dass in „Bedienungshilfen“ > „Gesprochene Inhalte“ die Option „Auswahl sprechen“ eingeschaltet ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere activar Accesibilidad, Contenido hablado, Pronunciar selección"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaatii, että Käyttöapu, Puhuttu sisältö, Puhu valinta on kytketty päälle"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite Accessibilité, Contenu énoncé, Énoncer la sélection activé"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דורש הפעלה של ״נגישות״, ״תוכן מושמע״, ״השמעת הבחירה״"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Kisegítő lehetőségek, Kimondott tartalom, Kijelölt szöveg felolvasása bekapcsolását igényli"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perlu Aksesibilitas, Konten Lisan, Ucapkan pilihan dinyalakan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede Accessibilità, Contenuto pronunciato, Pronuncia selezione attivata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アクセシビリティ」>「読み上げコンテンツ」>「選択項目の読み上げ」をオンにする必要があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용에서 음성 콘텐츠, 선택 항목 말하기가 켜져 있어야 합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krever at Tilgjengelighet, Opplest innhold, Les opp merket tekst er slått på"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist dat bij Toegankelijkheid, Gesproken inhoud, Lees selectie voor is ingeschakeld"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymaga włączenia: Dostępność, Treść mówiona, Mów zaznaczenie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa de Acessibilidade, Conteúdo Falado, Falar seleção ativado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно включить «Универсальный доступ» > «Речь» > «Проговаривание выбранного»"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžaduje zapnuté Prístupnosť, Hovorený obsah, Prečítať výber"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräver att Hjälpmedel, Talat innehåll, Läs upp markering är påslaget"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องเปิดการช่วยการเข้าถึง > เนื้อหาที่พูด > พูดข้อความที่เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişilebilirlik, Sesli İçerik, Seçimi Seslendir seçeneğinin açık olması gerekir"
          }
        },
        "uk" : {
