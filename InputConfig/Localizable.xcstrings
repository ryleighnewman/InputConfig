    " (on for every preset in Settings, Advanced, Gaming utilities)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (قيد التشغيل لكل إعداد مسبق في الإعدادات، متقدم، أدوات الألعاب)"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (zapnuto pro každou předvolbu v Nastavení, Pokročilé, Herní nástroje)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (slået til for alle forudindstillinger i Indstillinger, Avanceret, Spilværktøjer)"
