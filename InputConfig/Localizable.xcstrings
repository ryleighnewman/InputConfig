    "Hold the controller's pair button until its light flashes, then add it from System Settings → Bluetooth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على زر اقتران ذراع التحكم حتى يومض ضوؤه، ثم أضفه من إعدادات النظام ثم Bluetooth."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte tlačítko párování ovladače, dokud nezabliká jeho světlo, a pak ho přidejte v Nastavení systému → Bluetooth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold controllerens parringsknap nede, til dens lys blinker, og tilføj den derefter fra Systemindstillinger → Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Koppeltaste des Controllers, bis seine Leuchte blinkt, und füge ihn dann in den Systemeinstellungen → Bluetooth hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el botón de emparejamiento del mando hasta que su luz parpadee y luego añádelo desde Ajustes del Sistema → Bluetooth."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä ohjaimen pariliitäntäpainiketta painettuna, kunnes sen valo vilkkuu, ja lisää se sitten kohdassa Järjestelmäasetukset → Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le bouton d’appairage de la manette jusqu’à ce que son voyant clignote, puis ajoutez-la depuis Réglages Système → Bluetooth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החזק את לחצן הצימוד של השלט עד שהאור שלו מהבהב, ואז הוסף אותו מ״הגדרות המערכת״ ← Bluetooth."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa nyomva a vezérlő párosítógombját, amíg a lámpája villogni nem kezd, majd adja hozzá a Rendszerbeállítások → Bluetooth részen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan tombol pasangkan pengontrol sampai lampunya berkedip, lalu tambahkan dari Pengaturan Sistem → Bluetooth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il pulsante di abbinamento del controller finché la luce non lampeggia, poi aggiungilo da Impostazioni di Sistema → Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントローラのペアリングボタンをライトが点滅するまで押し続けてから、「システム設定」>「Bluetooth」で追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤러의 페어링 버튼을 불빛이 깜박일 때까지 누른 다음 시스템 설정 → Bluetooth에서 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nede paringsknappen på kontrolleren til lyset blinker, og legg den deretter til fra Systeminnstillinger → Bluetooth."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de koppelknop van de controller ingedrukt tot het lampje knippert en voeg hem dan toe via Systeeminstellingen → Bluetooth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj przycisk parowania kontrolera, aż jego światło zacznie migać, a potem dodaj go w: Ustawienia systemowe → Bluetooth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o botão de pareamento do controle até a luz piscar e depois adicione-o em Ajustes do Sistema → Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте кнопку сопряжения контроллера, пока не замигает индикатор, затем добавьте его в «Системные настройки» > Bluetooth."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte tlačidlo párovania ovládača, kým nezačne blikať svetlo, a potom ho pridajte v aplikácii Systémové nastavenia → Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll spelkontrollens parkopplingsknapp tills dess lampa blinkar och lägg sedan till den i Systeminställningar → Bluetooth."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดปุ่มจับคู่ของคอนโทรลเลอร์ค้างจนไฟกะพริบ แล้วเพิ่มจากการตั้งค่าระบบ → Bluetooth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumandanın eşleştirme düğmesini ışığı yanıp sönene kadar basılı tutun, ardından Sistem Ayarları → Bluetooth’tan ekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте кнопку сполучення контролера, доки його індикатор не замиготить, потім додайте його в розділі «Системні параметри» > Bluetooth."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ nút ghép nối của bộ điều khiển cho đến khi đèn nháy, rồi thêm nó từ Cài đặt hệ thống → Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住控制器的配对按钮直到指示灯闪烁，然后在“系统设置”>“蓝牙”中添加它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住控制器的配對按鈕，直到燈號閃爍，然後從「系統設定」>「藍牙」加入。"
          }
        }
      }
    },
