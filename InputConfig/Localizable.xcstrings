          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa Aktivoi, kun olet valmis, niin ohjaimesi tekee sen, mitä esiasetus sanoo. Lopeta klikkaamalla uudelleen."
