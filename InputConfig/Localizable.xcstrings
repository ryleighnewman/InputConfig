    "Auto-applies when the preset activates; reverts on stop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطبَّق تلقائيًا عند تفعيل الإعداد المسبق؛ ويُرجَع عند الإيقاف."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použije se automaticky při aktivaci předvolby; po zastavení se vrátí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anvendes automatisk, når forudindstillingen aktiveres. Vender tilbage ved stop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird automatisch angewendet, wenn das Preset aktiviert wird; wird beim Stoppen zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica automáticamente al activar el preajuste; se revierte al detenerlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otetaan käyttöön automaattisesti esiasetuksen aktivoituessa; palautuu pysäytettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique automatiquement à l’activation du préréglage ; revient à l’arrêt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחל אוטומטית כשהפריסט מופעל; חוזר לקדמותו כשהוא נעצר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan érvényesül az előbeállítás aktiválásakor; leállításkor visszaáll."
          }
        },
        "id" : {
          "stringUnit" : {
