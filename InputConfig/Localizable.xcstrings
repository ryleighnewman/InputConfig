          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 입력 기기를 Mac의 무엇에든 매핑하는 무료 손쉬운 사용 도구."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et gratis tilgjengelighetsverktøy som kobler alle inndataenheter til hva som helst på Macen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gratis toegankelijkheidstool die elk invoerapparaat aan alles op je Mac koppelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezpłatne narzędzie ułatwień dostępu, które przypisuje dowolne urządzenie wejściowe do dowolnej czynności na Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma ferramenta de acessibilidade gratuita que mapeia qualquer dispositivo de entrada para qualquer coisa no seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатный инструмент универсального доступа, который связывает любое устройство ввода с чем угодно на вашем Mac."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezplatný nástroj prístupnosti, ktorý mapuje akékoľvek vstupné zariadenie na čokoľvek vo vašom Macu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett kostnadsfritt hjälpmedelsverktyg som kopplar vilken enhet som helst till vad som helst på din Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครื่องมือการช่วยการเข้าถึงฟรีที่แมปอุปกรณ์อินพุตใดก็ได้ไปยังสิ่งใดก็ได้บน Mac ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac’inizdeki herhangi bir giriş aygıtını istediğiniz her şeye eşleyen ücretsiz bir erişilebilirlik aracı."
