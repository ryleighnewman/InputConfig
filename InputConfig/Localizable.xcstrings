          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidána podpora Stream Decku včetně dotykových bodů modelu Neo a modulů Stream Deck, připojení z nabídky Zařízení nebo z řádku nabídek"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
