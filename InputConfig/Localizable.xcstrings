    "Macros chain keystrokes with per-step timing, and can mix keys, clicks, and MIDI in one sequence." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسلسل الماكرو ضغطات المفاتيح بتوقيت لكل خطوة، ويمكنه مزج المفاتيح والنقرات وMIDI في تسلسل واحد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makra řetězí stisky kláves s časováním každého kroku a mohou v jedné sekvenci míchat klávesy, kliknutí a MIDI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makroer kæder tastetryk sammen med timing pr. trin og kan blande taster, klik og MIDI i én sekvens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makros verketten Tastenanschläge mit Timing pro Schritt und können Tasten, Klicks und MIDI in einer Sequenz mischen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las macros encadenan pulsaciones de teclas con tiempos por paso, y pueden mezclar teclas, clics y MIDI en una sola secuencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makrot ketjuttavat näppäinpainalluksia vaihekohtaisella ajoituksella, ja niissä voi yhdistää näppäimiä, napsautuksia ja MIDIä yhdessä sarjassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les macros enchaînent des frappes avec un minutage par étape, et peuvent mélanger touches, clics et MIDI dans une même séquence."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאקרו משרשר הקשות מקשים עם תזמון לכל שלב, ויכול לשלב מקשים, לחיצות ו-MIDI ברצף אחד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A makrók billentyűleütéseket fűznek össze lépésenkénti időzítéssel, és billentyűket, kattintásokat és MIDI-t is keverhetnek egy sorozatban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makro merangkai penekanan tombol dengan pengaturan waktu per langkah, dan dapat memadukan tombol, klik, dan MIDI dalam satu urutan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le macro concatenano sequenze di tasti con tempi per passaggio, e possono mescolare tasti, clic e MIDI in un’unica sequenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロは、ステップごとのタイミングでキー入力をつなげ、キー、クリック、MIDIを1つのシーケンスに組み合わせられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로는 단계별 타이밍으로 키 입력을 연결하며, 키, 클릭, MIDI를 하나의 시퀀스에 섞을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makroer kjeder sammen tastetrykk med timing per trinn, og kan blande taster, klikk og MIDI i én sekvens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macro's koppelen toetsaanslagen met timing per stap, en kunnen toetsen, klikken en MIDI in één reeks combineren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makra łączą naciśnięcia klawiszy z czasem dla każdego kroku i mogą mieszać klawisze, kliknięcia i MIDI w jednej sekwencji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As macros encadeiam teclas com tempo por passo e podem misturar teclas, cliques e MIDI em uma sequência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макросы связывают нажатия клавиш в цепочки с временем для каждого шага и могут сочетать клавиши, клики и MIDI в одной последовательности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makrá reťazia stlačenia klávesov s časovaním každého kroku a môžu v jednej sekvencii miešať klávesy, kliknutia a MIDI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makron kedjar tangenttryckningar med timing per steg och kan blanda tangenter, klick och MIDI i en och samma sekvens."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาโครต่อแป้นกดเป็นลูกโซ่ด้วยจังหวะต่อขั้นตอน และผสมแป้น การคลิก และ MIDI ในลำดับเดียวได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makrolar tuş vuruşlarını adım başına zamanlamayla zincirler ve tek bir dizide tuşları, tıklamaları ve MIDI’yi karıştırabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макроси зв’язують натискання клавіш у ланцюжок із часом для кожного кроку й можуть поєднувати клавіші, клацання та MIDI в одній послідовності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macro nối các lần nhấn phím với thời gian theo từng bước, và có thể trộn phím, lượt nhấp và MIDI trong một chuỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏可串联按键并为每个步骤设置时序，还可在一个序列中混合按键、点按和 MIDI。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集會以每個步驟各自的時間串接按鍵，且可在同一序列中混合按鍵、點按和 MIDI。"
          }
        }
      }
    },
