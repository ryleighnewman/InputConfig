    "Everything runs and stays on your Mac. No telemetry, no account, nothing uploaded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء يعمل ويبقى على جهاز Mac. بلا قياس عن بُعد ولا حساب ولا رفع لأي شيء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše běží a zůstává ve vašem Macu. Žádná telemetrie, žádný účet, nic se nenahrává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt kører og bliver på din Mac. Ingen telemetri, ingen konto, intet uploades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles läuft auf deinem Mac und bleibt dort. Keine Telemetrie, kein Konto, nichts wird hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se ejecuta y se queda en tu Mac. Sin telemetría, sin cuenta, nada se sube."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
