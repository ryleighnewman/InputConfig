        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waterpas is hoe je hem vasthoudt, een nieuwe optie voor kantel- en aanwijzerrijen, meet de helling vanaf je greep in plaats van vanaf plat"
