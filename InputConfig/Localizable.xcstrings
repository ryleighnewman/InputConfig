    "Type a screen region's, stick region's or touchpad region's place and size, and a fixed click point's X and Y, instead of only dragging" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب موضع منطقة شاشة أو منطقة عصا أو منطقة لوحة لمس وحجمها، وX وY لنقطة نقر ثابتة، بدل السحب فقط"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte umístění a velikost oblasti obrazovky, oblasti páčky nebo oblasti touchpadu a X a Y pevného bodu kliknutí, místo pouhého tažení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv placeringen og størrelsen på et skærmområde, et stickområde eller et touchpad-område og X og Y for et fast klikpunkt i stedet for kun at trække"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib Position und Größe eines Bildschirmbereichs, eines Stick-Bereichs oder eines Touchpad-Bereichs sowie X und Y eines festen Klickpunkts ein, statt nur zu ziehen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe la posición y el tamaño de una región de pantalla, una región de stick o una región de panel táctil, y la X y la Y de un punto de clic fijo, en lugar de solo arrastrar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita näyttöalueen, sauva-alueen tai kosketuslevyalueen sijainti ja koko sekä kiinteän napsautuspisteen X ja Y pelkän vetämisen sijaan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez l’emplacement et la taille d’une zone d’écran, d’une zone de stick ou d’une zone de pavé tactile, ainsi que X et Y d’un point de clic fixe, au lieu de seulement faire glisser"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקלד מיקום וגודל של אזור מסך, אזור ג׳ויסטיק או אזור משטח מגע, ואת X ו-Y של נקודת לחיצה קבועה, במקום רק לגרור"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adja meg a képernyőterület, joystickterület vagy érintőpad-terület helyét és méretét, valamint egy rögzített kattintási pont X és Y értékét, a puszta húzás helyett"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik tempat dan ukuran wilayah layar, wilayah stik, atau wilayah touchpad, serta X dan Y titik klik tetap, bukan hanya menyeret"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita posizione e dimensione di una regione dello schermo, di una regione dello stick o del touchpad, e le coordinate X e Y di un punto di clic fisso, invece di limitarti a trascinare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグするだけでなく、画面領域、スティック領域、タッチパッド領域の位置とサイズ、固定クリック位置のXとYを入力できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 영역, 스틱 영역, 터치패드 영역의 위치와 크기, 고정 클릭 지점의 X와 Y를 드래그하는 대신 직접 입력할 수 있음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv inn plassering og størrelse for et skjermområde, et joystick-område eller et berøringsflateområde, og X og Y for et fast klikkpunkt, i stedet for bare å dra"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ de plek en grootte van een schermgebied, stickgebied of touchpadgebied, en de X en Y van een vast klikpunt, in plaats van alleen te slepen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz położenie i rozmiar obszaru ekranu, obszaru drążka lub obszaru gładzika oraz X i Y stałego punktu kliknięcia, zamiast tylko przeciągać"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite a posição e o tamanho da região de tela, da região de stick ou da região de touchpad, e o X e o Y de um ponto de clique fixo, em vez de apenas arrastar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводите положение и размер области экрана, области стика или тачпада, а также X и Y точки фиксированного клика, вместо того чтобы только перетаскивать"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte miesto a veľkosť oblasti obrazovky, oblasti páčky alebo oblasti touchpadu a X a Y pevného bodu kliknutia, namiesto iba ťahania"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv in en skärmregions, spakregions eller pekplattsregions plats och storlek, och en fast klickpunkts X och Y, i stället för att bara dra"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พิมพ์ตำแหน่งและขนาดของพื้นที่หน้าจอ พื้นที่จอยสติ๊ก หรือพื้นที่ทัชแพด และ X กับ Y ของจุดคลิกคงที่ แทนที่จะลากอย่างเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ekran bölgesinin, çubuk bölgesinin veya dokunmatik yüzey bölgesinin yerini ve boyutunu ve sabit bir tıklama noktasının X ve Y değerlerini yalnızca sürüklemek yerine yazın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводьте місце й розмір області екрана, області джойстика чи області сенсорної панелі та X і Y фіксованої точки клацання, а не лише перетягуйте"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập vị trí và kích thước của vùng màn hình, vùng cần hoặc vùng bàn di cảm ứng, cùng X và Y của điểm nhấp cố định, thay vì chỉ kéo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可键入屏幕区域、摇杆区域或触摸板区域的位置和大小，以及固定点按位置的 X 和 Y，而不只是拖移"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入螢幕區域、搖桿區域或觸控板區域的位置與大小，以及固定點按位置的 X 和 Y，而不只是拖移"
          }
        }
      }
    },
