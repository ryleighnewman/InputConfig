    "Logitech wheel for Xbox: InputConfig does not read this wheel yet; the PlayStation and PC version of the wheel works" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عجلة Logitech لجهاز Xbox: لا يقرأ InputConfig هذه العجلة بعد؛ أما نسخة PlayStation وPC من العجلة فتعمل"
          }
        },
        "cs" : {
          "stringUnit" : {
