    },
    "The Quick Start tour is shorter and friendlier, shows regions, opens Help and the motion menu for you, and its pointer reaches the toolbar and the editor" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبحت جولة البدء السريع أقصر وألطف، وتعرض المناطق، وتفتح المساعدة وقائمة الحركة لك، ويصل مؤشرها إلى شريط الأدوات والمحرر"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úvodní prohlídka je kratší a přívětivější, ukazuje oblasti, sama otevře Nápovědu a nabídku pohybu a její ukazatel dosáhne na panel nástrojů i do editoru"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduktionen er kortere og venligere, viser områder, åbner Hjælp og bevægelsesmenuen for dig, og dens markør når værktøjslinjen og editoren"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schnellstart-Tour ist kürzer und freundlicher, zeigt Bereiche, öffnet die Hilfe und das Bewegungsmenü für dich, und ihr Zeiger erreicht die Symbolleiste und den Editor"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tour de inicio rápido es más corto y amable, muestra las regiones, abre la Ayuda y el menú de movimiento por ti, y su puntero llega a la barra de herramientas y al editor"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pika-aloituskierros on lyhyempi ja ystävällisempi, näyttää alueet, avaa Ohjeen ja liikevalikon puolestasi, ja sen osoitin ulottuu työkalupalkkiin ja editoriin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La visite guidée rapide est plus courte et plus accueillante, montre les zones, ouvre l'Aide et le menu du mouvement pour vous, et son pointeur atteint la barre d'outils et l'éditeur"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיור ההתחלה המהירה קצר וידידותי יותר, מציג אזורים, פותח בשבילכם את העזרה ואת תפריט התנועה, והסמן שלו מגיע לסרגל הכלים ולעורך"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gyorsindítási bemutató rövidebb és barátságosabb, megmutatja a területeket, megnyitja neked a Súgót és a mozgásmenüt, a mutatója pedig eléri az eszközsort és a szerkesztőt"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tur Mulai Cepat lebih singkat dan ramah, menampilkan wilayah, membukakan Bantuan dan menu gerak untuk Anda, dan penunjuknya menjangkau bar alat dan editor"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tour di avvio rapido è più breve e amichevole, mostra le regioni, apre per te l'Aiuto e il menu del movimento, e il suo puntatore arriva alla barra degli strumenti e all'editor"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイックスタートツアーが短く親しみやすくなり、領域を紹介し、ヘルプとモーションのメニューを開き、ポインタがツールバーやエディタまで届くようになりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 시작 둘러보기가 더 짧고 친근해졌고, 영역을 보여 주며, 도움말과 모션 메뉴를 열어 주고, 포인터가 도구 막대와 편집기까지 닿습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omvisningen i hurtigstart er kortere og vennligere, viser områder, åpner Hjelp og bevegelsesmenyen for deg, og pekeren når verktøylinjen og redigeringsvinduet"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De snelstartrondleiding is korter en vriendelijker, laat gebieden zien, opent Help en het bewegingsmenu voor je, en de aanwijzer komt bij de knoppenbalk en de editor"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szybki przewodnik jest krótszy i przyjaźniejszy, pokazuje obszary, sam otwiera Pomoc i menu ruchu, a jego kursor sięga paska narzędzi i edytora"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tour de início rápido está mais curto e amigável, mostra as regiões, abre a Ajuda e o menu de movimento para você, e o ponteiro dele chega à barra de ferramentas e ao editor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрый обзор стал короче и дружелюбнее, показывает области, сам открывает Справку и меню движения, а его указатель достаёт до панели инструментов и редактора"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úvodná prehliadka je kratšia a priateľskejšia, ukazuje oblasti, sama otvorí Pomocníka a ponuku pohybu a jej ukazovateľ dosiahne na panel s nástrojmi aj do editora"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabbstartsrundturen är kortare och vänligare, visar regioner, öppnar Hjälp och rörelsemenyn åt dig, och pekaren når verktygsfältet och redigeraren"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทัวร์เริ่มต้นอย่างรวดเร็วสั้นลงและเป็นมิตรขึ้น แสดงพื้นที่ เปิดวิธีใช้และเมนูการเคลื่อนไหวให้ และตัวชี้ไปถึงแถบเครื่องมือและตัวแก้ไข"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlı Başlangıç Turu daha kısa ve samimi; bölgeleri gösteriyor, Yardım'ı ve hareket menüsünü sizin için açıyor ve imleci araç çubuğuna ve düzenleyiciye ulaşıyor"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Екскурсія швидкого старту коротша й привітніша, показує області, сама відкриває Довідку та меню руху, а її вказівник дістає до панелі інструментів і редактора"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyến tham quan bắt đầu nhanh ngắn gọn và thân thiện hơn, giới thiệu vùng, tự mở Trợ giúp và menu chuyển động, và con trỏ của nó với tới thanh công cụ và trình chỉnh sửa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速入门导览更短、更友好，会介绍区域，为你打开帮助和运动菜单，指针也能到达工具栏和编辑器"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速入門導覽更短、更友善，會介紹區域，為你打開說明和動態選單，指標也能到達工具列和編輯器"
          }
        }
      }
    },
    "The readout should move when you turn the controller and settle near zero when it rests. If it reads exactly zero whatever you do, motion is not reaching the app: try a wired connection or re-pair over Bluetooth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يتحرك المقياس عند تدوير ذراع التحكم ويستقر قرب الصفر عند سكونه. إذا قرأ صفرًا تمامًا مهما فعلت، فالحركة لا تصل إلى التطبيق: جرّب اتصالًا سلكيًا أو أعد الاقتران عبر Bluetooth."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaj by se měl při otáčení ovladače pohybovat a v klidu se ustálit poblíž nuly. Pokud je přesně nula, ať děláte cokoli, pohyb do aplikace nedorazí: zkuste kabelové připojení nebo znovu spárujte přes Bluetooth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aflæsningen bør bevæge sig, når du drejer controlleren, og falde til ro nær nul, når den hviler. Hvis den læser præcis nul, uanset hvad du gør, når bevægelsen ikke appen: prøv en kablet forbindelse, eller par igen via Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anzeige sollte sich bewegen, wenn du den Controller drehst, und sich nahe null einpendeln, wenn er ruht. Zeigt sie egal was du tust genau null, erreicht die Bewegung die App nicht: Versuche eine kabelgebundene Verbindung oder koppele per Bluetooth neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lectura debería moverse al girar el mando y quedarse cerca de cero en reposo. Si marca exactamente cero hagas lo que hagas, el movimiento no llega a la app: prueba una conexión por cable o vuelve a emparejar por Bluetooth."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukeman pitäisi liikkua, kun ohjainta käännetään, ja asettua lähelle nollaa levossa. Jos se lukee täsmälleen nollaa mitä tahansa tekeekin, liike ei saavuta appia: kokeile langallista yhteyttä tai muodosta pariliitos uudelleen Bluetoothilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’affichage doit bouger quand vous tournez la manette et se stabiliser près de zéro au repos. S’il indique exactement zéro quoi que vous fassiez, le mouvement n’arrive pas jusqu’à l’app : essayez une connexion filaire ou appairez à nouveau en Bluetooth."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקריאה אמורה לזוז כשמסובבים את השלט ולהתייצב ליד אפס כשהוא נח. אם היא מראה אפס בדיוק לא משנה מה תעשה, תנועה לא מגיעה לאפליקציה: נסה חיבור קווי או צמד מחדש דרך Bluetooth."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelzőnek mozognia kell, amikor elfordítja a vezérlőt, és nulla közelében meg kell állapodnia nyugalomban. Ha pontosan nullát mutat, bármit is tesz, a mozgás nem jut el az apphoz: próbáljon vezetékes kapcsolatot, vagy párosítsa újra Bluetoothon."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembacaan harus bergerak saat Anda memutar pengontrol dan mengendap mendekati nol saat diam. Jika terbaca tepat nol apa pun yang Anda lakukan, gerakan tidak sampai ke app: coba sambungan berkabel atau pasangkan ulang melalui Bluetooth."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lettura dovrebbe muoversi quando ruoti il controller e assestarsi vicino a zero a riposo. Se legge esattamente zero qualunque cosa tu faccia, il movimento non arriva all’app: prova una connessione cablata o abbina di nuovo via Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントローラを回すと表示が動き、静止するとゼロ付近に落ち着くはずです。何をしても完全にゼロのままなら、モーションがAppに届いていません。有線接続を試すか、Bluetoothでペアリングし直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤러를 돌리면 표시값이 움직이고, 가만히 두면 0 근처에서 안정되어야 합니다. 무엇을 해도 정확히 0이면 모션이 앱에 전달되지 않는 것이니 유선 연결을 시도하거나 Bluetooth로 다시 페어링하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avlesningen skal bevege seg når du vrir på kontrolleren og stabilisere seg nær null når den hviler. Hvis den leser nøyaktig null uansett hva du gjør, når ikke bevegelse frem til appen: prøv en kablet tilkobling eller par på nytt over Bluetooth."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De uitlezing hoort te bewegen wanneer je de controller draait en bij nul tot rust te komen wanneer hij stilligt. Als hij precies nul toont wat je ook doet, bereikt beweging de app niet: probeer een bekabelde verbinding of koppel opnieuw via Bluetooth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odczyt powinien się zmieniać, gdy obracasz kontroler, i ustabilizować blisko zera w spoczynku. Jeśli wynosi dokładnie zero, cokolwiek zrobisz, ruch nie dociera do aplikacji: spróbuj połączenia przewodowego lub sparuj ponownie przez Bluetooth."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A leitura deve se mover quando você gira o controle e se acomodar perto de zero em repouso. Se ela marca exatamente zero faça o que fizer, o movimento não está chegando ao app: tente uma conexão com fio ou pareie de novo por Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показание должно двигаться при повороте контроллера и успокаиваться около нуля в покое. Если оно точно равно нулю, что бы вы ни делали, движение не доходит до приложения: попробуйте проводное подключение или заново выполните сопряжение по Bluetooth."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaj by sa mal hýbať, keď otáčate ovládačom, a usadiť sa blízko nuly v pokoji. Ak ukazuje presne nulu, nech robíte čokoľvek, pohyb sa k aplikácii nedostáva: skúste káblové pripojenie alebo opätovné spárovanie cez Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avläsningen bör röra sig när du vrider spelkontrollen och lugna sig nära noll när den vilar. Om den visar exakt noll vad du än gör når rörelsen inte appen: prova en trådbunden anslutning eller parkoppla via Bluetooth igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ค่าที่แสดงควรเคลื่อนเมื่อคุณหมุนคอนโทรลเลอร์และนิ่งใกล้ศูนย์เมื่อพัก หากอ่านเป็นศูนย์พอดีไม่ว่าทำอะไร แสดงว่าการเคลื่อนไหวไม่ถึงแอป: ลองใช้การเชื่อมต่อแบบมีสาย หรือจับคู่ใหม่ผ่าน Bluetooth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumandayı çevirdiğinizde gösterge hareket etmeli, dinlenirken sıfıra yakın durmalı. Ne yaparsanız yapın tam sıfır okuyorsa hareket uygulamaya ulaşmıyor demektir: kablolu bağlantı deneyin ya da Bluetooth üzerinden yeniden eşleştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показання має рухатися, коли ви повертаєте контролер, і зупинятися біля нуля в спокої. Якщо воно читає рівно нуль, що б ви не робили, рух не доходить до програми: спробуйте дротове підключення або повторно спарте через Bluetooth."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số đọc nên thay đổi khi bạn xoay bộ điều khiển và về gần không khi nó nghỉ. Nếu nó đọc đúng bằng không dù bạn làm gì, chuyển động không đến được ứng dụng: hãy thử kết nối có dây hoặc ghép nối lại qua Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转动控制器时读数应当变化，静止时应稳定在零附近。如果无论怎么操作都精确显示零，说明运动数据没有传到 App：请尝试有线连接，或通过蓝牙重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轉動控制器時讀數應該會移動，靜止時則應穩定在零附近。如果無論怎麼做讀數都剛好是零，表示動態資料沒有傳到 App：請嘗試有線連接，或透過藍牙重新配對。"
          }
        }
      }
    },
