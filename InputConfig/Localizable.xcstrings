    "Share, Create, and Capture keep their macOS screenshot and recording shortcut unless the running preset uses them" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ Share وCreate وCapture باختصار لقطة الشاشة والتسجيل في macOS ما لم يستخدمها الإعداد المسبق قيد التشغيل"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílet, Vytvořit a Capture si ponechají své zkratky macOS pro snímky a nahrávání obrazovky, pokud je nepoužívá běžící předvolba"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del, Opret og Optag beholder deres macOS-genvej til skærmbillede og optagelse, medmindre den kørende forudindstilling bruger dem"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Teilen“, „Erstellen“ und „Aufnahme“ behalten ihren macOS-Kurzbefehl für Bildschirmfotos und Aufnahmen, sofern das laufende Preset sie nicht verwendet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir, Crear y Capturar conservan su atajo de captura y grabación de macOS a menos que el preajuste en marcha los use"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa, Luo ja Tallenna säilyttävät macOS:n kuvakaappaus- ja tallennusoikotiensä, ellei käynnissä oleva esiasetus käytä niitä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partager, Créer et Capture gardent leur raccourci macOS de capture et d’enregistrement d’écran sauf si le préréglage en cours les utilise"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Share, Create ו-Capture שומרים על קיצור הצילום וההקלטה של macOS אלא אם הפריסט הפועל משתמש בהם"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Megosztás, Létrehozás és Rögzítés megtartja a macOS képernyőkép- és felvételi billentyűparancsát, kivéve, ha a futó előbeállítás használja őket"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan, Buat, dan Tangkap mempertahankan pintasan tangkapan layar dan rekaman macOS-nya kecuali preset yang berjalan menggunakannya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi, Crea e Cattura mantengono la loro scorciatoia macOS per screenshot e registrazione, a meno che il preset in esecuzione li usi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のプリセットが使わない限り、共有、作成、キャプチャはmacOSのスクリーンショットと録画のショートカットのままです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유, 만들기, 캡처는 실행 중인 프리셋이 사용하지 않는 한 macOS 스크린샷 및 녹화 단축키를 유지함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share, Create og Capture beholder macOS-snarveien for skjermbilde og opptak med mindre forhåndsinnstillingen som kjører, bruker dem"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delen, Maken en Capture behouden hun macOS-sneltoets voor schermafbeeldingen en opnamen, tenzij de draaiende preset ze gebruikt"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij, Utwórz i Przechwytywanie zachowują swoje skróty zrzutu i nagrywania w macOS, chyba że używa ich działający preset"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhar, Criar e Capturar mantêm o atalho de captura de tela e gravação do macOS, a menos que o preset em execução os use"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопки «Поделиться», «Создать» и «Захват» сохраняют свои сочетания macOS для снимков экрана и записи, если работающий пресет их не использует"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share, Create a Capture si ponechajú svoju skratku macOS pre snímku a nahrávanie obrazovky, pokiaľ ich nepoužíva spustená predvoľba"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share, Create och Capture behåller sina genvägar för skärmavbildning och inspelning i macOS om inte förinställningen som körs använder dem"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share, Create และ Capture คงแป้นพิมพ์ลัดภาพหน้าจอและการบันทึกของ macOS ไว้ เว้นแต่พรีเซ็ตที่ทำงานอยู่ใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaş, Oluştur ve Yakala, çalışan ön ayar bunları kullanmadıkça macOS ekran görüntüsü ve kayıt kısayollarını korur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share, Create і Capture зберігають свої скорочення macOS для знімків і запису екрана, якщо працюючий пресет їх не використовує"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share, Create và Capture giữ phím tắt chụp và ghi màn hình macOS của chúng trừ khi cài đặt sẵn đang chạy dùng chúng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“共享”、“创建”和“捕获”会保留其 macOS 截屏和录制快捷键，除非运行中的预设用到了它们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「分享」、「建立」和「擷取」會保留其 macOS 螢幕截圖與錄製快速鍵，除非執行中的預設使用它們"
          }
        }
      }
    },
