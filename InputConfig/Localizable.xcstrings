    "On your own, Save keeps your changes. The tour closes the editor without saving." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تعمل بنفسك، يبقي «حفظ» تغييراتك. تغلق الجولة المحرر دون حفظ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když pracujete sami, Uložit ponechá změny. Prohlídka zavře editor bez uložení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du selv arbejder, beholder Gem dine ændringer. Rundturen lukker editoren uden at gemme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du selbst arbeitest, behält Sichern deine Änderungen. Die Tour schließt den Editor, ohne zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando trabajes por tu cuenta, Guardar conserva tus cambios. El tour cierra el editor sin guardar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun teet itse, Tallenna pitää muutokset. Kierros sulkee editorin tallentamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous travaillez seul, Enregistrer garde vos modifications. La visite ferme l'éditeur sans enregistrer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשאתם עובדים לבד, ״שמור״ שומר את השינויים. הסיור סוגר את העורך בלי לשמור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha magad dolgozol, a Mentés megtartja a módosításokat. A bemutató mentés nélkül zárja be a szerkesztőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat bekerja sendiri, Simpan menyimpan perubahan Anda. Tur menutup editor tanpa menyimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando lavori da solo, Salva tiene le modifiche. Il tour chiude l'editor senza salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分で作業するときは、「保存」で変更が残ります。ツアーでは保存せずにエディタを閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 작업할 때는 저장을 누르면 변경 사항이 남습니다. 둘러보기는 저장하지 않고 편집기를 닫습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du jobber selv, beholder Lagre endringene. Omvisningen lukker redigeringsvinduet uten å lagre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je zelf bezig bent, houdt Bewaar je wijzigingen. De rondleiding sluit de editor zonder te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy działasz sam, Zapisz zachowuje zmiany. Wycieczka zamyka edytor bez zapisywania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando estiver sozinho, Salvar guarda suas alterações. O tour fecha o editor sem salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда работаете сами, «Сохранить» оставляет изменения. Обзор закрывает редактор без сохранения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď pracujete sami, Uložiť ponechá zmeny. Prehliadka zavrie editor bez uloženia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du jobbar själv behåller Spara dina ändringar. Rundturen stänger redigeraren utan att spara."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อทำเอง บันทึกจะเก็บการเปลี่ยนแปลงของคุณ ทัวร์จะปิดตัวแก้ไขโดยไม่บันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendiniz çalışırken Kaydet değişikliklerinizi saklar. Tur, düzenleyiciyi kaydetmeden kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли працюєте самі, «Зберегти» залишає зміни. Огляд закриває редактор без збереження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn tự làm, Lưu giữ thay đổi của bạn. Chuyến tham quan đóng trình chỉnh sửa mà không lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己操作时，“保存”会保留你的更改。导览会不保存直接关闭编辑器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自己操作時，「儲存」會保留你的變更。導覽會不儲存直接關閉編輯器。"
          }
        }
      }
    },
