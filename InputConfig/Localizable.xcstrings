    "%lld built-in presets from the backup added beside this Mac’s copy, named “(from backup)”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إضافة %lld من الإعدادات المسبقة المضمّنة من النسخة الاحتياطية بجانب نسخة جهاز Mac هذا، باسم “(من النسخة الاحتياطية)”"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vestavěné předvolby ze zálohy (%lld) byly přidány vedle kopie v tomto Macu a nazvány „(ze zálohy)“"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld indbyggede forudindstillinger fra backuppen er tilføjet ved siden af denne Macs kopi og hedder “(fra backup)”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld integrierte Presets aus dem Backup neben der Kopie dieses Mac hinzugefügt, benannt „(aus Backup)“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han añadido %lld preajustes integrados de la copia de seguridad junto a la copia de este Mac, con el nombre “(de la copia de seguridad)”"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld sisäänrakennettua esiasetusta lisätty varmuuskopiosta tämän Macin kopion viereen nimellä ”(varmuuskopiosta)”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld préréglages intégrés de la sauvegarde ajoutés à côté de la copie de ce Mac, nommés « (de la sauvegarde) »"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%lld פריסטים מובנים מהגיבוי נוספו לצד העותק של ה-Mac הזה, בשם “(מהגיבוי)”"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld beépített előbeállítás a mentésből hozzáadva a Mac meglévő példánya mellé, „(mentésből)” névvel"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld preset bawaan dari cadangan ditambahkan di samping salinan di Mac ini, bernama “(dari cadangan)”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld preset integrati dal backup aggiunti accanto alla copia di questo Mac, con il nome “(dal backup)”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの組み込みプリセット%lld個を、このMacのコピーの隣に「（バックアップから）」という名前で追加しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업의 내장 프리셋 %lld개를 이 Mac의 사본 옆에 “(백업에서)”라는 이름으로 추가함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld innebygde forhåndsinnstillinger fra sikkerhetskopien lagt til ved siden av kopien på denne Macen, med navnet «(fra sikkerhetskopi)»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ingebouwde presets uit de back-up zijn toegevoegd naast de kopie op deze Mac, met de naam “(uit back-up)”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wbudowane presety z kopii zapasowej (%lld) dodano obok kopii na tym Macu, z nazwą „(z kopii zapasowej)”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld presets integrados do backup adicionados ao lado da cópia deste Mac, chamados “(do backup)”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроенных пресетов из резервной копии: %lld. Они добавлены рядом с копией на этом Mac с пометкой «(из резервной копии)»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vstavané predvoľby zo zálohy pridané vedľa kópie v tomto Macu s názvom „(zo zálohy)“: %lld"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld inbyggda förinställningar från säkerhetskopian har lagts till bredvid den här Macens kopia, med namnet ”(från säkerhetskopia)”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มพรีเซ็ตที่มากับระบบ %lld รายการจากข้อมูลสำรองไว้ข้างสำเนาของ Mac เครื่องนี้ โดยตั้งชื่อว่า “(จากข้อมูลสำรอง)”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekteki %lld yerleşik ön ayar, bu Mac’teki kopyanın yanına “(yedekten)” adıyla eklendi"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вбудованих пресетів із резервної копії додано поруч із копією на цьому Mac під назвою «(з резервної копії)»: %lld"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cài đặt sẵn tích hợp từ bản sao lưu đã được thêm bên cạnh bản của Mac này, đặt tên “(từ bản sao lưu)”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份中的 %lld 个内置预设已添加到此 Mac 的副本旁，名称带“（来自备份）”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份中的 %lld 個內建預設已新增在此 Mac 的副本旁，名稱為「(來自備份)」"
          }
        }
      }
    },
    "%lld built-in presets were put back. Ones you kept, edited or not, were left as they are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُعيد %lld من الإعدادات المسبقة المضمّنة. لم تتأثر الإعدادات التي أبقيتها، سواء عدّلتها أم لا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vestavěné předvolby (%lld) byly obnoveny. Ty, které jste si ponechali, upravené či ne, zůstaly beze změny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld indbyggede forudindstillinger blev sat tilbage. Dem, du beholdt, redigeret eller ej, blev ikke ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld integrierte Presets wurden wiederhergestellt. Presets, die du behalten hast, ob bearbeitet oder nicht, blieben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han restaurado %lld preajustes integrados. Los que conservaste, editados o no, se han dejado como están."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld sisäänrakennettua esiasetusta palautettiin. Säilytettyjä esiasetuksia, muokattuja tai ei, ei muutettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld préréglages intégrés ont été rétablis. Ceux que vous avez conservés, modifiés ou non, sont restés tels quels."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%lld פריסטים מובנים הוחזרו. פריסטים ששמרת, ערכת או לא, נשארו כפי שהם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld beépített előbeállítás vissza lett állítva. A megtartott, szerkesztett vagy nem szerkesztett előbeállítások változatlanok maradtak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld preset bawaan telah dikembalikan. Preset yang Anda simpan, diedit atau tidak, dibiarkan apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld preset integrati sono stati ripristinati. Quelli che hai tenuto, modificati o meno, sono stati lasciati invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みプリセット%lld個を元に戻しました。保持していたもの（編集済みかどうかにかかわらず）はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내장 프리셋 %lld개를 복원했습니다. 보관한 프리셋은 편집 여부와 관계없이 그대로 두었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld innebygde forhåndsinnstillinger ble satt tilbake. De du beholdt, endret eller ikke, ble latt være som de er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ingebouwde presets zijn teruggezet. Presets die je hebt behouden, bewerkt of niet, zijn ongewijzigd gelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywrócono wbudowane presety: %lld. Zachowane presety, edytowane lub nie, pozostały bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld presets integrados foram restaurados. Os que você manteve, editados ou não, foram deixados como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановлено встроенных пресетов: %lld. Пресеты, которые вы оставили, изменённые или нет, не затронуты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovené vstavané predvoľby: %lld. Tie, ktoré ste ponechali, upravené či nie, zostali bez zmeny."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld inbyggda förinställningar har återställts. De du behöll, redigerade eller inte, lämnades som de är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำพรีเซ็ตที่มากับระบบ %lld รายการกลับมาแล้ว รายการที่คุณเก็บไว้ ไม่ว่าจะแก้ไขหรือไม่ ไม่ถูกเปลี่ยนแปลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld yerleşik ön ayar geri konuldu. Tuttuğunuz ön ayarlar, düzenlenmiş olsun olmasın, olduğu gibi bırakıldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повернено вбудованих пресетів: %lld. Ті, які ви залишили (змінені чи ні), не змінено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld cài đặt sẵn tích hợp đã được đặt lại. Những cái bạn đã giữ, dù đã chỉnh sửa hay chưa, được để nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复 %lld 个内置预设。你保留的预设（无论是否编辑过）保持不变。"
          }
        },
        "zh-Hant" : {
