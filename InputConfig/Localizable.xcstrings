    "Number of distinct times you've turned a preset on. Toggling off then back on counts as a fresh activation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد المرات المميزة التي شغّلت فيها إعدادًا مسبقًا. إيقافه ثم تشغيله مجددًا يُحتسب تفعيلًا جديدًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet jednotlivých případů, kdy jste předvolbu zapnuli. Vypnutí a opětovné zapnutí se počítá jako nová aktivace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal forskellige gange, du har slået en forudindstilling til. At slå fra og derefter til igen tæller som en ny aktivering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der verschiedenen Male, die du ein Preset eingeschaltet hast. Aus- und wieder Einschalten zählt als neue Aktivierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de veces distintas que has activado un preajuste. Desactivarlo y volver a activarlo cuenta como una activación nueva."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka monta eri kertaa esiasetus on kytketty päälle. Pois ja takaisin päälle kytkeminen lasketaan uudeksi aktivoinniksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de fois distinctes où vous avez activé un préréglage. Désactiver puis réactiver compte comme une nouvelle activation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר הפעמים השונות שהפעלת פריסט. כיבוי והפעלה מחדש נחשבים להפעלה חדשה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előbeállítás bekapcsolásainak különálló száma. A kikapcsolás, majd újbóli bekapcsolás új aktiválásnak számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah berapa kali Anda menyalakan preset. Mematikan lalu menyalakan lagi dihitung sebagai aktivasi baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di volte distinte in cui hai attivato un preset. Disattivarlo e riattivarlo conta come una nuova attivazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットをオンにした個別の回数。オフにして再びオンにすると、新たな有効化として数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋을 켠 서로 다른 횟수입니다. 껐다가 다시 켜면 새로운 활성화로 집계됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall ganger du har slått på en forhåndsinnstilling. Å slå av og på igjen telles som en ny aktivering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal keren dat je een preset hebt ingeschakeld. Uit- en weer inschakelen telt als een nieuwe activering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba różnych włączeń presetu. Wyłączenie, a potem ponowne włączenie liczy się jako nowa aktywacja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de vezes distintas em que você ligou um preset. Desligar e ligar de novo conta como uma nova ativação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Число раз, когда вы включали пресет. Выключение и повторное включение считаются новой активацией."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet jednotlivých ráz, keď ste zapli predvoľbu. Vypnutie a opätovné zapnutie sa počíta ako nová aktivácia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal separata gånger du har slagit på en förinställning. Att slå av och på igen räknas som en ny aktivering."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนครั้งที่คุณเปิดพรีเซ็ตโดยนับแยกกัน การปิดแล้วเปิดใหม่นับเป็นการเปิดใช้งานครั้งใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ön ayarı kaç farklı kez açtığınız. Kapatıp yeniden açmak yeni bir etkinleştirme sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість різних разів, коли ви вмикали пресет. Вимкнення та повторне ввімкнення рахується як нова активація."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lần riêng biệt bạn đã bật một cài đặt sẵn. Tắt rồi bật lại được tính là một lần kích hoạt mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你开启预设的不同次数。关闭后再开启算作一次新的启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你開啟預設的不同次數。關閉後再開啟會算作一次新的啟用。"
          }
        }
      }
    },
    "Number of key outputs the engine has fired. A press and its release count once; a row with several keys counts each one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد مخرجات المفاتيح التي أطلقها المحرك. تُحتسب الضغطة وتحريرها مرة واحدة؛ والصف ذو المفاتيح المتعددة يحتسب كل مفتاح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet výstupů kláves, které jádro spustilo. Stisk a jeho uvolnění se počítají jednou; řádek s několika klávesami počítá každou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal tastoutputs, motoren har udløst. Et tryk og dets slip tælles én gang. En række med flere taster tæller hver enkelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der Tastenausgaben, die die Engine ausgelöst hat. Ein Drücken und sein Loslassen zählen einmal; eine Zeile mit mehreren Tasten zählt jede einzeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de salidas de tecla que ha activado el motor. Una pulsación y su soltado cuentan una vez; una fila con varias teclas cuenta cada una."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moottorin laukaisemien näppäinulostulojen määrä. Painallus ja sen vapautus lasketaan kerran; usean näppäimen rivi laskee jokaisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de sorties de touche déclenchées par le moteur. Un appui et son relâchement comptent une fois ; une ligne avec plusieurs touches compte chacune."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר פלטי המקשים שהמנוע הפעיל. לחיצה ושחרורה נספרות פעם אחת; שורה עם כמה מקשים סופרת כל אחד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A motor által kiváltott billentyűkimenetek száma. Egy lenyomás és a felengedése egynek számít; a több billentyűs sor mindegyiket külön számolja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah output tombol yang telah dipicu mesin. Penekanan dan pelepasannya dihitung sekali; baris dengan beberapa tombol menghitung masing-masing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di uscite tasto attivate dal motore. Una pressione e il suo rilascio contano una volta; una riga con più tasti conta ciascuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンジンが実行したキー出力の回数。押下とその解除は1回として数えられ、複数のキーを持つ行は各キーが数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔진이 실행한 키 출력 횟수입니다. 누름과 놓음은 한 번으로 집계되며, 키가 여러 개인 행은 각각 집계됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall tasteutdata motoren har utløst. Et trykk og slippet av det telles én gang. En rad med flere taster teller hver av dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal toetsuitvoeren dat de engine heeft geactiveerd. Een druk en het loslaten tellen als één; een rij met meerdere toetsen telt ze elk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba wyjść klawiszy uruchomionych przez silnik. Naciśnięcie i jego puszczenie liczą się jako jedno, a wiersz z kilkoma klawiszami liczy każdy z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de saídas de tecla que o motor disparou. Um pressionamento e sua liberação contam uma vez; uma linha com várias teclas conta cada uma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Число выводов клавиш, выполненных движком. Нажатие и его отпускание считаются один раз; строка с несколькими клавишами считает каждую."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet výstupov klávesov, ktoré nástroj spustil. Stlačenie a jeho uvoľnenie sa počítajú raz; riadok s viacerými klávesmi počíta každý."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal tangentutdata som motorn har utlöst. Ett tryck och dess släpp räknas en gång. En rad med flera tangenter räknar var och en."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนเอาต์พุตแป้นที่เอนจินสั่งแล้ว การกดและการปล่อยนับเป็นหนึ่งครั้ง แถวที่มีหลายแป้นนับแต่ละแป้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motorun tetiklediği tuş çıkışı sayısı. Bir basış ve bırakılışı bir kez sayılır; birkaç tuşlu bir satır her birini sayar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість виходів клавіш, які запустив рушій. Натискання та його відпускання рахуються один раз; рядок із кількома клавішами рахує кожну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số đầu ra phím mà công cụ đã kích hoạt. Một lần nhấn và lần nhả của nó tính một lần; một hàng có nhiều phím tính từng phím."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎触发的按键输出数量。一次按下及其释放算一次；包含多个按键的行，每个按键各算一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引擎已觸發的按鍵輸出數量。一次按下及其放開只算一次；有多個按鍵的列則每個都計算。"
          }
        }
      }
    },
    "Number of times a macro binding has fired. Each macro chain counts once regardless of how many steps it contains." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد مرات إطلاق ربط ماكرو. تُحتسب كل سلسلة ماكرو مرة واحدة بغض النظر عن عدد خطواتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolikrát se přiřazení makra spustilo. Každý řetězec makra se počítá jednou bez ohledu na počet kroků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal gange, en makrotildeling er udløst. Hver makrokæde tælles én gang, uanset hvor mange trin den indeholder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der Male, die eine Makro-Belegung ausgelöst hat. Jede Makrokette zählt einmal, unabhängig von der Anzahl ihrer Schritte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de veces que se ha activado una asignación de macro. Cada cadena de macro cuenta una vez sin importar cuántos pasos contenga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuinka monta kertaa makromääritys on laukaissut. Jokainen makroketju lasketaan kerran riippumatta vaiheiden määrästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de fois où une affectation de macro s’est déclenchée. Chaque chaîne de macro compte une fois quel que soit son nombre d’étapes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר הפעמים שקישור מאקרו הופעל. כל שרשרת מאקרו נספרת פעם אחת, בלי קשר לכמה שלבים יש בה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahányszor egy makróhozzárendelés aktiválódott. Minden makrólánc egynek számít, függetlenül a lépések számától."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah berapa kali pemetaan makro aktif. Setiap rantai makro dihitung sekali berapa pun jumlah langkahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di volte in cui un’assegnazione macro è scattata. Ogni catena macro conta una volta indipendentemente da quanti passaggi contiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロのバインディングが実行された回数。マクロチェーンは、ステップ数にかかわらず1回として数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로 바인딩이 실행된 횟수입니다. 각 매크로 체인은 단계 수와 관계없이 한 번으로 집계됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall ganger en makrotilordning har utløst. Hver makrokjede telles én gang uansett hvor mange trinn den inneholder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal keren dat een macrotoewijzing is afgegaan. Elke macroketen telt één keer, ongeacht hoeveel stappen hij bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba uruchomień przypisania makra. Każdy łańcuch makr liczy się raz, niezależnie od liczby kroków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de vezes que um mapeamento de macro disparou. Cada cadeia de macro conta uma vez, qualquer que seja o número de passos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Число срабатываний привязки с макросом. Каждая цепочка макроса считается один раз независимо от числа шагов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet ráz, keď sa spustilo priradenie makra. Každý reťazec makra sa počíta raz bez ohľadu na počet krokov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal gånger en makrotilldelning har utlösts. Varje makrokedja räknas en gång oavsett hur många steg den innehåller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนครั้งที่การผูกมาโครทำงาน ลูกโซ่มาโครแต่ละอันนับเป็นหนึ่งครั้งไม่ว่าจะมีกี่ขั้นตอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir makro atamasının tetiklenme sayısı. Her makro zinciri, kaç adım içerirse içersin bir kez sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість спрацювань прив’язки макросу. Кожен ланцюжок макросу рахується один раз незалежно від кількості кроків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lần một mục gán macro đã kích hoạt. Mỗi chuỗi macro tính một lần bất kể có bao nhiêu bước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏绑定触发的次数。无论包含多少步骤，每条宏链算一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集綁定已觸發的次數。每條巨集串鏈無論包含幾個步驟都只算一次。"
          }
        }
      }
    },
