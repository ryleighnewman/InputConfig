    "The binding editor is still open. If you do not save, the changes are lost." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محرر الربط لا يزال مفتوحًا. إذا لم تحفظ، فستضيع التغييرات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor přiřazení je stále otevřený. Pokud neuložíte, změny se ztratí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tildelingseditoren er stadig åben. Hvis du ikke gemmer, går ændringerne tabt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Belegungseditor ist noch geöffnet. Wenn du nicht sicherst, gehen die Änderungen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El editor de asignaciones sigue abierto. Si no guardas, se perderán los cambios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Määritysmuokkain on edelleen auki. Jos et tallenna, muutokset menetetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éditeur d’affectation est toujours ouvert. Si vous n’enregistrez pas, les modifications seront perdues."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עורך הקישורים עדיין פתוח. אם לא תשמור, השינויים יאבדו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzárendelésszerkesztő még nyitva van. Ha nem ment, a módosítások elvesznek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor pemetaan masih terbuka. Jika Anda tidak menyimpan, perubahan akan hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’editor delle assegnazioni è ancora aperto. Se non salvi, le modifiche vanno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バインディングエディタはまだ開いています。保存しないと、変更内容は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바인딩 편집기가 아직 열려 있습니다. 저장하지 않으면 변경 사항이 사라집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilordningseditoren er fortsatt åpen. Hvis du ikke lagrer, går endringene tapt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toewijzingseditor is nog open. Als je niet bewaart, gaan de wijzigingen verloren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edytor przypisań jest nadal otwarty. Jeśli nie zapiszesz, zmiany zostaną utracone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O editor de mapeamento ainda está aberto. Se você não salvar, as alterações serão perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор привязок всё ещё открыт. Если не сохранить, изменения будут потеряны."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor priradení je stále otvorený. Ak neuložíte, zmeny sa stratia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilldelningsredigeraren är fortfarande öppen. Om du inte sparar går ändringarna förlorade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวแก้ไขการผูกยังเปิดอยู่ หากไม่บันทึก การเปลี่ยนแปลงจะสูญหาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atama düzenleyicisi hâlâ açık. Kaydetmezseniz değişiklikler kaybolur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор прив’язок досі відкрито. Якщо ви не збережете, зміни буде втрачено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình chỉnh sửa mục gán vẫn đang mở. Nếu bạn không lưu, các thay đổi sẽ mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绑定编辑器仍处于打开状态。如果不保存，更改将丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "綁定編輯器仍然開啟。如果不儲存，變更將會遺失。"
          }
        }
      }
    },
    "The binding editor opens faster and scrolls smoothly" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح محرر الربط أسرع ويمرر بسلاسة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editor přiřazení se otevírá rychleji a plynule se posouvá"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tildelingseditoren åbner hurtigere og ruller jævnt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Belegungseditor öffnet schneller und scrollt flüssig"
