        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แถวจอยสติ๊กทำงานด้วยทิศทางหรือโซน เลือกเคียงกันในเมนูทิศทาง ขณะที่จอยสติ๊กอยู่ในโซน แถวของโซนนั้นจะทำงานและแถวทิศทางของจอยสติ๊กจะรอ เว้นแต่โซนนั้นใช้จอยสติ๊กร่วมกัน (โซนในพรีเซ็ตที่สร้างก่อน 1.7 ยังคงใช้ร่วมกัน)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir çubuk satırı bir yönle veya bir bölgeyle çalışır; ikisi yön menüsünde yan yana seçilir. Çubuk bir bölgenin içindeyken o bölgenin satırı çalışır ve çubuğun yön satırları bekler, bölge çubuğu paylaşmıyorsa (1.7 öncesinde yapılmış ön ayarlardaki bölgeler paylaşmaya devam eder)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рядок джойстика спрацьовує за напрямком або за зоною, які вибирають поруч у меню напрямку; поки джойстик перебуває в зоні, спрацьовує рядок цієї зони, а рядки напрямків джойстика чекають, якщо тільки зона не ділить джойстик (зони в пресетах, створених до 1.7, і далі діляться)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một hàng cần kích hoạt theo một hướng hoặc theo một vùng, được chọn cạnh nhau trong menu hướng của nó; khi cần nằm trong một vùng, hàng của vùng đó kích hoạt và các hàng hướng của cần chờ, trừ khi vùng chia sẻ cần (các vùng trong cài đặt sẵn tạo trước 1.7 vẫn chia sẻ)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摇杆行可以按方向或按分区触发，二者并排显示在它的方向菜单中供选取；摇杆处于某个分区内时，该分区的行会触发，而摇杆的方向行会等待，除非该分区与摇杆共用（1.7 之前制作的预设中的分区仍保持共用）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搖桿列可以依方向或依分區觸發，兩者並排顯示在它的方向選單中供選擇；搖桿位於某個分區內時，該分區的列會觸發，而搖桿的方向列會等待，除非該分區與搖桿共用（1.7 之前製作的預設中的分區仍維持共用）"
          }
        }
      }
    },
    "A stick with four ring regions lighting in turn, a trigger with two bands, and a gesture of two flicks back" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عصا بأربع مناطق حلقية تضيء بالتناوب، وزناد بنطاقين، وإيماءة من نفضتين للخلف"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Páčka se čtyřmi prstencovými oblastmi, které se rozsvěcují postupně, spoušť se dvěma pásmy a gesto ze dvou švihnutí zpět"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En stick med fire ringområder, der lyser efter tur, en trigger med to bånd og en bevægelse med to ryk tilbage"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Stick mit vier Ring-Bereichen, die der Reihe nach aufleuchten, ein Trigger mit zwei Bändern und eine Geste aus zwei Flicks nach hinten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un stick con cuatro regiones en anillo que se iluminan por turnos, un gatillo con dos bandas y un gesto de dos flicks hacia atrás"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauva, jonka neljä rengasaluetta syttyvät vuorotellen, liipaisin, jolla on kaksi kaistaa, ja ele, jossa on kaksi näpäytystä taaksepäin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un stick avec quatre zones en anneau qui s’allument à tour de rôle, une gâchette avec deux bandes, et un geste de deux coups de stick vers l’arrière"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ג׳ויסטיק עם ארבעה אזורי טבעת שנדלקים בזה אחר זה, הדק עם שתי רצועות, ומחווה של שתי הצלפות אחורה"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy joystick négy gyűrűterülettel, amelyek sorban kigyulladnak, egy ravasz két sávval, és egy kétszeri hátrapöccintésből álló mozdulat"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stik dengan empat wilayah cincin yang menyala bergantian, pemicu dengan dua pita, dan gestur dua sentakan ke belakang"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stick con quattro regioni ad anello che si accendono a turno, un grilletto con due bande e un gesto di due flick all’indietro"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4つのリング領域が順に点灯するスティック、2つの帯があるトリガ、後ろへの2回のフリックによるジェスチャ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링 영역 네 개가 차례로 켜지는 스틱, 구간 두 개가 있는 트리거, 뒤로 두 번 플릭하는 제스처"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En joystick med fire ringområder som lyser etter tur, en avtrekker med to bånd og en bevegelse med to rykk bakover"
