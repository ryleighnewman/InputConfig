    "Automatic switching is off globally. Turn it on for these lists to take effect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التبديل التلقائي متوقف بشكل عام. شغّله لتسري هذه القوائم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické přepínání je globálně vypnuto. Zapněte ho, aby se tyto seznamy uplatnily."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk skift er slået fra globalt. Slå det til, for at disse lister træder i kraft."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der automatische Wechsel ist global ausgeschaltet. Schalte ihn ein, damit diese Listen wirksam werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cambio automático está desactivado globalmente. Actívalo para que estas listas surtan efecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen vaihto on pois päältä kaikkialla. Ota se käyttöön, jotta nämä luettelot tulevat voimaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement automatique est désactivé globalement. Activez-le pour que ces listes prennent effet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההחלפה האוטומטית כבויה בכל המערכת. הפעל אותה כדי שהרשימות האלה ייכנסו לתוקף."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az automatikus váltás globálisan ki van kapcsolva. Kapcsolja be, hogy ezek a listák érvényesüljenek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergantian otomatis nonaktif secara global. Nyalakan agar daftar ini berlaku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cambio automatico è disattivato a livello globale. Attivalo perché questi elenchi abbiano effetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動切り替えは全体でオフになっています。これらのリストを有効にするには、オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 전환이 전체적으로 꺼져 있습니다. 이 목록이 적용되려면 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
