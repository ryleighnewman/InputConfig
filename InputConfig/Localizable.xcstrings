    "Connect a controller and use it for a while." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل ذراع تحكم واستخدمه لبعض الوقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte ovladač a chvíli ho používejte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbind en controller, og brug den et stykke tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde einen Controller und benutze ihn eine Weile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un mando y úsalo un rato."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä ohjain ja käytä sitä hetki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez une manette et utilisez-la un moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חבר שלט והשתמש בו זמן מה."
          }
        },
        "hu" : {
