          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像配置文件按键一样切换 PlayStation Access 控制器的当前配置文件。仅限 USB-C；通过蓝牙时控制器只接受它自己的按键。"
