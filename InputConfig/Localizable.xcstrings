    "Per-preset Automation & Gaming Utilities: open an app on activate, confine the cursor, hide the system pointer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدوات الأتمتة والألعاب لكل إعداد مسبق: تشغيل تطبيق عند التفعيل، وحصر المؤشر، وإخفاء مؤشر النظام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nástroje pro automatizaci a hraní pro každou předvolbu: otevřít aplikaci při aktivaci, omezit kurzor, skrýt systémový ukazatel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiserings- og spilværktøjer pr. forudindstilling: åbn en app ved aktivering, begræns markøren, skjul systemmarkøren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisierungs- und Gaming-Dienstprogramme pro Preset: App beim Aktivieren öffnen, Cursor begrenzen, Systemzeiger ausblenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilidades de automatización y juegos por preajuste: abrir una app al activar, confinar el cursor, ocultar el puntero del sistema."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esiasetuskohtaiset Automaatio- ja pelityökalut: avaa appi aktivoitaessa, rajaa osoitin, piilota järjestelmän osoitin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitaires d’automatisation et de jeu par préréglage : ouvrir une app à l’activation, confiner le curseur, masquer le pointeur du système."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כלי אוטומציה ומשחקים לכל פריסט: פתיחת אפליקציה בהפעלה, הגבלת הסמן, הסתרת מצביע המערכת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Előbeállításonkénti Automatizálási és játékeszközök: app megnyitása aktiváláskor, a kurzor korlátozása, a rendszermutató elrejtése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilitas Otomatisasi & Game per preset: buka app saat aktivasi, kurung kursor, sembunyikan penunjuk sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automazione e utilità per i giochi per preset: apri un’app all’attivazione, confina il cursore, nascondi il puntatore di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットごとのオートメーションとゲーミングユーティリティ: 有効化時にAppを開く、カーソルを制限する、システムポインタを隠す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프리셋별 자동화 및 게임 유틸리티: 활성화할 때 앱 열기, 커서 가두기, 시스템 포인터 숨기기."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiserings- og spillverktøy per forhåndsinnstilling: åpne en app ved aktivering, begrens pekeren, skjul systempekeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatiserings- en gamehulpmiddelen per preset: open een app bij activering, beperk de cursor, verberg de systeemaanwijzer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzia automatyzacji i gier dla każdego presetu: otwórz aplikację przy aktywacji, ogranicz kursor, ukryj wskaźnik systemowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
