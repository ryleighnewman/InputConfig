    "Vibration requires a controller with Core Haptics support (DualSense, DualSense Edge, etc.) connected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب الاهتزاز ذراع تحكم يدعم Core Haptics (DualSense وDualSense Edge وغيرهما) متصلًا."
          }
        },
        "cs" : {
          "stringUnit" : {
