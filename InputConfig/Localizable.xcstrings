    "Vibrate the controller when a binding fires. Works with DualSense, DualSense Edge, and similar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يهتز ذراع التحكم عند إطلاق ربط. يعمل مع DualSense وDualSense Edge وما شابههما."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibrovat ovladačem, když se spustí přiřazení. Funguje s DualSense, DualSense Edge a podobnými."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibrér controlleren, når en tildeling udløses. Virker med DualSense, DualSense Edge og lignende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt den Controller vibrieren, wenn eine Belegung auslöst. Funktioniert mit DualSense, DualSense Edge und ähnlichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace vibrar el mando cuando se activa una asignación. Funciona con DualSense, DualSense Edge y similares."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värise ohjainta, kun määritys laukeaa. Toimii DualSensen, DualSense Edgen ja vastaavien kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire vibrer la manette quand une affectation se déclenche. Fonctionne avec la DualSense, la DualSense Edge et les manettes similaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרטט את השלט כשקישור מופעל. עובד עם DualSense, DualSense Edge ודומיהם."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezgesse a vezérlőt, amikor egy hozzárendelés aktiválódik. DualSense, DualSense Edge és hasonló vezérlőkkel működik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getarkan pengontrol saat pemetaan aktif. Berfungsi dengan DualSense, DualSense Edge, dan sejenisnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa vibrare il controller quando un’assegnazione si attiva. Funziona con DualSense, DualSense Edge e simili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バインディングが動作したときにコントローラを振動させます。DualSense、DualSense Edgeなどで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바인딩이 실행될 때 컨트롤러를 진동시킵니다. DualSense, DualSense Edge 및 유사한 컨트롤러에서 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vibrer kontrolleren når en tilordning utløses. Fungerer med DualSense, DualSense Edge og lignende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de controller trillen wanneer een toewijzing wordt geactiveerd. Werkt met DualSense, DualSense Edge en vergelijkbare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wibruj kontrolerem, gdy uruchamia się przypisanie. Działa z DualSense, DualSense Edge i podobnymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
