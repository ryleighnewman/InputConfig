    },
    "This change waits for Save: it would take away the rows that get you around the editor, so the running preset keeps its last version until you save." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتظر هذا التغيير زر «حفظ»: فهو سيزيل الصفوف التي تتيح لك التنقل في المحرر، لذا يحتفظ الإعداد المسبق الجاري بنسخته الأخيرة حتى تحفظ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato změna čeká na Uložit: odebrala by řádky, které vás provázejí editorem, takže běžící předvolba si ponechá poslední verzi, dokud neuložíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne ændring venter på Gem: den ville fjerne de rækker, der får dig rundt i editoren, så den kørende forudindstilling beholder sin sidste version, til du gemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Änderung wartet auf Sichern: Sie würde die Zeilen entfernen, mit denen du dich im Editor bewegst, daher behält das laufende Preset seine letzte Version, bis du sicherst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este cambio espera a Guardar: quitaría las filas que te permiten moverte por el editor, así que el preajuste en marcha conserva su última versión hasta que guardes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä muutos odottaa Tallenna-toimintoa: se poistaisi rivit, joilla liikut muokkaimessa, joten käynnissä oleva esiasetus säilyttää viimeisen versionsa, kunnes tallennat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette modification attend l’enregistrement : elle supprimerait les lignes qui vous permettent de naviguer dans l’éditeur, donc le préréglage en cours garde sa dernière version jusqu’à l’enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השינוי הזה ממתין ל״שמור״: הוא היה מסיר את השורות שמאפשרות לך להתמצא בעורך, ולכן הפריסט הפועל שומר על הגרסה האחרונה שלו עד שתשמור."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a módosítás a Mentésre vár: elvenné azokat a sorokat, amelyekkel a szerkesztőben közlekedik, ezért a futó előbeállítás az utolsó verzióját tartja meg, amíg nem ment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan ini menunggu Simpan: perubahan ini akan menghapus baris yang membantu Anda bergerak di editor, jadi preset yang berjalan mempertahankan versi terakhirnya sampai Anda menyimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa modifica attende Salva: toglierebbe le righe che ti permettono di muoverti nell’editor, quindi il preset in esecuzione mantiene la sua ultima versione finché non salvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この変更は保存するまで反映されません。エディタ内の移動に使う行がなくなってしまうため、保存するまでは実行中のプリセットが前のバージョンのまま動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 변경은 저장할 때까지 보류됩니다. 편집기 안에서 이동하는 데 쓰는 행이 사라지게 되므로, 저장하기 전까지 실행 중인 프리셋은 마지막 버전을 유지합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne endringen venter på Lagre: den ville fjernet radene som får deg rundt i editoren, så forhåndsinnstillingen som kjører, beholder sin siste versjon til du lagrer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze wijziging wacht op Bewaar: ze zou de rijen weghalen waarmee je je door de editor beweegt, dus de actieve preset behoudt zijn laatste versie tot je bewaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta zmiana czeka na Zapisz: usunęłaby wiersze, które prowadzą Cię po edytorze, więc działający preset zachowuje ostatnią wersję, dopóki nie zapiszesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
