        }
      }
    },
    "The small + on a row adds another action, so one press can do several things together." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علامة + الصغيرة في الصف تضيف إجراءً آخر، فتفعل الضغطة الواحدة عدة أشياء معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malé + u řádku přidá další akci, takže jeden stisk může udělat několik věcí zároveň."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lille + på en række tilføjer endnu en handling, så ét tryk kan gøre flere ting på én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kleine + an einer Zeile fügt eine weitere Aktion hinzu, sodass ein Druck mehrere Dinge zugleich tun kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El pequeño + de una fila añade otra acción, para que una pulsación haga varias cosas a la vez."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivin pieni + lisää uuden toiminnon, joten yksi painallus voi tehdä monta asiaa yhtä aikaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le petit + d'une ligne ajoute une autre action, pour qu'un seul appui fasse plusieurs choses ensemble."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-+ הקטן בשורה מוסיף פעולה נוספת, כך שלחיצה אחת עושה כמה דברים יחד."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sor kis + jele újabb műveletet ad hozzá, így egy nyomás több dolgot is csinálhat egyszerre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanda + kecil di baris menambah aksi lain, jadi satu tekanan bisa melakukan beberapa hal bersamaan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piccolo + su una riga aggiunge un'altra azione, così una pressione può fare più cose insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行の小さな＋で動作を追加すると、1回押すだけで複数のことを同時にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "행의 작은 +로 동작을 하나 더 추가하면, 한 번 눌러 여러 일을 함께 할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lille + på en rad legger til en handling til, så ett trykk kan gjøre flere ting samtidig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de kleine + op een rij voeg je nog een actie toe, zodat één druk meerdere dingen tegelijk doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mały + przy wierszu dodaje kolejną akcję, więc jedno naciśnięcie może zrobić kilka rzeczy naraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pequeno + numa linha adiciona outra ação, para um toque fazer várias coisas juntas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленький + у строки добавляет ещё одно действие, и одно нажатие делает несколько вещей сразу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malé + pri riadku pridá ďalšiu akciu, takže jedno stlačenie môže urobiť niekoľko vecí zároveň."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det lilla + på en rad lägger till en åtgärd till, så att ett tryck kan göra flera saker samtidigt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครื่องหมาย + เล็ก ๆ บนแถวเพิ่มการกระทำอีกอย่าง การกดครั้งเดียวจึงทำได้หลายอย่างพร้อมกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satırdaki küçük +, bir işlem daha ekler; böylece tek basış birkaç şeyi birlikte yapabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маленький + біля рядка додає ще одну дію, тож одне натискання робить кілька речей одразу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dấu + nhỏ trên một hàng thêm một hành động nữa, để một lần bấm làm được nhiều việc cùng lúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一行上的小 + 可以再添加一个动作，让一次按压同时做几件事。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一列上的小 + 可以再加入一個動作，讓一次按壓同時做幾件事。"
          }
        }
      }
    },
    "The Smart Preset Maker builds a tailored preset from a few questions: pick a game, answer, done." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبني صانع الإعدادات الذكية إعدادًا مسبقًا مخصصًا من بضعة أسئلة: اختر لعبة، وأجب، وانتهى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůrce chytrých předvoleb sestaví předvolbu na míru z několika otázek: vyberte hru, odpovězte, hotovo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Preset Maker bygger en skræddersyet forudindstilling ud fra nogle få spørgsmål: vælg et spil, svar, færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Smart-Preset-Ersteller baut aus ein paar Fragen ein maßgeschneidertes Preset: Spiel wählen, antworten, fertig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Creador de preajustes inteligentes crea un preajuste a medida con unas pocas preguntas: elige un juego, responde, listo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älykäs esiasetustyökalu rakentaa räätälöidyn esiasetuksen muutamasta kysymyksestä: valitse peli, vastaa, valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Créateur de préréglages intelligents crée un préréglage sur mesure à partir de quelques questions : choisissez un jeu, répondez, c’est fait."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יוצר הפריסטים החכמים בונה פריסט מותאם מכמה שאלות: בחר משחק, ענה, וסיימת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Okos előbeállítás-készítő néhány kérdésből személyre szabott előbeállítást épít: válasszon játékot, válaszoljon, kész."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembuat Preset Cerdas membuat preset yang disesuaikan dari beberapa pertanyaan: pilih game, jawab, selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Creatore di preset intelligenti costruisce un preset su misura da poche domande: scegli un gioco, rispondi, fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートプリセットメーカーは、いくつかの質問からプリセットを作成します: ゲームを選び、答えるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 프리셋 메이커는 몇 가지 질문으로 맞춤 프리셋을 만듭니다: 게임을 고르고, 답하면 끝."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Preset Maker bygger en skreddersydd forhåndsinnstilling ut fra noen få spørsmål: velg et spill, svar, ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Slimme preset-maker bouwt een preset op maat uit een paar vragen: kies een game, beantwoord, klaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreator inteligentnych ustawień buduje dopasowany preset na podstawie kilku pytań: wybierz grę, odpowiedz, gotowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Criador de presets inteligentes monta um preset sob medida a partir de poucas perguntas: escolha um jogo, responda e pronto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Умный конструктор пресетов» собирает подходящий пресет по нескольким вопросам: выберите игру, ответьте, готово."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvorca inteligentných predvolieb vytvorí predvoľbu na mieru z niekoľkých otázok: vyberte hru, odpovedzte, hotovo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Preset Maker bygger en skräddarsydd förinställning från några frågor: välj ett spel, svara, klart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวสร้างพรีเซ็ตอัจฉริยะสร้างพรีเซ็ตที่เหมาะกับคุณจากคำถามไม่กี่ข้อ: เลือกเกม ตอบ เสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akıllı Ön Ayar Oluşturucu birkaç sorudan size özel bir ön ayar oluşturur: bir oyun seçin, yanıtlayın, bitti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Конструктор розумних пресетів» створює пресет на замовлення за кількома запитаннями: виберіть гру, дайте відповідь, готово."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình tạo cài đặt sẵn thông minh tạo một cài đặt sẵn phù hợp từ vài câu hỏi: chọn một trò chơi, trả lời, xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智能预设制作器通过几个问题构建量身定制的预设：选一款游戏，回答问题，完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智慧型預設製作器會根據幾個問題建立量身打造的預設：選擇遊戲、回答，完成。"
          }
        }
      }
    },
    "The Smart Preset Maker can add touchpad-as-trackpad, gyro fine aim, and trigger rumble" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لصانع الإعدادات الذكية إضافة لوحة اللمس كلوحة تعقب، والتصويب الدقيق بالجيروسكوب، واهتزاز الزناد"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůrce chytrých předvoleb umí přidat touchpad jako trackpad, jemné zamíření gyroskopem a vibrace spouště"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Preset Maker kan tilføje touchpad som pegefelt, fint gyro-sigte og triggervibration"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Smart-Preset-Ersteller kann Touchpad als Trackpad, Gyro-Feinzielen und Trigger-Vibration hinzufügen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Creador de preajustes inteligentes puede añadir panel táctil como trackpad, apuntado fino por giroscopio y vibración de gatillo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Älykäs esiasetustyökalu voi lisätä kosketuslevyn ohjauslevynä, gyron hienokohdistuksen ja liipaisimen värinän"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Créateur de préréglages intelligents peut ajouter le pavé tactile en trackpad, la visée fine au gyroscope et les vibrations des gâchettes"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יוצר הפריסטים החכמים יכול להוסיף משטח מגע כמשטח עקיבה, כיוון עדין בג׳יירו ורטט הדק"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Okos előbeállítás-készítő hozzáadhat érintőpadot trackpadként, giroszkópos finomcélzást és ravaszrezgést"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembuat Preset Cerdas dapat menambahkan touchpad-sebagai-trackpad, bidikan halus giroskop, dan getaran pemicu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Creatore di preset intelligenti può aggiungere touchpad come trackpad, mira fine con giroscopio e vibrazione dei grilletti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートプリセットメーカーで、タッチパッドのトラックパッド化、ジャイロによる微調整エイム、トリガの振動を追加できるようになりました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 프리셋 메이커가 터치패드를 트랙패드로, 자이로 미세 조준, 트리거 진동을 추가할 수 있음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Preset Maker kan legge til berøringsflate som styreflate, gyro-finsikting og avtrekkervibrasjon"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Slimme preset-maker kan touchpad-als-trackpad, fijn richten met de gyro en triggertrilling toevoegen"
