    "%@ started, but Accessibility is off, so its keys and clicks are blocked" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدأ %@ لكن تسهيلات الاستخدام متوقفة، لذا فمفاتيحه ونقراته محظورة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spuštěno: %@, ale Zpřístupnění je vypnuto, takže jeho klávesy a kliknutí jsou blokovány"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ startede, men Tilgængelighed er slået fra, så dens taster og klik er blokeret"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde gestartet, aber Bedienungshilfen sind deaktiviert, daher werden Tasten und Klicks blockiert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha iniciado, pero Accesibilidad está desactivada, por lo que sus teclas y clics están bloqueados"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ käynnistyi, mutta Käyttöapu on pois päältä, joten sen näppäimet ja napsautukset estetään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a démarré, mais l’accessibilité est désactivée : ses touches et ses clics sont bloqués"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ הופעל, אבל הנגישות כבויה, ולכן המקשים והלחיצות שלו חסומים"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ elindult, de a Kisegítő lehetőségek ki van kapcsolva, ezért a billentyűleütései és kattintásai le vannak tiltva"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dimulai, tetapi Aksesibilitas nonaktif, sehingga tombol dan kliknya diblokir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato avviato, ma Accessibilità è disattivata, quindi i suoi tasti e clic sono bloccati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は起動しましたが、アクセシビリティがオフのため、キー入力とクリックはブロックされています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 시작되었지만 손쉬운 사용이 꺼져 있어 키와 클릭이 차단됩니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ startet, men Tilgjengelighet er av, så tastene og klikkene blokkeres"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is gestart, maar Toegankelijkheid staat uit, dus de toetsen en klikken worden geblokkeerd"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
