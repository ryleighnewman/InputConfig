    },
    "Unused means no button, stick, trigger or D-pad; motion does not count. A controller on a cable is never disconnected. Press its PS, Xbox or Home button to connect it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مستخدمة تعني عدم استخدام أي زر أو عصا أو زناد أو أزرار اتجاه؛ الحركة لا تُحتسب. لا تُفصل أبدًا وحدة تحكم موصولة بكابل. اضغط زر PS أو Xbox أو Home لتوصيلها من جديد."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepoužívaný znamená žádné tlačítko, páčka, spoušť ani směrový kříž; pohyb se nepočítá. Ovladač na kabelu se nikdy neodpojí. Stiskněte jeho tlačítko PS, Xbox nebo Home a znovu ho připojte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubrugt betyder ingen knap, stick, trigger eller retningsknap; bevægelse tæller ikke. En controller på kabel afbrydes aldrig. Tryk på dens PS-, Xbox- eller Home-knap for at forbinde den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungenutzt heißt: keine Taste, kein Stick, kein Trigger, kein Steuerkreuz; Bewegung zählt nicht. Ein Controller am Kabel wird nie getrennt. Drücke seine PS-, Xbox- oder Home-Taste, um ihn wieder zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin uso significa ningún botón, stick, gatillo ni cruceta; el movimiento no cuenta. Un mando con cable nunca se desconecta. Pulsa su botón PS, Xbox o Home para volver a conectarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttämätön tarkoittaa, ettei yhtään painiketta, sauvaa, liipaisinta tai ristiohjainta käytetä; liike ei lasku. Kaapelilla liitettyä ohjainta ei koskaan irroteta. Paina sen PS-, Xbox- tai Koti-painiketta yhdistääksesi sen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutilisée veut dire aucun bouton, stick, gâchette ni croix directionnelle ; le mouvement ne compte pas. Une manette sur câble n'est jamais déconnectée. Appuyez sur son bouton PS, Xbox ou Home pour la reconnecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אינו בשימוש פירושו אף כפתור, סטיק, הדק או כפתורי כיוון; תנועה לא נחשבת. בקר בכבל לעולם לא מנותק. לחצו על כפתור PS, Xbox או Home שלו כדי לחבר אותו שוב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használaton kívül azt jelenti: nincs gomb, kar, ravasz vagy iránygomb; a mozgás nem számít. Kábellel csatlakozó kontroller sosem lesz leválasztva. Nyomd meg a PS, Xbox vagy Home gombját az újracsatlakozáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dipakai artinya tidak ada tombol, stik, pemicu, atau D-pad; gerakan tidak dihitung. Kontroler berkabel tidak pernah diputus. Tekan tombol PS, Xbox, atau Home-nya untuk menyambungkannya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inutilizzato significa nessun pulsante, stick, grilletto o croce direzionale; il movimento non conta. Un controller via cavo non viene mai disconnesso. Premi il suo pulsante PS, Xbox o Home per ricollegarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使われていないとは、ボタン、スティック、トリガー、十字キーのどれも操作されていないことです。モーションは数えません。ケーブル接続のコントローラーは切断されません。PS、Xbox、ホームボタンを押すと再接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하지 않음은 버튼, 스틱, 트리거, 방향 패드를 쓰지 않는 상태입니다. 모션은 포함되지 않습니다. 케이블로 연결된 컨트롤러는 끊지 않습니다. PS, Xbox, 홈 버튼을 눌러 다시 연결하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubrukt betyr ingen knapp, stikke, avtrekker eller styrekors; bevegelse teller ikke. En kontroller på kabel kobles aldri fra. Trykk på PS-, Xbox- eller Hjem-knappen for å koble den til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongebruikt betekent geen knop, stick, trigger of D-pad; beweging telt niet. Een controller aan een kabel wordt nooit verbroken. Druk op de PS-, Xbox- of Home-knop om hem weer te verbinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieużywany oznacza brak przycisku, gałki, spustu i krzyżaka; ruch się nie liczy. Kontroler na kablu nigdy nie jest rozłączany. Naciśnij jego przycisk PS, Xbox lub Home, aby połączyć go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem uso significa nenhum botão, stick, gatilho ou direcional; movimento não conta. Um controle no cabo nunca é desconectado. Aperte o botão PS, Xbox ou Home para conectá-lo de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неиспользуемый значит: ни кнопок, ни стиков, ни триггеров, ни крестовины; движение не считается. Контроллер на кабеле никогда не отключается. Нажмите на нём PS, Xbox или Home, чтобы снова подключить."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepoužívaný znamená žiadne tlačidlo, páčka, spúšť ani smerový kríž; pohyb sa nepočíta. Ovládač na kábli sa nikdy neodpojí. Stlačte jeho tlačidlo PS, Xbox alebo Home a znova ho pripojte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oanvänd betyder ingen knapp, spak, avtryckare eller styrkors; rörelse räknas inte. En kontroll med kabel kopplas aldrig från. Tryck på dess PS-, Xbox- eller Hem-knapp för att ansluta den igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ได้ใช้หมายถึงไม่มีการกดปุ่ม สติ๊ก ทริกเกอร์ หรือปุ่มทิศทาง การเคลื่อนไหวไม่นับ คอนโทรลเลอร์ที่ต่อสายจะไม่ถูกตัด กดปุ่ม PS, Xbox หรือ Home เพื่อเชื่อมต่ออีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılmıyor demek düğme, çubuk, tetik veya yön tuşu yok demektir; hareket sayılmaz. Kabloyla bağlı bir denetleyicinin bağlantısı asla kesilmez. Yeniden bağlamak için PS, Xbox veya Home düğmesine basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невикористовуваний означає: жодних кнопок, стіків, тригерів чи хрестовини; рух не враховується. Контролер на кабелі ніколи не від'єднується. Натисніть на ньому PS, Xbox або Home, щоб знову під'єднати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không dùng nghĩa là không có nút, cần, cò hay phím hướng nào được dùng; chuyển động không tính. Tay cầm cắm cáp không bao giờ bị ngắt. Nhấn nút PS, Xbox hoặc Home để kết nối lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "闲置指没有按键、摇杆、扳机或方向键操作；体感不算。用线缆连接的控制器不会被断开。按下其 PS、Xbox 或 Home 键即可重新连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閒置指沒有按鈕、搖桿、扳機或方向鍵操作；體感不算。以線材連接的控制器不會被中斷。按下其 PS、Xbox 或 Home 鍵即可重新連接。"
          }
        }
      }
    },
