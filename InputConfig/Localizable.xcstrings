          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้อัตโนมัติเมื่อพรีเซ็ตเปิดใช้งาน และเปลี่ยนกลับเมื่อหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
