          "stringUnit" : {
            "state" : "translated",
            "value" : "Các cài đặt sẵn tích hợp liệt kê hàng trên một cần hoặc D-pad theo cùng thứ tự trên mọi bản cài"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内置预设在每次安装中都以相同顺序列出同一摇杆或十字键上的行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "內建預設在每次安裝中，都以相同順序列出單一搖桿或十字鍵上的列"
          }
        }
      }
    },
