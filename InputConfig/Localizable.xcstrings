    "Trigger feedback on the first connected controller, and speak through your Mac speakers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استجابة الزناد على أول ذراع تحكم متصل، والتحدث عبر مكبرات صوت الـ Mac."
          }
        },
        "cs" : {
