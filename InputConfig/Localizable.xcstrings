    "The gyroscope is not reporting. Try a wired connection, or re-pair the controller." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجيروسكوب لا يُبلغ. جرّب اتصالًا سلكيًا، أو أعد اقتران ذراع التحكم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyroskop nehlásí. Zkuste kabelové připojení, nebo ovladač znovu spárujte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyroskopet rapporterer ikke. Prøv en kablet forbindelse, eller par controlleren igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gyroskop meldet nichts. Versuche eine kabelgebundene Verbindung oder koppele den Controller neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El giroscopio no informa. Prueba una conexión por cable o vuelve a emparejar el mando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyroskooppi ei raportoi. Kokeile langallista yhteyttä tai muodosta ohjaimen pariliitos uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gyroscope ne signale rien. Essayez une connexion filaire, ou appairez à nouveau la manette."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הג׳יירוסקופ לא מדווח. נסה חיבור קווי, או צמד מחדש את השלט."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A giroszkóp nem jelent. Próbáljon vezetékes kapcsolatot, vagy párosítsa újra a vezérlőt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
