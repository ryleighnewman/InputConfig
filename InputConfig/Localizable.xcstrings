    "The activity log shows everything the app does, pops out into its own window, and can save a report" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض سجل النشاط كل ما يفعله التطبيق، ويمكن إخراجه في نافذته الخاصة، ويمكنه حفظ تقرير"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokol aktivity ukazuje vše, co aplikace dělá, lze ho vysunout do vlastního okna a umí uložit hlášení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
