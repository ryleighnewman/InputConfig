    "Outlined: the regions on this stick, lit while it is inside one: %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاطة بخط: مناطق العصا، وتُضاء المنطقة الحالية: %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti (páčka) jsou orámované, rozsvítí se ta, ve které se právě nachází: %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optegnet: områderne på denne stick, der lyser, mens den er inde i et af dem: %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umrandet: die Bereiche auf diesem Stick, hell, solange er in einem liegt: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con contorno: las regiones de este stick, que se iluminan mientras está dentro de una: %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reunustettu: tämän ohjainosan (sauva) alueet. Valaistuna, kun se on jonkin sisällä: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contourées : les zones de ce stick, allumées quand il est dans l’une d’elles : %@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסומן בקו מתאר: האזורים של ג׳ויסטיק זה, מוארים כל עוד הוא בתוך אחד מהם: %@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körvonalazva: a(z) joystick területei, amelyek világítanak, amíg benne van egyikben: %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diberi garis tepi: wilayah pada stik ini, menyala saat berada di dalam salah satunya: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con contorno: le regioni di questo stick, che si illuminano mentre è dentro una: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "枠線で表示: このスティックの領域。領域内にある間は点灯します: %@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윤곽선 표시: 이 스틱의 영역이며, 그 안에 있는 동안 켜집니다: %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omrisset: områdene på denne joysticken, som lyser mens den er inne i et av dem: %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omlijnd: de gebieden op deze stick, verlicht zolang hij in een gebied zit: %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obszary (drążek) są zaznaczone obrysem, podświetla się ten, w którym się aktualnie znajduje: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com contorno: as regiões deste stick, que acendem enquanto ele está dentro de uma: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обведены области этого элемента (стик); подсвечиваются, пока он внутри одной из них: %@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oblasti (páčka) sú orámované, rozsvieti sa tá, v ktorej sa práve nachádza: %@."
