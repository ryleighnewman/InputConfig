    "InputConfig cannot read this preset file. It may be from a newer version: update InputConfig, or ask for the file again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع InputConfig قراءة ملف الإعداد المسبق هذا. قد يكون من إصدار أحدث: حدّث InputConfig، أو اطلب الملف مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig tento soubor předvolby nedokáže přečíst. Může pocházet z novější verze: aktualizujte InputConfig, nebo o soubor požádejte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig kan ikke læse denne forudindstillingsfil. Den kan være fra en nyere version: opdater InputConfig, eller bed om filen igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig kann diese Preset-Datei nicht lesen. Sie stammt möglicherweise aus einer neueren Version: Aktualisiere InputConfig oder fordere die Datei erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig no puede leer este archivo de preajuste. Puede ser de una versión más reciente: actualiza InputConfig o pide el archivo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig ei voi lukea tätä esiasetustiedostoa. Se voi olla uudemmasta versiosta: päivitä InputConfig tai pyydä tiedosto uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InputConfig ne peut pas lire ce fichier de préréglage. Il provient peut-être d’une version plus récente : mettez à jour InputConfig, ou redemandez le fichier."
