            "value" : "Yedekteki 1 yerleşik ön ayar, bu Mac’teki kopyanın yanına “(yedekten)” adıyla eklendi"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 вбудований пресет із резервної копії додано поруч із копією на цьому Mac під назвою «(з резервної копії)»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 cài đặt sẵn tích hợp từ bản sao lưu đã được thêm bên cạnh bản của Mac này, đặt tên “(từ bản sao lưu)”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
