    "Help has a guide for every feature. You can start this tour again from the Help menu too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المساعدة دليل لكل ميزة. ويمكنك بدء هذه الجولة من جديد من قائمة «المساعدة» أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nápověda má průvodce každou funkcí. Tuto prohlídku můžete znovu spustit i z nabídky Nápověda."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælp har en guide til hver funktion. Du kan også starte rundturen igen fra menuen Hjælp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hilfe hat eine Anleitung zu jeder Funktion. Auch diese Tour kannst du im Menü Hilfe neu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ayuda tiene una guía para cada función. También puedes volver a empezar este tour desde el menú Ayuda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohjeessa on opas jokaiseen ominaisuuteen. Voit aloittaa tämän kierroksen uudelleen myös Ohje-valikosta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Aide a un guide pour chaque fonction. Vous pouvez aussi relancer cette visite depuis le menu Aide."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בעזרה יש מדריך לכל תכונה. אפשר גם להתחיל את הסיור הזה מחדש מתפריט ״עזרה״."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Súgóban minden funkcióhoz van útmutató. Ezt a bemutatót a Súgó menüből is újraindíthatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bantuan punya panduan untuk setiap fitur. Anda juga bisa memulai tur ini lagi dari menu Bantuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'Aiuto ha una guida per ogni funzione. Puoi far ripartire questo tour anche dal menu Aiuto."
          }
        },
