        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวแสดงภาพสดแสดงคอนโทรลเลอร์ของคุณขณะใช้งาน คลิกส่วนใดก็ได้เพื่อดูว่ามันทำอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı Görselleştirici, kumandanızı kullanırken gösterir. Ne yaptığını görmek için herhangi bir parçasına tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Візуалізатор наживо показує ваш контролер, поки ви ним користуєтеся. Натисніть будь-яку частину, щоб побачити, що вона робить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình hiển thị trực tiếp cho thấy bộ điều khiển khi bạn dùng nó. Nhấp vào bất kỳ phần nào để xem nó làm gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时可视化器会在你使用时显示你的控制器。点按任意部分即可查看它的作用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時視覺化工具會在你使用時顯示你的控制器。點按任何部分即可查看它的作用。"
          }
        }
      }
    },
    "The Live Visualizer's 3D controller now turns, tips and leans the way the controller does" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبحت وحدة التحكم ثلاثية الأبعاد في العارض المباشر تدور وتميل وتنحني كما تفعل وحدة التحكم"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3D ovladač v živém vizualizéru se teď otáčí, naklápí a klopí stejně jako skutečný ovladač"
          }
        },
        "da" : {
          "stringUnit" : {
