    "Trouble connecting a device or need help? Open Help, or please reach out" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تواجه مشكلة في توصيل جهاز أو تحتاج إلى مساعدة؟ افتح المساعدة، أو تواصل معنا"
          }
        },
        "cs" : {
          "stringUnit" : {
