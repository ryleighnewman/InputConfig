    "It also overlaps the region of row %@. Where the two meet, both rows fire." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتتداخل أيضًا مع منطقة الصف %@. حيث تلتقيان، يعمل الصفان معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasahuje také do oblasti řádku %@. Tam, kde se obě potkají, se spouštějí oba řádky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det overlapper også området for række %@. Hvor de to mødes, udløses begge rækker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er überschneidet sich auch mit dem Bereich der Zeile %@. Wo sich beide treffen, lösen beide Zeilen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se solapa con la región de la fila %@. Donde las dos coinciden, se activan ambas filas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se menee päällekkäin myös rivin %@ alueen kanssa. Missä ne kohtaavat, molemmat rivit laukeavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chevauche aussi la zone de la ligne %@. Là où les deux se rejoignent, les deux lignes se déclenchent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוא חופף גם לאזור של השורה %@. היכן ששניהם נפגשים, שתי השורות פועלות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@. sor területét is átfedi. Ahol a kettő találkozik, mindkét sor aktiválódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah ini juga tumpang tindih dengan wilayah baris %@. Di tempat keduanya bertemu, kedua baris aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sovrappone anche alla regione della riga %@. Dove le due si incontrano, si attivano entrambe le righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行 %@ の領域とも重なっています。2 つが重なる場所では、両方の行が動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 행의 영역과도 겹칩니다. 두 영역이 겹치는 곳에서는 두 행이 모두 동작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det overlapper også området til rad %@. Der de to møtes, utløses begge radene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het overlapt ook met het gebied van rij %@. Waar de twee elkaar raken, worden beide rijen geactiveerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakłada się też na obszar wiersza %@. Tam, gdzie się spotykają, uruchamiają się oba wiersze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também se sobrepõe à região da linha %@. Onde as duas se encontram, as duas linhas disparam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она также пересекается с областью строки %@. Там, где они встречаются, срабатывают обе строки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasahuje aj do oblasti riadka %@. Tam, kde sa obe stretnú, sa spúšťajú oba riadky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den överlappar också regionen för rad %@. Där de två möts utlöses båda raderna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่นี้ยังซ้อนกับพื้นที่ของแถว %@ ตรงที่ทั้งสองซ้อนกัน ทั้งสองแถวจะทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca %@ satırının bölgesiyle de çakışıyor. İkisinin buluştuğu yerde iki satır da çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона також перетинається із областю рядка %@. Там, де вони зустрічаються, спрацьовують обидва рядки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng này cũng chồng lên vùng của hàng %@. Ở chỗ hai vùng gặp nhau, cả hai hàng đều kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它还与第 %@ 行的区域重叠。两者相交处，两行都会触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它還與第 %@ 列的區域重疊。兩者相交處，兩列都會觸發。"
          }
        }
      }
    },
    "It also overlaps the regions of rows %@. Where they meet, each of those rows fires too." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتتداخل أيضًا مع مناطق الصفوف %@. حيث تلتقي، يعمل كل صف منها أيضًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasahuje také do oblastí řádků %@. Tam, kde se potkají, se spouští i každý z těch řádků."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det overlapper også områderne for rækkerne %@. Hvor de mødes, udløses hver af de rækker også."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er überschneidet sich auch mit den Bereichen der Zeilen %@. Wo sie sich treffen, löst auch jede dieser Zeilen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se solapa con las regiones de las filas %@. Donde coinciden, cada una de esas filas se activa también."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se menee päällekkäin myös rivien %@ alueiden kanssa. Missä ne kohtaavat, myös jokainen niistä riveistä laukeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chevauche aussi les zones des lignes %@. Là où elles se rejoignent, chacune de ces lignes se déclenche aussi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוא חופף גם לאזורים של השורות %@. היכן שהם נפגשים, גם כל אחת מהשורות האלה פועלת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@. sorok területeit is átfedi. Ahol találkoznak, azok a sorok is mind aktiválódnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wilayah ini juga tumpang tindih dengan wilayah baris %@. Di tempat semuanya bertemu, setiap baris itu juga aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sovrappone anche alle regioni delle righe %@. Dove si incontrano, si attiva anche ognuna di quelle righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行 %@ の領域とも重なっています。重なる場所では、それらの行もそれぞれ動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 행의 영역과도 겹칩니다. 겹치는 곳에서는 그 행들도 각각 동작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det overlapper også områdene til radene %@. Der de møtes, utløses hver av de radene også."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het overlapt ook met de gebieden van rijen %@. Waar ze elkaar raken, wordt elk van die rijen ook geactiveerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakłada się też na obszary wierszy %@. Tam, gdzie się spotykają, uruchamia się też każdy z tych wierszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também se sobrepõe às regiões das linhas %@. Onde elas se encontram, cada uma dessas linhas dispara também."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она также пересекается с областями строк %@. Там, где они встречаются, срабатывает и каждая из этих строк."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasahuje aj do oblastí riadkov %@. Tam, kde sa stretnú, sa spúšťa aj každý z tých riadkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den överlappar också regionerna för raderna %@. Där de möts utlöses var och en av de raderna också."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่นี้ยังซ้อนกับพื้นที่ของแถว %@ ตรงที่ซ้อนกัน แถวเหล่านั้นแต่ละแถวจะทำงานด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca %@ satırlarının bölgeleriyle de çakışıyor. Buluştukları yerde o satırların her biri de çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона також перетинається із областями рядків %@. Там, де вони зустрічаються, спрацьовує й кожен із цих рядків."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng này cũng chồng lên các vùng của hàng %@. Ở chỗ chúng gặp nhau, từng hàng đó cũng kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它还与第 %@ 行的区域重叠。相交处，这些行也都会各自触发。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它還與第 %@ 列的區域重疊。相交處，這些列也都會各自觸發。"
          }
        }
      }
    },
    "It also overlaps the zone of row %@. Where the two meet, both rows fire." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتتداخل أيضًا مع منطقة الصف %@. حيث تلتقيان، يعمل الصفان معًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasahuje také do zóny řádku %@. Tam, kde se obě potkají, se spouštějí oba řádky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den overlapper også zonen for række %@. Hvor de to mødes, udløses begge rækker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie überschneidet sich auch mit der Zone der Zeile %@. Wo sich beide treffen, lösen beide Zeilen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se solapa con la zona de la fila %@. Donde las dos coinciden, se activan ambas filas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se menee päällekkäin myös rivin %@ vyöhykkeen kanssa. Missä ne kohtaavat, molemmat rivit laukeavat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chevauche aussi la zone de la ligne %@. Là où les deux se rejoignent, les deux lignes se déclenchent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוא חופף גם לאזור של השורה %@. היכן ששניהם נפגשים, שתי השורות פועלות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@. sor zónáját is átfedi. Ahol a kettő találkozik, mindkét sor aktiválódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zona ini juga tumpang tindih dengan zona baris %@. Di tempat keduanya bertemu, kedua baris aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sovrappone anche alla zona della riga %@. Dove le due si incontrano, si attivano entrambe le righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行 %@ のゾーンとも重なっています。2 つが重なる場所では、両方の行が動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 행의 존과도 겹칩니다. 두 존이 겹치는 곳에서는 두 행이 모두 동작합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den overlapper også sonen til rad %@. Der de to møtes, utløses begge radene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij overlapt ook met de zone van rij %@. Waar de twee elkaar raken, worden beide rijen geactiveerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakłada się też na strefę wiersza %@. Tam, gdzie się spotykają, uruchamiają się oba wiersze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também se sobrepõe à zona da linha %@. Onde as duas se encontram, as duas linhas disparam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она также пересекается с зоной строки %@. Там, где они встречаются, срабатывают обе строки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasahuje aj do zóny riadka %@. Tam, kde sa obe stretnú, sa spúšťajú oba riadky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den överlappar också zonen för rad %@. Där de två möts utlöses båda raderna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โซนนี้ยังซ้อนกับโซนของแถว %@ ตรงที่ทั้งสองซ้อนกัน ทั้งสองแถวจะทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayrıca %@ satırının bölgesiyle de çakışıyor. İkisinin buluştuğu yerde iki satır da çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона також перетинається із зоною рядка %@. Там, де вони зустрічаються, спрацьовують обидва рядки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vùng này cũng chồng lên vùng của hàng %@. Ở chỗ hai vùng gặp nhau, cả hai hàng đều kích hoạt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
