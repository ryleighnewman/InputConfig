        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazır olduğunuzda Etkinleştir'e tıklayın; kumandanız ön ayarın söylediğini yapar. Durdurmak için tekrar tıklayın."
          }
