    "Invalid JSON. Open the file in a text editor and check for missing braces, quotes, or commas." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏JSON غير صالح. افتح الملف في محرر نصوص وتحقق من الأقواس أو علامات الاقتباس أو الفواصل المفقودة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neplatný JSON. Otevřete soubor v textovém editoru a zkontrolujte chybějící složené závorky, uvozovky nebo čárky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugyldig JSON. Åbn filen i et tekstprogram, og tjek for manglende tuborgklammer, anførselstegn eller kommaer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungültiges JSON. Öffne die Datei in einem Texteditor und prüfe, ob Klammern, Anführungszeichen oder Kommas fehlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON no válido. Abre el archivo en un editor de texto y comprueba si faltan llaves, comillas o comas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virheellinen JSON. Avaa tiedosto tekstieditorissa ja tarkista puuttuvat aaltosulkeet, lainausmerkit tai pilkut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON non valide. Ouvrez le fichier dans un éditeur de texte et vérifiez s’il manque des accolades, des guillemets ou des virgules."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏JSON לא תקין. פתח את הקובץ בעורך טקסט ובדוק אם חסרים סוגריים מסולסלים, מרכאות או פסיקים."
