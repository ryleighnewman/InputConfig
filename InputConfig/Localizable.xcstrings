    "Xbox One or Series pad: update to macOS 15 to use it over USB, or use Bluetooth" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذراع Xbox One أو Series: حدّث إلى macOS 15 لاستخدامه عبر USB، أو استخدم Bluetooth"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamepad Xbox One nebo Series: aktualizujte na macOS 15, abyste ho mohli používat přes USB, nebo použijte Bluetooth"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xbox One- eller Series-pad: opdater til macOS 15 for at bruge den via USB, eller brug Bluetooth"
