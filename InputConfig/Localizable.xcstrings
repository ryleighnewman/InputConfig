    "Adds a random amount, plus or minus, to every gap so the presses are not perfectly regular. 0 keeps them exact." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف مقدارًا عشوائيًا، موجبًا أو سالبًا، إلى كل فاصل حتى لا تكون الضغطات منتظمة تمامًا. القيمة 0 تبقيها دقيقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidá ke každé prodlevě náhodnou hodnotu, plus nebo minus, aby stisky nebyly dokonale pravidelné. 0 je ponechá přesné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lægger en tilfældig mængde, plus eller minus, til hvert mellemrum, så trykkene ikke er helt regelmæssige. 0 holder dem nøjagtige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt jedem Abstand einen zufälligen Betrag hinzu, plus oder minus, damit die Tastendrücke nicht perfekt gleichmäßig sind. 0 hält sie exakt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una cantidad aleatoria, más o menos, a cada intervalo para que las pulsaciones no sean perfectamente regulares. 0 las mantiene exactas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää satunnaisen määrän, plus tai miinus, jokaiseen väliin, jotta painallukset eivät ole täysin tasaisia. 0 pitää ne tarkkoina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une durée aléatoire, en plus ou en moins, à chaque intervalle pour que les appuis ne soient pas parfaitement réguliers. 0 les garde exacts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף כמות אקראית, חיובית או שלילית, לכל מרווח כדי שהלחיצות לא יהיו סדירות לגמרי. 0 משאיר אותן מדויקות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Véletlenszerű értéket ad hozzá vagy von le minden szünethez, hogy a lenyomások ne legyenek tökéletesen szabályosak. A 0 pontosan tartja őket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menambahkan jumlah acak, plus atau minus, ke setiap jeda sehingga penekanan tidak sepenuhnya teratur. 0 membuatnya tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge una quantità casuale, in più o in meno, a ogni intervallo, così le pressioni non risultano perfettamente regolari. Con 0 restano esatte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての間隔にプラスまたはマイナスのランダムな値を加え、押下が完全に規則的にならないようにします。0にすると正確なままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 간격에 ±무작위 값을 더해 누르기가 완벽하게 규칙적이지 않게 합니다. 0이면 정확하게 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger til en tilfeldig mengde, pluss eller minus, i hvert mellomrom, slik at trykkene ikke er helt regelmessige. 0 holder dem nøyaktige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt aan elke pauze een willekeurige hoeveelheid toe, plus of min, zodat de drukken niet perfect regelmatig zijn. 0 houdt ze exact."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje losową wartość, dodatnią lub ujemną, do każdego odstępu, aby naciśnięcia nie były idealnie regularne. 0 zachowuje dokładne odstępy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona uma quantidade aleatória, para mais ou para menos, a cada intervalo, para que os pressionamentos não sejam perfeitamente regulares. 0 os mantém exatos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет к каждому интервалу случайную величину (плюс или минус), чтобы нажатия шли не в идеальном ритме. 0 сохраняет точный ритм."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pridá ku každému intervalu náhodnú hodnotu, plus alebo mínus, aby stlačenia neboli dokonale pravidelné. 0 ich ponechá presné."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till en slumpmässig mängd, plus eller minus, i varje paus så att tryckningarna inte blir helt regelbundna. 0 behåller dem exakta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มค่าสุ่มบวกหรือลบให้กับทุกช่วงห่าง เพื่อไม่ให้การกดสม่ำเสมอเกินไป 0 คือคงที่พอดี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basışların tam düzenli olmaması için her aralığa artı veya eksi rastgele bir miktar ekler. 0 tam değerleri korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає до кожного проміжку випадкову величину, плюс або мінус, щоб натискання не були ідеально рівномірними. 0 залишає їх точними."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm một lượng ngẫu nhiên, cộng hoặc trừ, vào mỗi khoảng nghỉ để các lần nhấn không đều tuyệt đối. 0 giữ chúng chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个间隔会随机增减一定量，使按下不会过于规律。0 表示保持精确。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為每個間隔加上隨機的正負量，讓按下的節奏不會完全規律。0 表示維持精確。"
