    "Any control can also be bound to Emergency Stop in the editor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أيضًا ربط أي عنصر تحكم بإيقاف الطوارئ في المحرر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libovolný ovládací prvek lze v editoru přiřadit také k Nouzovému zastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhver kontrol kan også tildeles Nødstop i editoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Bedienelement kann im Editor auch dem Notstopp zugewiesen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier control también puede asignarse a Parada de emergencia en el editor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minkä tahansa ohjauksen voi myös määrittää Hätäpysäytykseksi muokkaimessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute commande peut aussi être affectée à l’arrêt d’urgence dans l’éditeur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לקשר כל פקד גם לעצירת חירום בעורך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármely vezérlő hozzárendelhető Vészleállításhoz a szerkesztőben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrol apa pun juga dapat dipetakan ke Penghentian Darurat di editor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsiasi comando può anche essere assegnato ad Arresto di emergenza nell’editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタで、どのコントロールも「緊急停止」に割り当てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집기에서 어떤 컨트롤이든 긴급 정지에 바인딩할 수도 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enhver kontroll kan også tilordnes til Nødstopp i editoren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke bediening kan in de editor ook aan Noodstop worden toegewezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowolne sterowanie można też przypisać do Awaryjnego zatrzymania w edytorze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer controle também pode ser mapeado para Parada de emergência no editor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой элемент управления можно также привязать к аварийной остановке в редакторе."
          }
        },
        "sk" : {
          "stringUnit" : {
