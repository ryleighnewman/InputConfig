    "Export Backup carries every setting, and the privacy policy says nothing is transmitted" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحمل «تصدير نسخة احتياطية» كل الإعدادات، وتنص سياسة الخصوصية على أنه لا يُرسل شيء"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportovat zálohu zahrnuje všechna nastavení a zásady ochrany soukromí uvádějí, že se nic nepřenáší"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportér backup indeholder alle indstillinger, og privatlivspolitikken siger, at intet sendes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Backup exportieren“ enthält jede Einstellung, und die Datenschutzrichtlinie besagt, dass nichts übertragen wird"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar copia de seguridad incluye todos los ajustes, y la política de privacidad dice que no se transmite nada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopion vienti sisältää jokaisen asetuksen, ja tietosuojakäytännön mukaan mitään ei lähetetä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporter la sauvegarde inclut tous les réglages, et la politique de confidentialité indique que rien n’est transmis"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״ייצוא גיבוי״ כולל כל הגדרה, ומדיניות הפרטיות קובעת שדבר לא נשלח"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mentés exportálása minden beállítást tartalmaz, az adatvédelmi irányelv pedig kimondja, hogy semmi sem kerül továbbításra"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspor Cadangan menyertakan setiap pengaturan, dan kebijakan privasi menyatakan tidak ada yang dikirim"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esporta backup include ogni impostazione, e l’informativa sulla privacy dice che nulla viene trasmesso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「バックアップを書き出す」にはすべての設定が含まれ、プライバシーポリシーには何も送信されないと明記されています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업 내보내기는 모든 설정을 포함하며, 개인정보 처리방침은 아무것도 전송되지 않는다고 명시함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporter sikkerhetskopi tar med alle innstillinger, og personvernerklæringen sier at ingenting overføres"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer back-up bevat elke instelling, en het privacybeleid zegt dat er niets wordt verzonden"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuj kopię zapasową obejmuje każde ustawienie, a polityka prywatności mówi, że nic nie jest przesyłane"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportar backup inclui todos os ajustes, e a política de privacidade diz que nada é transmitido"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Экспортировать резервную копию» сохраняет все настройки, а политика конфиденциальности гарантирует, что ничего не передаётся"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportovať zálohu obsahuje každé nastavenie a zásady ochrany súkromia hovoria, že sa nič neprenáša"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportera säkerhetskopia tar med alla inställningar, och integritetspolicyn säger att ingenting överförs"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งออกข้อมูลสำรองรวมทุกการตั้งค่า และนโยบายความเป็นส่วนตัวระบุว่าไม่มีการส่งข้อมูลใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeği Dışa Aktar her ayarı taşır ve gizlilik politikası hiçbir şeyin iletilmediğini söyler"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експорт резервної копії містить кожен параметр, а політика конфіденційності стверджує, що нічого не передається"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xuất bản sao lưu bao gồm mọi cài đặt, và chính sách quyền riêng tư nói rằng không có gì được truyền đi"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
