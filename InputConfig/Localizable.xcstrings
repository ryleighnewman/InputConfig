    "Unavailable while the throttle axis is a trigger (a trigger has no backward pull)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير متاح بينما يكون محور دواسة الوقود زنادًا (لا سحب للخلف في الزناد)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedostupné, dokud je osa plynu spoušť (spoušť nemá tah dozadu)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke tilgængelig, mens speederaksen er en trigger (en trigger har intet træk baglæns)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verfügbar, solange die Gasachse ein Trigger ist (ein Trigger hat kein Zurückziehen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible mientras el eje del acelerador es un gatillo (un gatillo no tiene tirón hacia atrás)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei käytettävissä kaasuakselin ollessa liipaisin (liipaisimella ei ole taaksepäin vetoa)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indisponible tant que l’axe d’accélération est une gâchette (une gâchette n’a pas de traction arrière)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא זמין כשציר המצערת הוא הדק (להדק אין משיכה אחורה)."
          }
        },
        "hu" : {
          "stringUnit" : {
