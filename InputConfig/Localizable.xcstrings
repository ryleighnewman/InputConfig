        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 누르면 출력이 켜지고 유지됩니다. 다음에 누르면 꺼집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett trykk slår utdataene på og lar dem stå på. Neste trykk slår dem av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén druk zet de uitvoer aan en laat hem aan. De volgende druk zet hem uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno naciśnięcie włącza wyjście i zostawia je włączone. Następne naciśnięcie je wyłącza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um pressionamento liga a saída e a deixa ligada. O próximo pressionamento a desliga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно нажатие включает вывод и оставляет его включённым. Следующее нажатие выключает его."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno stlačenie zapne výstup a nechá ho zapnutý. Ďalšie stlačenie ho vypne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett tryck slår på utdatan och lämnar den på. Nästa tryck slår av den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกดครั้งเดียวเปิดเอาต์พุตและคงไว้ การกดครั้งถัดไปปิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek basış çıkışı açar ve açık bırakır. Sonraki basış kapatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одне натискання вмикає вихід і залишає його ввімкненим. Наступне натискання вимикає його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lần nhấn bật đầu ra và giữ nó bật. Lần nhấn tiếp theo tắt nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一次打开输出并保持开启。再按一次关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一次就開啟輸出並保持開啟。再按一次則關閉。"
          }
        }
      }
    },
