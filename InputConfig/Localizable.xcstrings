          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 것이 Mac에서 실행되고 Mac에 남습니다. 원격 측정도, 계정도, 업로드도 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
