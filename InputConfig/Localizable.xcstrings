    "Note-on, note-off, CC, pitch-bend, program change: every event sent to the virtual MIDI source counts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل النوتة وإيقافها وCC وانحناء النغمة وتغيير البرنامج: يُحتسب كل حدث مرسل إلى مصدر MIDI الافتراضي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch-bend, změna programu: počítá se každá událost odeslaná do virtuálního zdroje MIDI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note On, Note Off, CC, pitch bend, programskift: hver hændelse sendt til den virtuelle MIDI-kilde tælles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, Note-off, CC, Pitch Bend, Programmwechsel: Jedes an die virtuelle MIDI-Quelle gesendete Ereignis zählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota activada, nota desactivada, CC, inflexión de tono, cambio de programa: cada evento enviado a la fuente MIDI virtual cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, äänenkorkeuden taivutus, ohjelmanvaihto: jokainen virtuaaliseen MIDI-lähteeseen lähetetty tapahtuma lasketaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note On, Note Off, CC, pitch bend, changement de programme : chaque événement envoyé à la source MIDI virtuelle compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Note-on, note-off, CC, pitch-bend, program change: כל אירוע שנשלח למקור ה-MIDI הווירטואלי נספר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, hanghajlítás, programváltás: a virtuális MIDI-forrásnak küldött minden esemény számít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch-bend, program change: setiap peristiwa yang dikirim ke sumber MIDI virtual dihitung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch-bend, program change: ogni evento inviato alla sorgente MIDI virtuale viene conteggiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートオン、ノートオフ、CC、ピッチベンド、プログラムチェンジ: 仮想MIDIソースに送信されるすべてのイベントが数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노트 온, 노트 오프, CC, 피치 벤드, 프로그램 체인지: 가상 MIDI 소스로 보낸 모든 이벤트가 집계됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch bend, programskifte: hver hendelse som sendes til den virtuelle MIDI-kilden, telles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch bend, programmawissel: elke gebeurtenis die naar de virtuele MIDI-bron wordt gestuurd, telt mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuta włączona, nuta wyłączona, CC, zmiana wysokości dźwięku, zmiana programu: liczy się każde zdarzenie wysłane do wirtualnego źródła MIDI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota ligada, nota desligada, CC, pitch bend, troca de programa: cada evento enviado à fonte MIDI virtual conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch-bend, смена программы: учитывается каждое событие, отправленное на виртуальный источник MIDI."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch-bend, program change: počíta sa každá udalosť odoslaná do virtuálneho zdroja MIDI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton på, ton av, CC, tonhöjdsböjning, programbyte: varje händelse som skickas till den virtuella MIDI-källan räknas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note-on, note-off, CC, pitch-bend, program change: ทุกเหตุการณ์ที่ส่งไปยังแหล่ง MIDI เสมือนถูกนับ"
