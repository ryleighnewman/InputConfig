    "Push a button on your controller while a preset is active to start tracking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط زرًا على ذراع التحكم بينما يكون إعداد مسبق نشطًا لبدء التتبع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiskněte tlačítko na ovladači, zatímco je předvolba aktivní, a začne sledování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en knap på din controller, mens en forudindstilling er aktiv, for at starte sporing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke eine Taste an deinem Controller, während ein Preset aktiv ist, um die Erfassung zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa un botón del mando mientras un preajuste está activo para empezar a registrar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina ohjaimen painiketta esiasetuksen ollessa aktiivinen aloittaaksesi seurannan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un bouton de votre manette pendant qu’un préréglage est actif pour commencer le suivi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחץ על לחצן בשלט בזמן שפריסט פעיל כדי להתחיל במעקב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyomjon meg egy gombot a vezérlőn, amíg egy előbeállítás aktív, hogy elindítsa a követést."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan tombol pada pengontrol Anda saat preset aktif untuk mulai melacak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi un pulsante sul controller mentre un preset è attivo per iniziare il tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリセットが有効な間にコントローラのボタンを押すと、記録を開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추적을 시작하려면 프리셋이 활성화된 상태에서 컨트롤러의 버튼을 누르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en knapp på kontrolleren mens en forhåndsinnstilling er aktiv for å starte sporing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op een knop op je controller terwijl een preset actief is om het bijhouden te starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij przycisk na kontrolerze, gdy preset jest aktywny, aby rozpocząć śledzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione um botão do controle enquanto um preset está ativo para começar a acompanhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку на контроллере, пока пресет активен, чтобы начать отслеживание."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stlačte tlačidlo na ovládači, kým je predvoľba aktívna, a začne sa sledovanie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en knapp på spelkontrollen medan en förinställning är aktiv för att börja spåra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กดปุ่มบนคอนโทรลเลอร์ขณะพรีเซ็ตใช้งานอยู่เพื่อเริ่มติดตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzlemeyi başlatmak için bir ön ayar etkinken kumandanızda bir düğmeye basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть кнопку на контролері, поки пресет активний, щоб почати відстеження."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn một nút trên bộ điều khiển khi cài đặt sẵn đang hoạt động để bắt đầu theo dõi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预设启用时按下控制器上的按钮即可开始追踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設啟用時在控制器上按下按鈕，即可開始追蹤。"
          }
        }
      }
    },
    "Push and hold the stick in one direction first. Disabled until the stick is moved far enough." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع العصا مع الإبقاء في اتجاه واحد أولًا. معطّل حتى تتحرك العصا بما يكفي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejdřív zatlačte a podržte páčku v jednom směru. Zakázáno, dokud se páčka nevychýlí dost daleko."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub og hold sticken i én retning først. Deaktiveret, indtil sticken er flyttet langt nok."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke den Stick zuerst in eine Richtung und halte ihn. Deaktiviert, bis der Stick weit genug bewegt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empuja primero el stick y mantenlo en una dirección. Desactivado hasta que el stick se mueva lo suficiente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työnnä ja pidä sauvaa ensin yhteen suuntaan. Pois käytöstä, kunnes sauvaa on liikutettu tarpeeksi kauas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poussez et maintenez d’abord le stick dans une direction. Désactivé tant que le stick n’est pas assez déplacé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דחוף והחזק את הג׳ויסטיק קודם בכיוון אחד. מושבת עד שהג׳ויסטיק מוזז מספיק רחוק."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Először tolja és tartsa a joystickot egy irányban. Letiltva, amíg a joystick nincs elég messzire mozdítva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorong dan tahan stik ke satu arah terlebih dahulu. Nonaktif sampai stik digerakkan cukup jauh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spingi e tieni lo stick in una direzione per prima cosa. Disattivato finché lo stick non è mosso abbastanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先にスティックを1方向に倒したまま保持してください。スティックが十分に動くまで無効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 스틱을 한 방향으로 밀어 유지하세요. 스틱이 충분히 움직이기 전에는 비활성화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyv og hold joysticken i én retning først. Deaktivert til joysticken er flyttet langt nok."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duw de stick eerst in één richting en houd hem vast. Uitgeschakeld tot de stick ver genoeg is bewogen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw wychyl i przytrzymaj drążek w jednym kierunku. Wyłączone, dopóki drążek nie zostanie wychylony wystarczająco daleko."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empurre e segure o stick em uma direção primeiro. Desativado até o stick ser movido o bastante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала отклоните стик и удерживайте его в одном направлении. Недоступно, пока стик не отклонён достаточно далеко."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprv zatlačte a podržte páčku v jednom smere. Nedostupné, kým sa páčka nepohne dostatočne ďaleko."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjut och håll spaken i en riktning först. Inaktiverad tills spaken har flyttats tillräckligt långt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดันจอยสติ๊กค้างไปทางเดียวก่อน ใช้ไม่ได้จนกว่าจะขยับจอยสติ๊กไกลพอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce çubuğu bir yöne itip basılı tutun. Çubuk yeterince uzağa hareket ettirilene kadar devre dışı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу натисніть джойстик в одному напрямку й утримуйте. Вимкнено, доки джойстик не відхилено достатньо далеко."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước tiên hãy đẩy và giữ cần theo một hướng. Bị tắt cho đến khi cần được di chuyển đủ xa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先朝一个方向推住摇杆。在摇杆移动足够远之前此项不可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先朝一個方向推住搖桿。在搖桿移動夠遠之前無法使用。"
          }
        }
      }
    },
