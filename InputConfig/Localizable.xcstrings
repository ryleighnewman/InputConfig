    "arrives as media keys: bind Keyboard Key › Play / Pause" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصل كمفاتيح وسائط: اربط «مفتاح لوحة المفاتيح» ثم «تشغيل / إيقاف مؤقت»"
