    "Profiles can be read and changed over USB-C only; over Bluetooth, switch with the controller's Profile button." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن قراءة ملفات التعريف وتغييرها إلا عبر USB-C؛ عبر Bluetooth بدّل بزر ملف التعريف على الوحدة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profily lze číst a měnit jen přes USB-C; přes Bluetooth přepínejte tlačítkem Profil na ovladači."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler kan kun læses og ændres via USB-C; via Bluetooth skifter du med controllerens Profil-knap."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile können nur über USB-C gelesen und geändert werden; über Bluetooth schaltest du mit der Profiltaste des Controllers um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles solo se pueden leer y cambiar por USB-C; por Bluetooth, cambia con el botón Perfil del mando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiileja voi lukea ja muuttaa vain USB-C:llä; Bluetoothilla vaihda ohjaimen Profiili-painikkeella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils ne peuvent être lus et modifiés qu'en USB-C ; en Bluetooth, basculez avec le bouton Profil de la manette."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניתן לקרוא ולשנות פרופילים רק דרך USB-C; ב-Bluetooth החליפו בכפתור הפרופיל של הבקר."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A profilok csak USB-C-n olvashatók és módosíthatók; Bluetoothon a kontroller Profil gombjával válts."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil hanya bisa dibaca dan diubah lewat USB-C; lewat Bluetooth, berpindah dengan tombol Profil kontroler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili si possono leggere e modificare solo via USB-C; via Bluetooth, cambia con il pulsante Profilo del controller."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルの読み取りと変更はUSB-Cでのみ可能です。Bluetoothではコントローラーのプロファイルボタンで切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로파일은 USB-C로만 읽고 변경할 수 있습니다. Bluetooth에서는 컨트롤러의 프로파일 버튼으로 전환하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler kan bare leses og endres via USB-C; via Bluetooth bytter du med Profil-knappen på kontrolleren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profielen kunnen alleen via USB-C worden gelezen en gewijzigd; via Bluetooth schakel je met de Profiel-knop van de controller."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile można odczytywać i zmieniać tylko przez USB-C; przez Bluetooth przełączaj przyciskiem Profil na kontrolerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os perfis só podem ser lidos e alterados por USB-C; por Bluetooth, alterne com o botão Perfil do controle."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили можно читать и менять только по USB-C; по Bluetooth переключайте кнопкой Профиль на контроллере."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profily možno čítať a meniť len cez USB-C; cez Bluetooth prepínajte tlačidlom Profil na ovládači."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler kan bara läsas och ändras via USB-C; via Bluetooth växlar du med kontrollens Profil-knapp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านและเปลี่ยนโปรไฟล์ได้ผ่าน USB-C เท่านั้น; ผ่าน Bluetooth ให้สลับด้วยปุ่มโปรไฟล์ของคอนโทรลเลอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiller yalnızca USB-C üzerinden okunup değiştirilebilir; Bluetooth'ta denetleyicinin Profil düğmesiyle geçiş yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профілі можна читати та змінювати лише по USB-C; по Bluetooth перемикайте кнопкою Профіль на контролері."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ đọc và thay đổi được hồ sơ qua USB-C; qua Bluetooth, chuyển bằng nút Hồ sơ của tay cầm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置文件只能通过 USB-C 读取和更改；蓝牙下请用控制器的配置文件按键切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
