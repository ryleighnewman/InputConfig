        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“与系统一致”跟随“系统设置”>“通用”>“语言与地区”，你也可以在那里仅为 InputConfig 设置语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
