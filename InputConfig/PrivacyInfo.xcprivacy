<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Privacy manifest declaring zero third-party data collection and zero
        tracking. InputConfig stores everything (presets, stats, region
        definitions, calibration) on-device in the sandbox container. No
        network beacons, no analytics SDKs, no advertising attribution, and
        no network calls in normal use (the App Store handles updates; the
        in-app version check was removed).
    -->
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!--
        Required-reason API declarations. We touch a small number of APIs
        that Apple flags as "common-but-may-be-fingerprinted" since the App
        Store rollout in 2024. Each entry below names the API category and
        the reason code from Apple's published list.
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!--
            UserDefaults is how preset metadata, calibration matrices,
            region definitions, and user preferences persist across
            launches. Reason CA92.1: "Access info from same app, per
            documentation." We never read or write UserDefaults belonging
            to another app or extension.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>

        <!--
            File timestamps are read only for files inside the app's own
            container: the creation date of Application Support/InputConfig
            tells an upgrade from a first run (ContentView), and FileManager
            reads metadata while writing preset, backup, and stats files.
            Reason C617.1: access the timestamps, size, or other metadata of
            files inside the app container. Never shown or sent anywhere.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>

        <!--
            System boot time is read via ProcessInfo.systemUptime in the
            engine, the cursor guard, and the input services for monotonic
            clocks (tick deltas, double-click timing, hold windows). Reason
            35F9.1: "Measure time elapsed between events that occur inside
            the app." Never transmitted off-device.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
